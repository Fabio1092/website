---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/wissenPkvFuerWen/Hero.astro";
import TableOfContents from "@/components/wissenPkvFuerWen/TableOfContents.astro";
import Article from "@/components/wissenPkvFuerWen/Article.astro";
import Fazit from "@/components/wissenPkvFuerWen/Fazit.astro";

const pageTitle = "Für wen lohnt sich die PKV? | Fabio Rumpf";
const pageDescription =
  "Für wen ist die PKV sinnvoll? Entscheidungshilfe für Angestellte, Selbstständige, Beamte und Familien – mit Kriterien, Risiken und Praxisbeispielen.";
const canonicalUrl = new URL("/wissen/private-krankenversicherung/fuer-wen-lohnt-sich-die-pkv/", Astro.site).toString();

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "Für wen lohnt sich die private Krankenversicherung?",
  description: pageDescription,
  inLanguage: "de-DE",
  datePublished: "2026-10-14",
  dateModified: "2026-10-14",
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl },
  author: { "@type": "Person", name: "Fabio Rumpf", jobTitle: "Versicherungs- und Finanzmakler" },
  publisher: { "@type": "Organization", name: "Fabio Rumpf Makler" },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Startseite", item: new URL("/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: "Wissen", item: new URL("/wissen/", Astro.site).toString() },
    {
      "@type": "ListItem",
      position: 3,
      name: "PKV-Wissen",
      item: new URL("/wissen/private-krankenversicherung/", Astro.site).toString(),
    },
    { "@type": "ListItem", position: 4, name: "Für wen lohnt sich die PKV?", item: canonicalUrl },
  ],
};
---

<Layout title={pageTitle} description={pageDescription} fullTitle>
  <Hero />
  <TableOfContents />
  <Article />
  <Fazit />
</Layout>

<script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
