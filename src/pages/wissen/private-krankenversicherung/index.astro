---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/wissen/Hero.astro";
import TopicCategoryList from "@/components/wissen/TopicCategoryList.astro";
import AvailableNow from "@/components/wissen/AvailableNow.astro";
import { pkvWissenCategories, pkvAvailableLinks } from "@/lib/wissen";
---

<Layout
  title="PKV-Wissen & Ratgeber | Fabio Rumpf"
  description="PKV-Wissen von Fabio Rumpf: verständliche Ratgeber zu Tarifen, Leistungen, Gesundheitsangaben, Risikovoranfrage und langfristigen Entscheidungen."
  fullTitle
>
  <Hero
    eyebrow="PKV-Wissen"
    title="PKV-Wissen: Private Krankenversicherung verständlich erklärt"
    titleHighlight="Private Krankenversicherung"
    intro={[
      "Hier findest du meine Ratgeber zu wichtigen Fragen rund um die private Krankenversicherung – von Tarifen und Leistungen bis zu Gesundheitsangaben, Risikovoranfrage und langfristigen Entscheidungen.",
    ]}
  />

  <TopicCategoryList
    categories={pkvWissenCategories}
    heading="Themen im PKV-Wissen"
    intro="Die Inhalte sind nach Themen geordnet. Verfügbare Artikel kannst du direkt öffnen; weitere PKV-Themen ergänze ich Schritt für Schritt."
  />

  <AvailableNow
    title="Bereits verfügbar"
    intro="Diese Themen sind schon jetzt ausführlich aufbereitet."
    links={pkvAvailableLinks}
    hubHref="/private-krankenversicherung-kassel/"
    hubLabel="Zur PKV-Beratung in Kassel"
  />
</Layout>
