---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/wissenPkvTarifwechsel/Hero.astro";
import TableOfContents from "@/components/wissenPkvTarifwechsel/TableOfContents.astro";
import Article from "@/components/wissenPkvTarifwechsel/Article.astro";
import Fazit from "@/components/wissenPkvTarifwechsel/Fazit.astro";

const pageTitle = "PKV Tarifwechsel nach § 204 VVG: So funktioniert er";
const pageDescription =
  "PKV-Tarifwechsel nach § 204 VVG erklärt: Rechte, Altersrückstellungen, Gesundheitsprüfung, Mehrleistungen und typische Fehler beim internen Wechsel.";
const canonicalUrl = new URL("/wissen/private-krankenversicherung/pkv-tarifwechsel/", Astro.site).toString();

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "PKV-Tarifwechsel nach § 204 VVG: So funktioniert er",
  description: pageDescription,
  inLanguage: "de-DE",
  datePublished: "2026-10-16",
  dateModified: "2026-10-16",
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl },
  author: { "@type": "Person", name: "Fabio Rumpf", jobTitle: "Versicherungs- und Finanzmakler" },
  publisher: { "@type": "Organization", name: "Fabio Rumpf Makler" },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Startseite", item: new URL("/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: "Wissen", item: new URL("/wissen/", Astro.site).toString() },
    {
      "@type": "ListItem",
      position: 3,
      name: "PKV-Wissen",
      item: new URL("/wissen/private-krankenversicherung/", Astro.site).toString(),
    },
    { "@type": "ListItem", position: 4, name: "PKV Tarifwechsel", item: canonicalUrl },
  ],
};
---

<Layout title={pageTitle} description={pageDescription} fullTitle>
  <Hero />
  <TableOfContents />
  <Article />
  <Fazit />
</Layout>

<script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
