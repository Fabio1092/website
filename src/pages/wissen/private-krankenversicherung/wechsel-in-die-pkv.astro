---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/wissenWechselInDiePkv/Hero.astro";
import TableOfContents from "@/components/wissenWechselInDiePkv/TableOfContents.astro";
import Article from "@/components/wissenWechselInDiePkv/Article.astro";
import Fazit from "@/components/wissenWechselInDiePkv/Fazit.astro";

const pageTitle = "Wechsel in die PKV: Ablauf, Fristen & Gesundheitsprüfung";
const pageDescription =
  "Wie funktioniert der Wechsel von der GKV in die PKV? Voraussetzungen, Gesundheitsprüfung, Risikovoranfrage, Antrag und Kündigung Schritt für Schritt.";
const canonicalUrl = new URL("/wissen/private-krankenversicherung/wechsel-in-die-pkv/", Astro.site).toString();

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "Wechsel in die PKV: So funktioniert der Wechsel von der GKV",
  description: pageDescription,
  inLanguage: "de-DE",
  datePublished: "2026-10-16",
  dateModified: "2026-10-16",
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl },
  author: { "@type": "Person", name: "Fabio Rumpf", jobTitle: "Versicherungs- und Finanzmakler" },
  publisher: { "@type": "Organization", name: "Fabio Rumpf Makler" },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Startseite", item: new URL("/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: "Wissen", item: new URL("/wissen/", Astro.site).toString() },
    {
      "@type": "ListItem",
      position: 3,
      name: "PKV-Wissen",
      item: new URL("/wissen/private-krankenversicherung/", Astro.site).toString(),
    },
    { "@type": "ListItem", position: 4, name: "Wechsel in die PKV", item: canonicalUrl },
  ],
};
---

<Layout title={pageTitle} description={pageDescription} fullTitle>
  <Hero />
  <TableOfContents />
  <Article />
  <Fazit />
</Layout>

<script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
