---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/wissenPkvVoraussetzungen/Hero.astro";
import TableOfContents from "@/components/wissenPkvVoraussetzungen/TableOfContents.astro";
import Article from "@/components/wissenPkvVoraussetzungen/Article.astro";
import Fazit from "@/components/wissenPkvVoraussetzungen/Fazit.astro";

const pageTitle = "PKV Voraussetzungen: Wer kann sich privat versichern?";
const pageDescription =
  "Welche Voraussetzungen gelten für die PKV? Einkommen, JAEG, Berufsstatus und Gesundheitsprüfung für Angestellte, Selbstständige, Beamte und Studenten.";
const canonicalUrl = new URL("/wissen/private-krankenversicherung/pkv-voraussetzungen/", Astro.site).toString();

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "PKV Voraussetzungen: Wer kann sich privat krankenversichern?",
  description: pageDescription,
  inLanguage: "de-DE",
  datePublished: "2026-10-14",
  dateModified: "2026-10-14",
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl },
  author: { "@type": "Person", name: "Fabio Rumpf", jobTitle: "Versicherungs- und Finanzmakler" },
  publisher: { "@type": "Organization", name: "Fabio Rumpf Makler" },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Startseite", item: new URL("/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: "Wissen", item: new URL("/wissen/", Astro.site).toString() },
    {
      "@type": "ListItem",
      position: 3,
      name: "PKV-Wissen",
      item: new URL("/wissen/private-krankenversicherung/", Astro.site).toString(),
    },
    { "@type": "ListItem", position: 4, name: "PKV Voraussetzungen", item: canonicalUrl },
  ],
};
---

<Layout title={pageTitle} description={pageDescription} fullTitle>
  <Hero />
  <TableOfContents />
  <Article />
  <Fazit />
</Layout>

<script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
