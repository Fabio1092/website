---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/wissenPkvFunktionsweise/Hero.astro";
import TableOfContents from "@/components/wissenPkvFunktionsweise/TableOfContents.astro";
import Article from "@/components/wissenPkvFunktionsweise/Article.astro";
import Faq from "@/components/wissenPkvFunktionsweise/Faq.astro";
import Fazit from "@/components/wissenPkvFunktionsweise/Fazit.astro";

const pageTitle = "Wie funktioniert die private Krankenversicherung? | Fabio Rumpf";
const pageDescription =
  "Wie funktioniert die private Krankenversicherung? Beiträge, Leistungen, Gesundheitsprüfung, Rechnungen und Alterungsrückstellungen verständlich erklärt.";
const canonicalUrl = new URL("/wissen/private-krankenversicherung/wie-funktioniert-die-pkv/", Astro.site).toString();

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "Wie funktioniert die private Krankenversicherung?",
  description: pageDescription,
  inLanguage: "de-DE",
  datePublished: "2026-09-16",
  dateModified: "2026-09-16",
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl },
  author: { "@type": "Person", name: "Fabio Rumpf", jobTitle: "Versicherungs- und Finanzmakler" },
  publisher: { "@type": "Organization", name: "Fabio Rumpf Makler" },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Startseite", item: new URL("/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: "Wissen", item: new URL("/wissen/", Astro.site).toString() },
    {
      "@type": "ListItem",
      position: 3,
      name: "PKV-Wissen",
      item: new URL("/wissen/private-krankenversicherung/", Astro.site).toString(),
    },
    { "@type": "ListItem", position: 4, name: "Wie funktioniert die private Krankenversicherung?", item: canonicalUrl },
  ],
};
---

<Layout title={pageTitle} description={pageDescription} fullTitle>
  <Hero />
  <TableOfContents />
  <Article />
  <Faq />
  <Fazit />
</Layout>

<script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
