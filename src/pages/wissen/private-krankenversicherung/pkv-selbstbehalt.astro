---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/wissenPkvSelbstbehalt/Hero.astro";
import TableOfContents from "@/components/wissenPkvSelbstbehalt/TableOfContents.astro";
import Article from "@/components/wissenPkvSelbstbehalt/Article.astro";
import Fazit from "@/components/wissenPkvSelbstbehalt/Fazit.astro";

const pageTitle = "PKV Selbstbehalt: Wie hoch sollte er sein?";
const pageDescription =
  "PKV Selbstbehalt erklärt: Welche Höhe sinnvoll ist, wie er den Beitrag senkt und worauf Angestellte und Selbstständige achten sollten.";
const canonicalUrl = new URL("/wissen/private-krankenversicherung/pkv-selbstbehalt/", Astro.site).toString();

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "PKV Selbstbehalt: Wie hoch sollte die Selbstbeteiligung sein?",
  description: pageDescription,
  inLanguage: "de-DE",
  datePublished: "2026-10-15",
  dateModified: "2026-10-15",
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl },
  author: { "@type": "Person", name: "Fabio Rumpf", jobTitle: "Versicherungs- und Finanzmakler" },
  publisher: { "@type": "Organization", name: "Fabio Rumpf Makler" },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Startseite", item: new URL("/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: "Wissen", item: new URL("/wissen/", Astro.site).toString() },
    {
      "@type": "ListItem",
      position: 3,
      name: "PKV-Wissen",
      item: new URL("/wissen/private-krankenversicherung/", Astro.site).toString(),
    },
    { "@type": "ListItem", position: 4, name: "PKV Selbstbehalt", item: canonicalUrl },
  ],
};
---

<Layout title={pageTitle} description={pageDescription} fullTitle>
  <Hero />
  <TableOfContents />
  <Article />
  <Fazit />
</Layout>

<script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
