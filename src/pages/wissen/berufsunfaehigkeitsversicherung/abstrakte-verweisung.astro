---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/wissenAbstrakteVerweisung/Hero.astro";
import TableOfContents from "@/components/wissenAbstrakteVerweisung/TableOfContents.astro";
import Article from "@/components/wissenAbstrakteVerweisung/Article.astro";
import Faq from "@/components/wissenAbstrakteVerweisung/Faq.astro";
import Fazit from "@/components/wissenAbstrakteVerweisung/Fazit.astro";

const pageTitle = "Abstrakte Verweisung in der BU | Fabio Rumpf";
const pageDescription =
  "Abstrakte Verweisung in der BU verständlich erklärt: Was sie bedeutet, warum der Verzicht wichtig ist und worauf du bei älteren Verträgen achten solltest.";
const canonicalUrl = new URL("/wissen/berufsunfaehigkeitsversicherung/abstrakte-verweisung/", Astro.site).toString();

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: pageTitle,
  description: pageDescription,
  inLanguage: "de-DE",
  datePublished: "2026-09-12",
  dateModified: "2026-09-12",
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl },
  author: { "@type": "Person", name: "Fabio Rumpf", jobTitle: "Versicherungs- und Finanzmakler" },
  publisher: { "@type": "Organization", name: "Fabio Rumpf Makler" },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Startseite", item: new URL("/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: "Wissen", item: new URL("/wissen/", Astro.site).toString() },
    {
      "@type": "ListItem",
      position: 3,
      name: "Berufsunfähigkeitsversicherung",
      item: new URL("/wissen/berufsunfaehigkeitsversicherung/", Astro.site).toString(),
    },
    { "@type": "ListItem", position: 4, name: "Abstrakte Verweisung", item: canonicalUrl },
  ],
};
---

<Layout title={pageTitle} description={pageDescription} fullTitle>
  <Hero />
  <TableOfContents />
  <Article />
  <Faq />
  <Fazit />
</Layout>

<script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
