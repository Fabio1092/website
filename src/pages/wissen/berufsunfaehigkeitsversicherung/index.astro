---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/wissen/Hero.astro";
import TopicCategoryList from "@/components/wissen/TopicCategoryList.astro";
import AvailableNow from "@/components/wissen/AvailableNow.astro";
import { buWissenCategories, buAvailableLinks } from "@/lib/wissen";
---

<Layout
  title="BU-Wissen & Ratgeber | Fabio Rumpf"
  description="BU-Wissen von Fabio Rumpf: verständliche Ratgeber zu Vertragsbedingungen, Leistungsdynamik, Verweisung, Gesundheitsfragen und Risikovoranfrage."
  fullTitle
>
  <Hero
    eyebrow="BU-Wissen"
    title="BU-Wissen: Berufsunfähigkeitsversicherung verständlich erklärt"
    titleHighlight="Berufsunfähigkeitsversicherung"
    intro={[
      "Hier findest du meine Ratgeber zu wichtigen Fragen rund um die Berufsunfähigkeitsversicherung – von Vertragsgestaltung und Verweisungsklauseln bis zu Gesundheitsangaben und Risikovoranfrage.",
    ]}
  />

  <TopicCategoryList
    categories={buWissenCategories}
    heading="Themen im BU-Wissen"
    intro="Die Inhalte sind nach Themen geordnet. Bereits veröffentlichte Artikel kannst du direkt öffnen; weitere BU-Themen ergänze ich Schritt für Schritt."
  />

  <AvailableNow
    title="Bereits verfügbar"
    intro="Diese Themen sind schon jetzt ausführlich aufbereitet."
    links={buAvailableLinks}
    hubHref="/berufsunfaehigkeitsversicherung-kassel/"
    hubLabel="Zur BU-Beratung in Kassel"
  />
</Layout>
