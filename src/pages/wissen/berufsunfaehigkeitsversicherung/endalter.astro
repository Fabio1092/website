---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/wissenEndalter/Hero.astro";
import TableOfContents from "@/components/wissenEndalter/TableOfContents.astro";
import Article from "@/components/wissenEndalter/Article.astro";
import Faq from "@/components/wissenEndalter/Faq.astro";
import Fazit from "@/components/wissenEndalter/Fazit.astro";

const pageTitle = "BU Endalter: Bis 60, 65 oder 67? | Fabio Rumpf";
const pageDescription =
  "Welches Endalter ist bei der BU sinnvoll? Warum ich grundsätzlich bis 67 absichern würde und wann eine kürzere Laufzeit trotzdem sinnvoll sein kann.";
const canonicalUrl = new URL("/wissen/berufsunfaehigkeitsversicherung/endalter/", Astro.site).toString();

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "Endalter in der BU: Wie lange sollte eine Berufsunfähigkeitsversicherung laufen?",
  description: pageDescription,
  inLanguage: "de-DE",
  datePublished: "2026-09-18",
  dateModified: "2026-09-18",
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl },
  author: { "@type": "Person", name: "Fabio Rumpf", jobTitle: "Versicherungs- und Finanzmakler" },
  publisher: { "@type": "Organization", name: "Fabio Rumpf Makler" },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Startseite", item: new URL("/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: "Wissen", item: new URL("/wissen/", Astro.site).toString() },
    {
      "@type": "ListItem",
      position: 3,
      name: "Berufsunfähigkeitsversicherung",
      item: new URL("/wissen/berufsunfaehigkeitsversicherung/", Astro.site).toString(),
    },
    { "@type": "ListItem", position: 4, name: "Endalter in der BU", item: canonicalUrl },
  ],
};
---

<Layout title={pageTitle} description={pageDescription} fullTitle>
  <Hero />
  <TableOfContents />
  <Article />
  <Faq />
  <Fazit />
</Layout>

<script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
