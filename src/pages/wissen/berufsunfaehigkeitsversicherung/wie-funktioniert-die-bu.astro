---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/wissenWieFunktioniertDieBu/Hero.astro";
import TableOfContents from "@/components/wissenWieFunktioniertDieBu/TableOfContents.astro";
import Article from "@/components/wissenWieFunktioniertDieBu/Article.astro";
import Fazit from "@/components/wissenWieFunktioniertDieBu/Fazit.astro";

const pageTitle = "Wie funktioniert eine BU? Einfach erklärt";
const pageDescription =
  "Wie funktioniert eine Berufsunfähigkeitsversicherung? Erfahre, wann die BU zahlt, was die 50-%-Regel bedeutet und wie du deine BU-Rente absicherst.";
const canonicalUrl = new URL("/wissen/berufsunfaehigkeitsversicherung/wie-funktioniert-die-bu/", Astro.site).toString();

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "Wie funktioniert eine Berufsunfähigkeitsversicherung?",
  description: pageDescription,
  inLanguage: "de-DE",
  datePublished: "2026-10-22",
  dateModified: "2026-10-22",
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl },
  author: { "@type": "Person", name: "Fabio Rumpf", jobTitle: "Versicherungs- und Finanzmakler" },
  publisher: { "@type": "Organization", name: "Fabio Rumpf Makler" },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Startseite", item: new URL("/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: "Wissen", item: new URL("/wissen/", Astro.site).toString() },
    {
      "@type": "ListItem",
      position: 3,
      name: "Berufsunfähigkeitsversicherung",
      item: new URL("/wissen/berufsunfaehigkeitsversicherung/", Astro.site).toString(),
    },
    { "@type": "ListItem", position: 4, name: "Wie funktioniert die BU?", item: canonicalUrl },
  ],
};
---

<Layout title={pageTitle} description={pageDescription} fullTitle>
  <Hero />
  <TableOfContents />
  <Article />
  <Fazit />
</Layout>

<script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
