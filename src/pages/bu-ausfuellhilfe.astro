---
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/PageHero.astro";
import IntroAndChecklist from "@/components/buGuide/IntroAndChecklist.astro";
import AccuracyPrinciple from "@/components/buGuide/AccuracyPrinciple.astro";
import Formula from "@/components/buGuide/Formula.astro";
import HealthCheckList from "@/components/buGuide/HealthCheckList.astro";
import Examples from "@/components/buGuide/Examples.astro";
import PsychTopics from "@/components/buGuide/PsychTopics.astro";
import RecurringAndDocs from "@/components/buGuide/RecurringAndDocs.astro";
import DocumentUploadNote from "@/components/guides/DocumentUploadNote.astro";
import ProfessionAndRisks from "@/components/buGuide/ProfessionAndRisks.astro";
import VoiceMessageCallout from "@/components/buGuide/VoiceMessageCallout.astro";
import FinalCheck from "@/components/buGuide/FinalCheck.astro";
import WhatHappensNext from "@/components/buGuide/WhatHappensNext.astro";
import ClosingSteps from "@/components/buGuide/ClosingSteps.astro";
---

<Layout
  title="Dein Leitfaden zur BU-Risikovoranfrage"
  description="So füllst du deinen Risikofragebogen für die BU-Risikovoranfrage richtig und vollständig aus."
  fullTitle
  noindex
>
  <PageHero
    title="Dein Leitfaden zur BU-Risikovoranfrage"
    intro="So füllst du deinen Risikofragebogen richtig und vollständig aus."
  />
  <IntroAndChecklist />
  <AccuracyPrinciple />
  <Formula />
  <HealthCheckList />
  <Examples />
  <PsychTopics />
  <RecurringAndDocs />
  <section id="guide-unterlagen-upload" class="bg-white py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <div data-reveal class="mb-8 space-y-3 text-sm leading-relaxed text-ink-700/85">
        <p class="text-base font-medium text-ink-950">Noch ein wichtiger Punkt, bevor du startest:</p>
        <p>
          Du musst nicht vorab auf Verdacht Arztberichte, Befunde oder Patientenakten anfordern –
          auch nicht, wenn du denkst, dass zum Beispiel eine vollständige Heilung, eine
          folgenlose Ausheilung oder „keine Beschwerden mehr" darin vermerkt ist und das deiner
          Situation nützen könnte.
        </p>
        <p>
          Hast du solche Unterlagen aber ohnehin bereits vorliegen und möchtest sie mir dennoch
          zukommen lassen, ist das natürlich jederzeit möglich – am einfachsten über mein
          Finanzmanager-Portal:
        </p>
      </div>
      <DocumentUploadNote />
    </div>
  </section>
  <ProfessionAndRisks />
  <VoiceMessageCallout />
  <FinalCheck />
  <WhatHappensNext />
  <ClosingSteps />
</Layout>
