---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/zahnzusatzversicherung/Hero.astro";
import KeyFacts from "@/components/zahnzusatzversicherung/KeyFacts.astro";
import TableOfContents from "@/components/zahnzusatzversicherung/TableOfContents.astro";
import WhyUseful from "@/components/zahnzusatzversicherung/WhyUseful.astro";
import GkvExplainer from "@/components/zahnzusatzversicherung/GkvExplainer.astro";
import RechnerSection from "@/components/zahnzusatzversicherung/RechnerSection.astro";
import RiskChoice from "@/components/zahnzusatzversicherung/RiskChoice.astro";
import TariffLevels from "@/components/zahnzusatzversicherung/TariffLevels.astro";
import WhichLevelForYou from "@/components/zahnzusatzversicherung/WhichLevelForYou.astro";
import Recommendation from "@/components/zahnzusatzversicherung/Recommendation.astro";
import AgeReserves from "@/components/zahnzusatzversicherung/AgeReserves.astro";
import EarlyClose from "@/components/zahnzusatzversicherung/EarlyClose.astro";
import Zahnstaffel from "@/components/zahnzusatzversicherung/Zahnstaffel.astro";
import BeyondDenture from "@/components/zahnzusatzversicherung/BeyondDenture.astro";
import WhatToCheck from "@/components/zahnzusatzversicherung/WhatToCheck.astro";
import TariffFitCards from "@/components/zahnzusatzversicherung/TariffFitCards.astro";
import Checkout from "@/components/zahnzusatzversicherung/Checkout.astro";
import ContactBeforeCheckout from "@/components/zahnzusatzversicherung/ContactBeforeCheckout.astro";
import Faq from "@/components/zahnzusatzversicherung/Faq.astro";
import Closing from "@/components/zahnzusatzversicherung/Closing.astro";
import { guides } from "@/lib/guides";

const guide = guides.find((g) => g.slug === "zahnzusatzversicherung")!;

const pageTitle = "Zahnzusatzversicherung: Empfehlung & Kosten-Rechner | Fabio Rumpf";
const pageDescription =
  "Was kostet Zahnersatz wirklich? Versicherungsmakler Fabio Rumpf aus Kassel erklärt Eigenanteile, 75/90/100 % Zahnzusatzschutz und seine Allianz-Empfehlung.";
const canonicalUrl = new URL("/ratgeber/zahnzusatzversicherung/", Astro.site).toString();

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "Zahnzusatzversicherung: Meine Empfehlung, Kosten & Vergleich",
  description: pageDescription,
  inLanguage: "de-DE",
  datePublished: "2026-09-04",
  dateModified: guide.updatedAt,
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl },
  author: { "@type": "Person", name: "Fabio Rumpf", jobTitle: "Versicherungs- und Finanzmakler" },
  publisher: { "@type": "Organization", name: "Fabio Rumpf Makler" },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Startseite", item: new URL("/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: "Ratgeber", item: new URL("/ratgeber/", Astro.site).toString() },
    { "@type": "ListItem", position: 3, name: "Zahnzusatzversicherung", item: canonicalUrl },
  ],
};
---

<Layout title={pageTitle} fullTitle description={pageDescription}>
  <Hero />
  <KeyFacts />
  <TableOfContents />
  <WhyUseful />
  <GkvExplainer />
  <RechnerSection />
  <RiskChoice />
  <TariffLevels />
  <WhichLevelForYou />
  <Recommendation />
  <AgeReserves />
  <EarlyClose />
  <Zahnstaffel />
  <BeyondDenture />
  <WhatToCheck />
  <TariffFitCards />
  <Checkout />
  <ContactBeforeCheckout />
  <Faq />
  <Closing />
</Layout>

<script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
