---
import Layout from "@/layouts/Layout.astro";
import DentalCostSimulator from "@/components/zahnzusatzversicherung/DentalCostSimulator.tsx";

const pageTitle = "Zahnersatzkosten-Rechner: Eigenanteil mit & ohne Zahnzusatzversicherung";
const pageDescription =
  "Simuliere typische Behandlungsfälle bei Zahnersatz und sieh dir modellhaft an, wie hoch dein Eigenanteil mit Allianz MeinZahnschutz 75, 90 oder 100 ausfallen könnte.";
const canonicalUrl = new URL("/ratgeber/zahnzusatzversicherung/", Astro.site).toString();

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Startseite", item: new URL("/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: "Ratgeber", item: new URL("/ratgeber/", Astro.site).toString() },
    { "@type": "ListItem", position: 3, name: "Zahnzusatzversicherung", item: canonicalUrl },
  ],
};
---

<Layout title={pageTitle} fullTitle description={pageDescription}>
  <section id="zahnersatzrechner" class="scroll-mt-24 bg-brand-50/30 py-14 sm:py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <a
        href="/ratgeber/#gesundheit-vorsorge"
        class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-brand-600 transition-colors hover:text-brand-700"
      >
        Ratgeber · Gesundheit &amp; Vorsorge
      </a>

      <h1 class="mt-5 hyphens-auto break-words font-serif text-3xl font-semibold leading-tight tracking-tight text-ink-950 sm:text-4xl">
        Was kann <span class="text-brand-600">Zahnersatz</span> eigentlich kosten?
      </h1>

      <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink-700/80 sm:text-lg">
        Ein Implantat oder eine hochwertige Krone kann schnell teuer werden. Mit diesem Rechner
        bekommst du ein Gefühl dafür, wie groß dein Eigenanteil ohne Zahnzusatzversicherung sein
        kann – und welchen Unterschied 75 %, 90 % oder 100 % Versicherungsschutz machen können.
      </p>

      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-ink-700/60">
        Die dargestellten Kosten sind Orientierungswerte für typische Beispielbehandlungen. Dein
        tatsächlicher Heil- und Kostenplan kann davon abweichen.
      </p>

      <div class="mt-10">
        <DentalCostSimulator client:visible />
      </div>
    </div>
  </section>
</Layout>

<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
