---
import { Clock, CheckCircle2 } from "lucide-react";
import type { WissenTopicCategory } from "@/lib/wissen";

interface Props {
  categories: WissenTopicCategory[];
}

const { categories } = Astro.props;
---

<section class="bg-white py-16 sm:py-24">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="font-serif text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">Themen, die wir hier nach und nach aufbauen</h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-700/80">
        Die einzelnen Artikel entstehen Schritt für Schritt. Hier bekommst du schon jetzt einen Überblick, welche
        Fragen künftig ausführlich beantwortet werden.
      </p>
    </div>

    <div class="mt-14 grid gap-8 sm:grid-cols-2">
      {
        categories.map((category) => (
          <div class="rounded-2xl border border-black/5 bg-brand-50/30 p-7">
            <h3 class="font-serif text-lg font-semibold text-ink-950">{category.name}</h3>
            <ul class="mt-4 space-y-2.5">
              {category.topics.map((topic) =>
                topic.href ? (
                  <li class="flex items-start justify-between gap-3 text-sm leading-relaxed">
                    <a href={topic.href} class="font-medium text-brand-700 underline decoration-brand-200 underline-offset-2 transition-colors hover:text-brand-800 hover:decoration-brand-400">
                      {topic.label}
                    </a>
                    <span class="inline-flex shrink-0 items-center gap-1 rounded-full border border-brand-200 bg-brand-50 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wide text-brand-700">
                      <CheckCircle2 className="h-3 w-3" aria-hidden="true" />
                      Verfügbar
                    </span>
                  </li>
                ) : (
                  <li class="flex items-start justify-between gap-3 text-sm leading-relaxed text-ink-700/80">
                    <span>{topic.label}</span>
                    <span class="inline-flex shrink-0 items-center gap-1 rounded-full border border-gold-200 bg-gold-50 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wide text-gold-700">
                      <Clock className="h-3 w-3" aria-hidden="true" />
                      Bald
                    </span>
                  </li>
                ),
              )}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
