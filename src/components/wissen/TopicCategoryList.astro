---
import { Clock, ArrowRight } from "lucide-react";
import type { WissenTopicCategory } from "@/lib/wissen";

interface Props {
  categories: WissenTopicCategory[];
  heading?: string;
  intro?: string;
}

const {
  categories,
  heading = "Themen, die wir hier nach und nach aufbauen",
  intro = "Die einzelnen Artikel entstehen Schritt für Schritt. Hier bekommst du schon jetzt einen Überblick, welche Fragen künftig ausführlich beantwortet werden.",
} = Astro.props;
---

<section class="bg-white py-16 sm:py-24">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="font-serif text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">{heading}</h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-700/80">{intro}</p>
    </div>

    <div class="mt-10 sm:mt-14 grid gap-8 sm:grid-cols-2">
      {
        categories.map((category) => (
          <div class="min-w-0 rounded-2xl border border-black/5 bg-brand-50/30 p-6 sm:p-7">
            <h3 class="font-serif text-lg font-semibold text-ink-950">{category.name}</h3>
            <ul class="mt-3 divide-y divide-black/5">
              {category.topics.map((topic) =>
                topic.href ? (
                  <li>
                    <a
                      href={topic.href}
                      class="group flex min-h-12 items-center justify-between gap-3 py-2.5 text-base font-medium leading-snug text-brand-700 transition-colors hover:text-brand-800 sm:text-sm"
                    >
                      <span class="min-w-0 hyphens-auto break-words">{topic.label}</span>
                      <ArrowRight className="h-4 w-4 shrink-0 transition-transform duration-200 group-hover:translate-x-0.5" aria-hidden="true" />
                    </a>
                  </li>
                ) : (
                  <li class="flex min-h-12 items-center justify-between gap-3 py-2.5 text-base leading-snug text-ink-700/65 sm:text-sm">
                    <span class="min-w-0 hyphens-auto break-words">{topic.label}</span>
                    <span class="inline-flex shrink-0 items-center gap-1 text-xs font-semibold uppercase tracking-wide text-gold-700">
                      <Clock className="h-3 w-3" aria-hidden="true" />
                      Bald
                    </span>
                  </li>
                ),
              )}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
