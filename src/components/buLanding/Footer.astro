---
import { legalNav } from "@/lib/nav";
import { siteConfig } from "@/lib/site";

const year = new Date().getFullYear();
---

<footer class="border-t border-black/5 bg-white">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center gap-6 text-center sm:flex-row sm:justify-between sm:text-left">
      <a href="/" class="flex items-center gap-2.5" aria-label="FR Makler Startseite">
        <img src="/images/Logo.png" alt="FR Makler Logo" class="h-9 w-9 rounded-lg" width="36" height="36" />
        <span class="flex flex-col leading-tight">
          <span class="font-serif text-sm font-semibold text-ink-950">Fabio Rumpf</span>
          <span class="text-[10px] font-semibold uppercase tracking-wide text-brand-600">Versicherungs- und Finanzmakler</span>
        </span>
      </a>

      <ul class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-ink-700/70">
        <li><a href={siteConfig.phoneHref} class="transition-colors hover:text-ink-950">{siteConfig.phone}</a></li>
        <li><a href={siteConfig.emailHref} class="transition-colors hover:text-ink-950">{siteConfig.email}</a></li>
        <li>{siteConfig.address}</li>
      </ul>
    </div>

    <div class="mt-8 flex flex-col items-center gap-4 border-t border-black/5 pt-6 text-xs text-ink-700/50 sm:flex-row sm:justify-between">
      <p>Copyright &copy; {year} Fabio Rumpf | Versicherungsmakler aus Kassel</p>
      <ul class="flex flex-wrap justify-center gap-5">
        {
          legalNav.map((link) => (
            <li>
              <a href={link.href} class="transition-colors hover:text-ink-950">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <p class="mt-6 border-t border-black/5 pt-6 text-xs leading-relaxed text-ink-700/45">
      Hinweis: Versicherbarkeit, Beiträge, Leistungen und Annahmebedingungen hängen von der
      individuellen Situation und der Risikoprüfung des jeweiligen Versicherers ab. Die
      dargestellten Beratungsfälle sind individuelle Beispiele und stellen keine Garantie für
      vergleichbare Ergebnisse dar.
    </p>
  </div>
</footer>
