---
import { Target, TrendingUp, Scale, MapPin, Laptop } from "lucide-react";

const points = [
  {
    icon: Target,
    title: "BU-Spezialisierung",
    text: "Die Berufsunfähigkeitsversicherung und insbesondere der Umgang mit Risikovoranfragen sind ein Schwerpunkt meiner Beratung.",
  },
  {
    icon: TrendingUp,
    title: "300+ Risikovoranfragen",
    text: "Ich habe bereits mehr als 300 Risikovoranfragen begleitet und dadurch unterschiedlichste Ausgangssituationen erlebt.",
  },
  {
    icon: Scale,
    title: "Unabhängige Beratung",
    text: "Als Versicherungsmakler bin ich nicht an einen einzelnen Versicherer gebunden. Wir können deshalb unterschiedliche Möglichkeiten betrachten und miteinander vergleichen.",
  },
  {
    icon: MapPin,
    title: "Aus Kassel. Für Nordhessen.",
    text: "Mein Standort ist Kassel. Ich berate Kunden aus Kassel, Baunatal, Vellmar, Lohfelden, Kaufungen und der Region Nordhessen.",
  },
  {
    icon: Laptop,
    title: "Persönlich oder digital",
    text: "Du entscheidest, was besser zu dir passt. Die Beratung kann persönlich oder vollständig digital durchgeführt werden.",
  },
];
---

<section id="fabio" class="scroll-mt-20 bg-white py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:items-center lg:gap-16">
      <div class="mx-auto w-full max-w-xs sm:max-w-sm lg:mx-0 lg:max-w-none">
        <div class="relative">
          <div class="pointer-events-none absolute -inset-4 -z-10 rounded-[2rem] bg-gradient-to-br from-brand-500/10 via-transparent to-gold-500/10 blur-xl" aria-hidden="true"></div>
          <img
            src="/images/1-48.jpg"
            alt="Fabio Rumpf, Versicherungs- und Finanzmakler aus Kassel"
            class="aspect-[4/5] w-full rounded-[2rem] border border-black/5 object-cover shadow-2xl shadow-black/10"
            width="800"
            height="1000"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>

      <div data-reveal class="min-w-0">
        <h2 class="font-serif text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">
          Warum <span class="text-brand-600">mit mir?</span>
        </h2>

        <div class="mt-8 space-y-6">
          {
            points.map((point) => (
              <div class="flex items-start gap-4">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
                  <point.icon className="h-5 w-5" aria-hidden="true" />
                </div>
                <div>
                  <p class="text-sm font-semibold text-ink-950">{point.title}</p>
                  <p class="mt-1 text-sm leading-relaxed text-ink-700/75">{point.text}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
