---
import ComparisonSplit from "@/components/ComparisonSplit.astro";
import { siteConfig } from "@/lib/site";

const columns: [
  { tone: "neutral"; label: string; points: string[] },
  { tone: "brand"; label: string; points: string[] },
] = [
  {
    tone: "neutral",
    label: "Direkt einen Antrag stellen",
    points: [
      "Du legst dich früh auf einen Versicherer fest",
      "Die individuelle Risikoprüfung erfolgt im Antragsprozess",
      "Zuschläge oder Ausschlüsse zeigen sich möglicherweise erst danach",
      "Vergleichbare Alternativen wurden vorher eventuell nicht geprüft",
      "Eine Ablehnung kann weitere Schritte unnötig komplizierter machen",
    ],
  },
  {
    tone: "brand",
    label: "Erst mit Risikovoranfrage prüfen",
    points: [
      "Deine Situation wird strukturiert aufbereitet",
      "Mehrere geeignete Versicherer können betrachtet werden",
      "Mögliche Annahmebedingungen werden vorab vergleichbarer",
      "Auffälligkeiten können vor einer Antragstellung erkannt werden",
      "Danach kannst du wesentlich bewusster entscheiden, wo ein Antrag sinnvoll ist",
    ],
  },
];
---

<section class="bg-brand-50/30 py-16 sm:py-24">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="font-serif text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">
        Der wichtigste Schritt kann passieren, <span class="text-brand-600">bevor überhaupt ein Antrag gestellt wird.</span>
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-ink-700/80">
        Erst prüfen, wie Versicherer deine Situation einschätzen. Dann gezielt entscheiden.
      </p>
      <p class="mt-4 text-base leading-relaxed text-ink-700/70">
        Gerade wenn gesundheitliche Themen bestehen, kann eine professionelle Risikovoranfrage
        sinnvoll sein. Dabei wird nicht einfach wahllos ein Antrag bei einem Versicherer
        eingereicht. Stattdessen bereiten wir deine Situation strukturiert auf und prüfen bei
        ausgewählten Versicherern vorab, wie diese deine persönliche Konstellation grundsätzlich
        einschätzen und welche Bedingungen möglich sein könnten. Das verschafft dir wesentlich
        mehr Klarheit für die anschließende Entscheidung.
      </p>
    </div>

    <div class="mt-12">
      <ComparisonSplit columns={columns} />
    </div>

    <div class="mx-auto mt-12 max-w-xl text-center">
      <p class="text-lg font-medium text-ink-950">
        Du stellst also nicht einfach irgendwo einen Antrag. Du prüfst zuerst deine Möglichkeiten
        und triffst danach eine fundierte Entscheidung.
      </p>
      <div class="mt-8">
        <a
          href={siteConfig.calendlyUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-cta="risk-check"
          class="inline-flex items-center justify-center rounded-full bg-gold-500 px-7 py-3.5 text-sm font-semibold text-ink-950 shadow-sm transition-transform duration-200 hover:-translate-y-0.5 hover:bg-gold-400"
        >
          Risikovoranfrage besprechen
        </a>
        <p class="mt-3 text-sm text-ink-700/55">Kostenloses Erstgespräch · kein Abschlusszwang</p>
      </div>
    </div>
  </div>
</section>
