---
import { siteConfig } from "@/lib/site";

interface Step {
  number: string;
  title: string;
  eyebrow?: string;
  intro: string[];
  outro?: string[];
}

const steps: Step[] = [
  {
    number: "01",
    title: "Kennenlernen",
    eyebrow: "ca. 15 Minuten",
    intro: ["In einem kurzen Gespräch klären wir deine Ausgangssituation und deine offenen Fragen."],
    outro: ["Kostenlos und unverbindlich."],
  },
  {
    number: "02",
    title: "Situation prüfen",
    intro: [
      "Wenn wir gemeinsam weitermachen, betrachten wir unter anderem: Beruf, Einkommen, gewünschte BU-Rente, bestehenden Versicherungsschutz und relevante Gesundheitshistorie.",
    ],
  },
  {
    number: "03",
    title: "Möglichkeiten prüfen",
    intro: ["Falls sinnvoll, bereiten wir eine Risikovoranfrage vor und prüfen deine Situation bei geeigneten Versicherern."],
  },
  {
    number: "04",
    title: "Lösungen vergleichen",
    intro: ["Wir betrachten nicht nur Beiträge, sondern auch: Leistungen, Vertragsbedingungen, Annahmebedingungen, Flexibilität und die persönliche Passung."],
  },
  {
    number: "05",
    title: "Du entscheidest",
    intro: ["Du bekommst die Ergebnisse verständlich erklärt und entscheidest anschließend selbst, ob und welche Lösung du umsetzen möchtest."],
    outro: ["Keine Verpflichtung."],
  },
];
---

<section class="scroll-mt-24 bg-white py-16 sm:py-24">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="font-serif text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">
        So läuft dein <span class="text-brand-600">BU-Check</span> ab
      </h2>
    </div>

    <ol class="mt-14 space-y-10">
      {
        steps.map((step, index) => (
          <li data-reveal style={`transition-delay: ${Math.min(index, 4) * 80}ms`} class="relative flex gap-6 sm:gap-8">
            <div class="flex flex-col items-center">
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-ink-950 font-serif text-base font-semibold text-white">
                {step.number}
              </span>
              {index < steps.length - 1 && <span class="mt-2 w-px flex-1 bg-brand-200" aria-hidden="true" />}
            </div>
            <div class="min-w-0 pb-2">
              {step.eyebrow && <span class="text-xs font-semibold uppercase tracking-wide text-brand-600">{step.eyebrow}</span>}
              <h3 class:list={["font-serif text-xl font-semibold text-ink-950 sm:text-2xl", step.eyebrow ? "mt-1" : ""]}>{step.title}</h3>
              <div class="mt-3 space-y-2.5">
                {step.intro.map((line) => (
                  <p class="text-sm leading-relaxed text-ink-700/80 sm:text-base">{line}</p>
                ))}
              </div>
              {step.outro &&
                step.outro.map((line) => <p class="mt-2 text-sm font-medium text-ink-950">{line}</p>)}
            </div>
          </li>
        ))
      }
    </ol>

    <div class="mt-14 text-center">
      <a
        href={siteConfig.calendlyBuUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-cta="process-cta"
        class="inline-flex items-center justify-center rounded-full bg-gold-500 px-7 py-3.5 text-sm font-semibold text-ink-950 shadow-sm transition-transform duration-200 hover:-translate-y-0.5 hover:bg-gold-400"
      >
        Kostenloses Erstgespräch vereinbaren
      </a>
    </div>
  </div>
</section>
