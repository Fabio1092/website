---
import { HeartPulse, Building2, FileCheck2 } from "lucide-react";
import { siteConfig } from "@/lib/site";

const problems = [
  {
    icon: HeartPulse,
    title: "Deine Gesundheitshistorie",
    text: "Diagnosen, Behandlungen und Beschwerden können von Versicherern unterschiedlich bewertet werden. Deshalb sollte deine Gesundheitshistorie sauber aufbereitet werden, bevor vorschnell ein Antrag gestellt wird.",
  },
  {
    icon: Building2,
    title: "Der richtige Versicherer",
    text: "Nicht jeder Versicherer bewertet denselben Beruf oder dieselbe gesundheitliche Vorgeschichte gleich. Was bei einem Anbieter zu einem Zuschlag oder Ausschluss führen kann, wird von einem anderen möglicherweise anders eingeschätzt.",
  },
  {
    icon: FileCheck2,
    title: "Der richtige Versicherungsschutz",
    text: "Eine günstige BU hilft dir wenig, wenn die vereinbarte BU-Rente nicht zu deinem Einkommen passt oder wichtige Vertragsbedingungen fehlen.",
  },
];
---

<section class="bg-white py-16 sm:py-24">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="font-serif text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">
        Bei einer BU geht es nicht darum, irgendeinen Vertrag zu haben. Sondern
        <span class="text-brand-600">einen, der zu dir passt</span>, wenn du ihn wirklich brauchst.
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-ink-700/80">
        Eine Berufsunfähigkeitsversicherung soll dein Einkommen schützen, wenn du deinen Beruf aus
        gesundheitlichen Gründen langfristig nicht mehr ausüben kannst.
      </p>
      <p class="mt-4 text-base leading-relaxed text-ink-700/70">Ob ein Vertrag wirklich zu dir passt, erkennst du aber nicht allein am Monatsbeitrag.</p>
      <p class="mt-6 text-base font-medium text-ink-950">Vor allem drei Punkte können einen großen Unterschied machen:</p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-3">
      {
        problems.map((problem, index) => (
          <div data-reveal style={`transition-delay: ${index * 80}ms`} class="rounded-2xl border border-black/5 bg-white p-7 shadow-soft">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
              <problem.icon className="h-5 w-5" aria-hidden="true" />
            </div>
            <h3 class="mt-5 font-serif text-lg font-semibold text-ink-950">{problem.title}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-ink-700/75">{problem.text}</p>
          </div>
        ))
      }
    </div>

    <div class="mx-auto mt-14 max-w-xl space-y-4 text-center">
      <p class="text-base text-ink-700/70">Deshalb starten wir nicht mit:</p>
      <p class="font-serif text-lg italic text-ink-700/60">„Welcher Tarif ist am billigsten?“</p>
      <p class="text-base text-ink-700/70">Sondern mit:</p>
      <p class="font-serif text-xl font-semibold text-ink-950">„Welche Absicherung passt wirklich zu deiner Situation?“</p>

      <div class="pt-4">
        <a
          href={siteConfig.calendlyBuUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-cta="problem-section-check"
          class="inline-flex items-center justify-center rounded-full bg-gold-500 px-7 py-3.5 text-sm font-semibold text-ink-950 shadow-sm transition-transform duration-200 hover:-translate-y-0.5 hover:bg-gold-400"
        >
          Meine BU-Möglichkeiten prüfen
        </a>
        <p class="mt-3 text-sm text-ink-700/55">Kostenloses Erstgespräch · ca. 15 Minuten</p>
      </div>
    </div>
  </div>
</section>
