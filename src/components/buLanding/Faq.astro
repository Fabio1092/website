---
import FaqAccordion, { type FaqItem } from "@/components/FaqAccordion.tsx";

const faqs: FaqItem[] = [
  {
    question: "Ist das Erstgespräch wirklich kostenlos?",
    answer: "Ja. Das erste Gespräch ist kostenlos und unverbindlich. Wir schauen uns deine Ausgangssituation an und klären, ob und wie ich dir sinnvoll weiterhelfen kann.",
  },
  {
    question: "Wie lange dauert das Erstgespräch?",
    answer: "Ungefähr 15 Minuten. Für den ersten Termin brauchen wir noch keine komplette Beratung durchzuführen. Es geht zunächst darum, deine Situation zu verstehen.",
  },
  {
    question: "Muss ich direkt Gesundheitsunterlagen mitbringen?",
    answer:
      "Nein. Im Erstgespräch reicht zunächst ein Überblick über deine Situation. Falls später Unterlagen erforderlich sind, besprechen wir konkret, was tatsächlich benötigt wird.",
  },
  {
    question: "Wann ist eine Risikovoranfrage sinnvoll?",
    answer:
      "Das hängt von deiner individuellen Ausgangssituation ab. Gerade bei relevanten Diagnosen, Behandlungen oder Beschwerden kann es sinnvoll sein, mögliche Annahmebedingungen zunächst vor einer konkreten Antragstellung zu prüfen.",
  },
  {
    question: "Kannst du garantieren, dass mich ein Versicherer annimmt?",
    answer:
      "Nein. Eine bestimmte Annahme kann niemand seriös garantieren. Die Entscheidung hängt von der Risikoprüfung des jeweiligen Versicherers und deiner individuellen Situation ab. Wir können aber strukturiert prüfen, welche Möglichkeiten für dich bestehen.",
  },
  {
    question: "Muss ich meine bestehende BU kündigen?",
    answer: "Nein. Und bitte kündige deinen bestehenden Schutz nicht vorschnell. Wir prüfen zunächst, was du bereits hast und ob eine Veränderung überhaupt sinnvoll wäre.",
  },
  {
    question: "Beratest du nur Kunden aus Kassel?",
    answer: "Nein. Mein Standort ist Kassel und mein regionaler Schwerpunkt liegt auf Nordhessen. Die Beratung kann aber auch digital durchgeführt werden.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<section id="faq" class="scroll-mt-20 bg-brand-50/30 py-16 sm:py-24">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <h2 class="hyphens-auto break-words font-serif text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">
        Häufige Fragen zur <span class="text-brand-600">Berufs&shy;unfähigkeits&shy;versicherung</span>
      </h2>
    </div>
    <div data-reveal class="mt-12">
      <FaqAccordion client:visible faqs={faqs} />
    </div>
  </div>
</section>

<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
