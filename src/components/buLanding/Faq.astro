---
import FaqAccordion, { type FaqItem } from "@/components/FaqAccordion.tsx";

const faqs: FaqItem[] = [
  {
    question: "Wann ist eine Risikovoranfrage sinnvoll?",
    answer:
      "Eine Risikovoranfrage kann insbesondere dann sinnvoll sein, wenn in deiner Gesundheitshistorie Diagnosen, Behandlungen, Beschwerden oder andere Punkte vorhanden sind, die für die Risikoprüfung relevant sein könnten. Ob eine Voranfrage in deinem konkreten Fall notwendig ist, klären wir individuell.",
  },
  {
    question: "Kannst du garantieren, dass mich ein Versicherer annimmt?",
    answer:
      "Nein. Welche Entscheidung ein Versicherer trifft, hängt von dessen Risikoprüfung und deiner individuellen Situation ab. Eine seriöse Beratung kann deshalb keine Annahme garantieren. Sie kann aber helfen, deine Ausgangssituation strukturiert vorzubereiten und deine Möglichkeiten gezielter zu prüfen.",
  },
  {
    question: "Muss ich meine bestehende BU kündigen, wenn wir eine Alternative prüfen?",
    answer:
      "Nein. Bitte kündige einen bestehenden Vertrag nicht vorschnell. Zuerst wird geprüft, ob eine Alternative überhaupt möglich und sinnvoll ist. Erst wenn alle relevanten Punkte geklärt sind, kann über eine Veränderung gesprochen werden.",
  },
  {
    question: "Beratest du nur Kunden aus Kassel?",
    answer: "Nein. Mein Standort ist Kassel und der regionale Schwerpunkt liegt auf Kassel und Nordhessen. Die Beratung kann aber auch vollständig digital durchgeführt werden.",
  },
  {
    question: "Wie lange dauert das erste Gespräch?",
    answer: "Etwa 15 Minuten. Wir klären deine Situation und entscheiden anschließend gemeinsam, ob weitere Schritte sinnvoll sind.",
  },
  {
    question: "Muss ich im Erstgespräch bereits Gesundheitsunterlagen mitbringen?",
    answer:
      "Nein. Für das erste Kennenlernen reicht zunächst ein Überblick über deine Situation. Falls Unterlagen erforderlich werden, besprechen wir anschließend konkret, was tatsächlich benötigt wird.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<section id="faq" class="scroll-mt-20 bg-brand-50/30 py-16 sm:py-24">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <h2 class="hyphens-auto break-words font-serif text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">
        Häufige Fragen zur <span class="text-brand-600">Berufs&shy;unfähigkeits&shy;versicherung</span>
      </h2>
    </div>
    <div data-reveal class="mt-12">
      <FaqAccordion client:visible faqs={faqs} />
    </div>
  </div>
</section>

<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
