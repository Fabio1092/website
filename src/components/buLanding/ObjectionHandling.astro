---
const objections = [
  {
    thought: "Ich möchte eigentlich nur erstmal wissen, was bei mir möglich ist.",
    answer:
      "Genau dafür ist das Erstgespräch da. Du musst dort keinen Tarif auswählen und nichts abschließen. Wir klären zunächst deine Situation und schauen, welcher nächste Schritt überhaupt sinnvoll ist.",
  },
  {
    thought: "Ich habe Vorerkrankungen.",
    answer:
      "Das bedeutet nicht automatisch, dass eine BU nicht möglich ist. Es bedeutet aber, dass man nicht vorschnell vorgehen sollte. Wir schauen uns deine Ausgangslage an und besprechen, ob eine strukturierte Vorprüfung sinnvoll ist.",
  },
  {
    thought: "Ich habe bereits eine BU. Wahrscheinlich möchtest du mir einfach eine neue verkaufen.",
    answer:
      "Nein. Ein bestehender Vertrag wird nicht automatisch ersetzt. Wir prüfen zuerst, was du bereits hast. Wenn dein bestehender Vertrag für dich die sinnvollere Lösung ist, gibt es keinen vernünftigen Grund, ihn nur wegen eines neuen Angebots aufzugeben.",
  },
  {
    thought: "Ich möchte nicht sofort etwas abschließen.",
    answer: "Musst du auch nicht. Das erste Gespräch dient dazu, herauszufinden, ob überhaupt Handlungsbedarf besteht und wie dieser aussehen könnte.",
  },
  {
    thought: "Ich möchte danach nicht von irgendwelchen Versicherungen angerufen werden.",
    answer: "Dein Ansprechpartner während der Beratung bin ich. Wir besprechen gemeinsam, welche Schritte durchgeführt werden und welche Informationen dafür erforderlich sind.",
  },
];
---

<section class="bg-white py-16 sm:py-24">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <h2 class="text-center font-serif text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">
      Vielleicht denkst du <span class="text-brand-600">gerade …</span>
    </h2>

    <div class="mt-12 grid gap-5 sm:grid-cols-2">
      {
        objections.map((item, index) => (
          <div
            data-reveal
            style={`transition-delay: ${(index % 4) * 60}ms`}
            class:list={["rounded-2xl border border-black/5 bg-brand-50/25 p-6", index === objections.length - 1 && "sm:col-span-2"]}
          >
            <p class="font-serif text-lg italic leading-snug text-ink-700/80">„{item.thought}“</p>
            <div class="mt-4 border-t border-black/[0.06] pt-4">
              <p class="text-sm leading-relaxed text-ink-950">{item.answer}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
