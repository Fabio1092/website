---
import { siteConfig } from "@/lib/site";
---

<header id="landing-header" class="fixed inset-x-0 top-0 z-50 border-b border-black/5 bg-white/90 backdrop-blur transition-shadow duration-300 data-[scrolled=true]:shadow-sm" data-scrolled="false">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <a href="/" class="flex shrink-0 items-center gap-2.5" aria-label="FR Makler Startseite">
      <img src="/images/Logo.png" alt="FR Makler Logo" class="h-10 w-10 shrink-0 rounded-lg" width="40" height="40" />
      <span class="hidden flex-col leading-tight sm:flex">
        <span class="font-serif text-base font-semibold tracking-tight text-ink-950">Fabio Rumpf</span>
        <span class="text-[10px] font-semibold uppercase tracking-wide text-brand-600">BU-Spezialist Kassel</span>
      </span>
    </a>

    <nav class="hidden items-center gap-7 sm:flex" aria-label="Seitennavigation">
      <a href="/bu-kassel#fabio" class="text-sm font-medium text-ink-700/80 transition-colors hover:text-ink-950">Über Fabio</a>
      <a href="/bu-kassel#faq" class="text-sm font-medium text-ink-700/80 transition-colors hover:text-ink-950">FAQ</a>
    </nav>

    <a
      href={siteConfig.calendlyBuUrl}
      target="_blank"
      rel="noopener noreferrer"
      data-cta="header-bu-check"
      class="inline-flex shrink-0 items-center justify-center whitespace-nowrap rounded-full bg-gold-500 px-4 py-2.5 text-sm font-semibold text-ink-950 shadow-sm transition-transform duration-200 hover:-translate-y-0.5 hover:bg-gold-400 sm:px-5"
    >
      Kostenlosen BU-Check starten
    </a>
  </div>
</header>

<div class="h-16" aria-hidden="true"></div>

<script>
  const header = document.getElementById("landing-header");
  const onScroll = () => {
    if (!header) return;
    header.dataset.scrolled = window.scrollY > 8 ? "true" : "false";
  };
  document.addEventListener("scroll", onScroll, { passive: true });
  onScroll();
</script>
