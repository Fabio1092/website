---
import { X, Check, TrendingUp, ShieldOff, Award, Clock3, ShieldCheck } from "lucide-react";
import { siteConfig } from "@/lib/site";

const without = [
  "Antrag wird direkt bei der Versicherung eingereicht",
  "Gesundheitsprüfung findet erst nach Antragstellung statt",
  "Risiko von Ablehnung oder Leistungsausschlüssen",
  "Ein negativer Eintrag bleibt oft Jahre gespeichert",
  "Weniger Auswahl an passenden Tarifen",
  "Höhere Beiträge oder schlechtere Bedingungen möglich",
];

const withInquiry = [
  "Anonyme Anfrage bei mehreren Versicherern vor der Antragstellung",
  "Gesundheitsprüfung erfolgt vorab, unverbindlich und ohne Eintrag",
  "Deutlich höhere Annahmechancen ohne unnötige Ausschlüsse",
  "Kein negativer Eintrag im Risikoregister bei einer Absage",
  "Volle Auswahl aus den passenden Top-Tarifen",
  "Bessere Beiträge und Bedingungen möglich",
];

const benefits = [
  { icon: TrendingUp, title: "Höhere Annahmechancen", description: "Wir wissen vorab, welcher Versicherer dich zu welchen Konditionen annehmen kann." },
  { icon: ShieldOff, title: "Weniger Ausschlüsse", description: "Durch die richtige Auswahl vermeiden wir unnötige Leistungsausschlüsse." },
  { icon: Award, title: "Bessere Konditionen", description: "Oft sind höhere Renten oder niedrigere Beiträge realisierbar." },
  { icon: Clock3, title: "Zeit & Nerven sparen", description: "Ich übernehme den kompletten Prozess - du erhältst klare Empfehlungen." },
  { icon: ShieldCheck, title: "Sicherheit vor Fehlern", description: "Keine voreiligen Anträge, keine unnötigen Risiken, kein böses Erwachen." },
];
---

<section class="bg-brand-50/40 py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">
        Der größte Unterschied entsteht, <span class="text-brand-600">bevor ein Antrag gestellt wird</span>.
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-700/80">
        Viele Anträge werden abgelehnt oder mit Ausschlüssen versehen – nicht weil der Kunde
        nicht versicherbar ist, sondern weil die Gesundheitsfragen oder der Versicherer nicht
        passen. Mit einer professionellen Risikovoranfrage vermeiden wir teure Fehler.
      </p>
    </div>

    <div class="mt-14 grid gap-6 lg:grid-cols-2">
      <div data-reveal class="rounded-2xl border border-danger-500/15 bg-white p-8">
        <span class="inline-flex items-center gap-2 text-sm font-semibold text-danger-500">
          <X className="h-4.5 w-4.5" aria-hidden="true" />
          Ohne Risikovoranfrage
        </span>
        <ul class="mt-6 space-y-3">
          {
            without.map((point) => (
              <li class="flex items-start gap-2.5 text-sm text-ink-700/85">
                <X className="mt-0.5 h-4.5 w-4.5 shrink-0 text-danger-500/70" aria-hidden="true" />
                {point}
              </li>
            ))
          }
        </ul>
      </div>

      <div data-reveal style="transition-delay: 100ms" class="rounded-2xl border border-success-500/20 bg-white p-8">
        <span class="inline-flex items-center gap-2 text-sm font-semibold text-success-500">
          <Check className="h-4.5 w-4.5" aria-hidden="true" />
          Mit professioneller Risikovoranfrage
        </span>
        <ul class="mt-6 space-y-3">
          {
            withInquiry.map((point) => (
              <li class="flex items-start gap-2.5 text-sm text-ink-700/85">
                <Check className="mt-0.5 h-4.5 w-4.5 shrink-0 text-success-500" aria-hidden="true" />
                {point}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mt-16">
      <p class="text-center text-sm font-semibold uppercase tracking-wider text-brand-600">
        Das bringt dir eine professionelle Risikovoranfrage
      </p>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-5">
        {
          benefits.map((benefit, index) => (
            <div data-reveal style={`transition-delay: ${index * 80}ms`} class="rounded-2xl border border-black/5 bg-white p-6">
              <benefit.icon className="h-6 w-6 text-brand-600" aria-hidden="true" />
              <p class="mt-4 text-sm font-semibold text-ink-950">{benefit.title}</p>
              <p class="mt-1.5 text-sm leading-relaxed text-ink-700/70">{benefit.description}</p>
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-14 rounded-3xl bg-ink-950 px-8 py-10 text-center text-white sm:px-12">
      <h3 class="font-serif text-2xl font-semibold">Jetzt Ersteinschätzung anfordern</h3>
      <p class="mx-auto mt-2 max-w-xl text-sm text-white/60">
        Wir prüfen unverbindlich, welche Möglichkeiten für dich bestehen.
      </p>
      <a
        href={siteConfig.calendlyUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 inline-flex items-center justify-center rounded-full bg-gold-500 px-7 py-3.5 text-sm font-semibold text-ink-950 shadow-sm transition-transform duration-200 hover:-translate-y-0.5 hover:bg-gold-400"
      >
        Jetzt unverbindliche Einschätzung anfordern →
      </a>
    </div>
  </div>
</section>
