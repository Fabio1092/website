---
import { TrendingUp, ShieldOff, Award, Clock3, ShieldCheck } from "lucide-react";
import ComparisonSplit from "@/components/ComparisonSplit.astro";

const columns: [
  { tone: "danger"; label: string; points: string[] },
  { tone: "success"; label: string; points: string[] },
] = [
  {
    tone: "danger",
    label: "Ohne Risikovoranfrage",
    points: [
      "Antrag wird direkt bei der Versicherung eingereicht",
      "Gesundheitsprüfung findet erst nach Antragstellung statt",
      "Risiko von Ablehnung oder Leistungsausschlüssen",
      "Ein negativer Eintrag bleibt oft Jahre gespeichert",
      "Weniger Auswahl an passenden Tarifen",
      "Höhere Beiträge oder schlechtere Bedingungen möglich",
    ],
  },
  {
    tone: "success",
    label: "Mit professioneller Risikovoranfrage",
    points: [
      "Anonyme Anfrage bei mehreren Versicherern vor der Antragstellung",
      "Gesundheitsprüfung erfolgt vorab, unverbindlich und ohne Eintrag",
      "Deutlich höhere Annahmechancen ohne unnötige Ausschlüsse",
      "Kein negativer Eintrag im Risikoregister bei einer Absage",
      "Volle Auswahl aus den passenden Top-Tarifen",
      "Bessere Beiträge und Bedingungen möglich",
    ],
  },
];

const benefits = [
  { icon: TrendingUp, title: "Höhere Annahmechancen", description: "Wir wissen vorab, welcher Versicherer dich zu welchen Konditionen annehmen kann." },
  { icon: ShieldOff, title: "Weniger Ausschlüsse", description: "Durch die richtige Auswahl vermeiden wir unnötige Leistungsausschlüsse." },
  { icon: Award, title: "Bessere Konditionen", description: "Oft sind höhere Renten oder niedrigere Beiträge realisierbar." },
  { icon: Clock3, title: "Zeit & Nerven sparen", description: "Ich übernehme den kompletten Prozess - du erhältst klare Empfehlungen." },
  { icon: ShieldCheck, title: "Sicherheit vor Fehlern", description: "Keine voreiligen Anträge, keine unnötigen Risiken, kein böses Erwachen." },
];
---

<section class="bg-brand-50/40 py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">
        Der größte Unterschied entsteht, <span class="text-brand-600">bevor ein Antrag gestellt wird</span>.
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-700/80">
        Viele Anträge werden abgelehnt oder mit Ausschlüssen versehen – nicht weil der Kunde
        nicht versicherbar ist, sondern weil die Gesundheitsfragen oder der Versicherer nicht
        passen. Mit einer professionellen Risikovoranfrage vermeiden wir teure Fehler.
      </p>
    </div>

    <div class="mt-14">
      <ComparisonSplit columns={columns} />
    </div>

    <div class="mt-16">
      <div class="grid gap-px overflow-hidden rounded-2xl border border-black/5 bg-black/5 sm:grid-cols-2 lg:grid-cols-5">
        {
          benefits.map((benefit, index) => (
            <div data-reveal style={`transition-delay: ${index * 80}ms`} class="bg-white p-6">
              <benefit.icon className="h-6 w-6 text-brand-600" aria-hidden="true" />
              <p class="mt-4 text-sm font-semibold text-ink-950">{benefit.title}</p>
              <p class="mt-1.5 text-sm leading-relaxed text-ink-700/70">{benefit.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
