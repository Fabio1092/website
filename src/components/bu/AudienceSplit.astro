---
import { TrendingUp, Wallet, ShieldCheck } from "lucide-react";
import ComparisonSplit from "@/components/ComparisonSplit.astro";

const columns: [
  { tone: "brand"; label: string; heading: string; points: string[] },
  { tone: "ink"; label: string; heading: string; points: string[] },
] = [
  {
    tone: "brand",
    label: "Du hast noch keine BU?",
    heading: "Wir finden die richtige Absicherung für deine Zukunft.",
    points: [
      "Professionelle Risikovoranfrage vor Antragstellung für die besten Annahmechancen",
      "Individuelle Analyse deiner Situation und Ziele",
      "Vergleich der Top-Versicherer am Markt",
      "Klare Empfehlungen – verständlich & transparent",
      "Digital, einfach und ohne Papierkram",
    ],
  },
  {
    tone: "ink",
    label: "Du hast bereits eine BU?",
    heading: "Wir prüfen deinen Vertrag kostenlos und unverbindlich.",
    points: [
      "Analyse deines aktuellen Vertrags und Leistungsumfangs",
      "Prüfung auf bessere Tarifgenerationen und Bedingungen",
      "Oft höhere Rente für weniger Geld möglich",
      "Wir finden heraus, ob & wie ein Wechsel für dich sinnvoll ist",
      "Jetzt prüfen, statt später ärgern",
    ],
  },
];

const goals = [
  { icon: TrendingUp, label: "Mehr Leistung für dich" },
  { icon: Wallet, label: "Weniger Beitrag für dich" },
  { icon: ShieldCheck, label: "Mehr Sicherheit für deine Zukunft" },
];
---

<section class="bg-white py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">Egal, wo du gerade stehst – <span class="text-brand-600">ich helfe dir weiter</span></h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-700/80">
        Ob du deine erste BU-Versicherung abschließen möchtest oder deinen bestehenden Vertrag
        überprüfen willst – wir finden die beste Lösung für dich.
      </p>
    </div>

    <div class="mt-14">
      <ComparisonSplit columns={columns} />
    </div>

    <div class="mx-auto mt-10 flex max-w-2xl flex-col items-center gap-5 text-center sm:flex-row sm:justify-center sm:gap-8">
      {
        goals.map((goal) => (
          <div class="flex items-center gap-2.5 text-sm font-medium text-ink-700/80">
            <goal.icon className="h-4.5 w-4.5 text-brand-600" aria-hidden="true" />
            {goal.label}
          </div>
        ))
      }
    </div>
  </div>
</section>
