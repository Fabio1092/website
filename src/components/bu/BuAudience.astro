---
import { CheckCircle2, Briefcase, Building2, GraduationCap, Landmark, ArrowRight } from "lucide-react";

const cards = [
  {
    icon: Briefcase,
    href: "/bu-angestellte-kassel/",
    label: "Angestellte",
    headline: "Dein Einkommen finanziert dein Leben. Was passiert, wenn es plötzlich wegfällt?",
    text: "Wir betrachten nicht nur deine Berufsbezeichnung, sondern deine konkrete Tätigkeit, Verantwortung und Belastung – und finden eine BU-Rente, die zu deinem Leben passt.",
    points: [
      "Individuelle Prüfung deiner beruflichen Situation",
      "Ermittlung einer bedarfsgerechten BU-Rente",
      "Strukturierte Aufbereitung deiner Gesundheitsangaben",
      "Vertragsbedingungen, die mit dir mitwachsen",
    ],
  },
  {
    icon: Building2,
    href: "/bu-selbststaendige-kassel/",
    label: "Selbstständige & Unternehmer",
    headline: "Wenn du nicht arbeiten kannst, fehlt möglicherweise direkt dein Einkommen.",
    text: "Als Selbstständiger trägst du dein wirtschaftliches Risiko persönlich. Wir trennen sauber zwischen betrieblichen und privaten Risiken und finden die passende Absicherung.",
    points: [
      "Klare Trennung von Unternehmens- und Privatrisiko",
      "Abstimmung von BU und Krankentagegeld",
      "Berücksichtigung deiner konkreten Tätigkeit",
      "Ganzheitlicher Blick auf dein Unternehmenswachstum",
    ],
  },
  {
    icon: GraduationCap,
    href: "/bu-studenten-kassel/",
    label: "Studenten",
    headline: "Deine Karriere hat noch nicht richtig begonnen. Genau deshalb kann jetzt der beste Zeitpunkt sein.",
    text: "Als Student profitierst du unter Umständen von einer günstigeren gesundheitlichen Ausgangssituation – und von Verträgen, die flexibel mit deiner Karriere mitwachsen.",
    points: [
      "Frühzeitige Prüfung der Versicherbarkeit",
      "Berücksichtigung deines Studiengangs",
      "Flexible Anpassung bei Berufseinstieg",
      "Langfristige Begleitung vom Studium bis in den Beruf",
    ],
  },
  {
    icon: Landmark,
    href: "/bu-beamte-kassel/",
    label: "Beamte & Referendare",
    headline: "Beamter zu sein bedeutet nicht automatisch, dass du bei Dienstunfähigkeit abgesichert bist.",
    text: "Bei Beamten zählt neben der Berufsunfähigkeit vor allem die Dienstunfähigkeitsklausel. Wir prüfen deinen Beamtenstatus und die konkreten Vertragsbedingungen.",
    points: [
      "Prüfung der Dienstunfähigkeitsklausel",
      "Abstimmung auf deinen Beamtenstatus",
      "Gemeinsame Betrachtung von PKV und DU möglich",
      "Für Anwärter, Beamte auf Probe und Lebenszeit",
    ],
  },
];
---

<section id="bu-zielgruppen" class="bg-white py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">
        Egal, wo du gerade stehst – wir prüfen, <span class="text-brand-600">was wirklich zu dir passt</span>.
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-700/80">
        Deine Tätigkeit, dein Einkommen und deine Lebensplanung entscheiden, welche
        Berufsunfähigkeitsabsicherung sinnvoll ist. Wähle deine Situation:
      </p>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2">
      {
        cards.map((card, index) => (
          <a
            href={card.href}
            data-reveal
            style={`transition-delay: ${index * 80}ms`}
            class="group rounded-2xl border border-black/5 bg-brand-50/30 p-7 transition-colors duration-200 hover:border-brand-200 hover:bg-brand-50"
          >
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-white text-brand-600 shadow-sm">
              <card.icon className="h-5 w-5" aria-hidden="true" />
            </div>
            <span class="mt-5 block text-xs font-semibold uppercase tracking-wider text-brand-600">{card.label}</span>
            <h3 class="mt-1.5 font-serif text-lg font-semibold text-ink-950">{card.headline}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-ink-700/75">{card.text}</p>
            <ul class="mt-5 space-y-2">
              {card.points.map((point) => (
                <li class="flex items-start gap-2.5 text-sm text-ink-700/85">
                  <CheckCircle2 className="mt-0.5 h-4.5 w-4.5 shrink-0 text-brand-600" aria-hidden="true" />
                  {point}
                </li>
              ))}
            </ul>
            <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600">
              Mehr erfahren
              <ArrowRight className="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5" aria-hidden="true" />
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
