---
import { HeartPulse, Coins, History } from "lucide-react";
import MistakeGrid from "@/components/MistakeGrid.astro";

const mistakes = [
  {
    icon: HeartPulse,
    number: "1. Fehler",
    title: "Gesundheitsfragen nicht optimal beantwortet.",
    description:
      "Ungenaue oder unvollständige Angaben können zu Leistungsausschlüssen oder sogar zur Ablehnung deines Antrags führen – oft ohne es zu merken.",
    consequence: "Ausschlüsse, Risikozuschläge oder Ablehnung – und das kann dir im Ernstfall den Schutz kosten.",
    solution: "Professionelle Risikovoranfrage zeigt dir, wie du optimal durch die Gesundheitsprüfung kommst.",
  },
  {
    icon: Coins,
    number: "2. Fehler",
    title: "Falscher Tarif – zu teuer oder zu schwach",
    description:
      "Viele Verträge bieten entweder zu wenig Leistung oder sind unnötig teuer – weil Möglichkeiten am Markt nicht richtig genutzt wurden.",
    consequence: "Im Ernstfall reicht die BU-Rente nicht aus – oder du zahlst über Jahre zu viel.",
    solution: "Wir vergleichen nicht nur Preise, sondern vor allem Leistungen, Bedingungen und Qualität.",
  },
  {
    icon: History,
    number: "3. Fehler",
    title: "Veralteter Vertrag – nicht mehr zeitgemäß",
    description:
      "Tarifgenerationen ändern sich laufend. Was vor ein paar Jahren noch gut war, kann heute im Vergleich schlechter sein – bei einem höheren Beitrag.",
    consequence: "Schlechtere Bedingungen und weniger Leistung – trotz jahrelanger Beitragszahlung.",
    solution: "Wir prüfen deinen bestehenden Vertrag und zeigen dir, ob du besser gestellt werden kannst.",
  },
];
---

<MistakeGrid
  id="bu-fehler"
  eyebrow="Die 3 häufigsten BU-Fehler"
  title="Kleine Fehler, große Folgen."
  titleHighlight="große Folgen"
  intro="Diese 3 Fehler werden im Ernstfall teuer. Bei der Berufsunfähigkeitsversicherung kommt es auf jedes Detail an – diese Fehler sehen wir leider viel zu oft, und helfen dir, sie von Anfang an zu vermeiden."
  mistakes={mistakes}
  columns={3}
  closing={{
    title: "Vermeide teure Fehler - bevor sie passieren.",
    text: "Mit unserer Risikovoranfrage sorgen wir dafür, dass du die bestmögliche Absicherung zu den bestmöglichen Bedingungen erhältst. Mehrere hundert Risikovoranfragen — Erfahrung, die dich absichert.",
  }}
/>
