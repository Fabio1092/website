---
import { ArrowRight } from "lucide-react";

const cases = [
  {
    tag: "Neukunde",
    title: "Maximale Absicherung von Anfang an richtig gemacht.",
    intro:
      "Max, 29, Ingenieur, wollte sich optimal gegen Berufsunfähigkeit absichern. Durch unsere Risikovoranfrage konnten wir vorab die besten Annahmechancen und Konditionen für ihn ermitteln.",
    before: { label: "Ohne Risikovoranfrage", points: ["Ablehnung oder Ausschlüsse", "Höherer Beitrag", "Unsicherheit im Antragsprozess", "Weniger Leistung"] },
    after: { label: "Ergebnis für Max", points: ["68,42 € monatlicher Beitrag", "2.000 € BU-Rente", "Top-Bedingungen ohne Ausschlüsse", "Sichere Annahme"] },
    outcome: "Max hat von Anfang an die bestmögliche Lösung – sicher, leistungsstark und zu einem fairen Preis.",
  },
  {
    tag: "Bestehender Vertrag",
    title: "Bestehende BU optimiert – mehr Rente, weniger Beitrag.",
    intro:
      "Julia, 38, Marketing-Managerin, hatte ihre BU vor 6 Jahren abgeschlossen. Wir haben ihren Vertrag geprüft und ein deutlich besseres Ergebnis erzielt.",
    before: { label: "Alter Vertrag", points: ["142,37 € monatlicher Beitrag", "1.500 € BU-Rente", "Leistung eingeschränkt", "Vertragsbedingung veraltet"] },
    after: { label: "Neuer Vertrag", points: ["69,11 € monatlicher Beitrag", "2.000 € BU-Rente", "Keine Einschränkungen", "Moderne Bedingungen"] },
    outcome: "Julia spart 73,26 € monatlich und erhält gleichzeitig 750 € mehr BU-Rente.",
  },
];
---

<section class="bg-brand-50/40 py-24">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">
        <span class="text-brand-600">Echte Ergebnisse.</span> Echte Menschen.
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-700/80">
        Zwei Beispiele, wie wir den Unterschied machen. Jede Situation ist einzigartig – unser Ziel
        ist immer das gleiche: die bestmögliche Absicherung zu den bestmöglichen Bedingungen.
      </p>
    </div>

    <div class="mt-14 space-y-6">
      {
        cases.map((c, index) => (
          <div data-reveal style={`transition-delay: ${index * 100}ms`} class="shadow-soft rounded-3xl bg-white p-8 sm:p-10">
            <span class="inline-flex items-center rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-brand-700">
              {c.tag}
            </span>
            <h3 class="mt-4 font-serif text-2xl font-semibold text-ink-950">{c.title}</h3>
            <p class="mt-2 max-w-3xl text-sm leading-relaxed text-ink-700/75">{c.intro}</p>

            <div class="mt-8 grid items-center gap-6 sm:grid-cols-[1fr_auto_1fr]">
              <div>
                <p class="text-xs font-semibold uppercase tracking-wide text-ink-700/45">{c.before.label}</p>
                <ul class="mt-3 space-y-1.5">
                  {c.before.points.map((p) => (
                    <li class="text-sm text-ink-700/60 line-through decoration-ink-700/30">{p}</li>
                  ))}
                </ul>
              </div>

              <div class="hidden h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-100 text-brand-600 sm:flex">
                <ArrowRight className="h-4 w-4" aria-hidden="true" />
              </div>

              <div class="border-t border-black/[0.06] pt-5 sm:border-t-0 sm:pt-0">
                <p class="text-xs font-semibold uppercase tracking-wide text-brand-600">{c.after.label}</p>
                <ul class="mt-3 space-y-1.5">
                  {c.after.points.map((p) => (
                    <li class="text-sm font-medium text-ink-950">{p}</li>
                  ))}
                </ul>
              </div>
            </div>

            <p class="mt-8 border-t border-black/[0.06] pt-6 text-sm font-medium text-brand-700">{c.outcome}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
