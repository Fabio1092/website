---
import { X, Check } from "lucide-react";

const cases = [
  {
    tag: "Neukunde",
    title: "Maximale Absicherung von Anfang an richtig gemacht.",
    intro:
      "Max, 29, Ingenieur, wollte sich optimal gegen Berufsunfähigkeit absichern. Durch unsere Risikovoranfrage konnten wir vorab die besten Annahmechancen und Konditionen für ihn ermitteln.",
    before: {
      label: "Ohne Risikovoranfrage",
      caption: "Mögliche Folgen",
      points: ["Ablehnung oder Ausschlüsse", "Höherer Beitrag", "Unsicherheit im Antragsprozess", "Weniger Leistung"],
    },
    after: {
      label: "Mit Risikovoranfrage",
      caption: "Ergebnis für Max",
      points: ["Monatlicher Beitrag: 68,42 €", "2.000 € BU-Rente", "Top-Bedingungen ohne Ausschlüsse", "Sichere Annahme"],
    },
    outcome: "Max hat von Anfang an die bestmögliche Lösung – sicher, leistungsstark und zu einem fairen Preis.",
  },
  {
    tag: "Bestehender Vertrag",
    title: "Bestehende BU optimiert – mehr Rente, weniger Beitrag.",
    intro:
      "Julia, 38, Marketing-Managerin, hatte ihre BU vor 6 Jahren abgeschlossen. Wir haben ihren Vertrag geprüft und ein deutlich besseres Ergebnis erzielt.",
    before: {
      label: "Alter Vertrag",
      caption: "Situation",
      points: ["Monatlicher Beitrag: 142,37 €", "BU-Rente: 1.500 €", "Leistung eingeschränkt", "Vertragsbedingung veraltet"],
    },
    after: {
      label: "Neuer Vertrag",
      caption: "Neues Ergebnis",
      points: ["Monatlicher Beitrag: 69,11 €", "BU-Rente: 2.000 €", "Keine Einschränkungen", "Moderne Bedingungen"],
    },
    outcome: "Julia spart 73,26 € monatlich und erhält gleichzeitig 750 € mehr BU-Rente.",
  },
];
---

<section class="bg-brand-50/40 py-24">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">
        <span class="text-brand-600">Echte Ergebnisse.</span> Echte Menschen.
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-700/80">
        Zwei Beispiele, wie wir den Unterschied machen. Jede Situation ist einzigartig – unser Ziel
        ist immer das gleiche: die bestmögliche Absicherung zu den bestmöglichen Bedingungen.
      </p>
    </div>

    <div class="mt-14 space-y-8">
      {
        cases.map((c, index) => (
          <div data-reveal style={`transition-delay: ${index * 100}ms`} class="rounded-2xl border border-black/5 bg-white p-8 sm:p-10">
            <span class="inline-flex items-center rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-brand-700">
              {c.tag}
            </span>
            <h3 class="mt-4 font-serif text-2xl font-semibold text-ink-950">{c.title}</h3>
            <p class="mt-2 max-w-3xl text-sm leading-relaxed text-ink-700/75">{c.intro}</p>

            <div class="mt-8 grid gap-6 sm:grid-cols-2">
              <div class="rounded-xl border border-danger-500/15 bg-danger-50 p-6">
                <span class="inline-flex items-center gap-2 text-sm font-semibold text-danger-500">
                  <X className="h-4 w-4" aria-hidden="true" />
                  {c.before.label}
                </span>
                <p class="mt-3 text-xs font-semibold uppercase tracking-wide text-ink-700/50">{c.before.caption}</p>
                <ul class="mt-2 space-y-1.5">
                  {c.before.points.map((p) => (
                    <li class="text-sm text-ink-700/85">{p}</li>
                  ))}
                </ul>
              </div>
              <div class="rounded-xl border border-success-500/20 bg-success-50 p-6">
                <span class="inline-flex items-center gap-2 text-sm font-semibold text-success-500">
                  <Check className="h-4 w-4" aria-hidden="true" />
                  {c.after.label}
                </span>
                <p class="mt-3 text-xs font-semibold uppercase tracking-wide text-ink-700/50">{c.after.caption}</p>
                <ul class="mt-2 space-y-1.5 font-medium">
                  {c.after.points.map((p) => (
                    <li class="text-sm text-ink-950">{p}</li>
                  ))}
                </ul>
              </div>
            </div>

            <p class="mt-6 text-sm font-medium text-brand-700">{c.outcome}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
