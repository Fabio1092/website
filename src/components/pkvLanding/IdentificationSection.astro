---
import { CheckCircle2 } from "lucide-react";
import BookingButton from "@/components/pkvLanding/BookingButton.astro";

const points = [
  "Du hast bereits mehrere PKV-Angebote vorliegen – kannst aber kaum einschätzen, welches davon wirklich gut ist.",
  "Du hast online Tarife verglichen und bist danach eher verwirrter als vorher.",
  "Du bist aktuell gesetzlich versichert und weißt nicht, ob ein Wechsel tatsächlich sinnvoll wäre.",
  "Du möchtest von Anfang an vermeiden, nur nach dem günstigsten Beitrag zu entscheiden.",
  "Du hast Vorerkrankungen und weißt nicht, welche Auswirkungen diese haben könnten.",
  "Oder du möchtest einfach einmal mit jemandem sprechen, der dir das Thema verständlich einordnet.",
];
---

<section class="bg-brand-50/30 py-16 sm:py-24">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <h2 class="text-center font-serif text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">Vielleicht erkennst du dich hier wieder.</h2>

    <div data-reveal class="mt-10 divide-y divide-black/[0.06] overflow-hidden rounded-3xl border border-black/5 bg-white shadow-soft">
      {
        points.map((point) => (
          <div class="flex items-start gap-3.5 px-6 py-4.5 sm:px-8">
            <CheckCircle2 className="mt-0.5 h-5 w-5 shrink-0 text-brand-600" aria-hidden="true" />
            <p class="text-sm leading-relaxed text-ink-950 sm:text-base">{point}</p>
          </div>
        ))
      }
    </div>

    <div class="mx-auto mt-10 max-w-xl space-y-4 text-center">
      <p class="text-base leading-relaxed text-ink-700/75">
        Genau dafür ist das 15-minütige Erstgespräch da. Wir klären zunächst deine
        Ausgangssituation, deine wichtigsten Fragen und ob eine weiterführende PKV-Beratung für
        dich überhaupt sinnvoll ist.
      </p>
      <div class="pt-2">
        <BookingButton location="identification" variant="compact" />
      </div>
    </div>
  </div>
</section>
