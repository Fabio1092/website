---
import { CheckCircle2 } from "lucide-react";
import BookingButton from "@/components/pkvLanding/BookingButton.astro";

const points = [
  "Du hast bereits PKV-Angebote vorliegen – kannst aber kaum beurteilen, welches davon wirklich gut ist.",
  "Du hast angefangen, online zu vergleichen, und hast inzwischen mehr Fragen als vorher.",
  "Du bist gesetzlich versichert und weißt nicht, ob sich der Wechsel für dich tatsächlich lohnt.",
  "Du hast gehört, dass die PKV im Alter teuer werden kann, und möchtest wissen, wie du das Thema vernünftig beurteilst.",
  "Du planst vielleicht eine Familie und willst verstehen, was das für deine Krankenversicherung bedeutet.",
  "Oder du hast gesundheitliche Themen in deiner Vorgeschichte und weißt nicht, wie du jetzt richtig vorgehst.",
];
---

<section class="bg-brand-50/30 py-16 sm:py-24">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <h2 class="text-center font-serif text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">Vielleicht stehst du gerade genau hier.</h2>

    <div data-reveal class="mt-10 divide-y divide-black/[0.06] overflow-hidden rounded-3xl border border-black/5 bg-white shadow-soft">
      {
        points.map((point) => (
          <div class="flex items-start gap-3.5 px-6 py-4.5 sm:px-8">
            <CheckCircle2 className="mt-0.5 h-5 w-5 shrink-0 text-brand-600" aria-hidden="true" />
            <p class="text-sm leading-relaxed text-ink-950 sm:text-base">{point}</p>
          </div>
        ))
      }
    </div>

    <div class="mx-auto mt-10 max-w-xl space-y-4 text-center">
      <p class="text-base leading-relaxed text-ink-700/75">
        Dann brauchst du nicht noch den nächsten Online-Rechner. Du brauchst zunächst Klarheit
        darüber, welche Fragen in deiner Situation überhaupt beantwortet werden müssen.
      </p>
      <div class="pt-2">
        <BookingButton location="identification" variant="compact" />
      </div>
    </div>
  </div>
</section>
