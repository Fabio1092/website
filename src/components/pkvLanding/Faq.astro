---
import FaqAccordion, { type FaqItem } from "@/components/FaqAccordion.tsx";

const faqs: FaqItem[] = [
  {
    question: "Ist die PKV grundsätzlich besser als die gesetzliche Krankenversicherung?",
    answer:
      "Nein. Welche Variante besser zu dir passt, hängt von deiner persönlichen Situation, deinen Anforderungen, deinem beruflichen Status und deiner langfristigen Planung ab. Genau deshalb schauen wir uns zunächst die grundsätzliche Entscheidung an und beschäftigen uns erst anschließend mit konkreten Tarifen.",
  },
  {
    question: "Sollte ich einfach den günstigsten PKV-Tarif wählen?",
    answer:
      "Der Beitrag ist ein wichtiges Kriterium – aber nicht das einzige. Bei einer Krankenversicherung können Leistungsbedingungen und langfristige Passung wichtiger sein als ein kurzfristiger Preisunterschied. Deshalb betrachten wir mehrere Faktoren gemeinsam.",
  },
  {
    question: "Kann ich mich auch mit Vorerkrankungen privat versichern?",
    answer:
      "Das lässt sich nicht pauschal beantworten. Art, Zeitraum und Verlauf einer Erkrankung können eine Rolle spielen. Je nach Situation kann deshalb eine strukturierte Aufbereitung der Gesundheitsangaben und gegebenenfalls eine anonyme Risikovoranfrage sinnvoll sein.",
  },
  {
    question: "Berätst du nur Beamte?",
    answer:
      "Nein. Meine PKV-Beratung richtet sich insbesondere an Angestellte, Selbstständige und Unternehmer sowie Beamte und Beamtenanwärter. Die Beratung wird anschließend auf die jeweilige Situation zugeschnitten.",
  },
  {
    question: "Muss ich für die Beratung nach Kassel kommen?",
    answer: "Nein. Mein regionaler Schwerpunkt liegt auf Kassel und Nordhessen. Die Beratung kann aber sowohl persönlich als auch digital stattfinden.",
  },
  {
    question: "Ich habe bereits ein PKV-Angebot. Kannst du es trotzdem mit mir anschauen?",
    answer:
      "Ja. Gerade wenn bereits ein oder mehrere Angebote vorliegen, können wir schauen, welche Unterschiede relevant sind und welche Fragen vor einer Entscheidung noch geklärt werden sollten.",
  },
  {
    question: "Was passiert im 15-minütigen Erstgespräch?",
    answer:
      "Wir sprechen kurz über deine Ausgangssituation und darüber, warum du dich aktuell mit der privaten Krankenversicherung beschäftigst. Dabei klären wir deine wichtigsten Fragen und schauen, ob und wie eine weiterführende Beratung sinnvoll ist. Der Termin dient zunächst dazu, deine Situation einzuordnen und uns kennenzulernen.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<section id="faq" class="scroll-mt-20 bg-brand-50/30 py-16 sm:py-24">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <h2 class="font-serif text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">Häufige Fragen zur <span class="text-brand-600">privaten Krankenversicherung</span></h2>
    </div>
    <div data-reveal class="mt-12">
      <FaqAccordion client:visible faqs={faqs} />
    </div>
  </div>
</section>

<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
