---
import FaqAccordion, { type FaqItem } from "@/components/FaqAccordion.tsx";

const faqs: FaqItem[] = [
  {
    question: "Ist die PKV grundsätzlich besser als die gesetzliche Krankenversicherung?",
    answer:
      "Nein. Beide Systeme haben unterschiedliche Vor- und Nachteile. Was besser zu dir passt, hängt unter anderem von deiner beruflichen und persönlichen Situation, deinen Anforderungen und deiner langfristigen Lebensplanung ab. Genau deshalb sollte diese Frage geklärt werden, bevor wir konkrete Tarife vergleichen.",
  },
  {
    question: "Sollte ich einfach den günstigsten PKV-Tarif wählen?",
    answer:
      "Der aktuelle Beitrag ist ein wichtiger Punkt – aber eben nur einer. Gerade bei einer Entscheidung, die dich möglicherweise über Jahrzehnte begleitet, sollten auch Leistungen, Bedingungen und die langfristige Passung betrachtet werden.",
  },
  {
    question: "Kann ich mich auch mit Vorerkrankungen privat versichern?",
    answer:
      "Das lässt sich nicht pauschal beantworten. Welche Möglichkeiten bestehen, hängt unter anderem von Art, Verlauf und Zeitraum der gesundheitlichen Vorgeschichte sowie von der Risikoprüfung des jeweiligen Versicherers ab. Je nach Situation kann eine anonyme Risikovoranfrage sinnvoll sein.",
  },
  {
    question: "Was passiert mit der PKV, wenn ich später Kinder bekomme?",
    answer:
      "Familienplanung sollte bereits vor einem Wechsel mitgedacht werden. Welche Auswirkungen entstehen, hängt von deiner konkreten familiären und versicherungsrechtlichen Situation ab. Genau deshalb gehört dieses Thema für mich in eine langfristige PKV-Beratung.",
  },
  {
    question: "Berätst du nur Beamte?",
    answer:
      "Nein. Meine PKV-Beratung richtet sich insbesondere an Angestellte, Selbstständige und Unternehmer sowie Beamte und Beamtenanwärter. Die Betrachtung unterscheidet sich je nach Ausgangssituation.",
  },
  {
    question: "Muss ich für die Beratung nach Kassel kommen?",
    answer: "Nein. Mein persönlicher Schwerpunkt liegt auf Kassel und Nordhessen. Die Beratung ist aber auch vollständig digital möglich.",
  },
  {
    question: "Ich habe bereits ein Angebot. Kannst du es trotzdem mit mir anschauen?",
    answer:
      "Ja. Wenn dir bereits ein oder mehrere PKV-Angebote vorliegen, können wir gemeinsam einordnen, welche Unterschiede relevant sind und welche Fragen vor einer Entscheidung noch offen sind.",
  },
  {
    question: "Was passiert im 15-minütigen Erstgespräch?",
    answer:
      "Wir sprechen über deine aktuelle Situation und darüber, warum du dich gerade mit der privaten Krankenversicherung beschäftigst. Wir klären deine wichtigsten Fragen und schauen, welcher nächste Schritt sinnvoll ist. Du musst im Erstgespräch keinen Tarif auswählen oder einen Vertrag abschließen.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<section id="faq" class="scroll-mt-20 bg-brand-50/30 py-16 sm:py-24">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <h2 class="font-serif text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">Häufige Fragen zur <span class="text-brand-600">privaten Krankenversicherung</span></h2>
    </div>
    <div data-reveal class="mt-12">
      <FaqAccordion client:visible faqs={faqs} />
    </div>
  </div>
</section>

<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
