---
import { siteConfig } from "@/lib/site";

// Central CTA for the PKV landing page: one URL, one label, everywhere.
// Change the destination in siteConfig.calendlyPkvUrl — never per-instance.
const BOOKING_LABEL = "15-minütiges Erstgespräch buchen";

interface Props {
  /** Feeds data-cta-location so CTA clicks can be told apart later in GA4/GTM. */
  location: string;
  variant?: "primary" | "compact" | "sticky" | "text";
  class?: string;
}

const { location, variant = "primary", class: className = "" } = Astro.props;

const variantClass = {
  primary:
    "inline-flex items-center justify-center rounded-full bg-gold-500 px-8 py-4 text-base font-semibold text-ink-950 shadow-lg shadow-gold-500/20 transition-transform duration-200 hover:-translate-y-0.5 hover:bg-gold-400",
  compact:
    "inline-flex items-center justify-center rounded-full bg-gold-500 px-7 py-3.5 text-sm font-semibold text-ink-950 shadow-sm transition-transform duration-200 hover:-translate-y-0.5 hover:bg-gold-400",
  sticky: "flex w-full items-center justify-center rounded-full bg-gold-500 px-5 py-3 text-sm font-semibold text-ink-950 shadow-sm",
  text: "font-semibold text-brand-700 underline underline-offset-4 decoration-brand-300 transition-colors hover:text-brand-800",
}[variant];
---

<a
  href={siteConfig.calendlyPkvUrl}
  target="_blank"
  rel="noopener noreferrer"
  data-cta="booking"
  data-cta-location={location}
  class={`${variantClass} ${className}`.trim()}
>
  {BOOKING_LABEL}
</a>
