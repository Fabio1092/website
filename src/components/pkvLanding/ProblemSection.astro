---
import { CheckCircle2 } from "lucide-react";
import BookingButton from "@/components/pkvLanding/BookingButton.astro";

const questions = [
  "Was passiert, wenn du später eine Familie gründest?",
  "Wie verändert sich deine Situation, wenn dein Einkommen oder dein Beruf sich verändert?",
  "Welche Leistungen möchtest du wirklich abgesichert haben?",
  "Welche Rolle spielt deine gesundheitliche Vorgeschichte?",
  "Und ist die PKV überhaupt die bessere Entscheidung für dich – oder passt die gesetzliche Krankenversicherung langfristig besser?",
];
---

<section class="bg-white py-16 sm:py-24">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <h2 class="font-serif text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">
        Die entscheidende Frage ist nicht: „Welcher Tarif ist am günstigsten?“
      </h2>
      <p class="mt-3 text-lg leading-relaxed text-ink-700/80">Sondern: Welche Entscheidung passt langfristig zu dir?</p>
      <p class="mt-6 text-base leading-relaxed text-ink-700/70">
        Wer anfängt, sich mit der privaten Krankenversicherung zu beschäftigen, landet schnell bei
        Beiträgen, Tarifnamen und Leistungsvergleichen. Dabei sind vorher ganz andere Fragen
        wichtig.
      </p>
    </div>

    <ul data-reveal class="mx-auto mt-10 max-w-xl space-y-3">
      {
        questions.map((question) => (
          <li class="flex items-start gap-3 rounded-xl border border-black/5 bg-brand-50/25 px-5 py-3.5 text-sm leading-relaxed text-ink-950 sm:text-base">
            <CheckCircle2 className="mt-0.5 h-5 w-5 shrink-0 text-brand-600" aria-hidden="true" />
            {question}
          </li>
        ))
      }
    </ul>

    <div class="mx-auto mt-12 max-w-xl space-y-1.5 text-center">
      <p class="font-serif text-lg font-semibold text-ink-950">Genau deshalb beginnt meine Beratung nicht mit einem Tarif.</p>
      <p class="font-serif text-lg font-semibold text-brand-600">Sie beginnt mit deiner Situation.</p>

      <div class="pt-6">
        <BookingButton location="problem" variant="compact" label="Meine Situation besprechen" />
      </div>
    </div>
  </div>
</section>
