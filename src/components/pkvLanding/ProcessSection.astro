---
import BookingButton from "@/components/pkvLanding/BookingButton.astro";

const steps = [
  {
    number: "1",
    title: "Erstgespräch – ca. 15 Minuten",
    text: "Wir sprechen über deine aktuelle Situation, deine Motivation für die PKV und deine wichtigsten Fragen. Danach wissen wir beide, ob und wie eine weitere Beratung sinnvoll ist.",
  },
  {
    number: "2",
    title: "Persönliche Analyse",
    text: "Wenn es passt, gehen wir anschließend tiefer. Wir betrachten deine berufliche Situation, deine Anforderungen an den Versicherungsschutz, deine Lebensplanung und – soweit relevant – deine gesundheitliche Vorgeschichte.",
  },
  {
    number: "3",
    title: "Lösungen vergleichen & verstehen",
    text: "Erst jetzt geht es um konkrete Versicherer und Tarife. Dabei schauen wir nicht nur auf den Beitrag, sondern auf die Punkte, die für deine Situation langfristig entscheidend sind. Du bekommst keine Tarifflut, sondern eine nachvollziehbare Einordnung.",
  },
  {
    number: "4",
    title: "Entscheidung & langfristige Begleitung",
    text: "Wenn du dich für eine Lösung entscheidest, unterstütze ich dich bei der Umsetzung. Und auch danach bleibe ich dein Ansprechpartner, wenn Fragen entstehen oder sich dein Leben verändert.",
  },
];
---

<section class="scroll-mt-24 bg-white py-16 sm:py-24">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="font-serif text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">So läuft deine PKV-Beratung ab</h2>
    </div>

    <ol class="mt-14 space-y-10">
      {
        steps.map((step, index) => (
          <li data-reveal style={`transition-delay: ${index * 80}ms`} class="relative flex gap-6 sm:gap-8">
            <div class="flex flex-col items-center">
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-ink-950 font-serif text-base font-semibold text-white">
                {step.number}
              </span>
              {index < steps.length - 1 && <span class="mt-2 w-px flex-1 bg-brand-200" aria-hidden="true" />}
            </div>
            <div class="min-w-0 pb-2">
              <h3 class="font-serif text-xl font-semibold text-ink-950 sm:text-2xl">{step.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-ink-700/80 sm:text-base">{step.text}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="mx-auto mt-14 max-w-lg space-y-4 text-center">
      <p class="text-base leading-relaxed text-ink-700/75">Mein Ziel ist nicht, dass du sagst:</p>
      <p class="font-serif text-lg italic text-ink-700/60">„Fabio hat gesagt, dieser Tarif sei der beste.“</p>
      <p class="text-base text-ink-700/75">Sondern:</p>
      <p class="font-serif text-xl font-semibold text-ink-950">„Ich verstehe, warum diese Lösung zu mir passt.“</p>

      <div class="pt-4">
        <BookingButton location="process" variant="compact" label="Beratung jetzt starten" />
      </div>
    </div>
  </div>
</section>
