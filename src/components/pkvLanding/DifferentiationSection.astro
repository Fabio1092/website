---
import { BookOpenCheck, Fingerprint, Infinity as InfinityIcon } from "lucide-react";

const points = [
  {
    icon: BookOpenCheck,
    title: "Verstehen statt einfach unterschreiben",
    text: "Du sollst nachvollziehen können, warum eine bestimmte Lösung empfohlen wird. Nicht einfach einen Tarifnamen und einen Monatsbeitrag präsentiert bekommen.",
  },
  {
    icon: Fingerprint,
    title: "Deine Situation statt irgendeiner Musterlösung",
    text: "Ein Beamter benötigt eine andere Betrachtung als ein Selbstständiger. Ein Single möglicherweise eine andere als jemand mit konkreter Familienplanung. Deshalb beginnt die Beratung bei dir – und nicht bei einem Tarif.",
  },
  {
    icon: InfinityIcon,
    title: "Langfristige Betreuung statt einmaliger Abschluss",
    text: "Eine Krankenversicherung begleitet dich möglicherweise viele Jahrzehnte. Entsprechend sollte auch die Beratung gedacht sein.",
  },
];
---

<section class="bg-white py-16 sm:py-24">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="font-serif text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">Warum ich PKV-Beratung anders angehe</h2>
      <p class="mt-3 text-lg leading-relaxed text-ink-700/80">Nicht einfach nur Tarife vergleichen.</p>
      <p class="mt-6 text-base leading-relaxed text-ink-700/70">
        Natürlich gehört ein Tarifvergleich zu einer guten PKV-Beratung. Aber ein Vergleich allein
        beantwortet noch nicht die wichtigste Frage:
      </p>
      <p class="mt-3 font-serif text-lg font-semibold text-ink-950">Welche Krankenversicherung passt langfristig zu deinem Leben?</p>
      <p class="mt-4 text-base text-ink-700/70">Deshalb sind mir drei Dinge besonders wichtig.</p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-3">
      {
        points.map((point, index) => (
          <div data-reveal style={`transition-delay: ${index * 80}ms`} class="rounded-2xl border border-black/5 bg-white p-7 shadow-soft">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
              <point.icon className="h-5 w-5" aria-hidden="true" />
            </div>
            <h3 class="mt-5 font-serif text-lg font-semibold text-ink-950">{point.title}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-ink-700/75">{point.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
