---
import { siteConfig } from "@/lib/site";

// Real, live Google reviews via the same Trustindex widget used on the homepage.
// Deliberately not reusing the static BU-page reviews here: of the reviews
// collected so far, only one explicitly covers PKV, and presenting the
// others (which speak to BU experiences) as PKV testimonials would misrepresent
// what they're actually about. The live widget stays accurate without that risk.
---

<section class="bg-white py-16 sm:py-24">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <h2 class="text-center font-serif text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">Das sagen meine Kunden</h2>

    <div data-reveal class="mt-10 rounded-2xl border border-black/5 bg-brand-50/25 p-4 sm:p-6">
      <script is:inline type="text/javascript" defer async src={siteConfig.trustindexEmbedSrc}></script>
      <noscript>
        <p class="p-6 text-center text-sm text-ink-700/70">
          Live-Bewertungen werden über
          <a href="https://www.trustindex.io/reviews/www.fr-makler.de" class="underline" target="_blank" rel="noopener noreferrer">
            Trustindex
          </a>
          angezeigt.
        </p>
      </noscript>
    </div>
  </div>
</section>
