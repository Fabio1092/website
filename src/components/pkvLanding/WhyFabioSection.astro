---
import { UserCheck, Scale, BookOpenCheck, Infinity as InfinityIcon } from "lucide-react";

const points = [
  {
    icon: UserCheck,
    title: "Persönlich statt Callcenter",
    text: "Du sprichst direkt mit mir. Kein wechselnder Ansprechpartner und kein anonymer Vergleichsprozess. Wenn wir zusammenarbeiten, weißt du, wer für deine Fragen zuständig ist.",
  },
  {
    icon: Scale,
    title: "Ungebunden statt an eine Gesellschaft gebunden",
    text: "Als Versicherungsmakler bin ich nicht an eine einzelne Versicherungsgesellschaft gebunden. Damit startet die Beratung nicht mit der Frage: „Welchen Tarif dieser Gesellschaft nehmen wir?“ Sondern mit: „Welche Lösung passt zu deiner Situation?“",
  },
  {
    icon: BookOpenCheck,
    title: "Verständlich statt Tarifdschungel",
    text: "Ich halte wenig davon, dir 30 Seiten Vergleich auszudrucken und anschließend zu sagen: „Such dir etwas aus.“ Mein Anspruch ist, dass du die entscheidenden Unterschiede verstehst. Du sollst am Ende wissen, warum eine Lösung zu dir passt.",
  },
  {
    icon: InfinityIcon,
    title: "Langfristig statt nur bis zur Unterschrift",
    text: "Eine private Krankenversicherung begleitet dich möglicherweise über Jahrzehnte. Deshalb endet meine Arbeit nicht automatisch mit einem Vertragsabschluss. Auch wenn sich deine Situation später verändert, hast du weiterhin einen persönlichen Ansprechpartner.",
  },
];
---

<section class="bg-brand-50/30 py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:items-center lg:gap-16">
      <div class="mx-auto w-full max-w-xs sm:max-w-sm lg:mx-0 lg:max-w-none">
        <div class="relative">
          <div class="pointer-events-none absolute -inset-4 -z-10 rounded-[2rem] bg-gradient-to-br from-brand-500/10 via-transparent to-gold-500/10 blur-xl" aria-hidden="true"></div>
          <img
            src="/images/1-42.jpg"
            alt="Fabio Rumpf, Versicherungsmakler aus Kassel"
            class="aspect-[4/5] w-full rounded-[2rem] border border-black/5 object-cover shadow-2xl shadow-black/10"
            width="800"
            height="1000"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>

      <div data-reveal class="min-w-0">
        <h2 class="font-serif text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">Warum mit Fabio über deine PKV sprechen?</h2>

        <div class="mt-8 grid gap-6 sm:grid-cols-2">
          {
            points.map((point) => (
              <div class="flex items-start gap-4">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white text-brand-600 shadow-soft">
                  <point.icon className="h-5 w-5" aria-hidden="true" />
                </div>
                <div>
                  <p class="text-sm font-semibold text-ink-950">{point.title}</p>
                  <p class="mt-1.5 text-sm leading-relaxed text-ink-700/75">{point.text}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
