---
import BookingButton from "@/components/pkvLanding/BookingButton.astro";

const items = [
  {
    number: "01",
    title: "Deine Ausgangssituation",
    text: "Wir ordnen ein, ob und warum die PKV für dich grundsätzlich interessant sein könnte.",
  },
  {
    number: "02",
    title: "Deine wichtigsten offenen Fragen",
    text: "Wir schauen darauf, welche Themen für deine Entscheidung wirklich relevant sind – statt dich mit hundert Tarifdetails zu überladen.",
  },
  {
    number: "03",
    title: "Deinen nächsten sinnvollen Schritt",
    text: "Du bekommst eine erste Orientierung, wie wir weiter vorgehen können und ob eine ausführliche PKV-Beratung für dich sinnvoll ist.",
  },
];
---

<section class="bg-white py-16 sm:py-24">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="font-serif text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">Was bringen dir die ersten 15 Minuten?</h2>
      <p class="mt-3 text-lg leading-relaxed text-ink-700/80">Keine Tarifschlacht. Keine Entscheidung unter Druck.</p>
      <p class="mt-5 text-base leading-relaxed text-ink-700/70">
        Das Erstgespräch ist bewusst kurz gehalten. Wir wollen zunächst herausfinden, wo du stehst
        und was für dich überhaupt sinnvoll ist.
      </p>
      <p class="mt-4 text-base font-medium text-ink-950">Nach unserem Gespräch solltest du drei Dinge klarer sehen:</p>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-3">
      {
        items.map((item, index) => (
          <div data-reveal style={`transition-delay: ${index * 90}ms`} class="rounded-2xl border border-black/5 bg-brand-50/25 p-7">
            <span class="font-serif text-2xl font-semibold text-brand-300">{item.number}</span>
            <h3 class="mt-2 font-serif text-lg font-semibold text-ink-950">{item.title}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-ink-700/75">{item.text}</p>
          </div>
        ))
      }
    </div>

    <div class="mx-auto mt-12 max-w-xl space-y-1.5 text-center">
      <p class="text-base leading-relaxed text-ink-700/75">Du musst nach diesen 15 Minuten nichts abschließen.</p>
      <p class="text-base font-medium text-ink-950">Du sollst danach einfach mehr Klarheit haben als vorher.</p>

      <div class="pt-6">
        <BookingButton location="benefits" variant="compact" label="Klarheit in 15 Minuten holen" />
        <p class="mt-3 text-sm text-ink-700/55">Termin online auswählen · Gespräch persönlich oder digital</p>
      </div>
    </div>
  </div>
</section>
