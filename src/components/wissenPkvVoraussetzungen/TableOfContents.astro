---
const entries = [
  { id: "pkv-voraussetzungen-im-ueberblick", label: "Die PKV-Voraussetzungen im Überblick" },
  { id: "voraussetzungen-angestellte", label: "Welche Voraussetzungen gelten für Angestellte?" },
  { id: "jaeg-vs-beitragsbemessungsgrenze", label: "Jahresarbeitsentgeltgrenze und Beitragsbemessungsgrenze sind nicht dasselbe" },
  { id: "einkuenfte-fuer-die-jaeg", label: "Welche Einkünfte zählen für die Jahresarbeitsentgeltgrenze?" },
  { id: "wann-wechseln-angestellte", label: "Wann kann ein Angestellter tatsächlich in die PKV wechseln?" },
  { id: "besondere-jaeg", label: "Gibt es eine besondere Jahresarbeitsentgeltgrenze?" },
  { id: "voraussetzungen-selbststaendige", label: "Welche Voraussetzungen gelten für Selbstständige?" },
  { id: "voraussetzungen-beamte", label: "Welche Voraussetzungen gelten für Beamte?" },
  { id: "studenten-pkv", label: "Können sich Studenten privat krankenversichern?" },
  { id: "reichen-gesetzliche-voraussetzungen", label: "Reicht es, die gesetzlichen Voraussetzungen zu erfüllen?" },
  { id: "rolle-gesundheitspruefung", label: "Welche Rolle spielt die Gesundheitsprüfung?" },
  { id: "hoechstalter-pkv", label: "Gibt es ein Höchstalter für die PKV?" },
  { id: "kinder-familienplanung", label: "Sind Kinder oder Familienplanung ein Hindernis für die PKV?" },
  { id: "haeufigste-missverstaendnisse", label: "Die häufigsten Missverständnisse bei den PKV-Voraussetzungen" },
  { id: "reihenfolge-vor-wechsel", label: "Meine Reihenfolge vor einem PKV-Wechsel" },
  { id: "fazit", label: "Fazit" },
  { id: "pkv-voraussetzungen-gemeinsam-pruefen", label: "PKV-Voraussetzungen gemeinsam prüfen" },
];
---

<section class="bg-white py-14">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <nav aria-label="Inhaltsverzeichnis" class="rounded-2xl border border-black/5 bg-brand-50/30 p-6 sm:p-8">
      <p class="text-xs font-semibold uppercase tracking-wide text-brand-600">Inhalt dieses Artikels</p>
      <ul class="mt-4 grid grid-cols-1 gap-x-8 gap-y-2.5 sm:grid-cols-2">
        {
          entries.map((entry, index) => (
            <li>
              <a
                href={`#${entry.id}`}
                class="group flex items-baseline gap-2.5 text-sm leading-relaxed text-ink-700/85 transition-colors duration-150 hover:text-brand-700"
              >
                <span class="tabular-nums text-xs font-semibold text-brand-400 group-hover:text-brand-600">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="underline decoration-transparent underline-offset-2 group-hover:decoration-brand-300">{entry.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</section>
