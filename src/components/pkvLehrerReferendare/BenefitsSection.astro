---
const pillars = [
  {
    number: "01",
    title: "Klarheit statt Tarifdschungel",
    text: [
      "Ich ordne die für dich infrage kommenden Lösungen und erkläre dir die Unterschiede bei Leistungen, Beiträgen und Bedingungen.",
      "Nicht mit einer endlosen Tarifliste, sondern mit einer nachvollziehbaren Gegenüberstellung.",
    ],
  },
  {
    number: "02",
    title: "Sorgfalt bei Gesundheitsfragen",
    text: [
      "Gesundheitsfragen gehören zu den wichtigsten Punkten beim PKV-Abschluss.",
      "Wir bereiten die erforderlichen Angaben strukturiert vor, prüfen bei Bedarf Unterlagen und besprechen, ob eine Risikovoranfrage sinnvoll ist.",
      "Damit du keine vorschnelle Entscheidung auf Grundlage unvollständiger Informationen treffen musst.",
    ],
  },
  {
    number: "03",
    title: "Persönliche Begleitung statt Abschlussdruck",
    text: [
      "Du bekommst eine verständliche Entscheidungsgrundlage und ausreichend Raum für deine Fragen.",
      "Wenn du dich für eine passende Lösung entscheidest, begleite ich dich bei der Antragstellung.",
      "Auch danach bleibe ich dein persönlicher Ansprechpartner.",
    ],
  },
];
---

<section id="leistungen" class="scroll-mt-20 bg-white py-16 sm:py-24">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <div data-reveal class="mx-auto max-w-2xl text-center">
      <h2 class="font-serif text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">Was du von meiner PKV-Beratung erwarten kannst</h2>
    </div>

    <div class="mx-auto mt-10 grid gap-5 sm:grid-cols-3">
      {
        pillars.map((p, i) => (
          <div data-reveal style={`transition-delay: ${i * 80}ms`} class="rounded-3xl border border-black/5 bg-brand-50/20 p-6 shadow-soft">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-ink-950 font-serif text-sm font-semibold text-white">{p.number}</span>
            <h3 class="mt-4 font-serif text-lg font-semibold text-ink-950">{p.title}</h3>
            <div class="mt-2 space-y-2.5 text-sm leading-relaxed text-ink-700/80">
              {p.text.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
