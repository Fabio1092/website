---
import RichParagraph from "@/components/RichParagraph.astro";

type Part = string | { b: string } | { a: string; href: string };

type Block =
  | { type: "p"; parts: Part[] }
  | { type: "standalone"; text: string }
  | { type: "quote"; text: string }
  | { type: "list"; items: string[] }
  | { type: "h3"; text: string }
  | { type: "table"; headers: string[]; rows: string[][] };

interface Section {
  id: string;
  heading: string;
  blocks: Block[];
}

const introBlocks: Block[] = [
  { type: "standalone", text: "Muss ich jetzt den Versicherer wechseln?" },
  { type: "p", parts: ["Nicht unbedingt."] },
  { type: "p", parts: ["Bevor du eine bestehende PKV kündigst, gibt es eine Möglichkeit, die viele Versicherte nicht ausreichend kennen:"] },
  { type: "standalone", text: "den internen Tarifwechsel nach § 204 Versicherungsvertragsgesetz." },
  { type: "p", parts: ["Dabei verlässt du deine Versicherungsgesellschaft nicht."] },
  { type: "p", parts: ["Stattdessen wechselst du innerhalb deines bestehenden Versicherers in einen anderen Tarif."] },
  {
    type: "p",
    parts: [
      "Das kann interessant sein, wenn dein heutiger Beitrag nicht mehr zu deiner Situation passt, wenn sich deine Anforderungen verändert haben oder wenn innerhalb deines Versicherers andere Tarifoptionen existieren.",
    ],
  },
  { type: "p", parts: ["Der große Unterschied zu einem kompletten Versichererwechsel:"] },
  { type: "standalone", text: "Deine bisher erworbenen Rechte und deine Alterungsrückstellungen werden beim internen Tarifwechsel berücksichtigt." },
  { type: "p", parts: ["Eine komplette neue Gesundheitsprüfung ist ebenfalls nicht automatisch notwendig."] },
  { type: "p", parts: ["Aber genau hier steckt der Teufel im Detail."] },
  {
    type: "p",
    parts: [
      "Denn sobald der neue Tarif bessere oder umfassendere Leistungen enthält, gelten andere Regeln. Und ein Tarif mit niedrigerem Beitrag kann gleichzeitig an wichtigen Stellen schlechtere Leistungen haben.",
    ],
  },
  { type: "p", parts: ["Deshalb sollte die Frage nicht lauten:"] },
  { type: "standalone", text: "„Welcher Tarif ist am billigsten?“" },
  { type: "p", parts: ["Sondern:"] },
  { type: "standalone", text: "„Welcher Tarif verbessert meine Situation, ohne dass ich dafür an der falschen Stelle Versicherungsschutz aufgebe?“" },
];

