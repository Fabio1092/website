  {
    id: "neuer-tarif-automatisch-besser",
    heading: "Ist ein neuer Tarif automatisch besser kalkuliert?",
    blocks: [
      { type: "p", parts: ["Nein."] },
      { type: "p", parts: ["Das würde ich niemals pauschal behaupten."] },
      { type: "p", parts: ["Ein neuer Tarif kann interessante Leistungen oder eine andere Tarifstruktur haben."] },
      { type: "p", parts: ["Aber:"] },
      { type: "standalone", text: "„Neu“ bedeutet nicht automatisch „langfristig beitragsstabil“." },
      { type: "p", parts: ["Genauso ist ein älterer Tarif nicht automatisch schlecht."] },
      { type: "p", parts: ["Die bisherige Beitragsentwicklung kann ein Analysepunkt sein."] },
      { type: "p", parts: ["Sie ist aber keine Garantie für die Zukunft."] },
      { type: "p", parts: ["Deshalb sollten weder Tarifalter noch ein besonders niedriger aktueller Beitrag allein über einen Wechsel entscheiden."] },
    ],
  },
  {
    id: "bisex-unisex-wechsel",
    heading: "Besonderheit: Wechsel von Bisex zu Unisex",
    blocks: [
      { type: "p", parts: ["Für Versicherte mit älteren Verträgen kann dieser Punkt relevant sein."] },
      { type: "p", parts: ["Alte PKV-Tarife wurden teilweise noch geschlechtsabhängig kalkuliert."] },
      { type: "p", parts: ["Spätere Tarife sind als sogenannte Unisex-Tarife kalkuliert."] },
      { type: "p", parts: ["Ein Wechsel von einem alten Bisex-Tarif in einen Unisex-Tarif sollte besonders sorgfältig geprüft werden."] },
      { type: "p", parts: ["Denn ein späterer Wechsel zurück in die alte Bisex-Tarifwelt ist rechtlich grundsätzlich nicht mehr möglich."] },
      { type: "p", parts: ["Das heißt nicht:"] },
      { type: "standalone", text: "„Nie in Unisex wechseln.“" },
      { type: "p", parts: ["Es heißt:"] },
      { type: "standalone", text: "Vorher die Konsequenzen kennen." },
    ],
  },
  {
    id: "ablauf-in-sechs-schritten",
    heading: "Wie läuft ein Tarifwechsel nach § 204 VVG praktisch ab?",
    blocks: [
      { type: "p", parts: ["Ich würde den Prozess in sechs Schritte teilen."] },
      { type: "h3", text: "1. Bestehenden Tarif analysieren" },
      { type: "p", parts: ["Zuerst muss klar sein:"] },
      { type: "p", parts: ["Was hast du aktuell überhaupt versichert?"] },
      { type: "p", parts: ["Nicht nur der Beitrag zählt."] },
      { type: "p", parts: ["Die Bedingungen sind die Ausgangsbasis."] },
      { type: "h3", text: "2. Ziel definieren" },
      { type: "p", parts: ["Was möchtest du erreichen?"] },
      { type: "p", parts: ["Zum Beispiel:"] },
      {
        type: "list",
        items: ["Beitrag reduzieren", "Selbstbehalt verändern", "Leistungen verbessern", "Tarifstruktur modernisieren", "Versicherung im Ruhestand tragfähiger gestalten"],
      },
      { type: "h3", text: "3. Tarifalternativen innerhalb des Versicherers prüfen" },
      { type: "p", parts: ["Jetzt werden die relevanten Zieltarife derselben Gesellschaft betrachtet."] },
      { type: "h3", text: "4. Leistungen gegenüberstellen" },
      { type: "p", parts: ["Hier sollten Mehr- und Minderleistungen transparent sichtbar werden."] },
      { type: "h3", text: "5. Gesundheitsprüfung nur bei notwendigen Mehrleistungen prüfen" },
      { type: "p", parts: ["Enthält der Zieltarif Mehrleistungen, sollte vor einer endgültigen Entscheidung geklärt werden:"] },
      {
        type: "list",
        items: [
          "Welche Leistungen gelten konkret als Mehrleistung?",
          "Für welche davon verlangt der Versicherer Gesundheitsangaben?",
          "Gibt es einen Risikozuschlag?",
          "Gibt es einen Leistungsausschluss?",
          "Kann auf die Mehrleistung verzichtet werden?",
        ],
      },
      { type: "h3", text: "6. Erst danach Tarifwechsel erklären" },
      { type: "p", parts: ["Nicht umgekehrt."] },
      { type: "p", parts: ["Erst wenn Beitrag, Leistung und mögliche Risikoprüfung geklärt sind, würde ich die tatsächliche Umstellung durchführen."] },
    ],
  },
  {
    id: "drei-typische-situationen",
    heading: "Drei typische Tarifwechsel-Situationen",
    blocks: [
      { type: "h3", text: "Beispiel 1: Ähnliches Leistungsniveau, niedrigerer Beitrag" },
      { type: "p", parts: ["Dein bestehender Tarif ist deutlich teurer geworden."] },
      { type: "p", parts: ["Ein anderer Tarif derselben Gesellschaft bietet ein vergleichbares Leistungsniveau zu einem niedrigeren Beitrag."] },
      { type: "p", parts: ["Enthält der Zieltarif keine relevanten Mehrleistungen, kann ein solcher Wechsel sehr interessant sein."] },
      {
        type: "p",
        parts: [{ b: "Meine Einschätzung:" }, " Genau prüfen. Das ist der klassische Fall, in dem § 204 VVG einen großen Vorteil bieten kann."],
      },
      { type: "h3", text: "Beispiel 2: Niedrigerer Beitrag durch deutlichen Leistungsabbau" },
      { type: "p", parts: ["Du kannst 200 Euro monatlich sparen."] },
      { type: "p", parts: ["Dafür verschlechterst du aber mehrere wichtige Leistungen."] },
      {
        type: "p",
        parts: [
          { b: "Meine Einschätzung:" },
          " Nicht allein wegen der Ersparnis wechseln. Prüfe zuerst, welche Rechte du später möglicherweise nur noch mit Gesundheitsprüfung zurückbekommst.",
        ],
      },
      { type: "h3", text: "Beispiel 3: Neuer Tarif mit besseren Leistungen" },
      { type: "p", parts: ["Der neue Tarif ist attraktiv und bietet an mehreren Stellen besseren Schutz."] },
      {
        type: "p",
        parts: [{ b: "Meine Einschätzung:" }, " Gute Option, aber Mehrleistungen identifizieren und vor dem Wechsel klären, welche Gesundheitsprüfung dafür erforderlich ist."],
      },
    ],
  },
  {
    id: "kosten-des-tarifwechsels",
    heading: "Was kostet ein Tarifwechsel nach § 204 VVG?",
    blocks: [
      { type: "p", parts: ["Das gesetzliche Tarifwechselrecht selbst ist kein Neuabschluss bei einer neuen Versicherungsgesellschaft."] },
      { type: "p", parts: ["Wenn du deinen Versicherer direkt zu Tarifalternativen befragst, entstehen nicht automatisch Kosten für einen externen Tarifwechselberater."] },
      { type: "p", parts: ["Externe Berater oder spezialisierte Dienstleister können dagegen unterschiedliche Vergütungsmodelle haben."] },
      { type: "p", parts: ["Zum Beispiel:"] },
      { type: "list", items: ["feste Beratungsgebühr", "Honorar", "erfolgsabhängige Vergütung", "Beteiligung an der Beitragsersparnis"] },
      { type: "p", parts: ["Wenn du externe Unterstützung nutzt, würde ich deshalb vorab klären:"] },
      { type: "standalone", text: "Was kostet die Beratung insgesamt und wofür genau bezahlst du?" },
    ],
  },
  {
    id: "wichtigster-rat",
    heading: "Mein wichtigster Rat beim PKV-Tarifwechsel",
    blocks: [
      { type: "p", parts: ["Optimiere nicht deinen Beitrag."] },
      { type: "standalone", text: "Optimiere das Verhältnis aus Beitrag und Versicherungsschutz." },
      { type: "p", parts: ["Das ist ein großer Unterschied."] },
      { type: "p", parts: ["Eine PKV soll dich nicht nur in den nächsten zwölf Monaten begleiten."] },
      { type: "p", parts: ["Im besten Fall begleitet sie dich über Jahrzehnte."] },
      { type: "p", parts: ["Wenn du heute 150 Euro sparst, dafür aber langfristig relevante Leistungen aufgibst, kann das eine schlechte Entscheidung sein."] },
      {
        type: "p",
        parts: [
          "Wenn du dagegen innerhalb deiner Gesellschaft einen Tarif findest, der deine gewünschten Leistungen sinnvoll abbildet und gleichzeitig wirtschaftlich attraktiver ist, kann § 204 VVG ein sehr wertvolles Instrument sein.",
        ],
      },
    ],
  },
  {
    id: "checkliste",
    heading: "Checkliste: Das würde ich vor einem Tarifwechsel prüfen",
    blocks: [
      {
        type: "list",
        items: [
          "1. Wie hoch ist mein aktueller Beitrag?",
          "2. Welche Leistungen habe ich heute?",
          "3. Welche Tarife stehen innerhalb meines Versicherers zur Verfügung?",
          "4. Wie unterscheiden sich die Leistungen?",
          "5. Welche Leistungen verliere ich?",
          "6. Welche Leistungen kommen hinzu?",
          "7. Gibt es Mehrleistungen mit Gesundheitsprüfung?",
          "8. Ändert sich mein Selbstbehalt?",
          "9. Gibt es neue Leistungsausschlüsse oder Risikozuschläge?",
          "10. Wie hoch ist die tatsächliche Beitragsersparnis?",
          "11. Wie sieht die bisherige Beitragsentwicklung der Tarife aus?",
          "12. Wechsle ich von Bisex zu Unisex?",
          "13. Kann ich später problemlos wieder auf ein höheres Leistungsniveau wechseln?",
          "14. Passt der neue Tarif auch langfristig zu meiner Situation?",
        ],
      },
      { type: "p", parts: ["Erst wenn diese Fragen beantwortet sind, würde ich eine Entscheidung treffen."] },
    ],
  },
];
---

<div class="mx-auto max-w-3xl space-y-20 px-4 py-16 sm:px-6 lg:px-8">
  <div data-reveal class="space-y-4">
    {
      introBlocks.map((block) => {
        if (block.type === "p") return <RichParagraph parts={block.parts} />;
        if (block.type === "standalone") return <p class="text-base font-medium leading-relaxed text-ink-950">{block.text}</p>;
        return null;
      })
    }
  </div>

  {
    sections.map((section) => (
      <section id={section.id} class="scroll-mt-24">
        <h2 class="font-serif text-2xl font-semibold tracking-tight text-ink-950 sm:text-3xl">{section.heading}</h2>
        <div data-reveal class="mt-6 space-y-4">
          {section.blocks.map((block) => {
            if (block.type === "p") return <RichParagraph parts={block.parts} />;
            if (block.type === "standalone") return <p class="text-base font-medium leading-relaxed text-ink-950">{block.text}</p>;
            if (block.type === "quote")
              return (
                <blockquote class="border-l-2 border-brand-200 pl-5">
                  <p class="font-serif text-lg italic leading-relaxed text-ink-950">{block.text}</p>
                </blockquote>
              );
            if (block.type === "list")
              return (
                <ul class="space-y-2">
                  {block.items.map((item) => (
                    <li class="flex items-baseline gap-2.5 text-base leading-relaxed text-ink-700/85">
                      <span class="h-1.5 w-1.5 shrink-0 translate-y-[-2px] rounded-full bg-brand-400" aria-hidden="true" />
                      {item}
                    </li>
                  ))}
                </ul>
              );
            if (block.type === "h3") return <h3 class="!mt-10 font-serif text-xl font-semibold text-ink-950">{block.text}</h3>;
            if (block.type === "table")
              return (
                <div class="overflow-x-auto rounded-xl border border-black/5">
                  <table class="w-full min-w-[560px] border-collapse text-left text-sm">
                    <thead>
                      <tr class="bg-brand-50/60">
                        {block.headers.map((h) => (
                          <th class="px-4 py-3 font-semibold text-ink-950">{h}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-black/5 bg-white">
                      {block.rows.map((row) => (
                        <tr>
                          {row.map((cell, i) => (
                            <td class={i === 0 ? "px-4 py-3 font-medium text-ink-950" : "px-4 py-3 text-ink-700/80"}>{cell}</td>
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              );
            return null;
          })}
        </div>
      </section>
    ))
  }
</div>
