---
const entries = [
  { id: "wichtigstes-in-kuerze", label: "Das Wichtigste zur Rückkehr von der PKV in die GKV" },
  { id: "warum-nicht-einfach-freiwillig", label: "Warum kann ich nicht einfach freiwillig in die GKV zurück?" },
  { id: "moeglichkeit-1-arbeitnehmer", label: "Möglichkeit 1: Als Arbeitnehmer wieder versicherungspflichtig werden" },
  { id: "einkommen-unter-jaeg", label: "Wie kann das Einkommen unter die JAEG fallen?" },
  { id: "beispiel-vollzeit-teilzeit", label: "Beispiel: Wechsel von Vollzeit auf Teilzeit" },
  { id: "jaeg-steigt", label: "Was passiert, wenn nur die JAEG steigt?" },
  { id: "moeglichkeit-2-arbeitslosengeld", label: "Möglichkeit 2: Rückkehr über Arbeitslosengeld" },
  { id: "trotz-alg-privat-bleiben", label: "Kann ich trotz Arbeitslosengeld privat versichert bleiben?" },
  { id: "buergergeld-grundsicherung", label: "Bürgergeld beziehungsweise Grundsicherung: Komme ich dadurch zurück?" },
  { id: "moeglichkeit-3-selbststaendiger-zum-arbeitnehmer", label: "Möglichkeit 3: Vom Selbstständigen zum Arbeitnehmer" },
  { id: "beispiel-selbststaendigkeit-aufgegeben", label: "Beispiel: Selbstständigkeit wird aufgegeben" },
  { id: "kleine-teilzeitstelle", label: "Reicht eine kleine Teilzeitstelle neben der Selbstständigkeit?" },
  { id: "moeglichkeit-4-familienversicherung", label: "Möglichkeit 4: Familienversicherung" },
  { id: "rueckkehr-ab-55", label: "Die wichtigste Grenze: Rückkehr ab 55" },
  { id: "beispiel-58-jahre", label: "Beispiel: 58 Jahre und seit vielen Jahren privat versichert" },
  { id: "55-geburtstag-fuer-immer-pkv", label: "Bedeutet der 55. Geburtstag automatisch „für immer PKV“?" },
  { id: "ausland-trick", label: "Kann ich kurz ins Ausland gehen und danach wieder in die GKV?" },
  { id: "alterungsrueckstellungen", label: "Was passiert mit meinen PKV-Alterungsrückstellungen?" },
  { id: "pkv-parallel-behalten", label: "Kann ich meine PKV einfach parallel behalten?" },
  { id: "sonderkuendigungsrecht", label: "Sonderkündigungsrecht der PKV bei neuer Versicherungspflicht" },
  { id: "welche-krankenkasse-waehlen", label: "Welche gesetzliche Krankenkasse kann ich wählen?" },
  { id: "pflegeversicherung", label: "Was passiert mit der Pflegeversicherung?" },
  { id: "was-kostet-die-gkv", label: "Was kostet die GKV nach der Rückkehr?" },
  { id: "finanziell-sinnvoll", label: "Ist die Rückkehr in die GKV automatisch finanziell sinnvoll?" },
  { id: "beitrag-zu-hoch", label: "PKV-Beitrag zu hoch: Muss ich unbedingt zurück in die GKV?" },
  { id: "nicht-nur-nach-beitrag-entscheiden", label: "GKV oder PKV: Nicht nur nach dem Beitrag entscheiden" },
  { id: "drei-typische-situationen", label: "Drei typische Situationen" },
  { id: "typische-fehler", label: "Welche Fehler würde ich vermeiden?" },
  { id: "checkliste", label: "Meine Checkliste: Zurück von der PKV in die GKV" },
  { id: "fazit", label: "Fazit: Wie komme ich von der PKV zurück in die GKV?" },
  { id: "rueckkehr-sauber-pruefen", label: "Rückkehr in die GKV sauber prüfen" },
];
---

<section class="bg-white py-14">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <nav aria-label="Inhaltsverzeichnis" class="rounded-2xl border border-black/5 bg-brand-50/30 p-6 sm:p-8">
      <p class="text-xs font-semibold uppercase tracking-wide text-brand-600">Inhalt dieses Artikels</p>
      <ul class="mt-4 grid grid-cols-1 gap-x-8 gap-y-2.5 sm:grid-cols-2">
        {
          entries.map((entry, index) => (
            <li>
              <a
                href={`#${entry.id}`}
                class="group flex items-baseline gap-2.5 text-sm leading-relaxed text-ink-700/85 transition-colors duration-150 hover:text-brand-700"
              >
                <span class="tabular-nums text-xs font-semibold text-brand-400 group-hover:text-brand-600">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="underline decoration-transparent underline-offset-2 group-hover:decoration-brand-300">{entry.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</section>
