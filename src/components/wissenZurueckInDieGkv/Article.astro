    blocks: [
      { type: "p", parts: ["Wenn erneut Versicherungspflicht entsteht, kannst du grundsätzlich eine wählbare gesetzliche Krankenkasse auswählen."] },
      { type: "p", parts: ["Dazu gehören je nach Voraussetzungen beispielsweise:"] },
      { type: "list", items: ["AOK am Wohn- oder Beschäftigungsort", "Ersatzkassen", "geöffnete Betriebskrankenkassen", "geöffnete Innungskrankenkassen"] },
      { type: "p", parts: ["Die gesundheitliche Vorgeschichte spielt bei der Aufnahme in die GKV grundsätzlich keine Rolle."] },
      { type: "p", parts: ["Gesetzliche Krankenkassen müssen Personen aufnehmen, wenn die gesetzlichen Voraussetzungen erfüllt sind."] },
    ],
  },
  {
    id: "pflegeversicherung",
    heading: "Was passiert mit der Pflegeversicherung?",
    blocks: [
      { type: "p", parts: ["Kranken- und Pflegeversicherung gehören grundsätzlich zusammen."] },
      { type: "p", parts: ["Wer gesetzlich krankenversichert ist, ist regelmäßig automatisch auch in der sozialen Pflegeversicherung versichert."] },
      { type: "p", parts: ["Beim Wechsel zurück in die GKV muss deshalb auch die bisherige private Pflegepflichtversicherung entsprechend beendet beziehungsweise umgestellt werden."] },
      { type: "p", parts: ["Auch hier sollte der Versicherungswechsel zeitlich sauber koordiniert werden."] },
    ],
  },
  {
    id: "was-kostet-die-gkv",
    heading: "Was kostet die GKV nach der Rückkehr?",
    blocks: [
      { type: "p", parts: ["Das hängt von deiner Situation ab."] },
      { type: "p", parts: ["Als Arbeitnehmer werden die Beiträge grundsätzlich einkommensabhängig erhoben."] },
      { type: "p", parts: ["2026 beträgt der allgemeine GKV-Beitragssatz:"] },
      { type: "standalone", text: "14,6 Prozent." },
      { type: "p", parts: ["Hinzu kommt der Zusatzbeitrag der jeweiligen Krankenkasse."] },
      { type: "p", parts: ["Arbeitgeber und Arbeitnehmer teilen sich die Beiträge aus dem Arbeitsentgelt grundsätzlich jeweils zur Hälfte."] },
      { type: "p", parts: ["Die Beitragsbemessung funktioniert damit vollkommen anders als in der PKV."] },
      { type: "p", parts: ["In der PKV hängt dein Beitrag nicht unmittelbar von deinem Einkommen ab."] },
      { type: "p", parts: ["In der GKV dagegen sehr wohl."] },
    ],
  },
  {
    id: "finanziell-sinnvoll",
    heading: "Ist die Rückkehr in die GKV automatisch finanziell sinnvoll?",
    blocks: [
      { type: "p", parts: ["Nein."] },
      { type: "p", parts: ["Nur weil du zurückkehren ", { b: "kannst" }, ", bedeutet das noch nicht automatisch, dass es die beste Entscheidung ist."] },
      { type: "p", parts: ["Ich würde unter anderem vergleichen:"] },
      {
        type: "list",
        items: [
          "heutiger PKV-Beitrag",
          "zukünftiger GKV-Beitrag",
          "Selbstbehalt",
          "Arbeitgeberanteil",
          "Leistungsunterschiede",
          "Familienversicherung",
          "Einkünfte heute und im Ruhestand",
          "Alterungsrückstellungen",
          "private Zusatzversicherungen",
          "langfristige Lebensplanung",
        ],
      },
      { type: "p", parts: ["Gerade bei einem niedrigeren Einkommen kann die GKV finanziell attraktiv werden."] },
      { type: "p", parts: ["Bei hohen späteren beitragspflichtigen Einkünften kann die Betrachtung anders aussehen."] },
      { type: "p", parts: ["Deshalb sollte die Entscheidung nicht ausschließlich aufgrund einer aktuellen PKV-Beitragserhöhung getroffen werden."] },
      {
        type: "p",
        parts: [
          "Mehr zum langfristigen Thema findest du unter ",
          { a: "PKV Beitragsentwicklung: Wie stark steigen die Beiträge?", href: "/wissen/private-krankenversicherung/pkv-beitragsentwicklung/" },
          ".",
        ],
      },
    ],
  },
  {
    id: "beitrag-zu-hoch",
    heading: "PKV-Beitrag zu hoch: Muss ich unbedingt zurück in die GKV?",
    blocks: [
      { type: "p", parts: ["Nein."] },
      {
        type: "p",
        parts: ["Wenn der eigentliche Grund für deinen Rückkehrwunsch ein hoher PKV-Beitrag ist, würde ich zusätzlich prüfen, welche Möglichkeiten ", { b: "innerhalb der PKV" }, " bestehen."],
      },
      { type: "p", parts: ["Eine Möglichkeit kann ein interner Tarifwechsel nach § 204 VVG sein."] },
      { type: "p", parts: ["Dabei bleibst du bei deiner Gesellschaft und kannst andere Tarife prüfen lassen."] },
      {
        type: "p",
        parts: ["Mehr dazu findest du unter ", { a: "PKV Tarifwechsel nach § 204 VVG", href: "/wissen/private-krankenversicherung/pkv-tarifwechsel/" }, "."],
      },
      { type: "p", parts: ["Gerade wenn eine GKV-Rückkehr rechtlich nicht mehr möglich oder wirtschaftlich gar nicht notwendig ist, kann das eine sinnvolle Alternative sein."] },
    ],
  },
  {
    id: "nicht-nur-nach-beitrag-entscheiden",
    heading: "GKV oder PKV: Nicht nur nach dem Beitrag entscheiden",
    blocks: [
      { type: "p", parts: ["Ein Wechsel zurück verändert nicht nur deinen Versicherungsbeitrag."] },
      { type: "p", parts: ["Du wechselst auch das Versicherungssystem."] },
      { type: "p", parts: ["In der PKV basiert dein Versicherungsschutz auf deinem Vertrag."] },
      { type: "p", parts: ["In der GKV richtet sich der Leistungsanspruch grundsätzlich nach dem gesetzlichen Leistungskatalog."] },
      { type: "p", parts: ["Auch Familienversicherung, Beitragsberechnung und Finanzierung funktionieren unterschiedlich."] },
      { type: "p", parts: ["Deshalb würde ich nicht nur fragen:"] },
      { type: "standalone", text: "„Wo zahle ich heute weniger?“" },
      { type: "p", parts: ["Sondern:"] },
      { type: "standalone", text: "„Welches System passt ab jetzt besser zu meiner gesamten Lebenssituation?“" },
      {
        type: "p",
        parts: ["Den ausführlichen Vergleich findest du unter ", { a: "GKV oder PKV?", href: "/wissen/private-krankenversicherung/gkv-oder-pkv/" }, "."],
      },
    ],
  },
  {
    id: "drei-typische-situationen",
    heading: "Drei typische Situationen",
    blocks: [
      { type: "h3", text: "Beispiel 1: Arbeitnehmer unter 55 reduziert dauerhaft sein Einkommen" },
      { type: "p", parts: ["Du bist 47 Jahre alt und privat versichert."] },
      { type: "p", parts: ["Dein Gehalt liegt bisher deutlich über der JAEG."] },
      { type: "p", parts: ["Durch einen Jobwechsel liegt dein regelmäßiges Jahresarbeitsentgelt künftig unter der Grenze."] },
      { type: "p", parts: ["Wenn keine besondere Ausnahme oder Befreiung greift, entsteht grundsätzlich wieder Versicherungspflicht."] },
      { type: "p", parts: [{ b: "Meine Einschätzung:" }, " Das ist einer der klassischen Rückkehrwege in die GKV."] },
      { type: "h3", text: "Beispiel 2: Selbstständiger wechselt vollständig in eine Beschäftigung" },
      { type: "p", parts: ["Du bist 50 Jahre alt und hauptberuflich selbstständig."] },
      { type: "p", parts: ["Du beendest deine Selbstständigkeit und nimmst eine sozialversicherungspflichtige Beschäftigung unterhalb der JAEG auf."] },
      { type: "p", parts: [{ b: "Meine Einschätzung:" }, " Auch hier kann grundsätzlich wieder GKV-Versicherungspflicht entstehen."] },
      { type: "p", parts: ["Wird die Selbstständigkeit dagegen weiterhin hauptberuflich ausgeübt, sieht die Situation anders aus."] },
      { type: "h3", text: "Beispiel 3: 59-jähriger langjährig Privatversicherter" },
      { type: "p", parts: ["Du bist 59 und seit vielen Jahren privat versichert."] },
      { type: "p", parts: ["Jetzt möchtest du dein Einkommen unter die JAEG reduzieren."] },
      { type: "p", parts: ["Wenn die Voraussetzungen des § 6 Abs. 3a SGB V erfüllt sind, entsteht trotz der Einkommensreduzierung keine GKV-Pflicht."] },
      {
        type: "p",
        parts: [{ b: "Meine Einschätzung:" }, " Genau hier zeigt sich, warum eine individuelle Prüfung der letzten fünf Jahre zwingend notwendig ist."],
      },
    ],
  },
  {
    id: "typische-fehler",
    heading: "Welche Fehler würde ich vermeiden?",
    blocks: [
      { type: "h3", text: "Fehler 1: Erst PKV kündigen und dann GKV prüfen" },
      { type: "p", parts: ["Falsche Reihenfolge."] },
      { type: "p", parts: ["Erst muss klar sein, dass tatsächlich GKV-Zugang besteht."] },
      { type: "h3", text: "Fehler 2: Glauben, unter 55 sei die Rückkehr immer möglich" },
      { type: "p", parts: ["Auch unter 55 braucht es einen gesetzlichen Zugang zur GKV."] },
      { type: "p", parts: ["Das Alter allein reicht nicht."] },
      { type: "h3", text: "Fehler 3: Glauben, ab 55 sei es ausnahmslos unmöglich" },
      { type: "p", parts: ["Auch das ist zu pauschal."] },
      { type: "p", parts: ["Die gesetzliche Regel hängt zusätzlich von den letzten fünf Jahren ab."] },
      { type: "h3", text: "Fehler 4: Eine nebenberufliche Anstellung bei weiterhin hauptberuflicher Selbstständigkeit überschätzen" },
      { type: "p", parts: ["Dann entsteht möglicherweise gerade keine Versicherungspflicht."] },
      { type: "h3", text: "Fehler 5: Arbeitslosengeld mit Bürgergeld beziehungsweise Grundsicherung gleichsetzen" },
      { type: "p", parts: ["Die versicherungsrechtlichen Folgen können unterschiedlich sein."] },
      { type: "h3", text: "Fehler 6: Sofort eine Befreiung von der Versicherungspflicht beantragen" },
      { type: "p", parts: ["Eine Befreiung kann genau die Rückkehr verhindern, die du eigentlich möchtest."] },
      { type: "h3", text: "Fehler 7: Nur auf den heutigen Beitrag schauen" },
      { type: "p", parts: ["Die Entscheidung betrifft Leistungen, Alterungsrückstellungen und deine langfristige Versicherungsbiografie."] },
    ],
  },
  {
    id: "checkliste",
    heading: "Meine Checkliste: Zurück von der PKV in die GKV",
    blocks: [
      { type: "p", parts: ["Bevor du irgendetwas kündigst, würde ich folgende Punkte klären:"] },
      {
        type: "list",
        items: [
          "1. Wie alt bist du?",
          "2. Wie warst du in den vergangenen fünf Jahren krankenversichert?",
          "3. Warum bist du aktuell versicherungsfrei?",
          "4. Bist du Arbeitnehmer, Selbstständiger oder arbeitslos?",
          "5. Entsteht durch eine Veränderung tatsächlich Versicherungspflicht?",
          "6. Liegt dein regelmäßiges Jahresarbeitsentgelt unter der maßgeblichen JAEG?",
          "7. Besteht weiterhin eine hauptberufliche Selbstständigkeit?",
          "8. Greift § 6 Abs. 3a SGB V wegen Vollendung des 55. Lebensjahres?",
          "9. Wurde irgendwann eine Befreiung von der Versicherungspflicht ausgesprochen?",
          "10. Besteht möglicherweise Anspruch auf Familienversicherung?",
          "11. Ab welchem Datum beginnt die GKV-Mitgliedschaft?",
          "12. Welche gesetzliche Krankenkasse möchtest du wählen?",
          "13. Ist die Pflichtversicherung schriftlich bestätigt?",
          "14. Wann kann die PKV beendet werden?",
          "15. Möchtest du einzelne PKV-Leistungen als Zusatzversicherung erhalten?",
          "16. Was passiert mit deiner privaten Pflegepflichtversicherung?",
          "17. Wie verändert sich deine tatsächliche Gesamtbelastung nach dem Wechsel?",
        ],
      },
      { type: "p", parts: ["Erst danach würde ich die PKV tatsächlich beenden."] },
    ],
  },
];
---

<div class="mx-auto max-w-3xl space-y-20 px-4 py-16 sm:px-6 lg:px-8">
  <div data-reveal class="space-y-4">
    {
      introBlocks.map((block) => {
        if (block.type === "p") return <RichParagraph parts={block.parts} />;
        if (block.type === "standalone") return <p class="text-base font-medium leading-relaxed text-ink-950">{block.text}</p>;
        return null;
      })
    }
  </div>

  {
    sections.map((section) => (
      <section id={section.id} class="scroll-mt-24">
        <h2 class="font-serif text-2xl font-semibold tracking-tight text-ink-950 sm:text-3xl">{section.heading}</h2>
        <div data-reveal class="mt-6 space-y-4">
          {section.blocks.map((block) => {
            if (block.type === "p") return <RichParagraph parts={block.parts} />;
            if (block.type === "standalone") return <p class="text-base font-medium leading-relaxed text-ink-950">{block.text}</p>;
            if (block.type === "quote")
              return (
                <blockquote class="border-l-2 border-brand-200 pl-5">
                  <p class="font-serif text-lg italic leading-relaxed text-ink-950">{block.text}</p>
                </blockquote>
              );
            if (block.type === "list")
              return (
                <ul class="space-y-2">
                  {block.items.map((item) => (
                    <li class="flex items-baseline gap-2.5 text-base leading-relaxed text-ink-700/85">
                      <span class="h-1.5 w-1.5 shrink-0 translate-y-[-2px] rounded-full bg-brand-400" aria-hidden="true" />
                      {item}
                    </li>
                  ))}
                </ul>
              );
            if (block.type === "h3") return <h3 class="!mt-10 font-serif text-xl font-semibold text-ink-950">{block.text}</h3>;
            if (block.type === "table")
              return (
                <div class="overflow-x-auto rounded-xl border border-black/5">
                  <table class="w-full min-w-[560px] border-collapse text-left text-sm">
                    <thead>
                      <tr class="bg-brand-50/60">
                        {block.headers.map((h) => (
                          <th class="px-4 py-3 font-semibold text-ink-950">{h}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-black/5 bg-white">
                      {block.rows.map((row) => (
                        <tr>
                          {row.map((cell, i) => (
                            <td class={i === 0 ? "px-4 py-3 font-medium text-ink-950" : "px-4 py-3 text-ink-700/80"}>{cell}</td>
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              );
            return null;
          })}
        </div>
      </section>
    ))
  }
</div>
