  { type: "standalone", text: "„Wie kündige ich meine PKV?“" },
  { type: "p", parts: ["Sondern:"] },
  { type: "standalone", text: "„Welcher gesetzliche Tatbestand würde mich überhaupt wieder versicherungspflichtig in der GKV machen?“" },
