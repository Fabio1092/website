---
import RichParagraph from "@/components/RichParagraph.astro";

type Part = string | { b: string } | { a: string; href: string };

type Block =
  | { type: "p"; parts: Part[] }
  | { type: "standalone"; text: string }
  | { type: "quote"; text: string }
  | { type: "list"; items: string[] }
  | { type: "h3"; text: string }
  | { type: "table"; headers: string[]; rows: string[][] };

interface Section {
  id: string;
  heading: string;
  blocks: Block[];
}

const introBlocks: Block[] = [
  { type: "p", parts: ["Dann ist der wichtigste Punkt direkt am Anfang:"] },
  { type: "standalone", text: "Du kannst die PKV nicht einfach kündigen und dich anschließend freiwillig bei einer gesetzlichen Krankenkasse anmelden." },
  {
    type: "p",
    parts: ["Der Wechsel zurück funktioniert grundsätzlich nur dann, wenn du die gesetzlichen Voraussetzungen für eine Mitgliedschaft in der GKV erfüllst."],
  },
  { type: "p", parts: ["In der Praxis bedeutet das häufig:"] },
  { type: "standalone", text: "Es muss erneut Versicherungspflicht entstehen." },
  {
    type: "p",
    parts: ["Das kann beispielsweise passieren, wenn ein privat versicherter Arbeitnehmer mit seinem regelmäßigen Jahresarbeitsentgelt unter die maßgebliche Jahresarbeitsentgeltgrenze fällt."],
