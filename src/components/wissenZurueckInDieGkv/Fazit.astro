---
import RichParagraph from "@/components/RichParagraph.astro";

const sources = [
  "Sozialgesetzbuch V (SGB V) § 5 – Versicherungspflicht",
  "Sozialgesetzbuch V (SGB V) § 6 – Versicherungsfreiheit (insbesondere § 6 Abs. 3a)",
  "Sozialgesetzbuch V (SGB V) § 8 – Befreiung von der Versicherungspflicht",
  "Sozialgesetzbuch V (SGB V) § 10 – Familienversicherung",
  "Bundesministerium für Gesundheit: Wechsel zwischen GKV und PKV",
  "Bundesministerium für Gesundheit: Informationen zur privaten Krankenversicherung",
  "Bundesministerium für Gesundheit: Familienversicherung, Pflegeversicherung und Beiträge",
];
---

<section id="fazit" class="scroll-mt-24 bg-white py-16">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <h2 class="font-serif text-2xl font-semibold tracking-tight text-ink-950 sm:text-3xl">
      Fazit: Wie komme ich von der PKV zurück in die GKV?
    </h2>

    <div data-reveal class="mt-6 space-y-4">
      <RichParagraph parts={["Der entscheidende Punkt lautet:"]} />

      <div class="rounded-2xl border border-brand-200 bg-brand-50/50 px-6 py-5">
        <p class="font-serif text-lg font-medium leading-relaxed text-ink-950">
          Du wechselst nicht zurück in die GKV, weil du das möchtest – sondern weil du wieder die gesetzlichen
          Voraussetzungen erfüllst.
        </p>
      </div>

      <RichParagraph
        parts={["Für Arbeitnehmer unter 55 kann eine neue Versicherungspflicht beispielsweise entstehen, wenn das regelmäßige Jahresarbeitsentgelt unter die JAEG fällt."]}
      />
      <RichParagraph
        parts={["Auch Arbeitslosengeld oder ein Wechsel von hauptberuflicher Selbstständigkeit in eine versicherungspflichtige Beschäftigung können relevant sein."]}
      />
      <RichParagraph parts={["Ab 55 gelten dagegen erhebliche zusätzliche Hürden."]} />
      <RichParagraph parts={["Die gute Nachricht:"]} />
      <RichParagraph
        parts={["Wenn tatsächlich Versicherungspflicht entsteht und keine gesetzliche Ausnahme greift, kannst du grundsätzlich wieder in die GKV zurückkehren."]}
      />
      <RichParagraph parts={["Die schlechte Nachricht:"]} />
      <p class="text-base font-medium leading-relaxed text-ink-950">Es gibt keinen universellen Trick, der für jeden funktioniert.</p>
      <RichParagraph
        parts={["Deshalb würde ich zuerst deine Versicherungsbiografie und deine aktuelle Situation prüfen – und erst danach über Kündigung oder Systemwechsel sprechen."]}
      />
    </div>
  </div>
</section>

<section id="rueckkehr-sauber-pruefen" class="scroll-mt-24 bg-brand-50/30 py-16">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <h2 class="font-serif text-2xl font-semibold tracking-tight text-ink-950 sm:text-3xl">
      Rückkehr in die GKV sauber prüfen
    </h2>

    <div data-reveal class="mt-6 space-y-4">
      <RichParagraph
        parts={["Wenn du privat versichert bist und über eine Rückkehr in die GKV nachdenkst, würde ich zuerst klären:"]}
      />

      <ul class="space-y-2">
        {
          [
            "deinen beruflichen Status",
            "dein Alter",
            "deine Versicherungsbiografie der vergangenen Jahre",
            "dein regelmäßiges Einkommen",
            "mögliche Versicherungspflicht",
            "mögliche Befreiungen",
            "die 55-Jahre-Regel",
            "Auswirkungen auf deine PKV",
            "mögliche Zusatzversicherungen",
            "die finanzielle Situation nach dem Wechsel",
          ].map((item) => (
            <li class="flex items-baseline gap-2.5 text-base leading-relaxed text-ink-700/85">
              <span class="h-1.5 w-1.5 shrink-0 translate-y-[-2px] rounded-full bg-brand-400" aria-hidden="true" />
              {item}
            </li>
          ))
        }
      </ul>

      <RichParagraph parts={["Mein Standort ist Kassel und mein regionaler Schwerpunkt liegt in Nordhessen."]} />
      <RichParagraph parts={["Die Beratung ist persönlich vor Ort in Kassel oder digital deutschlandweit möglich."]} />
      <RichParagraph parts={[{ a: "Mehr zur PKV-Beratung in Kassel", href: "/private-krankenversicherung-kassel/" }]} />
    </div>

    <div class="mt-14 border-t border-black/5 pt-8">
      <p id="quellen" class="scroll-mt-24 text-xs font-semibold uppercase tracking-wide text-ink-700/50">Quellen und weiterführende Informationen</p>
      <p class="mt-3 text-xs leading-relaxed text-ink-700/60">
        Für diesen Artikel wurden insbesondere folgende Primärquellen und gesetzlichen Grundlagen
        berücksichtigt:
      </p>
      <ul class="mt-3 space-y-1.5">
        {
          sources.map((source) => (
            <li class="text-xs leading-relaxed text-ink-700/60">{source}</li>
          ))
        }
      </ul>
      <p class="mt-3 text-xs leading-relaxed text-ink-700/50">Stand der gesetzlichen Angaben: Oktober 2026.</p>
    </div>

    <div class="mt-10 border-t border-black/5 pt-8">
      <RichParagraph
        parts={["Zurück zum ", { a: "PKV-Wissen", href: "/wissen/private-krankenversicherung/" }]}
        class="text-sm font-semibold text-ink-700/85"
      />
    </div>
  </div>
</section>
