<section id="pkv-selbststaendige-vorerkrankungen" class="bg-white py-24">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">
        PKV trotz <span class="text-brand-600">Vorerkrankungen</span>
      </h2>
    </div>

    <div data-reveal class="mx-auto mt-10 max-w-2xl space-y-4 text-base leading-relaxed text-ink-700/85">
