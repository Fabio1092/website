---
import { CheckCircle2 } from "lucide-react";

const points = [
  "eine langfristige Entscheidung treffen möchten,",
  "Wert auf verständliche Bedingungen legen,",
  "nicht nur den günstigsten Beitrag suchen,",
  "ihre Gesundheitsangaben professionell vorbereiten möchten,",
  "Krankenversicherung und Einkommensschutz gemeinsam betrachten,",
  "einen persönlichen Ansprechpartner in Kassel und Nordhessen suchen.",
];
---

<section id="pkv-selbststaendige-eignung" class="bg-brand-50/40 py-24">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <span class="text-sm font-semibold uppercase tracking-wider text-brand-600">Passt unsere Beratung zu dir?</span>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">
        Für wen ist unsere <span class="text-brand-600">Beratung geeignet?</span>
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-700/80">
        Unsere PKV-Beratung richtet sich an Selbstständige und Unternehmer, die:
      </p>
    </div>

    <ul data-reveal class="mx-auto mt-10 flex max-w-xl flex-col gap-3">
      {
        points.map((point) => (
          <li class="flex items-start gap-3 rounded-xl bg-white px-5 py-4 text-base leading-relaxed text-ink-700/85">
            <CheckCircle2 className="mt-0.5 h-5 w-5 shrink-0 text-brand-600" aria-hidden="true" />
            {point}
          </li>
        ))
      }
    </ul>

    <div data-reveal class="mx-auto mt-8 max-w-xl rounded-2xl border border-black/5 bg-white px-6 py-5 text-center">
      <p class="text-sm leading-relaxed text-ink-700/70">
        Nicht passend ist die Beratung für Menschen, die ausschließlich einen möglichst günstigen
        Einzelabschluss ohne Gesamtbetrachtung möchten.
      </p>
    </div>
  </div>
</section>
