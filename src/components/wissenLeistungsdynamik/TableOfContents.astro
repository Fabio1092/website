---
const entries = [
  { id: "was-ist-leistungsdynamik", label: "Was ist eine Leistungsdynamik?" },
  { id: "leistungsdynamik-vs-beitragsdynamik", label: "Leistungsdynamik vs. Beitragsdynamik" },
  { id: "warum-gibt-es-sie", label: "Warum gibt es die Leistungsdynamik?" },
  { id: "ist-sie-sinnvoll", label: "Ist eine Leistungsdynamik sinnvoll?" },
  { id: "hoehere-bu-rente-wichtiger", label: "Warum eine höhere BU-Rente meistens wichtiger ist" },
  { id: "was-kostet-sie", label: "Was kostet eine Leistungsdynamik?" },
  { id: "ueberschuesse", label: "Können Überschüsse die Leistungsdynamik ersetzen?" },
  { id: "wann-besonders-empfehlenswert", label: "Wann ich eine Leistungsdynamik besonders empfehle" },
  { id: "schueler", label: "Leistungsdynamik für Schüler" },
  { id: "studenten", label: "Leistungsdynamik für Studenten" },
  { id: "berufseinsteiger", label: "Leistungsdynamik für Berufseinsteiger" },
  { id: "1-2-oder-3-prozent", label: "1 %, 2 % oder 3 % Leistungsdynamik?" },
  { id: "meine-prioritaeten", label: "Meine Prioritäten bei der BU-Konfiguration" },
  { id: "fazit", label: "Fazit" },
  { id: "faq", label: "FAQ" },
];
---

<section class="bg-white py-14">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <nav aria-label="Inhaltsverzeichnis" class="rounded-2xl border border-black/5 bg-brand-50/30 p-6 sm:p-8">
      <p class="text-xs font-semibold uppercase tracking-wide text-brand-600">Inhalt dieses Artikels</p>
      <ul class="mt-4 grid grid-cols-1 gap-x-8 gap-y-2.5 sm:grid-cols-2">
        {
          entries.map((entry, index) => (
            <li>
              <a
                href={`#${entry.id}`}
                class="group flex items-baseline gap-2.5 text-sm leading-relaxed text-ink-700/85 transition-colors duration-150 hover:text-brand-700"
              >
                <span class="tabular-nums text-xs font-semibold text-brand-400 group-hover:text-brand-600">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="underline decoration-transparent underline-offset-2 group-hover:decoration-brand-300">{entry.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</section>
