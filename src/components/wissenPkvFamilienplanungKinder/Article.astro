---
import RichParagraph from "@/components/RichParagraph.astro";

type Part = string | { b: string } | { a: string; href: string };

type Block =
  | { type: "p"; parts: Part[] }
  | { type: "standalone"; text: string }
  | { type: "quote"; text: string }
  | { type: "list"; items: string[] }
  | { type: "h3"; text: string }
  | { type: "table"; headers: string[]; rows: string[][] };

interface Section {
  id: string;
  heading: string;
  blocks: Block[];
}

const introBlocks: Block[] = [
  {
    type: "p",
    parts: ["Diese Frage gehört für mich in ", { b: "jede vernünftige PKV-Beratung" }, ", wenn Familienplanung grundsätzlich ein Thema sein kann."],
  },
  { type: "p", parts: ["Denn die private Krankenversicherung funktioniert bei Familien anders als die gesetzliche Krankenversicherung."] },
  { type: "p", parts: ["Der wichtigste Unterschied:"] },
  { type: "standalone", text: "In der PKV gibt es keine beitragsfreie Familienversicherung." },
  { type: "p", parts: ["Jede privat versicherte Person benötigt grundsätzlich einen eigenen Versicherungsschutz und damit auch einen eigenen Beitrag."] },
  { type: "p", parts: ["Das bedeutet aber nicht automatisch:"] },
  { type: "standalone", text: "„Mit Kindern ist die PKV immer zu teuer.“" },
  { type: "p", parts: ["Genauso falsch wäre:"] },
  { type: "standalone", text: "„Kinder kosten in der PKV kaum etwas, also spielt Familienplanung keine Rolle.“" },
  { type: "p", parts: ["Die Wahrheit hängt von deiner konkreten Familienkonstellation ab."] },
  { type: "p", parts: ["Entscheidend ist unter anderem:"] },
  {
    type: "list",
    items: [
      "wie beide Eltern versichert sind",
      "ob ihr verheiratet seid",
      "wer mehr verdient",
      "ob das Einkommen des privat versicherten Elternteils über der Jahresarbeitsentgeltgrenze liegt",
      "wie viele Kinder geplant sind",
      "welcher PKV-Schutz für die Kinder gewünscht ist",
      "wie sich Elternzeit auf Einkommen und Beiträge auswirkt",
    ],
  },
  {
    type: "p",
    parts: ["Genau deshalb sollte Familienplanung ", { b: "vor" }, " dem Wechsel in die PKV besprochen werden – nicht erst nach der Geburt des ersten Kindes."],
  },
];

