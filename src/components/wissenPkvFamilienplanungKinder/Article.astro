      { type: "p", parts: ["Nach der Geburt müssen dann hauptsächlich noch die tatsächlichen Daten des Kindes ergänzt und die Anmeldung fristgerecht durchgeführt werden."] },
    ],
  },
  {
    id: "adoption",
    heading: "Was gilt bei Adoption?",
    blocks: [
      { type: "p", parts: ["§ 198 VVG stellt die Adoption eines minderjährigen Kindes grundsätzlich der Geburt gleich."] },
      { type: "p", parts: ["Allerdings gibt es einen wichtigen Unterschied:"] },
      { type: "p", parts: ["Bei einem erhöhten Risiko darf der Versicherer bei adoptierten Kindern einen Risikozuschlag verlangen."] },
      { type: "p", parts: ["Dieser ist gesetzlich begrenzt."] },
      { type: "p", parts: ["Das ist eine besondere Regelung und sollte bei einer konkret geplanten Adoption individuell geprüft werden."] },
    ],
  },
  {
    id: "pkv-waehrend-schwangerschaft",
    heading: "Was passiert mit meiner PKV während der Schwangerschaft?",
    blocks: [
      { type: "p", parts: ["Eine bestehende private Krankenversicherung läuft während einer Schwangerschaft grundsätzlich weiter."] },
      { type: "p", parts: ["Welche konkreten Leistungen übernommen werden, richtet sich nach deinem Tarif."] },
      { type: "p", parts: ["Deshalb sollte bereits bei der Tarifauswahl geprüft werden, wie beispielsweise Leistungen rund um:"] },
      { type: "list", items: ["Vorsorge", "ambulante Behandlung", "Hebammenleistungen", "Entbindung", "Krankenhaus", "privatärztliche Behandlung"] },
      { type: "p", parts: ["geregelt sind."] },
      { type: "p", parts: ["Familienplanung ist damit nicht erst ein Thema ", { b: "nach" }, " der Geburt."] },
      { type: "p", parts: ["Sie beginnt bereits bei der Auswahl der eigenen PKV-Leistungen."] },
    ],
  },
  {
    id: "pkv-waehrend-mutterschutz",
    heading: "Was passiert mit meiner PKV während des Mutterschutzes?",
    blocks: [
      { type: "p", parts: ["Eine bestehende private Krankenversicherung bleibt grundsätzlich bestehen."] },
      { type: "p", parts: ["Anders als bei einer beitragsfreien GKV-Familienversicherung verschwindet der eigene PKV-Beitrag nicht einfach deshalb, weil du vorübergehend nicht arbeitest."] },
      { type: "p", parts: ["Ob und welche besonderen tariflichen Regelungen bestehen, hängt vom konkreten Versicherungsvertrag ab."] },
      { type: "p", parts: ["Deshalb würde ich bei geplanter Familie auch prüfen, ob der Tarif beispielsweise besondere Regelungen zur Beitragsentlastung während bestimmter Familienphasen vorsieht."] },
    ],
  },
  {
    id: "pkv-waehrend-elternzeit",
    heading: "Was passiert mit meiner PKV während der Elternzeit?",
    blocks: [
      { type: "p", parts: ["Dieser Punkt kann finanziell sehr relevant sein."] },
      { type: "p", parts: ["Grundsätzlich läuft deine PKV auch während der Elternzeit weiter."] },
      { type: "p", parts: ["Der Beitrag muss grundsätzlich weitergezahlt werden, soweit dein Tarif keine besondere Regelung vorsieht."] },
      { type: "p", parts: ["Bei Arbeitnehmern kommt ein weiterer Punkt hinzu:"] },
      { type: "p", parts: ["Wenn während der Elternzeit keine Beschäftigung ausgeübt und kein entsprechendes Arbeitsentgelt gezahlt wird, besteht grundsätzlich auch kein normaler Arbeitgeberzuschuss zur eigenen PKV."] },
      { type: "p", parts: ["Das kann die monatliche Nettobelastung deutlich erhöhen."] },
    ],
  },
  {
    id: "beispiel-elternzeit",
    heading: "Beispiel: PKV während der Elternzeit",
    blocks: [
      { type: "p", parts: ["Vor der Elternzeit beträgt dein eigener PKV-Beitrag beispielsweise:"] },
      { type: "standalone", text: "700 Euro monatlich." },
      { type: "p", parts: ["Dein Arbeitgeber beteiligt sich daran innerhalb der gesetzlichen Grenzen."] },
      { type: "p", parts: ["Während einer vollständigen Elternzeit entfällt dieser Arbeitgeberzuschuss grundsätzlich."] },
      { type: "p", parts: ["Dann kann der volle PKV-Beitrag bei dir selbst hängen bleiben."] },
      { type: "p", parts: ["Das Beispiel ist bewusst vereinfacht."] },
      { type: "p", parts: ["Entscheidend ist deine konkrete Beschäftigungs- und Familiensituation."] },
      { type: "p", parts: ["Aber es zeigt:"] },
      { type: "standalone", text: "Elternzeit gehört in eine seriöse PKV-Kostenplanung." },
    ],
  },
  {
    id: "teilzeit-waehrend-elternzeit",
    heading: "Was passiert, wenn ich während der Elternzeit Teilzeit arbeite?",
    blocks: [
      { type: "p", parts: ["Dann kann sich dein Versicherungsstatus verändern."] },
      { type: "p", parts: ["Sinkt dein regelmäßiges Arbeitsentgelt durch eine Teilzeittätigkeit unter die maßgebliche Jahresarbeitsentgeltgrenze, kann grundsätzlich Versicherungspflicht in der GKV entstehen."] },
      { type: "p", parts: ["Für bestimmte Teilzeitfälle während der Elternzeit sieht § 8 SGB V allerdings eine Möglichkeit vor, sich auf Antrag von dieser Versicherungspflicht befreien zu lassen."] },
      { type: "p", parts: ["Die Befreiung erstreckt sich dann auf die Elternzeit."] },
      { type: "p", parts: ["Das ist keine Entscheidung, die ich automatisch treffen würde."] },
      { type: "p", parts: ["Denn du solltest vorher verstehen:"] },
      { type: "list", items: ["was passiert während der Elternzeit?", "was passiert danach?", "möchtest du langfristig in der PKV bleiben?", "welche Auswirkungen hat eine Befreiung?"] },
      { type: "p", parts: ["Genau deshalb sollte die konkrete Konstellation vorher geprüft werden."] },
    ],
  },
  {
    id: "kinder-spaeter-gkv-wechseln",
    heading: "Können Kinder später von der PKV in die GKV wechseln?",
    blocks: [
      { type: "p", parts: ["Der Versicherungsstatus eines Kindes ist nicht zwangsläufig für das gesamte Leben festgeschrieben."] },
      { type: "p", parts: ["Spätestens wenn sich die Lebenssituation verändert – beispielsweise durch:"] },
      { type: "list", items: ["Ausbildung", "Studium", "eigenes Beschäftigungsverhältnis"] },
      { type: "p", parts: ["muss neu geprüft werden, ob Versicherungspflicht entsteht oder welches Versicherungssystem gewählt werden kann."] },
      { type: "p", parts: ["Ein privat versichertes Kind bleibt also nicht automatisch lebenslang in der PKV."] },
      { type: "p", parts: ["Die gesetzlichen Regeln der jeweiligen Lebensphase entscheiden über die Möglichkeiten."] },
    ],
  },
  {
    id: "mehrere-kinder",
    heading: "Was passiert bei mehreren Kindern?",
    blocks: [
      { type: "p", parts: ["Das ist vor allem eine wirtschaftliche Frage."] },
      { type: "p", parts: ["In der GKV können mehrere Kinder unter den Voraussetzungen der Familienversicherung beitragsfrei versichert sein."] },
      { type: "p", parts: ["In der PKV erhält jedes Kind einen eigenen Vertrag und eigenen Beitrag."] },
      { type: "p", parts: ["Bei einem Kind kann die Beitragsbelastung deshalb anders aussehen als bei drei Kindern."] },
      { type: "p", parts: ["Genau deswegen würde ich in der Beratung nicht nur rechnen:"] },
      { type: "standalone", text: "„Was kostet die PKV für dich heute?“" },
      { type: "p", parts: ["Sondern zum Beispiel auch:"] },
      { type: "standalone", text: "„Was passiert bei einem oder zwei Kindern?“" },
      { type: "p", parts: ["Das ist keine Prognose deiner Familienplanung."] },
      { type: "p", parts: ["Es ist einfach vernünftige finanzielle Vorbereitung."] },
    ],
  },
  {
    id: "pkv-fuer-familien-schlechter",
    heading: "Ist die PKV deshalb für Familien grundsätzlich schlechter?",
    blocks: [
      { type: "p", parts: ["Nein."] },
      { type: "p", parts: ["Das wäre viel zu pauschal."] },
      { type: "p", parts: ["Die PKV kann auch für Familien sehr gut passen."] },
      { type: "p", parts: ["Aber die wirtschaftliche Logik unterscheidet sich von der GKV."] },
      { type: "p", parts: ["Du solltest deshalb Vorteile und Nachteile gemeinsam betrachten."] },
      { type: "p", parts: ["Mögliche Vorteile können je nach Tarif beispielsweise sein:"] },
      {
        type: "list",
        items: [
          "individuell wählbarer Versicherungsschutz",
          "vertraglich definierte Leistungen",
          "hochwertige ambulante oder stationäre Leistungen",
          "umfangreicher Zahnschutz",
          "frühzeitige Absicherung des Kindes über die Kindernachversicherung",
        ],
      },
      { type: "p", parts: ["Dem stehen mögliche finanzielle Nachteile gegenüber:"] },
      {
        type: "list",
        items: ["eigener Beitrag für jedes privat versicherte Kind", "keine kostenlose Familienversicherung innerhalb der PKV", "zusätzliche Belastung während Elternzeiten", "höhere Gesamtkosten bei mehreren Kindern möglich"],
      },
      { type: "p", parts: ["Die richtige Frage lautet deshalb nicht:"] },
      { type: "standalone", text: "„PKV mit Kindern – gut oder schlecht?“" },
      { type: "p", parts: ["Sondern:"] },
      { type: "standalone", text: "„Passt die PKV auch zu der Familie, die ich möglicherweise in den nächsten Jahren haben werde?“" },
    ],
  },
  {
    id: "familienplanung-vor-wechsel",
    heading: "Familienplanung sollte vor dem PKV-Wechsel besprochen werden",
    blocks: [
      { type: "p", parts: ["Wenn mir ein 30-jähriger Angestellter sagt:"] },
      { type: "p", parts: ["„Kinder sind in zwei oder drei Jahren ziemlich wahrscheinlich.“"] },
      { type: "p", parts: ["dann gehört das in die Entscheidung."] },
      { type: "p", parts: ["Genauso wenn jemand sagt:"] },
      { type: "p", parts: ["„Kinder sind ausgeschlossen.“"] },
      { type: "p", parts: ["Oder:"] },
      { type: "p", parts: ["„Wir wollen wahrscheinlich drei Kinder.“"] },
      { type: "p", parts: ["Der heutige PKV-Beitrag ist immer nur eine Momentaufnahme."] },
      { type: "p", parts: ["Deine Krankenversicherung begleitet dich dagegen möglicherweise über Jahrzehnte."] },
      {
        type: "p",
        parts: [
          "Wenn du gerade noch vor dem Wechsel stehst, findest du den konkreten Ablauf unter ",
          { a: "Wechsel in die PKV: So funktioniert der Wechsel von der GKV", href: "/wissen/private-krankenversicherung/wechsel-in-die-pkv/" },
          ".",
        ],
      },
    ],
  },
  {
    id: "drei-familienkonstellationen",
    heading: "Drei typische Familienkonstellationen",
    blocks: [
      { type: "h3", text: "Beispiel 1: Beide Eltern privat versichert" },
      { type: "p", parts: ["Beide Eltern sind privat krankenversichert."] },
      { type: "p", parts: ["Ein Kind wird geboren."] },
      { type: "p", parts: ["Eine beitragsfreie GKV-Familienversicherung über einen Elternteil steht nicht zur Verfügung."] },
      {
        type: "p",
        parts: [{ b: "Meine Einschätzung:" }, " Den Kinderschutz und die Kosten bereits vor der Geburt einplanen. Kindernachversicherung nach § 198 VVG rechtzeitig vorbereiten."],
      },
      { type: "h3", text: "Beispiel 2: Ein Elternteil PKV, ein Elternteil GKV" },
      { type: "p", parts: ["Der privat versicherte Elternteil verdient mehr als der gesetzlich versicherte Elternteil und liegt über der JAEG."] },
      { type: "p", parts: ["Die Eltern sind verheiratet."] },
      {
        type: "p",
        parts: [{ b: "Meine Einschätzung:" }, " Prüfen, ob § 10 Abs. 3 SGB V die kostenlose Familienversicherung ausschließt. Danach GKV- und PKV-Optionen für das Kind vergleichen."],
      },
      { type: "h3", text: "Beispiel 3: Ein Elternteil PKV, ein Elternteil GKV – unverheiratet" },
      { type: "p", parts: ["Der privat versicherte Elternteil verdient deutlich mehr."] },
      { type: "p", parts: ["Die Eltern sind aber nicht verheiratet."] },
      {
        type: "p",
        parts: [
          { b: "Meine Einschätzung:" },
          " Die spezielle Ausschlussregel des § 10 Abs. 3 SGB V greift aufgrund dieser Konstellation nicht. Die allgemeinen Voraussetzungen einer Familienversicherung über den GKV-Elternteil müssen trotzdem geprüft werden.",
        ],
      },
    ],
  },
  {
    id: "typische-fehler",
    heading: "Welche Fehler würde ich vermeiden?",
    blocks: [
      { type: "h3", text: "Fehler 1: „Mein Kind kann immer kostenlos über meinen Partner in die GKV“" },
      { type: "p", parts: ["Nein."] },
      { type: "p", parts: ["Bei verheirateten gemischt versicherten Eltern können Einkommen und JAEG die kostenlose Familienversicherung ausschließen."] },
      { type: "h3", text: "Fehler 2: „Wenn einer privat ist, muss das Kind immer privat sein“" },
      { type: "p", parts: ["Auch das stimmt nicht."] },
      { type: "p", parts: ["Bei gemischten Eltern muss die konkrete Konstellation geprüft werden."] },
      { type: "h3", text: "Fehler 3: Familienplanung erst nach dem PKV-Abschluss bedenken" },
      { type: "p", parts: ["Dann hast du wichtige wirtschaftliche Fragen zu spät gestellt."] },
      { type: "h3", text: "Fehler 4: Zwei-Monats-Frist nach der Geburt verpassen" },
      { type: "p", parts: ["Die erleichterte Kindernachversicherung nach § 198 VVG ist an eine Frist gebunden."] },
      { type: "h3", text: "Fehler 5: Davon ausgehen, dass das Kind automatisch mehr Leistungen bekommen kann als der Elternteil" },
      { type: "p", parts: ["Für die gesetzlich privilegierte Aufnahme darf der Schutz nicht höher oder umfassender sein als beim versicherten Elternteil."] },
      { type: "h3", text: "Fehler 6: Elternzeit finanziell ignorieren" },
      { type: "p", parts: ["Der eigene PKV-Beitrag läuft grundsätzlich weiter."] },
      { type: "p", parts: ["Der Arbeitgeberzuschuss kann während einer vollständigen Elternzeit wegfallen."] },
      { type: "h3", text: "Fehler 7: Nur auf den Kinderbeitrag schauen" },
      { type: "p", parts: ["Auch Leistungen, Arbeitgeberzuschuss, Elternzeit und Familienversicherung gehören in die Rechnung."] },
    ],
  },
  {
    id: "checkliste",
    heading: "Meine Checkliste für PKV und Familienplanung",
    blocks: [
      { type: "p", parts: ["Bevor ich eine PKV-Entscheidung mit Familienplanung treffe, würde ich folgende Punkte klären:"] },
      {
        type: "list",
        items: [
          "1. Sind Kinder grundsätzlich geplant?",
          "2. Wie viele Kinder sind realistisch denkbar?",
          "3. Wie ist der Partner aktuell versichert?",
          "4. Seid ihr verheiratet oder unverheiratet?",
          "5. Wer verdient aktuell mehr?",
          "6. Liegt der privat versicherte Elternteil über der JAEG?",
          "7. Wäre eine beitragsfreie GKV-Familienversicherung möglich?",
          "8. Was kostet ein Kind in der gewünschten PKV?",
          "9. Was kosten zwei oder mehrere Kinder?",
          "10. Ist noch Arbeitgeberzuschuss für Kinderbeiträge verfügbar?",
          "11. Wie ist der eigene Tarif bei Schwangerschaft und Entbindung aufgestellt?",
          "12. Welche Kindernachversicherung bietet der Versicherer?",
          "13. Ist die erforderliche Vorversicherungszeit erfüllt?",
          "14. Ist die Zwei-Monats-Frist nach Geburt bekannt?",
          "15. Welchen Leistungsumfang kann das Kind ohne Risikoprüfung erhalten?",
          "16. Wie verändert Elternzeit die eigene Beitragsbelastung?",
          "17. Ist Teilzeit während der Elternzeit geplant?",
          "18. Was passiert nach der Elternzeit mit dem Versicherungsstatus?",
          "19. Passt die PKV auch dann noch zur Familie, wenn die heutige Ersparnis kleiner wird?",
        ],
      },
      { type: "p", parts: ["Erst wenn diese Fragen beantwortet sind, hast du ein realistisches Bild."] },
    ],
  },
];
---

<div class="mx-auto max-w-3xl space-y-20 px-4 py-16 sm:px-6 lg:px-8">
  <div data-reveal class="space-y-4">
    {
      introBlocks.map((block) => {
        if (block.type === "p") return <RichParagraph parts={block.parts} />;
        if (block.type === "standalone") return <p class="text-base font-medium leading-relaxed text-ink-950">{block.text}</p>;
        if (block.type === "list")
          return (
            <ul class="space-y-2">
              {block.items.map((item) => (
                <li class="flex items-baseline gap-2.5 text-base leading-relaxed text-ink-700/85">
                  <span class="h-1.5 w-1.5 shrink-0 translate-y-[-2px] rounded-full bg-brand-400" aria-hidden="true" />
                  {item}
                </li>
              ))}
            </ul>
          );
        return null;
      })
    }
  </div>

  {
    sections.map((section) => (
      <section id={section.id} class="scroll-mt-24">
        <h2 class="font-serif text-2xl font-semibold tracking-tight text-ink-950 sm:text-3xl">{section.heading}</h2>
        <div data-reveal class="mt-6 space-y-4">
          {section.blocks.map((block) => {
            if (block.type === "p") return <RichParagraph parts={block.parts} />;
            if (block.type === "standalone") return <p class="text-base font-medium leading-relaxed text-ink-950">{block.text}</p>;
            if (block.type === "quote")
              return (
                <blockquote class="border-l-2 border-brand-200 pl-5">
                  <p class="font-serif text-lg italic leading-relaxed text-ink-950">{block.text}</p>
                </blockquote>
              );
            if (block.type === "list")
              return (
                <ul class="space-y-2">
                  {block.items.map((item) => (
                    <li class="flex items-baseline gap-2.5 text-base leading-relaxed text-ink-700/85">
                      <span class="h-1.5 w-1.5 shrink-0 translate-y-[-2px] rounded-full bg-brand-400" aria-hidden="true" />
                      {item}
                    </li>
                  ))}
                </ul>
              );
            if (block.type === "h3") return <h3 class="!mt-10 font-serif text-xl font-semibold text-ink-950">{block.text}</h3>;
            if (block.type === "table")
              return (
                <div class="overflow-x-auto rounded-xl border border-black/5">
                  <table class="w-full min-w-[560px] border-collapse text-left text-sm">
                    <thead>
                      <tr class="bg-brand-50/60">
                        {block.headers.map((h) => (
                          <th class="px-4 py-3 font-semibold text-ink-950">{h}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-black/5 bg-white">
                      {block.rows.map((row) => (
                        <tr>
                          {row.map((cell, i) => (
                            <td class={i === 0 ? "px-4 py-3 font-medium text-ink-950" : "px-4 py-3 text-ink-700/80"}>{cell}</td>
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              );
            return null;
          })}
        </div>
      </section>
    ))
  }
</div>
