      { type: "standalone", text: "Abweichendes Angebot" },
      { type: "p", parts: ["Der Versicherer bietet Versicherungsschutz zu veränderten Bedingungen an."] },
      { type: "p", parts: ["Erst wenn das Ergebnis vorliegt, weißt du wirklich, welche PKV du bekommen kannst."] },
    ],
  },
  {
    id: "schritt-9-gkv-nicht-voreilig-beenden",
    heading: "Schritt 9: GKV nicht voreilig beenden",
    blocks: [
      { type: "p", parts: ["Das ist einer der wichtigsten praktischen Punkte."] },
      { type: "p", parts: ["Ich würde die gesetzliche Krankenversicherung nicht einfach beenden und anschließend hoffen, dass der gewünschte PKV-Antrag angenommen wird."] },
      { type: "p", parts: ["Die bessere Reihenfolge lautet:"] },
      { type: "standalone", text: "1. PKV prüfen." },
      { type: "standalone", text: "2. Gesundheit klären." },
      { type: "standalone", text: "3. Antrag stellen." },
      { type: "standalone", text: "4. Annahme beziehungsweise verbindlichen Versicherungsschutz erhalten." },
      { type: "standalone", text: "5. Danach GKV-Austritt beziehungsweise Kündigung final koordinieren." },
      { type: "p", parts: ["So vermeidest du unnötige Probleme bei der zeitlichen Abstimmung."] },
      { type: "p", parts: ["In Deutschland besteht grundsätzlich die Pflicht, einen ausreichenden Krankenversicherungsschutz zu haben."] },
      { type: "p", parts: ["Deshalb müssen Ende der GKV und Beginn der PKV lückenlos zusammenpassen."] },
    ],
  },
  {
    id: "gkv-beenden",
    heading: "Wie beendet man die GKV beim Wechsel zur PKV?",
    blocks: [
      { type: "p", parts: ["Hier muss zwischen verschiedenen Situationen unterschieden werden."] },
      { type: "h3", text: "Variante 1: Deine Versicherungspflicht endet gerade erst" },
      { type: "p", parts: ["Wenn deine Versicherungspflicht endet, setzt sich deine bisherige GKV-Mitgliedschaft grundsätzlich automatisch als freiwillige Mitgliedschaft fort."] },
      { type: "p", parts: ["Die Krankenkasse muss dich auf deine Austrittsmöglichkeit hinweisen."] },
      {
        type: "p",
        parts: [
          "Erklärst du innerhalb von ",
          { b: "zwei Wochen nach diesem Hinweis" },
          " deinen Austritt und weist eine anderweitige Absicherung im Krankheitsfall nach, kann die freiwillige Anschlussversicherung vermieden werden.",
        ],
      },
      { type: "p", parts: ["Das ist beispielsweise relevant, wenn du als Angestellter zum Jahreswechsel erstmals versicherungsfrei wirst."] },
      { type: "h3", text: "Variante 2: Du bist bereits freiwillig gesetzlich versichert" },
      { type: "p", parts: ["Dann gilt grundsätzlich die normale Kündigungsfrist."] },
      { type: "p", parts: ["Die freiwillige Mitgliedschaft kann zum Ablauf des ", { b: "übernächsten Kalendermonats" }, " beendet werden."] },
      { type: "p", parts: ["Beispiel:"] },
      {
        type: "p",
        parts: ["Geht deine Kündigung im März ein, kann die Mitgliedschaft grundsätzlich zum ", { b: "31. Mai" }, " enden und die PKV zum ", { b: "1. Juni" }, " beginnen."],
      },
      { type: "p", parts: ["Damit die Kündigung wirksam wird, musst du den anderweitigen Krankenversicherungsschutz nachweisen."] },
    ],
  },
  {
    id: "beispiel-jahresanfang-angestellter",
    heading: "Beispiel: Wechsel zum Jahresanfang als Angestellter",
    blocks: [
      { type: "p", parts: ["Nehmen wir an:"] },
      { type: "p", parts: ["Du bist 2026 gesetzlich pflichtversichert."] },
      { type: "p", parts: ["Durch eine Gehaltserhöhung liegt dein regelmäßiges Jahresarbeitsentgelt oberhalb der maßgeblichen JAEG."] },
      { type: "p", parts: ["Auch die JAEG des Folgejahres wird voraussichtlich überschritten."] },
      { type: "p", parts: ["Dann endet deine Versicherungspflicht grundsätzlich zum:"] },
      { type: "standalone", text: "31. Dezember." },
      { type: "p", parts: ["Die Krankenkasse informiert dich über die Möglichkeit, freiwilliges Mitglied zu bleiben."] },
      { type: "p", parts: ["Möchtest du stattdessen in die PKV, erklärst du innerhalb der vorgesehenen Frist deinen Austritt und weist den privaten Versicherungsschutz nach."] },
      { type: "p", parts: ["Die PKV beginnt dann passend zum Ende der GKV."] },
      {
        type: "p",
        parts: [
          { b: "Wichtig:" },
          " Ob die Versicherungspflicht tatsächlich endet, sollte vorher verbindlich geklärt werden. Gerade variable Vergütung, Boni oder Änderungen der Arbeitszeit können die Beurteilung beeinflussen.",
        ],
      },
    ],
  },
  {
    id: "beispiel-freiwillig-versicherter-angestellter",
    heading: "Beispiel: Bereits freiwillig versicherter Angestellter",
    blocks: [
      { type: "p", parts: ["Du verdienst bereits seit längerer Zeit oberhalb der JAEG und bist freiwillig gesetzlich versichert."] },
      { type: "p", parts: ["Jetzt entscheidest du dich im März für die PKV."] },
      { type: "p", parts: ["Dein PKV-Antrag wird angenommen."] },
      { type: "p", parts: ["Anschließend kündigst du deine freiwillige GKV-Mitgliedschaft."] },
      { type: "p", parts: ["Bei Eingang der Kündigung im März kann sie grundsätzlich zum 31. Mai enden."] },
      { type: "p", parts: ["Der private Versicherungsschutz startet:"] },
      { type: "standalone", text: "1. Juni." },
      { type: "p", parts: ["So entsteht keine Versicherungslücke."] },
    ],
  },
  {
    id: "beispiel-selbststaendiger",
    heading: "Beispiel: Selbstständiger",
    blocks: [
      { type: "p", parts: ["Du bist selbstständig und freiwillig gesetzlich versichert."] },
      { type: "p", parts: ["Nach einer ausführlichen Prüfung entscheidest du dich für die PKV."] },
      { type: "p", parts: ["Dann gilt ebenfalls:"] },
      { type: "p", parts: ["Erst PKV prüfen und Annahme sicherstellen."] },
      {
        type: "p",
        parts: ["Danach freiwillige GKV-Mitgliedschaft unter Beachtung der Kündigungsfrist beenden und den Beginn der privaten Versicherung entsprechend koordinieren."],
      },
      { type: "p", parts: ["Die PKV beginnt unmittelbar nach Ende deiner gesetzlichen Absicherung."] },
    ],
  },
  {
    id: "schritt-10-arbeitgeber-informieren",
    heading: "Schritt 10: Arbeitgeber informieren",
    blocks: [
      { type: "p", parts: ["Wenn du Angestellter bist, muss dein Arbeitgeber wissen, dass du zukünftig privat kranken- und pflegeversichert bist."] },
      { type: "p", parts: ["Unter den gesetzlichen Voraussetzungen besteht ein Anspruch auf Arbeitgeberzuschuss zur privaten Krankenversicherung."] },
      { type: "p", parts: ["Der Arbeitgeber übernimmt dabei nicht unbegrenzt die Hälfte jedes beliebigen PKV-Beitrags."] },
      { type: "p", parts: ["Der Zuschuss ist gesetzlich begrenzt und grundsätzlich auch auf die Hälfte des tatsächlichen zuschussfähigen Beitrags beschränkt."] },
      {
        type: "p",
        parts: ["Seit 2026 werden die relevanten PKV-Beitragsdaten für Arbeitgeberzuschuss und Lohnsteuer grundsätzlich digital zwischen Versicherern, Finanzverwaltung und Arbeitgebern ausgetauscht."],
      },
      { type: "p", parts: ["Die frühere regelmäßige Papierbescheinigung wurde damit weitgehend ersetzt."] },
      { type: "p", parts: ["Mehr zur PKV als Arbeitnehmer findest du unter ", { a: "PKV für Angestellte", href: "/pkv-angestellte-kassel/" }, "."] },
    ],
  },
  {
    id: "schritt-11-pflegepflichtversicherung",
    heading: "Schritt 11: PKV und Pflegepflichtversicherung müssen zusammenpassen",
    blocks: [
      { type: "p", parts: ["Beim Wechsel geht es nicht nur um die Krankheitskostenvollversicherung."] },
      { type: "p", parts: ["Auch die Pflegeversicherung muss lückenlos geregelt sein."] },
      { type: "p", parts: ["Wer privat krankenversichert ist, benötigt grundsätzlich auch eine entsprechende private Pflege-Pflichtversicherung."] },
      { type: "p", parts: ["In der Praxis wird beides im Rahmen des Wechsels gemeinsam koordiniert."] },
      { type: "p", parts: ["Achte deshalb beim Versicherungsbeginn darauf, dass deine gesamte Absicherung ab dem ersten Tag der privaten Versicherung steht."] },
    ],
  },
  {
    id: "wie-lange-dauert-wechsel",
    heading: "Wie lange dauert der Wechsel in die PKV?",
    blocks: [
      { type: "p", parts: ["Darauf gibt es keine pauschale Antwort."] },
      { type: "p", parts: ["Ein unkomplizierter Antrag eines gesunden Kunden kann schnell bearbeitet werden."] },
      { type: "p", parts: ["Bei umfangreicher Gesundheitshistorie können dagegen erforderlich sein:"] },
      { type: "list", items: ["Patientenakten", "Arztberichte", "Risikovoranfragen", "Rückfragen der Versicherer", "zusätzliche Erklärungen", "erneute Prüfung"] },
      { type: "p", parts: ["Deshalb würde ich mit dem Prozess nicht erst wenige Tage vor dem gewünschten Wechseltermin beginnen."] },
      { type: "p", parts: ["Gerade bei einem geplanten Wechsel zum Jahresanfang lohnt es sich, die Gesundheitshistorie frühzeitig vorzubereiten."] },
    ],
  },
  {
    id: "wie-lange-vorher-beginnen",
    heading: "Wie lange vorher sollte ich mich mit der PKV beschäftigen?",
    blocks: [
      { type: "p", parts: ["Wenn du deinen Wechselzeitpunkt bereits kennst, würde ich nicht bis zur letzten Woche warten."] },
      { type: "p", parts: ["Die eigentliche Tarifauswahl ist häufig nicht das Zeitproblem."] },
      { type: "p", parts: ["Aufwendiger können sein:"] },
      {
        type: "list",
        items: ["medizinische Unterlagen beschaffen", "falsche Diagnosen in Akten klären", "Arztberichte einholen", "Risikovoranfragen durchführen", "Angebote vergleichen", "Rückfragen beantworten"],
      },
      { type: "p", parts: ["Je komplexer deine gesundheitliche Vorgeschichte, desto früher würde ich beginnen."] },
    ],
  },
  {
    id: "antrag-abgelehnt",
    heading: "Was passiert, wenn die PKV meinen Antrag ablehnt?",
    blocks: [
      { type: "p", parts: ["Dann solltest du deine GKV nicht bereits voreilig beendet haben."] },
      { type: "p", parts: ["Genau deshalb ist die Reihenfolge so wichtig."] },
      { type: "p", parts: ["Bei Vorerkrankungen kann eine vorherige Risikovoranfrage helfen, dieses Risiko zu reduzieren und geeignete Versicherer zu identifizieren."] },
      { type: "p", parts: ["Eine Ablehnung bei einer Gesellschaft bedeutet außerdem nicht automatisch, dass jede andere Gesellschaft dieselbe Entscheidung trifft."] },
      { type: "p", parts: ["Risikoprüfungen unterscheiden sich."] },
    ],
  },
  {
    id: "typische-fehler",
    heading: "Welche Fehler sollte ich beim Wechsel vermeiden?",
    blocks: [
      { type: "h3", text: "Fehler 1: Nur nach dem günstigsten Beitrag auswählen" },
      { type: "p", parts: ["Ein niedriger Beitrag macht noch keine gute private Krankenversicherung."] },
      { type: "p", parts: ["Entscheidend ist, was langfristig versichert ist."] },
      { type: "h3", text: "Fehler 2: Gesundheitsfragen aus dem Gedächtnis beantworten" },
      { type: "p", parts: ["Ein vergessener Arztbesuch kann später erheblich relevanter sein als die paar Tage, die du beim Antrag sparen wolltest."] },
      { type: "h3", text: "Fehler 3: Direkt mehrere Anträge stellen" },
      { type: "p", parts: ["Bei relevanten Vorerkrankungen würde ich zunächst prüfen, ob eine Risikovoranfrage sinnvoller ist."] },
      { type: "h3", text: "Fehler 4: Die GKV zu früh beenden" },
      { type: "p", parts: ["Zuerst sollte der gewünschte private Versicherungsschutz stehen."] },
      { type: "h3", text: "Fehler 5: Familienplanung ignorieren" },
      { type: "p", parts: ["Kinder und Ehepartner sind in der PKV nicht automatisch kostenlos mitversichert."] },
      { type: "h3", text: "Fehler 6: Krankentagegeld vergessen" },
      { type: "p", parts: ["Krankenversicherung und Einkommensabsicherung bei längerer Arbeitsunfähigkeit gehören zusammen gedacht."] },
      { type: "h3", text: "Fehler 7: Beitragsentwicklung ausblenden" },
      { type: "p", parts: ["Du entscheidest dich nicht nur für den Beitrag des ersten Jahres."] },
      { type: "p", parts: ["Eine PKV ist langfristige Absicherung."] },
      {
        type: "p",
        parts: [
          "Mehr dazu findest du unter ",
          { a: "PKV Beitragsentwicklung: Wie stark steigen die Beiträge?", href: "/wissen/private-krankenversicherung/pkv-beitragsentwicklung/" },
          ".",
        ],
      },
      { type: "h3", text: "Fehler 8: Den Wechsel als kurzfristiges Sparmodell betrachten" },
      { type: "p", parts: ["Wenn der einzige Grund lautet:"] },
      { type: "standalone", text: "„Ich spare heute 200 Euro im Monat“" },
      { type: "p", parts: ["wäre mir das für eine Systementscheidung zu wenig."] },
    ],
  },
  {
    id: "zurueck-in-die-gkv",
    heading: "Kann ich später einfach wieder zurück in die GKV?",
    blocks: [
      { type: "p", parts: ["Nicht beliebig."] },
      { type: "p", parts: ["Das ist ein Punkt, den du ", { b: "vor" }, " dem Wechsel verstehen solltest."] },
      { type: "p", parts: ["Ein freiwilliges GKV-Mitglied kann grundsätzlich in die PKV wechseln."] },
      { type: "p", parts: ["Der umgekehrte Weg funktioniert später aber nicht einfach durch eine Kündigung der PKV und eine neue Anmeldung bei der GKV."] },
      { type: "p", parts: ["Für eine Rückkehr muss regelmäßig ein gesetzlicher Zugangstatbestand zur GKV bestehen – beispielsweise eine neue Versicherungspflicht."] },
      { type: "p", parts: ["Für Personen ab 55 Jahren gelten darüber hinaus erhebliche zusätzliche Einschränkungen."] },
      { type: "p", parts: ["Das soll dich nicht von der PKV abschrecken."] },
      { type: "p", parts: ["Aber du solltest die Entscheidung bewusst treffen."] },
    ],
  },
  {
    id: "checkliste",
    heading: "Meine Checkliste für den Wechsel in die PKV",
    blocks: [
      { type: "p", parts: ["Bevor der Wechsel durchgeführt wird, würde ich diese Punkte abhaken:"] },
      {
        type: "list",
        items: [
          "1. Besteht tatsächlich Versicherungsfreiheit?",
          "2. Ab welchem Datum darf ich wechseln?",
          "3. Passt die PKV langfristig zu meiner Lebensplanung?",
          "4. Wie sieht meine Familienplanung aus?",
          "5. Sind meine Gesundheitsangaben vollständig aufbereitet?",
          "6. Benötige ich eine Risikovoranfrage?",
          "7. Welche Versicherer kommen gesundheitlich infrage?",
          "8. Welche Leistungen möchte ich versichern?",
          "9. Wie hoch soll mein Selbstbehalt sein?",
          "10. Ist mein Krankentagegeld passend abgesichert?",
          "11. Wie entwickelt sich die Gesamtbelastung langfristig?",
          "12. Wurde der PKV-Antrag verbindlich angenommen?",
          "13. Wann endet meine GKV-Mitgliedschaft?",
          "14. Ist der Nachweis des neuen Versicherungsschutzes erbracht?",
          "15. Schließen GKV-Ende und PKV-Beginn lückenlos aneinander an?",
          "16. Ist mein Arbeitgeber informiert?",
          "17. Ist die private Pflegepflichtversicherung geregelt?",
        ],
      },
      { type: "p", parts: ["Wenn diese Punkte sauber beantwortet sind, ist der eigentliche Wechsel meistens der einfachste Teil."] },
    ],
  },
];
---

<div class="mx-auto max-w-3xl space-y-20 px-4 py-16 sm:px-6 lg:px-8">
  <div data-reveal class="space-y-4">
    {
      introBlocks.map((block) => {
        if (block.type === "p") return <RichParagraph parts={block.parts} />;
        if (block.type === "standalone") return <p class="text-base font-medium leading-relaxed text-ink-950">{block.text}</p>;
        if (block.type === "list")
          return (
            <ul class="space-y-2">
              {block.items.map((item) => (
                <li class="flex items-baseline gap-2.5 text-base leading-relaxed text-ink-700/85">
                  <span class="h-1.5 w-1.5 shrink-0 translate-y-[-2px] rounded-full bg-brand-400" aria-hidden="true" />
                  {item}
                </li>
              ))}
            </ul>
          );
        return null;
      })
    }
  </div>

  {
    sections.map((section) => (
      <section id={section.id} class="scroll-mt-24">
        <h2 class="font-serif text-2xl font-semibold tracking-tight text-ink-950 sm:text-3xl">{section.heading}</h2>
        <div data-reveal class="mt-6 space-y-4">
          {section.blocks.map((block) => {
            if (block.type === "p") return <RichParagraph parts={block.parts} />;
            if (block.type === "standalone") return <p class="text-base font-medium leading-relaxed text-ink-950">{block.text}</p>;
            if (block.type === "quote")
              return (
                <blockquote class="border-l-2 border-brand-200 pl-5">
                  <p class="font-serif text-lg italic leading-relaxed text-ink-950">{block.text}</p>
                </blockquote>
              );
            if (block.type === "list")
              return (
                <ul class="space-y-2">
                  {block.items.map((item) => (
                    <li class="flex items-baseline gap-2.5 text-base leading-relaxed text-ink-700/85">
                      <span class="h-1.5 w-1.5 shrink-0 translate-y-[-2px] rounded-full bg-brand-400" aria-hidden="true" />
                      {item}
                    </li>
                  ))}
                </ul>
              );
            if (block.type === "h3") return <h3 class="!mt-10 font-serif text-xl font-semibold text-ink-950">{block.text}</h3>;
            if (block.type === "table")
              return (
                <div class="overflow-x-auto rounded-xl border border-black/5">
                  <table class="w-full min-w-[560px] border-collapse text-left text-sm">
                    <thead>
                      <tr class="bg-brand-50/60">
                        {block.headers.map((h) => (
                          <th class="px-4 py-3 font-semibold text-ink-950">{h}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-black/5 bg-white">
                      {block.rows.map((row) => (
                        <tr>
                          {row.map((cell, i) => (
                            <td class={i === 0 ? "px-4 py-3 font-medium text-ink-950" : "px-4 py-3 text-ink-700/80"}>{cell}</td>
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              );
            return null;
          })}
        </div>
      </section>
    ))
  }
</div>
