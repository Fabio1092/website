---
import RichParagraph from "@/components/RichParagraph.astro";

type Part = string | { b: string } | { a: string; href: string };

type Block =
  | { type: "p"; parts: Part[] }
  | { type: "standalone"; text: string }
  | { type: "quote"; text: string }
  | { type: "list"; items: string[] }
  | { type: "h3"; text: string }
  | { type: "table"; headers: string[]; rows: string[][] };

interface Section {
  id: string;
  heading: string;
  blocks: Block[];
}

const introBlocks: Block[] = [
  { type: "p", parts: ["Dann stellt sich irgendwann die praktische Frage:"] },
  { type: "standalone", text: "Wie komme ich eigentlich sauber von der gesetzlichen in die private Krankenversicherung?" },
  {
    type: "p",
    parts: ["Genau an dieser Stelle würde ich nicht einfach irgendeinen PKV-Antrag ausfüllen und anschließend sofort die gesetzliche Krankenkasse kündigen."],
  },
  { type: "p", parts: ["Die Reihenfolge ist wichtig."] },
  { type: "p", parts: ["Denn vor dem eigentlichen Wechsel sollten unter anderem geklärt sein:"] },
  {
    type: "list",
    items: [
      "darfst du überhaupt in die PKV wechseln?",
      "passt die PKV langfristig zu deiner Lebensplanung?",
      "wie bewertet der Versicherer deine Gesundheitshistorie?",
      "welcher Tarif passt zu deinen Anforderungen?",
      "ab wann kann die private Krankenversicherung beginnen?",
      "wann endet deine gesetzliche Krankenversicherung?",
      "wie stellst du sicher, dass keine Versicherungslücke entsteht?",
    ],
  },
  { type: "p", parts: ["Mein Grundsatz dabei ist:"] },
  { type: "standalone", text: "Erst die PKV sauber prüfen und verbindlich absichern – danach den Austritt aus der GKV umsetzen." },
];

const sections: Section[] = [
  {
    id: "wichtigstes-in-kuerze",
