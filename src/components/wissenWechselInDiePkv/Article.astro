      { type: "p", parts: ["Diese liegt 2026 bei:"] },
      { type: "standalone", text: "69.750 Euro jährlich." },
      {
        type: "p",
        parts: [
          "Mehr zu diesem Thema findest du unter ",
          { a: "PKV Voraussetzungen: Wer kann sich privat versichern?", href: "/wissen/private-krankenversicherung/pkv-voraussetzungen/" },
