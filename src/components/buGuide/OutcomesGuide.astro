---
import { CheckCircle2, TrendingUp, ShieldOff, XCircle } from "lucide-react";

const outcomes = [
  {
    icon: CheckCircle2,
    tone: "success",
    title: "Normalannahme",
    description: "Eine Absicherung wäre auf Basis der geprüften Angaben grundsätzlich ohne besondere Erschwernisse möglich.",
  },
  {
    icon: TrendingUp,
    tone: "gold",
    title: "Risikozuschlag",
    description: "Eine Absicherung ist grundsätzlich möglich, allerdings zu einem erhöhten Beitrag.",
  },
  {
    icon: ShieldOff,
    tone: "brand",
    title: "Leistungsausschluss",
    description: "Bestimmte Erkrankungen, Körperbereiche oder daraus resultierende Ursachen können – abhängig vom konkreten Votum – vom Versicherungsschutz ausgeschlossen werden.",
  },
  {
    icon: XCircle,
    tone: "danger",
    title: "Ablehnung",
    description: "Die jeweilige Gesellschaft möchte das geprüfte Risiko nicht übernehmen.",
  },
];

const toneClasses: Record<string, string> = {
  success: "bg-success-50 text-success-600",
  gold: "bg-gold-50 text-gold-600",
  brand: "bg-brand-50 text-brand-600",
  danger: "bg-danger-50 text-danger-600",
};
---

<section id="guide-ergebnisse" class="bg-brand-50/40 py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">
        Welche <span class="text-brand-600">Ergebnisse</span> können wir bekommen?
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-700/80">
        Am Ende möchten wir wissen, welche Gesellschaft dich tatsächlich versichern würde und
        unter welchen Voraussetzungen. Mögliche Ergebnisse sind beispielsweise:
      </p>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2">
      {
        outcomes.map((outcome, index) => (
          <div
            data-reveal
            style={`transition-delay: ${index * 80}ms`}
            class="rounded-2xl border border-black/5 bg-white p-6 sm:p-7"
          >
            <div class:list={["flex h-11 w-11 items-center justify-center rounded-xl", toneClasses[outcome.tone]]}>
              <outcome.icon className="h-5 w-5" aria-hidden="true" />
            </div>
            <h3 class="mt-5 font-serif text-lg font-semibold text-ink-950">{outcome.title}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-ink-700/75">{outcome.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
