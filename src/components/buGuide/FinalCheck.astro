---
import { CheckCircle2 } from "lucide-react";

const checks = [
  "Habe ich jede Gesundheitsfrage vollständig gelesen?",
  "Habe ich den jeweiligen Fragezeitraum beachtet?",
  "Habe ich alle relevanten Arztbesuche innerhalb des abgefragten Zeitraums berücksichtigt?",
  "Habe ich Erkrankungen und Beschwerden nachvollziehbar beschrieben?",
  "Habe ich Ursache und Diagnose angegeben, soweit bekannt?",
  "Habe ich Untersuchungen und deren Ergebnisse berücksichtigt?",
  "Habe ich die Behandlung beschrieben?",
  "Habe ich mögliche Arbeitsunfähigkeiten angegeben?",
  "Habe ich beschrieben, wann die Behandlung abgeschlossen war?",
  "Ist erkennbar, seit wann ich beschwerde- und behandlungsfrei bin?",
  "Habe ich angegeben, wenn noch Beschwerden, Medikamente oder Behandlungen bestehen?",
  "Habe ich meine behandelnden Ärzte angegeben, soweit gefragt?",
  "Habe ich vorhandene relevante Unterlagen berücksichtigt?",
  "Habe ich psychische beziehungsweise psychotherapeutische Themen entsprechend der konkreten Fragestellung berücksichtigt?",
  "Habe ich meine berufliche Tätigkeit vollständig beschrieben?",
  "Habe ich Fragen zu besonderen Risiken in Beruf, Sport und Freizeit berücksichtigt?",
  "Habe ich bei Unsicherheiten nachgefragt, anstatt etwas wegzulassen oder zu raten?",
  "Sind meine Angaben vollständig und wahrheitsgemäß?",
];
---

<section id="guide-finaler-check" class="bg-brand-50/40 py-24">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">
      Dein finaler Check <span class="text-brand-600">vor dem Absenden</span>.
    </h2>
    <p class="mt-4 text-base leading-relaxed text-ink-700/80">
      Bevor du den Fragebogen abschickst, gehe diese Punkte bitte noch einmal durch:
    </p>

    <ul class="mt-8 grid gap-3 sm:grid-cols-2">
      {
        checks.map((check, index) => (
          <li data-reveal style={`transition-delay: ${(index % 6) * 60}ms`} class="flex items-start gap-2.5 rounded-xl bg-white p-4 text-sm leading-relaxed text-ink-700/85 shadow-sm">
            <CheckCircle2 className="mt-0.5 h-4.5 w-4.5 shrink-0 text-brand-500" aria-hidden="true" />
            {check}
          </li>
        ))
      }
    </ul>

    <p data-reveal class="mt-10 text-lg font-medium leading-relaxed text-ink-950">
      Alles erledigt? Dann kannst du den Fragebogen abschicken.
    </p>
  </div>
</section>
