          "Welche Leistungen sind im privaten Tarif tatsächlich vertraglich geregelt?",
          "Welche Einnahmen werde ich voraussichtlich im Ruhestand haben?",
          "Wie wichtig ist mir das Sachleistungs- oder Kostenerstattungsprinzip?",
          "Wie flexibel möchte ich zwischen unterschiedlichen Leistungsniveaus sein?",
        ],
      },
      { type: "standalone", text: "Erst wenn diese Punkte gemeinsam betrachtet werden, entsteht ein sinnvoller Systemvergleich." },
    ],
  },
  {
    id: "unterschiedliche-logiken",
    heading: "33. GKV und PKV verfolgen unterschiedliche Logiken",
    blocks: [
      { type: "p", parts: ["Die gesetzliche Krankenversicherung ist wesentlich solidarisch und einkommensbezogen organisiert."] },
      { type: "p", parts: ["Die private Krankenversicherung ist wesentlich tarif-, vertrags- und kalkulationsbezogen organisiert."] },
      { type: "p", parts: ["Daraus entstehen typische Unterschiede:"] },
      { type: "p", parts: ["Die GKV kann Familienangehörige unter bestimmten Voraussetzungen beitragsfrei einbeziehen."] },
      { type: "p", parts: ["Die PKV kalkuliert grundsätzlich für jede versicherte Person einen eigenen Beitrag."] },
      { type: "p", parts: ["Die GKV nimmt keine individuelle Gesundheitsprüfung vor."] },
      { type: "p", parts: ["Die PKV berücksichtigt das gesundheitliche Risiko grundsätzlich beim Eintritt in reguläre Tarife."] },
      { type: "p", parts: ["Die GKV bietet einen wesentlich gesetzlich definierten Leistungsrahmen."] },
      { type: "p", parts: ["Die PKV arbeitet mit vertraglich definierten Tarifleistungen."] },
      { type: "p", parts: ["Die GKV rechnet überwiegend über das Sachleistungsprinzip ab."] },
      { type: "p", parts: ["Die PKV arbeitet überwiegend nach dem Kostenerstattungsprinzip."] },
      { type: "standalone", text: "Keine dieser Eigenschaften lässt sich isoliert als grundsätzlich besser oder schlechter bewerten." },
      { type: "p", parts: ["Entscheidend ist, welche Systemlogik zur jeweiligen Lebenssituation passt."] },
    ],
  },
];
---

<div class="mx-auto max-w-3xl space-y-20 px-4 py-16 sm:px-6 lg:px-8">
  {
    sections.map((section) => (
      <section id={section.id} class="scroll-mt-24">
        <h2 class="font-serif text-2xl font-semibold tracking-tight text-ink-950 sm:text-3xl">{section.heading}</h2>
        <div data-reveal class="mt-6 space-y-4">
          {section.blocks.map((block) => {
            if (block.type === "p") return <RichParagraph parts={block.parts} />;
            if (block.type === "standalone") return <p class="text-base font-medium leading-relaxed text-ink-950">{block.text}</p>;
            if (block.type === "keyFacts")
              return (
                <div class="rounded-2xl border border-black/5 bg-brand-50/30 p-6 sm:p-8">
                  <ul class="space-y-4">
                    {block.items.map((item) => (
                      <li class="flex items-start gap-3">
                        <CheckCircle2 className="mt-0.5 h-4.5 w-4.5 shrink-0 text-brand-600" aria-hidden="true" />
                        <p class="text-sm leading-relaxed text-ink-700/85">{item}</p>
                      </li>
                    ))}
                  </ul>
                </div>
              );
            if (block.type === "quote")
              return (
                <blockquote class="border-l-2 border-brand-200 pl-5">
                  <p class="font-serif text-lg italic leading-relaxed text-ink-950">{block.text}</p>
                </blockquote>
              );
            if (block.type === "list")
              return (
                <ul class="space-y-2">
                  {block.items.map((item) => (
                    <li class="flex items-baseline gap-2.5 text-base leading-relaxed text-ink-700/85">
                      <span class="h-1.5 w-1.5 shrink-0 translate-y-[-2px] rounded-full bg-brand-400" aria-hidden="true" />
                      {item}
                    </li>
                  ))}
                </ul>
              );
            if (block.type === "h3") return <h3 class="!mt-10 font-serif text-xl font-semibold text-ink-950">{block.text}</h3>;
            if (block.type === "table")
              return (
                <div class="overflow-x-auto rounded-xl border border-black/5">
                  <table class="w-full min-w-[560px] border-collapse text-left text-sm">
                    <thead>
                      <tr class="bg-brand-50/60">
                        {block.headers.map((h) => (
                          <th class="px-4 py-3 font-semibold text-ink-950">{h}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-black/5 bg-white">
                      {block.rows.map((row) => (
                        <tr>
                          {row.map((cell, i) => (
                            <td class={i === 0 ? "px-4 py-3 font-medium text-ink-950" : "px-4 py-3 text-ink-700/80"}>{cell}</td>
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              );
            return null;
          })}
        </div>
      </section>
    ))
  }
</div>
