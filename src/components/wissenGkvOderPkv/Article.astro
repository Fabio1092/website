---
import { CheckCircle2 } from "lucide-react";
import RichParagraph from "@/components/RichParagraph.astro";

type Part = string | { b: string } | { a: string; href: string };

type Block =
  | { type: "p"; parts: Part[] }
  | { type: "standalone"; text: string }
  | { type: "keyFacts"; items: string[] }
  | { type: "quote"; text: string }
  | { type: "list"; items: string[] }
  | { type: "h3"; text: string }
  | { type: "table"; headers: string[]; rows: string[][] };

interface Section {
  id: string;
  heading: string;
  blocks: Block[];
}

const sections: Section[] = [
  {
    id: "das-wichtigste-auf-einen-blick",
    heading: "Das Wichtigste auf einen Blick",
    blocks: [
      {
        type: "keyFacts",
        items: [
          "In Deutschland ist die deutliche Mehrheit der Bevölkerung gesetzlich krankenversichert.",
          "Der Zugang zur GKV richtet sich hauptsächlich nach gesetzlichen Versicherungspflichten und Versicherungsberechtigungen.",
          "Der Zugang zur PKV setzt grundsätzlich voraus, dass keine Versicherungspflicht in der GKV entgegensteht.",
