---
import { primaryNav, legalNav } from "@/lib/nav";

const year = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-ink-950 text-white">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-[1.3fr_1fr_1fr]">
      <div>
        <a href="/" class="flex items-center gap-3" aria-label="FR Makler Startseite">
          <img src="/images/Logo.png" alt="FR Makler Logo" class="h-10 w-10 rounded-lg" width="40" height="40" />
          <span class="font-serif text-lg font-semibold">Fabio Rumpf <span class="text-brand-400">Makler</span></span>
        </a>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-white/60">
          Unabhängige Beratung zu Berufsunfähigkeit, privater Krankenversicherung und deiner
          finanziellen Absicherung — persönlich, ehrlich, auf Augenhöhe.
        </p>
      </div>

      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-white/40">Navigation</p>
        <ul class="mt-4 space-y-3">
          {
            primaryNav.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-white/70 transition-colors hover:text-white">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-white/40">Kontakt</p>
        <ul class="mt-4 space-y-3 text-sm text-white/70">
          <li>
            <a href="tel:+4915112345678" class="transition-colors hover:text-white">+49 151 123 456 78</a>
          </li>
          <li>
            <a href="mailto:info@fr-makler.de" class="transition-colors hover:text-white">info@fr-makler.de</a>
          </li>
          <li>Kassel &amp; deutschlandweit digital</li>
        </ul>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-4 border-t border-white/10 pt-8 text-sm text-white/50 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} Fabio Rumpf — Versicherungsmakler aus Kassel</p>
      <ul class="flex gap-6">
        {
          legalNav.map((link) => (
            <li>
              <a href={link.href} class="transition-colors hover:text-white">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
