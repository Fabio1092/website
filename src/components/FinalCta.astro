---
import { CheckCircle2 } from "lucide-react";
import { siteConfig } from "@/lib/site";

interface Props {
  id?: string;
  title?: string;
  titleHighlight?: string;
  body?: string;
  ctaLabel?: string;
  badges?: string[];
  points?: string[];
  closingLine?: string;
}

const {
  id,
  title = "Bereit für den nächsten Schritt?",
  titleHighlight = "nächsten Schritt",
  body = "In einem unverbindlichen Gespräch schauen wir gemeinsam, wie ich dich dabei unterstützen kann, deine Ziele zu erreichen und dein volles Potenzial zu entfalten.",
  ctaLabel = "Kostenloses Erstgespräch buchen",
  badges = ["15 Minuten · persönlich & offen", "Individuell · auf dich zugeschnitten", "Klare Schritte · dein 1:1 Fahrplan"],
  points,
  closingLine = "Persönlich. Ehrlich. Auf Augenhöhe. Kein Verkaufsgespräch, sondern ein ehrlicher Austausch über deine Situation und mögliche nächste Schritte.",
} = Astro.props;

const hIdx = titleHighlight ? title.indexOf(titleHighlight) : -1;
const titleBefore = hIdx >= 0 ? title.slice(0, hIdx) : title;
const titleMatch = hIdx >= 0 ? title.slice(hIdx, hIdx + titleHighlight!.length) : "";
const titleAfter = hIdx >= 0 ? title.slice(hIdx + titleHighlight!.length) : "";
---

<section id={id} class="relative overflow-hidden bg-ink-950 py-24 text-white">
  <div
    class="pointer-events-none absolute left-1/2 top-0 h-[28rem] w-[40rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand-500/15 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -bottom-24 right-[-8%] h-72 w-72 rounded-full bg-gold-500/10 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div data-reveal class="relative mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
    <h2 class="font-serif text-3xl font-semibold tracking-tight sm:text-4xl">
      {titleBefore}{titleMatch && <span class="text-brand-400">{titleMatch}</span>}{titleAfter}
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-lg leading-relaxed text-white/70">{body}</p>

    {
      points ? (
        <ul class="mx-auto mt-10 grid max-w-md grid-cols-1 gap-x-8 gap-y-3 text-left sm:grid-cols-2">
          {points.map((point) => (
            <li class="flex items-center gap-2.5 text-sm text-white/80">
              <CheckCircle2 className="h-5 w-5 shrink-0 text-brand-400" aria-hidden="true" />
              {point}
            </li>
          ))}
        </ul>
      ) : (
        <div class="mx-auto mt-10 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-sm text-white/70">
          {badges.map((badge) => <span>{badge}</span>)}
        </div>
      )
    }

    <a
      href={siteConfig.calendlyUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="shadow-lift mt-10 inline-flex items-center justify-center rounded-full bg-gold-500 px-8 py-4 text-sm font-semibold text-ink-950 transition-transform duration-200 hover:-translate-y-0.5 hover:bg-gold-400"
    >
      {ctaLabel}
    </a>

    <p class="mt-6 text-sm text-white/50">{closingLine}</p>
  </div>
</section>
