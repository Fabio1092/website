---
import { CheckCircle2 } from "lucide-react";
import { siteConfig } from "@/lib/site";

interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  body?: string;
  ctaLabel?: string;
  badges?: string[];
  points?: string[];
  closingLine?: string;
}

const {
  id,
  eyebrow = "Lass uns sprechen",
  title = "Bereit für den nächsten Schritt?",
  body = "In einem unverbindlichen Gespräch schauen wir gemeinsam, wie ich dich dabei unterstützen kann, deine Ziele zu erreichen und dein volles Potenzial zu entfalten.",
  ctaLabel = "Kostenloses Erstgespräch buchen",
  badges = ["15 Minuten · persönlich & offen", "Individuell · auf dich zugeschnitten", "Klare Schritte · dein 1:1 Fahrplan"],
  points,
  closingLine = "Persönlich. Ehrlich. Auf Augenhöhe. Kein Verkaufsgespräch, sondern ein ehrlicher Austausch über deine Situation und mögliche nächste Schritte.",
} = Astro.props;
---

<section id={id} class="bg-ink-950 py-24 text-white">
  <div data-reveal class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
    <span class="text-sm font-semibold uppercase tracking-wider text-brand-300">{eyebrow}</span>
    <h2 class="mt-3 font-serif text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h2>
    <p class="mx-auto mt-4 max-w-xl text-lg leading-relaxed text-white/70">{body}</p>

    {
      points ? (
        <ul class="mx-auto mt-10 grid max-w-md grid-cols-1 gap-x-8 gap-y-3 text-left sm:grid-cols-2">
          {points.map((point) => (
            <li class="flex items-center gap-2.5 text-sm text-white/80">
              <CheckCircle2 className="h-5 w-5 shrink-0 text-brand-400" aria-hidden="true" />
              {point}
            </li>
          ))}
        </ul>
      ) : (
        <div class="mx-auto mt-10 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-sm text-white/70">
          {badges.map((badge) => <span>{badge}</span>)}
        </div>
      )
    }

    <a
      href={siteConfig.calendlyUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-10 inline-flex items-center justify-center rounded-full bg-gold-500 px-8 py-4 text-sm font-semibold text-ink-950 shadow-lg shadow-gold-500/20 transition-transform duration-200 hover:-translate-y-0.5 hover:bg-gold-400"
    >
      {ctaLabel}
    </a>

    <p class="mt-6 text-sm text-white/50">{closingLine}</p>
  </div>
</section>
