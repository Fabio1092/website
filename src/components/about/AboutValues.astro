---
import { HeartHandshake, ListChecks, Scale, Users } from "lucide-react";

const values = [
  {
    icon: HeartHandshake,
    title: "Verstehen vor Verkaufen",
    text: "Ich möchte zuerst verstehen, was du brauchst und was du erreichen möchtest. Erst danach sprechen wir über konkrete Lösungen.",
  },
  {
    icon: ListChecks,
    title: "Klare Empfehlungen",
    text: "Du erhältst von mir keine unübersichtliche Tarifliste. Ich zeige dir verständlich, welche Möglichkeiten sinnvoll sind und wo die jeweiligen Vor- und Nachteile liegen.",
  },
  {
    icon: Scale,
    title: "Ehrlichkeit in beide Richtungen",
    text: "Ich empfehle dir nur eine Lösung, von der ich überzeugt bin. Ist ein Abschluss oder Wechsel für dich nicht sinnvoll, sage ich dir das genauso offen.",
  },
  {
    icon: Users,
    title: "Persönliche Begleitung",
    text: "Meine Arbeit endet nicht mit deiner Unterschrift. Auch nach dem Abschluss bleibe ich dein Ansprechpartner und begleite dich bei späteren Fragen oder Veränderungen.",
  },
];
---

<section id="about-werte" class="bg-ink-950 py-24 text-white">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="mt-3 font-serif text-3xl font-semibold tracking-tight sm:text-4xl">
        Du sollst <span class="text-brand-400">verstehen</span>, was du entscheidest.
      </h2>
    </div>

    <div class="mt-14 grid gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10 sm:grid-cols-2 lg:grid-cols-4">
      {
        values.map((value) => (
          <div class="bg-ink-950 p-8">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-white/5 text-gold-400">
              <value.icon className="h-5 w-5" aria-hidden="true" />
            </div>
            <h3 class="mt-5 text-base font-semibold text-white">{value.title}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-white/60">{value.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
