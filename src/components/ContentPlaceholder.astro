---
interface Props {
  note?: string;
}

const { note = "Inhalt folgt, sobald der Text für diese Seite vorliegt." } = Astro.props;
---

<div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
  <div class="rounded-2xl border-2 border-dashed border-brand-200 bg-brand-50/40 px-8 py-14 text-center">
    <p class="text-sm font-medium text-brand-700">{note}</p>
  </div>
</div>
