---
import RichParagraph from "@/components/RichParagraph.astro";
import HanseMerkurLogo from "./HanseMerkurLogo.astro";
import { dogHealthTariffTiers } from "@/lib/dogInsurance";
---

<section id="komfort-premium-premium-plus" class="scroll-mt-24 bg-white py-14 sm:py-20">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <h2 class="hyphens-auto break-words font-serif text-2xl font-semibold tracking-tight text-ink-950 sm:text-3xl">
      HanseMerkur Hundekrankenversicherung: <span class="text-brand-600">Komfort, Premium oder Premium plus?</span>
    </h2>

    <div class="mt-6 max-w-2xl space-y-4">
      <RichParagraph
        parts={["Der größte Unterschied liegt nicht in einem kleinen Extra, sondern in der Frage, ", { b: "wie weit der Schutz tatsächlich geht" }, "."]}
        class="text-base leading-relaxed text-ink-700/85"
      />
      <RichParagraph
        parts={["Im aktuellen Tarifvergleich liegt die Jahreshöchstentschädigung für Operationen und allgemeine Behandlungen bei Komfort bei 2.500 Euro und bei Premium bei 5.000 Euro."]}
        class="text-base leading-relaxed text-ink-700/85"
      />
      <RichParagraph parts={["Im Premium-plus-Tarif ist sie grundsätzlich unbegrenzt."]} class="text-base leading-relaxed text-ink-700/85" />
      <RichParagraph parts={["Das allein ist für mich bereits ein sehr wichtiger Unterschied."]} class="text-base leading-relaxed text-ink-700/85" />
      <RichParagraph parts={["Bei einer einzigen größeren Operation können 2.500 Euro relativ schnell erreicht sein."]} class="text-base leading-relaxed text-ink-700/85" />
      <RichParagraph
        parts={["Auch 5.000 Euro klingen zunächst nach viel – bis in einem Versicherungsjahr vielleicht eine Operation, weitere Diagnostik und zusätzliche Erkrankungen zusammenkommen."]}
        class="text-base leading-relaxed text-ink-700/85"
      />

      <div class="rounded-2xl border border-brand-200 bg-brand-50/50 px-6 py-5">
        <RichParagraph
          parts={[{ b: "Genau deshalb gefällt mir die grundsätzlich unbegrenzte Jahreshöchstentschädigung von Premium plus." }]}
          class="font-serif text-lg font-medium leading-relaxed text-ink-950"
          boldClass="text-ink-950"
        />
      </div>

      <RichParagraph
        parts={["Premium und Premium plus leisten außerdem bis zum 4-fachen GOT-Satz inklusive Notdienstgebühren, während Komfort bis zum 3-fachen Satz geht."]}
        class="text-base leading-relaxed text-ink-700/85"
      />
    </div>

    <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-3">
      {
        dogHealthTariffTiers.map((tier) => (
          <div class={`relative rounded-2xl border p-6 shadow-soft ${tier.isFavorite ? "border-brand-300 bg-brand-50/30" : "border-black/5 bg-white"}`}>
            {tier.isFavorite && (
              <span class="absolute -top-3 right-5 rounded-full bg-brand-600 px-3 py-1 text-[10px] font-semibold uppercase tracking-wide text-white">
                Fabios Empfehlung
              </span>
            )}
            <div class="flex h-10 w-20 items-center justify-center rounded-lg border border-black/5 bg-white p-1.5">
              <HanseMerkurLogo />
            </div>
            <p class="mt-4 font-serif text-xl font-semibold text-ink-950">{tier.name}</p>
            <dl class="mt-4 space-y-3 border-t border-black/5 pt-4">
              <div>
                <dt class="text-xs font-semibold uppercase tracking-wide text-ink-700/50">Jahreshöchstentschädigung</dt>
                <dd class="mt-1 text-sm font-medium text-ink-950">{tier.jahreshoechstentschaedigung}</dd>
              </div>
              <div>
                <dt class="text-xs font-semibold uppercase tracking-wide text-ink-700/50">GOT-Satz</dt>
                <dd class="mt-1 text-sm font-medium text-ink-950">{tier.gotSatz}</dd>
              </div>
            </dl>
          </div>
        ))
      }
    </div>
  </div>
</section>
