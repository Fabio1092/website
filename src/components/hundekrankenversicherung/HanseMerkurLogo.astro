---
// Logo-Slot für die HanseMerkur: kein Markenasset im Projekt vorhanden.
// Bis ein echtes Logo ergänzt wird, zeigt sich stattdessen sauber der
// Gesellschaftsname als Text — kein <img> auf eine nicht existierende Datei,
// damit kein 404 ausgelöst wird.
interface Props {
  class?: string;
}
const { class: className = "h-full w-full object-contain" } = Astro.props;
---

<span class:list={["flex items-center justify-center font-serif text-xs font-semibold text-ink-950 sm:text-sm", className]}>HanseMerkur</span>
