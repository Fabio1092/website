---
// Logo-Slot für die HanseMerkur: kein Markenasset im Projekt vorhanden, daher
// wird hier nur der Pfad vorbereitet (siehe Task-Vorgabe). Schlägt das Bild
// fehl, zeigt sich stattdessen sauber der Gesellschaftsname als Text – kein
// kaputtes Bild-Icon in Produktion, bis das echte Logo ergänzt wird.
interface Props {
  class?: string;
}
const { class: className = "h-full w-full object-contain" } = Astro.props;
---

<img
  src="/images/insurers/hansemerkur.svg"
  alt="HanseMerkur Logo"
  class={className}
  width="120"
  height="40"
  loading="lazy"
  onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'"
/>
<span class="hidden h-full w-full items-center justify-center font-serif text-xs font-semibold text-ink-950 sm:text-sm">HanseMerkur</span>
