---
import GuideAssessment from "@/components/ratgeber/GuideAssessment.astro";
import { guides } from "@/lib/guides";

const guide = guides.find((g) => g.slug === "hundekrankenversicherung")!;
const updatedLabel = new Intl.DateTimeFormat("de-DE", { day: "numeric", month: "long", year: "numeric" }).format(new Date(guide.updatedAt!));
---

<section id="guide-hero" class="relative overflow-hidden bg-ink-950 text-white">
  <div class="pointer-events-none absolute -top-40 right-[-10%] h-[32rem] w-[32rem] rounded-full bg-brand-500/20 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -bottom-32 left-[-10%] h-[26rem] w-[26rem] rounded-full bg-gold-500/10 blur-3xl" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    <a
      href="/ratgeber/#tiere"
      class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-brand-300 transition-colors hover:text-brand-200"
    >
      Ratgeber · Hund &amp; Tiergesundheit
    </a>

    <h1 class="mt-5 hyphens-auto break-words text-3xl font-semibold leading-tight tracking-tight sm:text-4xl lg:text-5xl">
      Hundekrankenversicherung &amp; Hunde-OP-Versicherung: <span class="text-brand-400">Kosten, Leistungen &amp; meine Empfehlung</span>
    </h1>

    <p class="mt-4 max-w-xl font-serif text-xl leading-snug text-white sm:text-2xl">
      Ein Tierarztbesuch ist oft überschaubar. Eine größere Behandlung oder Operation kann dagegen
      schnell mehrere tausend Euro kosten.
    </p>

    <div class="mt-4 max-w-xl space-y-4 text-base leading-relaxed text-white/70 sm:text-lg">
      <p>
        Ein Hund gehört für die meisten Besitzer zur Familie. Wenn er krank wird oder sich
        verletzt, möchte vermutlich niemand zuerst darüber nachdenken müssen, ob eine notwendige
        Behandlung finanziell gerade ins Budget passt.
      </p>
      <p>
        Genau dafür gibt es die Hundekrankenversicherung beziehungsweise als günstigere Alternative
        die reine Hunde-OP-Versicherung.
      </p>
      <p>Denn moderne Tiermedizin kann viel – sie kann aber auch teuer werden.</p>
      <p>
        Ein Kreuzbandriss, eine Magendrehung, ein Bandscheibenvorfall oder ein verschluckter
        Fremdkörper können schnell Rechnungen im vierstelligen Bereich verursachen. Dazu kommen die
        ganz normalen Tierarztkosten über das Hundeleben hinweg: Diagnostik, Medikamente,
        Allergien, Magen-Darm-Probleme, Ohrenentzündungen, Physiotherapie oder Zahnbehandlungen.
      </p>
      <p class="font-medium text-white">
        Meine persönliche Empfehlung ist deshalb klar: Wer diese Kosten nicht bewusst vollständig
        aus der eigenen Liquidität tragen möchte, sollte sich frühzeitig mit einer Hundekranken-
        oder zumindest einer Hunde-OP-Versicherung beschäftigen.
      </p>
      <p>
        Mein Favorit ist dabei aktuell die <span class="font-medium text-white">HanseMerkur – insbesondere die Tariflinie Premium plus</span>.
      </p>
      <p>Warum, erkläre ich dir auf dieser Seite.</p>
    </div>

    <GuideAssessment
      beratungsbedarf="mittel"
      wer="Hundehalter, die hohe Tierarzt- und Operationskosten nicht vollständig selbst tragen möchten"
      favoritenLabel="Mein Favorit"
      favoriten="HanseMerkur Premium plus"
    />

    <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
      <a
        href="#warum-hansemerkur"
        class="inline-flex items-center justify-center rounded-full bg-gold-500 px-6 py-3 text-sm font-semibold text-ink-950 shadow-lg shadow-gold-500/20 transition-transform duration-200 hover:-translate-y-0.5 hover:bg-gold-400"
      >
        Meine Empfehlung ansehen
      </a>
      <a
        href="#was-kann-behandlung-kosten"
        class="inline-flex items-center justify-center gap-1.5 rounded-full border border-white/20 px-6 py-3 text-sm font-semibold text-white/90 transition-colors hover:border-white/40 hover:text-white"
      >
        Kostenrisiko verstehen
      </a>
    </div>

    <p class="mt-6 text-xs text-white/45">
      Von Fabio Rumpf – Versicherungsmakler aus Kassel · Zuletzt aktualisiert: {updatedLabel} ·
      <a href="/ueber-mich/" class="underline decoration-white/20 underline-offset-2 hover:text-white/70">Über mich</a>
    </p>
  </div>
</section>
