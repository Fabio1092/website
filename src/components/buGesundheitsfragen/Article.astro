      { type: "callout", text: "Gleicher Kunde. Gleicher Rücken. Gleiche Vergangenheit. Andere Gesundheitsfrage." },
      { type: "p", parts: ["Genau deshalb darf man beim BU-Antrag niemals einfach sagen:"] },
      { type: "quote", text: "„Ach, das war doch nichts.“" },
      { type: "p", parts: ["Entscheidend ist ausschließlich, ", { b: "was der jeweilige Versicherer konkret in Textform wissen möchte." }] },
    ],
  },
