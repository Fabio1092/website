---
import RichParagraph from "@/components/RichParagraph.astro";

type Part = string | { b: string };

type Block =
  | { type: "p"; parts: Part[] }
  | { type: "standalone"; text: string }
  | { type: "callout"; text: string }
  | { type: "quote"; text: string }
  | { type: "list"; items: string[] }
  | { type: "h3"; text: string }
  | { type: "statRow"; items: string[] }
  | { type: "resultsList"; items: { label: string; value: string }[] }
  | { type: "steps"; items: { title: string; body: string }[] }
  | { type: "table"; headers: string[]; rows: string[][] }
  | {
      type: "compare";
      labelA: string;
      textA: string;
      noteA?: string;
      labelB: string;
      textB: string;
      noteB?: string;
      quoted?: boolean;
    }
  | { type: "quotePair"; goodLabel: string; good: string; badLabel: string; bad: string };

interface Section {
  id: string;
  heading: string;
  blocks: Block[];
}

const sections: Section[] = [
  {
    id: "welche-gesundheitsfragen",
    heading: "Welche Gesundheitsfragen stellt eine Berufsunfähigkeitsversicherung?",
    blocks: [
      { type: "p", parts: ["Eine Berufsunfähigkeitsversicherung möchte einschätzen, wie hoch das Risiko ist, dass du während der Vertragslaufzeit berufsunfähig wirst."] },
      { type: "p", parts: ["Dafür werden je nach Versicherer insbesondere folgende Bereiche abgefragt:"] },
      {
        type: "list",
        items: [
          "Erkrankungen und Beschwerden",
          "ambulante Behandlungen",
          "Krankenhausaufenthalte",
          "Operationen",
          "psychische oder psychosomatische Beschwerden",
          "Erkrankungen des Bewegungsapparates",
          "Herz- und Kreislauferkrankungen",
          "Allergien und Atemwegserkrankungen",
          "Medikamente",
          "laufende oder geplante Untersuchungen",
          "Arbeitsunfähigkeiten",
          "bestehende körperliche oder geistige Beeinträchtigungen",
          "teilweise frühere Versicherungsanträge oder Ablehnungen",
        ],
      },
      { type: "p", parts: ["Eine „Ja“-Antwort bedeutet dabei keineswegs automatisch, dass du keine Berufsunfähigkeitsversicherung bekommst."] },
      { type: "standalone", text: "Viel wichtiger ist:" },
      { type: "callout", text: "Was genau steckt hinter dieser Ja-Antwort?" },
      {
        type: "p",
        parts: [
          "Ein einmaliger Hexenschuss vor vier Jahren ist etwas anderes als seit Jahren bestehende chronische Rückenbeschwerden. Eine kurze psychologische Beratung wegen einer akuten Belastungssituation ist etwas anderes als eine langjährige Psychotherapie mit laufender Medikation.",
        ],
      },
      { type: "p", parts: ["Deshalb beginnt eine gute BU-Beratung für mich nicht mit der Frage:"] },
      { type: "quote", text: "„Welche Gesellschaft ist die günstigste?“" },
      { type: "p", parts: ["Sondern:"] },
      { type: "quote", text: "„Was ist gesundheitlich tatsächlich passiert und welcher Versicherer kann damit am sinnvollsten umgehen?“" },
    ],
  },
  {
    id: "offene-geschlossene-fragen",
    heading: "Der vielleicht wichtigste Unterschied: offene und geschlossene Gesundheitsfragen",
    blocks: [
      { type: "p", parts: ["Wenn du nur einen Punkt aus diesem Artikel mitnimmst, dann diesen:"] },
      { type: "callout", text: "Nicht nur der Zeitraum einer Gesundheitsfrage ist entscheidend. Mindestens genauso wichtig ist ihre Formulierung." },
      { type: "p", parts: ["Zwei Versicherer können beispielsweise beide einen Zeitraum von fünf Jahren abfragen – und trotzdem etwas vollkommen Unterschiedliches von dir wissen wollen."] },
      { type: "h3", text: "Beispiel einer offenen Gesundheitsfrage" },
      { type: "p", parts: ["Eine offene Fragestellung kann sinngemäß so aussehen:"] },
      { type: "quote", text: "„Bestehen oder bestanden in den letzten fünf Jahren Krankheiten, Beschwerden oder Funktionsstörungen?“" },
      { type: "p", parts: ["Das Problem:"] },
      { type: "standalone", text: "Die Frage setzt keinen Arztbesuch voraus." },
      {
        type: "p",
        parts: ["Du musst dir also theoretisch Gedanken darüber machen, welche Beschwerden du innerhalb dieses Zeitraums hattest – selbst wenn du deswegen nie bei einem Arzt oder Therapeuten warst."],
      },
      { type: "p", parts: ["Wo beginnt eine relevante Beschwerde?"] },
      {
        type: "list",
        items: [
          "Bei einmaligen Rückenschmerzen nach dem Fitnessstudio?",
          "Bei Kopfschmerzen?",
          "Bei gelegentlichem Ziehen im Knie?",
          "Bei zwei schlaflosen Nächten?",
        ],
      },
      { type: "p", parts: ["Genau hier entsteht Interpretationsspielraum."] },
      {
        type: "p",
        parts: ["Frühere Antragsversionen verschiedener Versicherer haben mit solchen sehr offenen Formulierungen gearbeitet. Auch die Nürnberger fragte beispielsweise lange sehr breit nach:"],
      },
      { type: "quote", text: "„Bestehen oder bestanden in den letzten 5 Jahren Krankheiten, Beschwerden oder Funktionsstörungen …“" },
      { type: "p", parts: ["Inzwischen wurden die Fragen dort deutlich überarbeitet und reine Beschwerdefragen zeitlich verkürzt."] },
      { type: "h3", text: "Geschlossene Gesundheitsfragen sind häufig kundenfreundlicher" },
      { type: "p", parts: ["Deutlich klarer finde ich Fragen, die an einen konkreten medizinischen Kontakt anknüpfen."] },
      { type: "p", parts: ["Der Volkswohl Bund formuliert beispielsweise sinngemäß:"] },
      { type: "quote", text: "„Wurden Sie in den nachfolgend genannten Zeiträumen wegen Erkrankungen oder Beschwerden ärztlich oder therapeutisch beraten, untersucht oder behandelt?“" },
      { type: "p", parts: ["Der entscheidende Unterschied:"] },
      { type: "p", parts: ["Es wird nicht einfach danach gefragt, ob irgendwann einmal irgendeine Beschwerde vorhanden war."] },
      { type: "standalone", text: "Die Frage knüpft an eine Beratung, Untersuchung oder Behandlung an." },
      { type: "p", parts: ["Auch AXA arbeitet mit einer vergleichsweise klaren Fragelogik:"] },
      {
        type: "quote",
        text: "„Sind oder waren Sie in den letzten 5 Jahren in Beratung, Behandlung oder Untersuchung bei Ärzten, Heilpraktikern, Physio-, Psycho- oder sonstigen nichtärztlichen Therapeuten wegen Krankheiten oder Unfallfolgen …“",
      },
      { type: "p", parts: ["Auch hier steht der tatsächliche Kontakt mit einem Arzt oder Therapeuten im Vordergrund."] },
      { type: "standalone", text: "Für einen Kunden ist das wesentlich klarer." },
    ],
  },
  {
    id: "praxisbeispiel-ruecken",
