      },
      {
        type: "compare",
        quoted: true,
        labelA: "Versicherer A fragt",
        textA: "Bestanden in den letzten fünf Jahren Beschwerden des Bewegungsapparates?",
        noteA: "Hier kann der Sachverhalt grundsätzlich unter die Frage fallen.",
        labelB: "Versicherer B fragt",
        textB: "Wurden Sie in den letzten fünf Jahren wegen Erkrankungen oder Beschwerden des Bewegungsapparates ärztlich oder therapeutisch beraten, untersucht oder behandelt?",
