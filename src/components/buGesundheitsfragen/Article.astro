        items: [
          "Welche Diagnose wurde gestellt?",
          "Wann trat sie erstmals auf?",
          "Wann war die letzte Behandlung?",
          "Welche Therapie fand statt?",
          "Welche Medikamente wurden genommen?",
          "Wie lange bestand Arbeitsunfähigkeit?",
          "Bestehen aktuell Beschwerden?",
          "Ist die Behandlung abgeschlossen?",
          "Gibt es Folgeschäden?",
        ],
      },
      { type: "p", parts: ["Je sauberer wir diese Informationen aufbereiten, desto besser kann ein Risikoprüfer die Situation einschätzen."] },
      { type: "h3", text: "Beispiel: „Rückenschmerzen“ ist für einen Risikoprüfer viel zu wenig" },
      { type: "p", parts: ["Stell dir zwei Angaben vor."] },
      {
        type: "compare",
        quoted: false,
        labelA: "Variante 1",
        textA: "Rückenschmerzen.",
        noteA: "Das sagt dem Risikoprüfer fast nichts.",
        labelB: "Variante 2",
        textB:
          "Einmalige muskuläre Verspannung nach sportlicher Belastung im Februar 2023. Zwei physiotherapeutische Behandlungen, keine Bildgebung, keine Arbeitsunfähigkeit, keine Medikamente, Behandlung abgeschlossen, seitdem vollständig beschwerde- und behandlungsfrei.",
        noteB: "Das ist eine vollkommen andere Informationsqualität.",
      },
      { type: "p", parts: ["Genau deshalb ist die ", { b: "Aufbereitung der Gesundheitshistorie häufig wichtiger als die bloße Anzahl der Diagnosen." }] },
    ],
  },
  {
    id: "anonyme-risikovoranfrage",
    heading: "Warum ich bei Vorerkrankungen häufig eine anonyme Risikovoranfrage mache",
    blocks: [
      { type: "p", parts: ["Wenn relevante Vorerkrankungen bestehen, stelle ich nicht einfach einen Antrag bei fünf Gesellschaften und schaue, wer ihn annimmt."] },
      { type: "p", parts: ["Ich gehe einen Schritt vorher."] },
      { type: "p", parts: ["Wir bereiten die gesundheitlichen Angaben gemeinsam auf und führen bei ausgewählten Gesellschaften eine ", { b: "anonyme Risikovoranfrage" }, " durch."] },
      { type: "p", parts: ["Dabei bekommt der Risikoprüfer die notwendigen Informationen über:"] },
      {
        type: "list",
        items: ["Alter,", "Beruf,", "gewünschte BU-Rente,", "Diagnose,", "Behandlungszeitraum,", "Therapie,", "aktuellen Gesundheitszustand", "und gegebenenfalls medizinische Unterlagen."],
      },
      { type: "p", parts: ["Persönliche Identifikationsmerkmale werden dabei soweit möglich nicht Bestandteil der Voranfrage."] },
      { type: "p", parts: ["Anschließend erhalten wir ein Votum."] },
      { type: "p", parts: ["Beispielsweise:"] },
      { type: "statRow", items: ["Normalannahme", "Risikozuschlag", "Leistungsausschluss", "Zurückstellung", "Ablehnung"] },
      { type: "h3", text: "Warum ist eine anonyme Risikovoranfrage sinnvoll?" },
      { type: "p", parts: ["Der größte Vorteil:"] },
      { type: "callout", text: "Wir kennen die Reaktion des Versicherers, bevor wir den eigentlichen Antrag stellen." },
      { type: "p", parts: ["Dadurch können wir verschiedene Risikoprüfer gezielt vergleichen."] },
      { type: "p", parts: ["Beispiel:"] },
      { type: "p", parts: ["Wir fragen fünf sinnvoll ausgewählte Gesellschaften an."] },
      { type: "p", parts: ["Die Ergebnisse:"] },
      {
        type: "resultsList",
        items: [
          { label: "Versicherer A", value: "Ablehnung" },
          { label: "Versicherer B", value: "Ausschluss Wirbelsäule" },
          { label: "Versicherer C", value: "+25 % Risikozuschlag" },
          { label: "Versicherer D", value: "Normalannahme" },
          { label: "Versicherer E", value: "Zurückstellung für zwölf Monate" },
        ],
      },
      { type: "p", parts: ["Jetzt haben wir eine vollkommen andere Entscheidungsgrundlage."] },
      { type: "p", parts: ["Ohne Voranfrage hättest du möglicherweise direkt bei Versicherer A einen Antrag gestellt."] },
      { type: "p", parts: ["Mit der Voranfrage wissen wir vorher:"] },
      { type: "standalone", text: "Versicherer D beurteilt deinen Fall möglicherweise erheblich besser." },
      { type: "h3", text: "Warum frage ich nicht einfach bei 20 Versicherern an?" },
      { type: "p", parts: ["Weil eine gute Risikovoranfrage kein Massenspam ist."] },
      { type: "p", parts: ["Ich wähle vorab aus:"] },
      {
        type: "list",
        items: [
          "Welche Gesundheitsfragen passen zur Vorgeschichte?",
          "Welche Gesellschaft hat bei dieser Diagnose erfahrungsgemäß eine interessante Risikoprüfung?",
          "Welcher Tarif erfüllt gleichzeitig die fachlichen Anforderungen?",
          "Welche Versicherer kommen preislich sinnvoll infrage?",
        ],
      },
      { type: "p", parts: ["Dann frage ich gezielt an."] },
      { type: "p", parts: ["Das bringt in der Praxis meist bessere Ergebnisse als eine schlecht vorbereitete Anfrage an den kompletten Markt."] },
    ],
  },
  {
    id: "sonderaktionen",
    heading: "Sonderaktionen mit vereinfachten Gesundheitsfragen",
    blocks: [
      { type: "p", parts: ["Ein weiterer großer Hebel sind ", { b: "BU-Sonderaktionen" }, "."] },
      { type: "p", parts: ["Versicherer bieten immer wieder vereinfachte Gesundheitsprüfungen an."] },
      { type: "p", parts: ["Diese können beispielsweise gebunden sein an:"] },
      {
        type: "list",
        items: [
          "ein bestimmtes Eintrittsalter,",
          "bestimmte Berufe,",
          "bestimmte Studiengänge,",
          "Schüler oder Studenten,",
          "eine Immobilienfinanzierung,",
          "bestimmte Versorgungswerke,",
          "Arbeitgeberkonzepte",
          "oder eine maximale BU-Rente.",
        ],
      },
      { type: "p", parts: ["Teilweise werden dann nur sehr wenige Fragen gestellt oder die Abfragezeiträume erheblich verkürzt."] },
      {
        type: "p",
        parts: ["So gibt es beispielsweise Aktionen, bei denen teilweise nur 24 Monate betrachtet werden. Andere Angebote richten sich an Personen unter 30 oder 35 Jahren oder begrenzen die BU-Rente beispielsweise auf 1.500 bis 2.000 Euro."],
      },
      { type: "p", parts: ["Das kann bei der passenden Gesundheitshistorie extrem wertvoll sein."] },
      { type: "h3", text: "Sind vereinfachte Gesundheitsfragen automatisch besser?" },
      { type: "standalone", text: "Nein." },
      { type: "p", parts: ["Das ist wichtig."] },
      { type: "p", parts: ["Eine Sonderaktion ist nicht automatisch der beste Vertrag."] },
      { type: "p", parts: ["Wir müssen gleichzeitig prüfen:"] },
      {
        type: "list",
        items: [
          "Wie gut sind die Versicherungsbedingungen?",
          "Welche BU-Rente ist möglich?",
          "Welche Dynamik kann eingeschlossen werden?",
          "Welche Nachversicherungsmöglichkeiten gibt es?",
          "Passt die Berufsgruppe?",
          "Wie hoch ist der Beitrag?",
          "Welche Gesundheitsfragen werden trotz Vereinfachung gestellt?",
        ],
      },
      { type: "p", parts: ["Deshalb kenne und prüfe ich bei meinen Kunden nicht nur die regulären Gesundheitsfragen, sondern auch die aktuell verfügbaren Sonderaktionen."] },
      { type: "standalone", text: "Der Kunde muss diesen Markt nicht selbst überblicken." },
      { type: "p", parts: ["Genau das ist meine Aufgabe."] },
    ],
  },
  {
    id: "untersuchungsgrenzen",
    heading: "Wie hoch kann eine BU ohne zusätzliche ärztliche Untersuchung abgeschlossen werden?",
    blocks: [
      { type: "p", parts: ["Auch hier unterscheiden sich die Versicherer."] },
      { type: "p", parts: ["Bis zu einer bestimmten BU-Rente reichen häufig die normalen Gesundheitsfragen."] },
      { type: "p", parts: ["Wird eine höhere monatliche BU-Rente beantragt, können zusätzliche Anforderungen entstehen."] },
      { type: "p", parts: ["Dazu gehören beispielsweise:"] },
      { type: "list", items: ["ärztliches Zeugnis,", "Hausarztbericht,", "Blutuntersuchung,", "HIV-Test,", "Ruhe-EKG,", "Belastungs-EKG", "oder weitere medizinische Unterlagen."] },
      {
        type: "p",
        parts: [
          "Die regulären Untersuchungsgrenzen liegen bei vielen Anbietern – abhängig insbesondere vom Eintrittsalter – ungefähr zwischen ",
          { b: "2.000 und 3.000 Euro" },
          " monatlicher BU-Rente.",
        ],
      },
      { type: "h3", text: "Warum eine Untersuchungsgrenze strategisch wichtig sein kann" },
      { type: "p", parts: ["Nehmen wir an, du möchtest eine BU-Rente von 4.000 Euro."] },
      { type: "p", parts: ["Versicherer A verlangt oberhalb von 3.000 Euro ein ärztliches Zeugnis."] },
      { type: "p", parts: ["Damit kann sich plötzlich nicht nur der Umfang der medizinischen Prüfung verändern."] },
      { type: "p", parts: ["Es können auch zusätzliche oder teilweise weitergehende Gesundheitsfragen entstehen."] },
      { type: "p", parts: ["Erweiterte ärztliche Fragebögen können dabei teilweise Fragen enthalten, die zeitlich deutlich weiter reichen als der normale BU-Antrag."] },
      { type: "p", parts: ["Deshalb muss bei hohen BU-Renten die Antragsstrategie noch sorgfältiger geplant werden."] },
      { type: "h3", text: "Kann man eine hohe BU-Rente auf mehrere Versicherer verteilen?" },
      { type: "p", parts: ["Grundsätzlich kann eine Aufteilung auf mehrere Verträge sinnvoll sein."] },
      { type: "p", parts: ["Beispiel:"] },
      { type: "p", parts: ["Statt 4.000 Euro bei einer Gesellschaft könnten je nach individueller Situation beispielsweise:"] },
      { type: "callout", text: "2.000 Euro + 2.000 Euro" },
      { type: "p", parts: ["bei zwei Versicherern geprüft werden."] },
      { type: "p", parts: ["Das kann Vorteile haben – etwa hinsichtlich späterer Flexibilität oder verschiedener Risikoprüfungsgrenzen."] },
      { type: "p", parts: ["Aber:"] },
      { type: "standalone", text: "Eine solche Aufteilung ist kein Trick, um Gesundheits- oder Versicherungsfragen zu umgehen." },
      { type: "p", parts: ["Bestehende und gleichzeitig beantragte Absicherungen müssen entsprechend der jeweiligen Fragen selbstverständlich korrekt angegeben werden."] },
      { type: "p", parts: ["Ob eine Aufteilung sinnvoll ist, muss individuell geprüft werden."] },
    ],
  },
  {
    id: "eigenschaften-kundenfreundlich",
    heading: "Welche Gesundheitsfragen sind für mich besonders kundenfreundlich?",
    blocks: [
      { type: "p", parts: ["Wenn ich Gesundheitsfragen bewerte, gefallen mir insbesondere folgende Eigenschaften:"] },
      { type: "h3", text: "1. Konkreter Arztbezug" },
      {
        type: "quotePair",
        goodLabel: "Gut",
        good: "Waren Sie wegen … in ärztlicher Behandlung oder Untersuchung?",
        badLabel: "Schwieriger",
        bad: "Bestanden Krankheiten oder Beschwerden?",
      },
      { type: "h3", text: "2. Kurze und eindeutig definierte Zeiträume" },
      { type: "p", parts: ["Drei oder fünf Jahre sind einfacher aufzuarbeiten als zehn Jahre."] },
      { type: "h3", text: "3. Kurze Beschwerdezeiträume" },
      { type: "p", parts: ["Wenn nach Beschwerden ohne Arztkontakt gefragt wird, finde ich kurze Zeiträume grundsätzlich kundenfreundlicher als mehrere Jahre."] },
      { type: "h3", text: "4. Klare Bagatellausschlüsse" },
      {
        type: "p",
        parts: ["Wenn der Versicherer ausdrücklich sagt, dass folgenlos ausgeheilte Erkältungen oder unauffällige Vorsorgeuntersuchungen nicht angegeben werden müssen, entsteht weniger Interpretationsspielraum."],
      },
      { type: "h3", text: "5. Klare Formulierungen zu geplanten Maßnahmen" },
      { type: "p", parts: ["Der Kunde muss erkennen können, ob ausschließlich durchgeführte oder auch angeratene Untersuchungen erfasst werden."] },
    ],
  },
  {
    id: "mein-vorgehen",
    heading: "Mein Vorgehen bei den Gesundheitsfragen",
    blocks: [
      { type: "p", parts: ["Ich würde die Gesundheitsprüfung niemals isoliert betrachten."] },
      { type: "p", parts: ["Mein Prozess sieht typischerweise so aus:"] },
      {
        type: "steps",
        items: [
          { title: "Gesundheitshistorie erfassen", body: "Was ist in den relevanten Jahren gesundheitlich passiert?" },
          { title: "Medizinische Unterlagen prüfen", body: "Falls notwendig, beschaffen und bewerten wir Unterlagen." },
          { title: "Diagnosen aufbereiten", body: "Nicht nur Diagnose nennen, sondern Verlauf, Therapie und heutigen Zustand erklären." },
          { title: "Gesundheitsfragen des Marktes vergleichen", body: "Jetzt schauen wir konkret: Welche Gesellschaft fragt was?" },
          { title: "Sonderaktionen prüfen", body: "Gibt es aktuell eine vereinfachte Gesundheitsprüfung, die zu dir passt?" },
          { title: "Risikovoranfrage durchführen", body: "Bei relevanten Vorerkrankungen hole ich gezielte anonyme Voten ein." },
          { title: "Versicherungsbedingungen und Beiträge vergleichen", body: "Erst jetzt kommt die klassische Tarifauswahl." },
          { title: "Antrag stellen", body: "Nachdem die Strategie steht, erfolgt der eigentliche Antrag." },
        ],
      },
    ],
  },
  {
    id: "guenstigster-tarif-beispiel",
    heading: "Praxisbeispiel: Warum der günstigste BU-Tarif wertlos sein kann",
    blocks: [
      { type: "p", parts: ["Stell dir vor:"] },
      { type: "list", items: ["32 Jahre alt", "Ingenieur", "2.500 Euro gewünschte BU-Rente", "Psychotherapie vor sechs Jahren", "seitdem vollständig beschwerdefrei"] },
      {
        type: "compare",
        quoted: false,
        labelA: "Versicherer A",
        textA: "Beitrag: 71 Euro",
        noteA: "Psychotherapie wird 10 Jahre abgefragt.",
        labelB: "Versicherer B",
        textB: "Beitrag: 79 Euro",
        noteB: "Psychotherapie wird 5 Jahre abgefragt.",
      },
      { type: "p", parts: ["Ein Vergleichsrechner zeigt zunächst:"] },
      { type: "standalone", text: "Versicherer A ist günstiger." },
      { type: "p", parts: ["Für deinen individuellen Fall kann Versicherer B trotzdem die interessantere Ausgangslage bieten."] },
      { type: "p", parts: ["Und genau deshalb ist eine BU kein Produkt, das man ausschließlich über Preislisten vergleichen sollte."] },
    ],
  },
  {
    id: "nicht-alles",
    heading: "Die Gesundheitsfragen sind wichtig – aber nicht alles",
    blocks: [
      { type: "p", parts: ["Bei aller Bedeutung möchte ich einen Punkt nicht verschweigen:"] },
      { type: "callout", text: "Ich würde niemals einen fachlich schlechten BU-Tarif ausschließlich deshalb empfehlen, weil dessen Gesundheitsfragen angenehmer sind." },
      { type: "p", parts: ["Die Gesundheitsprüfung ist ein Teil der Entscheidung."] },
      { type: "p", parts: ["Daneben müssen unter anderem stimmen:"] },
      {
        type: "list",
        items: [
          "Definition der Berufsunfähigkeit",
          "Nachversicherungsmöglichkeiten",
          "Dynamik",
          "garantierte Rentensteigerung",
          "Teilzeitregelungen",
          "Berufswechsel",
          "konkrete Verweisung",
          "Leistungsprüfung",
          "Laufzeit",
          "Beitrag",
          "finanzielle Angemessenheit",
          "und die gesamte Vertragsgestaltung",
        ],
      },
      { type: "p", parts: ["Die beste Lösung entsteht aus:"] },
      { type: "callout", text: "guten Versicherungsbedingungen + passender Risikoprüfung + sauberer Antragsstrategie." },
    ],
  },
];
---

<div class="mx-auto max-w-3xl space-y-24 px-4 py-16 sm:px-6 lg:px-8">
  {
    sections.map((section) => (
      <section id={section.id} class="scroll-mt-24">
        <h2 class="font-serif text-2xl font-semibold tracking-tight text-ink-950 sm:text-3xl">{section.heading}</h2>
        <div data-reveal class="mt-6 space-y-4">
          {section.blocks.map((block) => {
            if (block.type === "p") return <RichParagraph parts={block.parts} />;
            if (block.type === "standalone")
              return <p class="text-base font-medium leading-relaxed text-ink-950">{block.text}</p>;
            if (block.type === "callout")
              return (
                <div class="rounded-2xl border border-brand-200 bg-brand-50/50 px-6 py-5">
                  <p class="font-serif text-lg font-medium leading-relaxed text-ink-950">{block.text}</p>
                </div>
              );
            if (block.type === "quote")
              return (
                <blockquote class="border-l-2 border-brand-200 pl-5">
                  <p class="font-serif text-lg italic leading-relaxed text-ink-950">{block.text}</p>
                </blockquote>
              );
            if (block.type === "list")
              return (
                <ul class="space-y-2">
                  {block.items.map((item) => (
                    <li class="flex items-baseline gap-2.5 text-base leading-relaxed text-ink-700/85">
                      <span class="h-1.5 w-1.5 shrink-0 translate-y-[-2px] rounded-full bg-brand-400" aria-hidden="true" />
                      {item}
                    </li>
                  ))}
                </ul>
              );
            if (block.type === "h3") return <h3 class="!mt-10 font-serif text-xl font-semibold text-ink-950">{block.text}</h3>;
            if (block.type === "statRow")
              return (
                <div class="flex flex-wrap justify-center gap-4 py-2">
                  {block.items.map((item) => (
                    <div class="rounded-2xl border border-brand-200 bg-brand-50/50 px-6 py-4 text-center">
                      <p class="font-serif text-lg font-semibold text-brand-700">{item}</p>
                    </div>
                  ))}
                </div>
              );
            if (block.type === "resultsList")
              return (
                <ul class="divide-y divide-black/5 overflow-hidden rounded-xl border border-black/5 bg-white">
                  {block.items.map((item) => (
                    <li class="flex items-center justify-between gap-4 px-5 py-3.5 text-sm">
                      <span class="font-medium text-ink-950">{item.label}</span>
                      <span class="text-ink-700/80">{item.value}</span>
                    </li>
                  ))}
                </ul>
              );
            if (block.type === "steps")
              return (
                <ol class="space-y-6 pt-2">
                  {block.items.map((item, index) => (
                    <li class="flex gap-4">
                      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-ink-950 text-sm font-semibold text-white">
                        {index + 1}
                      </span>
                      <div class="min-w-0 pt-0.5">
                        <p class="font-semibold text-ink-950">{item.title}</p>
                        <p class="mt-1 text-sm leading-relaxed text-ink-700/80">{item.body}</p>
                      </div>
                    </li>
                  ))}
                </ol>
              );
            if (block.type === "table")
              return (
                <div class="overflow-x-auto rounded-xl border border-black/5">
                  <table class="w-full min-w-[640px] border-collapse text-left text-sm">
                    <thead>
                      <tr class="bg-brand-50/60">
                        {block.headers.map((h) => (
                          <th class="px-4 py-3 font-semibold text-ink-950">{h}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-black/5 bg-white">
                      {block.rows.map((row) => (
                        <tr>
                          {row.map((cell, i) => (
                            <td class={i === 0 ? "px-4 py-3 font-medium text-ink-950" : "px-4 py-3 text-ink-700/80"}>{cell}</td>
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              );
            if (block.type === "compare")
              return (
                <div class="grid gap-4 sm:grid-cols-2">
                  <div class="rounded-2xl border border-black/5 bg-white p-5">
                    <p class="text-xs font-semibold uppercase tracking-wide text-brand-600">{block.labelA}</p>
                    <p class="mt-2 font-serif text-base leading-relaxed text-ink-950">
                      {block.quoted ? `„${block.textA}“` : block.textA}
                    </p>
                    {block.noteA && <p class="mt-2.5 text-sm leading-relaxed text-ink-700/70">{block.noteA}</p>}
                  </div>
                  <div class="rounded-2xl border border-black/5 bg-white p-5">
                    <p class="text-xs font-semibold uppercase tracking-wide text-brand-600">{block.labelB}</p>
                    <p class="mt-2 font-serif text-base leading-relaxed text-ink-950">
                      {block.quoted ? `„${block.textB}“` : block.textB}
                    </p>
                    {block.noteB && <p class="mt-2.5 text-sm leading-relaxed text-ink-700/70">{block.noteB}</p>}
                  </div>
                </div>
              );
            if (block.type === "quotePair")
              return (
                <div class="space-y-3 rounded-xl border border-black/5 bg-white p-5">
                  <p class="text-sm leading-relaxed text-ink-950">
                    <span class="mr-2 font-semibold uppercase tracking-wide text-brand-600">{block.goodLabel}:</span>
                    <span class="font-serif italic">„{block.good}“</span>
                  </p>
                  <p class="text-sm leading-relaxed text-ink-950">
                    <span class="mr-2 font-semibold uppercase tracking-wide text-ink-400">{block.badLabel}:</span>
                    <span class="font-serif italic">„{block.bad}“</span>
                  </p>
                </div>
              );
            return null;
          })}
        </div>
      </section>
    ))
  }
</div>
