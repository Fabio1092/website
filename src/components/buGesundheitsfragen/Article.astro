      { type: "p", parts: ["Er kann auch wissen wollen, ob eine Untersuchung oder Behandlung:"] },
      { type: "list", items: ["angeraten,", "empfohlen,", "vorgesehen,", "beabsichtigt", "oder geplant ist."] },
      { type: "p", parts: ["Nehmen wir ein Beispiel:"] },
