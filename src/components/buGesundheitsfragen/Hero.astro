---
import { siteConfig } from "@/lib/site";
---

<section id="bu-gesundheitsfragen-hero" class="relative overflow-hidden bg-ink-950 text-white">
  <div
    class="pointer-events-none absolute -top-40 right-[-10%] h-[32rem] w-[32rem] rounded-full bg-brand-500/20 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -bottom-32 left-[-10%] h-[26rem] w-[26rem] rounded-full bg-gold-500/10 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-3xl px-4 py-20 text-center sm:px-6 lg:py-28 lg:px-8">
    <span
      class="inline-flex items-center rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-brand-300"
    >
      Gesundheitsfragen bei der Berufsunfähigkeitsversicherung
    </span>
    <h1 class="mt-6 hyphens-auto break-words text-3xl font-semibold leading-tight tracking-tight sm:text-4xl lg:text-5xl">
      Gesundheitsfragen in der Berufs&shy;unfähigkeits&shy;versicherung: Warum bei der BU
      <span class="text-brand-400">jedes Wort entscheidend</span> sein kann.
    </h1>
    <p class="mx-auto mt-6 max-w-2xl font-serif text-xl leading-relaxed text-white/90">
      Nicht nur deine Gesundheitshistorie entscheidet darüber, welcher BU-Versicherer zu dir
      passt. Auch der genaue Wortlaut der Gesundheitsfragen kann entscheidend sein.
    </p>

    <p class="mx-auto mt-6 max-w-xl text-sm leading-relaxed text-white/60">
      Dieses Thema ist Teil meiner{" "}
      <a href="/bu/" class="underline decoration-brand-400/50 underline-offset-4 text-white/80 transition-colors hover:decoration-brand-400">
        Beratung zur Berufsunfähigkeitsversicherung</a>.
    </p>

    <div class="mt-9 flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a
        href={siteConfig.calendlyUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex w-full items-center justify-center rounded-full bg-gold-500 px-7 py-3.5 text-sm font-semibold text-ink-950 shadow-lg shadow-gold-500/20 transition-transform duration-200 hover:-translate-y-0.5 hover:bg-gold-400 sm:w-auto"
      >
        Unverbindliches Erstgespräch vereinbaren
      </a>
    </div>
  </div>
</section>
