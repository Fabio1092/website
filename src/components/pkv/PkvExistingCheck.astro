---
import { CircleHelp } from "lucide-react";
import { siteConfig } from "@/lib/site";

const questions = [
  "Welche Leistungen enthält dein aktueller Tarif tatsächlich?",
  "Passt die Selbstbeteiligung noch zu deiner Situation?",
  "Ist dein Krankentagegeld richtig bemessen?",
  "Welche Tarifwechseloptionen bestehen innerhalb der Gesellschaft?",
  "Welche Vorteile oder Rechte würdest du bei einem Wechsel verlieren?",
  "Ist eine Veränderung überhaupt wirtschaftlich und gesundheitlich sinnvoll?",
];
---

<section id="pkv-bestandsvertrag" class="bg-brand-50/40 py-24">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">
        Nicht jeder bestehende Vertrag muss gewechselt werden. Aber jeder sollte <span class="text-brand-600">verstanden werden</span>.
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-700/80">
        Ein Wechsel ist nicht automatisch die beste Lösung. Häufig ist es sinnvoller, zunächst den
        bestehenden Tarif und mögliche interne Optionen zu prüfen.
      </p>
    </div>

    <div class="mt-14 grid gap-4 sm:grid-cols-2">
      {
        questions.map((question, index) => (
          <div data-reveal style={`transition-delay: ${index * 60}ms`} class="flex items-start gap-3 rounded-2xl border border-black/5 bg-white p-5">
            <CircleHelp className="mt-0.5 h-5 w-5 shrink-0 text-brand-600" aria-hidden="true" />
            <p class="text-sm leading-relaxed text-ink-700/85">{question}</p>
          </div>
        ))
      }
    </div>

    <div class="mx-auto mt-12 max-w-2xl rounded-3xl bg-ink-950 px-8 py-10 text-center text-white sm:px-12">
      <h3 class="font-serif text-2xl font-semibold">Nach der Analyse erhältst du eine klare Einordnung.</h3>
      <p class="mx-auto mt-2 max-w-xl text-sm text-white/60">
        Vertrag sinnvoll behalten, intern optimieren oder externe Alternativen prüfen – ohne
        vorschnellen Aktionismus.
      </p>
      <a
        href={siteConfig.calendlyUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 inline-flex items-center justify-center rounded-full bg-gold-500 px-7 py-3.5 text-sm font-semibold text-ink-950 shadow-sm transition-transform duration-200 hover:-translate-y-0.5 hover:bg-gold-400"
      >
        Bestehende PKV prüfen lassen
      </a>
    </div>
  </div>
</section>
