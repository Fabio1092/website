---
import {
  Stethoscope,
  BedDouble,
  Smile,
  Accessibility,
  Brain,
  Activity,
  Wallet,
  RefreshCcw,
} from "lucide-react";

const benefits = [
  {
    icon: Stethoscope,
    title: "Ambulante Behandlung",
    description: "Freie Arztwahl, Erstattung über den Höchstsätzen und Zugang zu modernen Behandlungsmethoden.",
  },
  {
    icon: BedDouble,
    title: "Stationäre Leistungen",
    description: "Unterbringung, privatärztliche Behandlung und klare Regelungen bei spezialisierten Kliniken.",
  },
  {
    icon: Smile,
    title: "Zahnbehandlung & Zahnersatz",
    description: "Erstattungssätze, Begrenzungen und Zahnstaffeln müssen zu deinem Anspruch passen.",
  },
  {
    icon: Accessibility,
    title: "Hilfsmittel",
    description: "Ein offener und leistungsstarker Hilfsmittelkatalog kann im Ernstfall entscheidend sein.",
  },
  {
    icon: Brain,
    title: "Psychotherapie",
    description: "Sitzungsanzahl, Genehmigungspflichten und Erstattung sollten klar geregelt sein.",
  },
  {
    icon: Activity,
    title: "Heilmittel",
    description: "Physiotherapie, Ergotherapie und weitere Behandlungen dürfen nicht unnötig begrenzt sein.",
  },
  {
    icon: Wallet,
    title: "Krankentagegeld",
    description: "Die Leistung muss zu deinem Einkommen, deinem Beruf und deiner Lohnfortzahlung passen.",
  },
  {
    icon: RefreshCcw,
    title: "Options- und Wechselrechte",
    description: "Gute Tarife bieten Möglichkeiten, den Schutz später ohne erneute Gesundheitsprüfung anzupassen.",
  },
];
---

<section id="pkv-leistungen" class="bg-brand-50/40 py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <span class="text-sm font-semibold uppercase tracking-wider text-brand-600">Die entscheidenden Leistungen</span>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">
        Ein guter PKV-Tarif muss mehr können als Rechnungen erstatten.
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-700/80">
        Die Unterschiede zwischen privaten Krankenversicherungen liegen oft im Detail. Genau diese
        Details entscheiden später darüber, wie umfassend und verlässlich dein Schutz wirklich
        ist.
      </p>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        benefits.map((benefit, index) => (
          <div data-reveal style={`transition-delay: ${index * 60}ms`} class="rounded-2xl border border-black/5 bg-white p-6">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-500/10 text-brand-600">
              <benefit.icon className="h-5 w-5" aria-hidden="true" />
            </div>
            <h3 class="mt-4 text-sm font-semibold text-ink-950">{benefit.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-700/70">{benefit.description}</p>
          </div>
        ))
      }
    </div>

    <div class="mx-auto mt-12 max-w-2xl rounded-2xl border border-black/5 bg-white px-8 py-6 text-center">
      <p class="text-sm leading-relaxed text-ink-700/80">
        Du musst diese Bedingungen nicht selbst vergleichen. Du solltest aber verstehen, warum sie
        für deine Entscheidung wichtig sind.
      </p>
    </div>
  </div>
</section>
