---
import { Tag, ClipboardList, Baby, Repeat } from "lucide-react";
import MistakeGrid from "@/components/MistakeGrid.astro";

const mistakes = [
  {
    icon: Tag,
    number: "01",
    title: "Nur nach dem günstigsten Beitrag entschieden",
    description:
      "Ein niedriger Preis sagt wenig darüber aus, wie gut ein Tarif bei wichtigen Behandlungen, Hilfsmitteln, Psychotherapie, Zahnersatz oder stationären Leistungen tatsächlich leistet.",
    consequence: "Im Leistungsfall entstehen Lücken, Eigenanteile oder unnötige Diskussionen.",
    solution: "Wir vergleichen zuerst Leistungen und Bedingungen – und erst danach den Beitrag.",
  },
  {
    icon: ClipboardList,
    number: "02",
    title: "Gesundheitsfragen zu schnell beantwortet",
    description:
      "Unvollständige oder ungenaue Angaben können zu Rückfragen, Risikozuschlägen oder Problemen bei der Annahme führen.",
    consequence: "Die Auswahl geeigneter Versicherer wird unnötig eingeschränkt.",
    solution:
      "Wir bereiten deine Gesundheitsangaben sauber auf und prüfen bei Bedarf vorab die realistischen Möglichkeiten.",
  },
  {
    icon: Baby,
    number: "03",
    title: "Familienplanung und Zukunft nicht berücksichtigt",
    description:
      "Was heute für eine Einzelperson günstig aussieht, kann bei Elternzeit, Teilzeit oder Familiengründung ganz anders wirken.",
    consequence: "Die Entscheidung passt später nicht mehr zu Einkommen und Lebensplanung.",
    solution: "Wir betrachten nicht nur deine heutige Situation, sondern auch realistische Veränderungen der nächsten Jahre.",
  },
  {
    icon: Repeat,
    number: "04",
    title: "Bestehenden Vertrag vorschnell gewechselt",
    description:
      "Ein externer Wechsel klingt manchmal attraktiv, kann aber neue Gesundheitsprüfungen, neue Vertragsbedingungen und den Verlust wertvoller Rechte bedeuten.",
    consequence: "Eine vermeintliche Verbesserung kann langfristig zum Nachteil werden.",
    solution: "Wir prüfen zuerst deinen bestehenden Vertrag und bewerten danach, ob überhaupt Handlungsbedarf besteht.",
  },
];
---

<MistakeGrid
  id="pkv-fehler"
  title="Kleine Entscheidungen heute können später große Folgen haben."
  titleHighlight="große Folgen"
  intro="Viele Probleme entstehen nicht, weil die PKV grundsätzlich falsch ist. Sie entstehen, weil vor dem Abschluss zu wenig geprüft, zu kurzfristig gedacht oder ein unpassender Tarif gewählt wurde."
  mistakes={mistakes}
/>
