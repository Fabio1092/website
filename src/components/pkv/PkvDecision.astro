---
import { X, Check } from "lucide-react";

const shortTerm = [
  "Möglichst günstiger Einstieg",
  "Leistungen werden nur oberflächlich verglichen",
  "Familienplanung bleibt unberücksichtigt",
  "Krankentagegeld und Selbstbeteiligung passen nicht zusammen",
  "Spätere Wechselmöglichkeiten werden nicht geprüft",
  "Die Entscheidung wirkt günstig, kann langfristig aber teuer werden",
];

const longTerm = [
  "Leistungen und Bedingungen stehen im Mittelpunkt",
  "Gesundheit und Risikoprüfung werden sauber vorbereitet",
  "Berufliche Entwicklung und Familienplanung fließen ein",
  "Krankentagegeld, Selbstbeteiligung und Beitrag werden abgestimmt",
  "Tarif- und Wechseloptionen werden langfristig bewertet",
  "Du triffst eine nachvollziehbare und belastbare Entscheidung",
];
---

<section id="pkv-entscheidung" class="bg-brand-50/40 py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <span class="text-sm font-semibold uppercase tracking-wider text-brand-600">Mehr als ein Tarifvergleich</span>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">
        Die beste PKV ist nicht die günstigste. Sie ist die, die <span class="text-brand-600">langfristig zu deinem Leben passt</span>.
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-700/80">
        Ein niedriger Einstiegsbeitrag kann attraktiv wirken. Entscheidend ist aber, welche
        Leistungen dein Tarif tatsächlich absichert, wie flexibel er auf Veränderungen reagiert
        und ob die Lösung auch in vielen Jahren noch sinnvoll ist.
      </p>
    </div>

    <div class="mt-14 grid gap-6 lg:grid-cols-2">
      <div data-reveal class="rounded-2xl border border-danger-500/15 bg-white p-8">
        <span class="inline-flex items-center gap-2 text-sm font-semibold text-danger-500">
          <X className="h-4.5 w-4.5" aria-hidden="true" />
          Kurzfristig gedacht
        </span>
        <h3 class="mt-3 font-serif text-lg font-semibold text-ink-950">Nur auf den heutigen Beitrag schauen</h3>
        <ul class="mt-5 space-y-3">
          {
            shortTerm.map((point) => (
              <li class="flex items-start gap-2.5 text-sm text-ink-700/85">
                <X className="mt-0.5 h-4.5 w-4.5 shrink-0 text-danger-500/70" aria-hidden="true" />
                {point}
              </li>
            ))
          }
        </ul>
      </div>

      <div data-reveal style="transition-delay: 100ms" class="rounded-2xl border border-success-500/20 bg-white p-8">
        <span class="inline-flex items-center gap-2 text-sm font-semibold text-success-500">
          <Check className="h-4.5 w-4.5" aria-hidden="true" />
          Langfristig geplant
        </span>
        <h3 class="mt-3 font-serif text-lg font-semibold text-ink-950">Die gesamte Lebensplanung berücksichtigen</h3>
        <ul class="mt-5 space-y-3">
          {
            longTerm.map((point) => (
              <li class="flex items-start gap-2.5 text-sm text-ink-700/85">
                <Check className="mt-0.5 h-4.5 w-4.5 shrink-0 text-success-500" aria-hidden="true" />
                {point}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <p class="mx-auto mt-12 max-w-2xl text-center font-serif text-lg text-ink-950">
      Mein Ziel ist nicht, dir irgendeine PKV zu vermitteln. Mein Ziel ist, dass du deine
      Entscheidung verstehst und auch langfristig mit ihr leben kannst.
    </p>
  </div>
</section>
