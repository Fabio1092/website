---
import { Briefcase, Users, HeartPulse, ClipboardList, Wallet } from "lucide-react";

const leistungen = [
  "ambulante Behandlung",
  "stationäre Leistungen",
  "Zahnbehandlung und Zahnersatz",
  "Psychotherapie",
  "Hilfs- und Heilmittel",
  "Arzneimittel",
  "Selbstbehalt",
  "Krankentagegeld",
  "Leistungen im Ausland",
  "Beitragsentlastung im Alter",
];
---

<section id="pkv-angestellte-checkpunkte" class="bg-brand-50/40 py-24">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">
        Diese Punkte <span class="text-brand-600">prüfen wir gemeinsam.</span>
      </h2>
    </div>

    <div class="mt-16 divide-y divide-black/[0.06] border-t border-black/[0.06]">
      {
        [
          {
            icon: Briefcase,
            title: "Deine berufliche Entwicklung",
            text: "Wie stabil ist dein Einkommen? Welche beruflichen Veränderungen sind realistisch? Sind Teilzeit, Selbstständigkeit oder ein längerer Auslandsaufenthalt denkbar?",
          },
          {
            icon: Users,
            title: "Deine Familienplanung",
            text: "In der privaten Krankenversicherung benötigt grundsätzlich jede versicherte Person einen eigenen Versicherungsschutz. Deshalb müssen Partner, mögliche Kinder und die Einkommenssituation der Familie von Beginn an berücksichtigt werden.",
          },
          {
            icon: HeartPulse,
            title: "Deinen Gesundheitszustand",
            text: "Bei einem PKV-Antrag werden Gesundheitsfragen gestellt. Vorerkrankungen können Einfluss auf die Annahme, den Beitrag oder den Leistungsumfang haben. Deshalb sollte kein Antrag unvorbereitet gestellt werden.",
          },
          { icon: Wallet, title: "Deine langfristige finanzielle Tragfähigkeit", text: "Die Entscheidung darf nicht nur auf dem heutigen Zahlbeitrag beruhen. Sie muss auch bei veränderten Lebenssituationen tragfähig bleiben." },
        ].map((item, index) => (
          <div data-reveal style={`transition-delay: ${index * 80}ms`} class="flex gap-5 py-8 sm:gap-6">
            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-brand-500/10 text-brand-600">
              <item.icon className="h-5 w-5" aria-hidden="true" />
            </div>
            <div class="min-w-0">
              <h3 class="font-serif text-lg font-semibold text-ink-950">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-700/75">{item.text}</p>
            </div>
          </div>
        ))
      }

      <div data-reveal class="flex gap-5 py-8 sm:gap-6">
        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-brand-500/10 text-brand-600">
          <ClipboardList className="h-5 w-5" aria-hidden="true" />
        </div>
        <div class="min-w-0 flex-1">
          <h3 class="font-serif text-lg font-semibold text-ink-950">Deine gewünschten Leistungen</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-700/75">Wir prüfen unter anderem:</p>
          <div class="mt-4 flex flex-wrap gap-2">
            {
              leistungen.map((leistung) => (
                <span class="rounded-full border border-brand-200 bg-brand-50 px-4 py-1.5 text-sm font-medium text-brand-700">{leistung}</span>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
