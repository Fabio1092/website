        ],
      },
      {
        type: "p",
        parts: [
          "Mehr zu den Ursachen langfristiger Beitragsveränderungen findest du unter ",
          { a: "PKV Beitragsentwicklung: Wie stark steigen die Beiträge?", href: "/wissen/private-krankenversicherung/pkv-beitragsentwicklung/" },
          ".",
        ],
      },
    ],
  },
  {
    id: "angst-vor-pkv-im-alter",
    heading: "Warum haben viele Menschen Angst vor der PKV im Alter?",
    blocks: [
      { type: "p", parts: ["Das Problem entsteht häufig durch den Vergleich zweier völlig unterschiedlicher Lebenssituationen."] },
