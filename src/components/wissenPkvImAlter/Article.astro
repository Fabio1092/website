---
import RichParagraph from "@/components/RichParagraph.astro";

type Part = string | { b: string } | { a: string; href: string };

type Block =
  | { type: "p"; parts: Part[] }
  | { type: "standalone"; text: string }
  | { type: "quote"; text: string }
  | { type: "list"; items: string[] }
  | { type: "h3"; text: string }
  | { type: "table"; headers: string[]; rows: string[][] };

interface Section {
  id: string;
  heading: string;
  blocks: Block[];
}

const introBlocks: Block[] = [
  { type: "p", parts: ["Diese Frage gehört für mich zu jeder langfristigen PKV-Entscheidung."] },
  { type: "p", parts: ["Denn eine private Krankenversicherung schließt du im Idealfall nicht für die nächsten fünf Jahre ab, sondern für mehrere Jahrzehnte."] },
  { type: "p", parts: ["Deshalb ist nicht nur wichtig, was deine PKV heute kostet."] },
  { type: "p", parts: ["Entscheidend ist auch:"] },
  { type: "standalone", text: "Wie finanzierst du deinen Versicherungsschutz später, wenn dein Arbeitseinkommen wegfällt?" },
  { type: "p", parts: ["Die gute Nachricht: In der PKV gibt es verschiedene Mechanismen, die Beiträge im Alter abfedern sollen. Zusätzlich kannst du selbst gezielt vorsorgen."] },
  { type: "p", parts: ["Dazu gehören insbesondere:"] },
  {
    type: "list",
    items: [
      "Alterungsrückstellungen",
      "der gesetzliche Beitragszuschlag",
      "der Wegfall bestimmter Beitragsbestandteile",
      "mögliche Zuschüsse aus der gesetzlichen Rentenversicherung",
      "zusätzliche Beitragsentlastungstarife",
      "eine Basisrente",
      "frei verfügbares Vermögen und andere Kapitalanlagen",
    ],
  },
  { type: "p", parts: ["Aber eines ist genauso wichtig:"] },
  { type: "standalone", text: "Keiner dieser Mechanismen garantiert, dass dein PKV-Beitrag im Ruhestand niemals steigt." },
  { type: "p", parts: ["Deshalb würde ich das Thema weder dramatisieren noch schönreden."] },
  { type: "p", parts: ["Ich würde es von Anfang an vernünftig planen."] },
];

const sections: Section[] = [
  {
    id: "wichtigstes-in-kuerze",
    heading: "Das Wichtigste zur PKV im Alter",
    blocks: [
      { type: "p", parts: ["Die wichtigsten Punkte im Überblick:"] },
      {
        type: "list",
        items: [
          "PKV-Beiträge sind grundsätzlich nicht direkt von deinem Einkommen abhängig.",
          "Deshalb sinkt der Beitrag nicht automatisch, wenn du in Rente gehst.",
          "Das reine Älterwerden führt in der üblichen alterungsrückstellungsbildenden PKV nicht automatisch zu einer jährlichen altersbedingten Beitragserhöhung.",
