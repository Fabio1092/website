---
const terms = [
  "passende Definition der Berufsunfähigkeit",
  "Bewertung des Studentenstatus",
  "spätere berufliche Tätigkeit",
  "Nachversicherungsmöglichkeiten",
  "Dynamik",
  "ausreichende Versicherungsdauer",
  "Optionen zur Erhöhung",
  "Regelungen beim Berufseinstieg",
  "mögliche Verbesserungen bei späterer beruflicher Einstufung",
  "relevante Ausschlüsse und Einschränkungen",
];
---

<section id="bu-studenten-anforderungen" class="bg-white py-24">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">
        Was sollte eine <span class="text-brand-600">Studenten-BU</span> können?
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-700/80">Wir achten insbesondere auf:</p>
    </div>

    <div data-reveal class="mt-10 flex flex-wrap justify-center gap-2.5">
      {terms.map((term) => <span class="rounded-full border border-brand-200 bg-brand-50/60 px-4 py-1.5 text-sm font-medium text-brand-700">{term}</span>)}
    </div>

    <p data-reveal class="mx-auto mt-12 max-w-xl text-center">
      <span class="block text-base leading-relaxed text-ink-700/60">Die Frage ist nicht: „Was kostet mich heute die billigste Studenten-BU?“</span>
      <span class="mt-1 block font-serif text-xl font-semibold text-ink-950">Sondern: „Welcher Vertrag kann mich vom Studium bis tief ins Berufsleben begleiten?“</span>
    </p>
  </div>
</section>
