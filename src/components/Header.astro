---
import { primaryNav } from "@/lib/nav";
import { siteConfig } from "@/lib/site";

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
}
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-ink-950/95 text-white backdrop-blur transition-shadow duration-300 data-[scrolled=true]:shadow-lg data-[scrolled=true]:shadow-black/20"
  data-scrolled="false"
>
  <div class="mx-auto flex h-20 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-4 xl:px-8">
    <a href="/" class="flex shrink-0 items-center gap-2.5" aria-label="FR Makler Startseite">
      <img src="/images/Logo.png" alt="FR Makler Logo" class="h-11 w-11 shrink-0 rounded-lg" width="44" height="44" />
      <span class="flex flex-col leading-tight whitespace-nowrap">
        <span class="font-serif text-lg font-semibold tracking-tight sm:text-xl">Fabio Rumpf</span>
        <span class="text-[10px] font-semibold uppercase tracking-wide text-brand-400 sm:text-xs lg:text-[9px] lg:tracking-normal xl:text-xs xl:tracking-wide">
          Versicherungs- und Finanzmakler
        </span>
      </span>
    </a>

    <nav class="hidden shrink-0 items-center gap-4 lg:flex xl:gap-7" aria-label="Hauptnavigation">
      {
        primaryNav.map((link) =>
          link.children ? (
            <div class="nav-dropdown group relative">
              <a
                href={link.href}
                class:list={[
                  "nav-dropdown-trigger relative flex items-center gap-1 whitespace-nowrap text-sm font-medium text-white/80 transition-colors hover:text-white",
                  { "text-white": isActive(link.href) },
                ]}
                aria-expanded="false"
              >
                {link.label}
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="nav-dropdown-chevron mt-0.5 transition-transform duration-200 group-hover:rotate-180"
                  aria-hidden="true"
                >
                  <path d="m6 9 6 6 6-6" />
                </svg>
                {isActive(link.href) && (
                  <span class="absolute -bottom-2 left-0 h-0.5 w-full rounded-full bg-brand-400" />
                )}
              </a>
              <div class="nav-dropdown-panel invisible absolute left-1/2 top-full z-50 w-72 -translate-x-1/2 pt-3 opacity-0 transition-all duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
                <div class="overflow-hidden rounded-2xl border border-white/10 bg-ink-900 shadow-xl shadow-black/30">
                  {link.children.map((child) => (
                    <a
                      href={child.href}
                      class:list={[
                        "block px-5 py-3 text-sm font-medium text-white/80 transition-colors hover:bg-white/5 hover:text-white",
                        { "bg-white/5 text-white": isActive(child.href) },
                      ]}
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a
              href={link.href}
              class:list={[
                "relative whitespace-nowrap text-sm font-medium text-white/80 transition-colors hover:text-white",
                { "text-white": isActive(link.href) },
              ]}
            >
              {link.label}
              {isActive(link.href) && (
                <span class="absolute -bottom-2 left-0 h-0.5 w-full rounded-full bg-brand-400" />
              )}
            </a>
          ),
        )
      }
    </nav>

    <div class="hidden shrink-0 items-center gap-2.5 lg:flex xl:gap-3">
      <a
        href={siteConfig.registrationUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center whitespace-nowrap rounded-full border border-white/20 px-3.5 py-2.5 text-sm font-semibold text-white transition-colors duration-200 hover:border-white/40 hover:bg-white/5"
      >
        Neukunde werden
      </a>
      <a
        href={siteConfig.calendlyUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center whitespace-nowrap rounded-full bg-gold-500 px-4 py-2.5 text-sm font-semibold text-ink-950 shadow-sm transition-transform duration-200 hover:-translate-y-0.5 hover:bg-gold-400 xl:px-5"
      >
        Kostenloses Erstgespräch
      </a>
    </div>

    <button
      id="menu-toggle"
      type="button"
      class="inline-flex h-10 w-10 items-center justify-center rounded-md text-white lg:hidden"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="Menü öffnen"
    >
      <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="7" y2="7"/><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="17" y2="17"/></svg>
      <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden"><line x1="18" x2="6" y1="6" y2="18"/><line x1="6" x2="18" y1="6" y2="18"/></svg>
    </button>
  </div>

  <div
    id="mobile-menu"
    class="grid overflow-hidden transition-[grid-template-rows] duration-300 ease-out lg:hidden"
    style="grid-template-rows: 0fr"
  >
    <div class="overflow-hidden">
      <nav class="mobile-nav-scroll space-y-1 border-t border-white/10 px-4 pb-6 pt-4" aria-label="Mobile Navigation">
        {
          primaryNav.map((link) => (
            <div>
              <a
                href={link.href}
                class:list={[
                  "block rounded-md px-3 py-3 text-base font-medium text-white/85 transition-colors hover:bg-white/5 hover:text-white",
                  { "bg-white/5 text-white": isActive(link.href) },
                ]}
              >
                {link.label}
              </a>
              {link.children && (
                <div class="ml-3 space-y-1 border-l border-white/10 pl-3">
                  {link.children
                    .filter((child) => child.href !== link.href)
                    .map((child) => (
                      <a
                        href={child.href}
                        class:list={[
                          "block rounded-md px-3 py-2.5 text-sm font-medium text-white/70 transition-colors hover:bg-white/5 hover:text-white",
                          { "bg-white/5 text-white": isActive(child.href) },
                        ]}
                      >
                        {child.label}
                      </a>
                    ))}
                </div>
              )}
            </div>
          ))
        }
        <a
          href={siteConfig.calendlyUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-3 block rounded-full bg-gold-500 px-5 py-3 text-center text-base font-semibold text-ink-950"
        >
          Kostenloses Erstgespräch
        </a>
        <a
          href={siteConfig.registrationUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-3 block rounded-full border border-white/20 px-5 py-3 text-center text-base font-semibold text-white transition-colors hover:border-white/40 hover:bg-white/5"
        >
          Neukunde werden
        </a>
      </nav>
    </div>
  </div>
</header>

<div class="h-20" aria-hidden="true"></div>

<style>
  .nav-dropdown.is-open .nav-dropdown-panel {
    visibility: visible;
    opacity: 1;
  }
  .nav-dropdown.is-open .nav-dropdown-chevron {
    transform: rotate(180deg);
  }

  /* The mobile menu can be taller than the viewport (PKV/BU submenus + CTAs).
     Bound it to the space below the header bar and let it scroll internally,
     instead of silently clipping the lower items via the parent's overflow-hidden. */
  .mobile-nav-scroll {
    max-height: calc(100vh - 5rem);
    max-height: calc(100dvh - 5rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
  }
</style>

<script>
  const header = document.getElementById("site-header");
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("icon-open");
  const iconClose = document.getElementById("icon-close");

  const onScroll = () => {
    if (!header) return;
    header.dataset.scrolled = window.scrollY > 8 ? "true" : "false";
  };
  document.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  const setMenuOpen = (open: boolean) => {
    if (menu) menu.style.gridTemplateRows = open ? "1fr" : "0fr";
    toggle?.setAttribute("aria-expanded", String(open));
    iconOpen?.classList.toggle("hidden", open);
    iconClose?.classList.toggle("hidden", !open);
    document.documentElement.classList.toggle("overflow-hidden", open);
  };

  toggle?.addEventListener("click", () => {
    setMenuOpen(toggle.getAttribute("aria-expanded") !== "true");
  });

  document.querySelectorAll<HTMLAnchorElement>("#mobile-menu a").forEach((a) => {
    a.addEventListener("click", () => setMenuOpen(false));
  });

  // Desktop nav dropdowns (PKV, BU) normally open on :hover. But touch devices
  // wide enough to show the desktop nav (tablets, especially in landscape)
  // never reliably trigger :hover, so the dropdown appears "unclickable"
  // there. Only touch/coarse-pointer devices get a click-to-toggle fallback;
  // real mouse/trackpad devices keep the original hover behaviour untouched.
  const isTouchPrimary = !window.matchMedia("(hover: hover) and (pointer: fine)").matches;

  if (isTouchPrimary) {
    const dropdowns = document.querySelectorAll<HTMLElement>(".nav-dropdown");

    const closeDropdown = (dropdown: HTMLElement) => {
      dropdown.classList.remove("is-open");
      dropdown.querySelector(".nav-dropdown-trigger")?.setAttribute("aria-expanded", "false");
    };

    dropdowns.forEach((dropdown) => {
      const trigger = dropdown.querySelector<HTMLAnchorElement>(".nav-dropdown-trigger");
      trigger?.addEventListener("click", (event) => {
        const isOpen = dropdown.classList.contains("is-open");
        if (!isOpen) {
          event.preventDefault();
          dropdowns.forEach((other) => other !== dropdown && closeDropdown(other));
          dropdown.classList.add("is-open");
          trigger.setAttribute("aria-expanded", "true");
        }
        // already open: let the click through so the label link navigates normally
      });
    });

    document.addEventListener("click", (event) => {
      dropdowns.forEach((dropdown) => {
        if (!dropdown.contains(event.target as Node)) closeDropdown(dropdown);
      });
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") dropdowns.forEach(closeDropdown);
    });
  }
</script>
