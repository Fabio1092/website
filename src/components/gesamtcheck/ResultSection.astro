---
import { ArrowRight } from "lucide-react";
import { gesamtcheckWhatsappUrl } from "@/lib/gesamtcheck";

const items = [
  { label: "Bestehendes", status: "geprüft" },
  { label: "Prioritäten", status: "definiert" },
  { label: "Budget", status: "festgelegt" },
  { label: "Gesamtplan", status: "erstellt" },
];
---

<section class="relative overflow-hidden bg-ink-950 py-20 text-white sm:py-28">
  <div class="pointer-events-none absolute left-1/2 top-0 h-[28rem] w-[40rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand-500/15 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -bottom-24 right-[-8%] h-72 w-72 rounded-full bg-gold-500/10 blur-3xl" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
    <h2 class="font-serif text-lg font-semibold uppercase tracking-wide text-brand-400">Das Ergebnis?</h2>
    <p class="mx-auto mt-4 max-w-2xl font-serif text-3xl font-semibold tracking-tight sm:text-4xl">
      Du kannst einen Haken hinter das Thema machen.
    </p>
    <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-white/65">
      Statt einzelner Versicherungen, Verträge und offener Fragen entsteht ein vollständiger
      Überblick.
    </p>

    <div data-reveal class="mx-auto mt-12 grid max-w-2xl grid-cols-2 gap-3 sm:grid-cols-4">
      {
        items.map((item, index) => (
          <div style={`transition-delay: ${index * 80}ms`} class="rounded-2xl border border-white/10 bg-white/[0.04] px-4 py-6">
            <p class="text-xs font-semibold uppercase tracking-wide text-white/45">{item.label}</p>
            <ArrowRight className="mx-auto mt-3 h-4 w-4 text-white/25" aria-hidden="true" />
            <p class="mt-3 font-serif text-base font-semibold text-brand-400">{item.status}</p>
          </div>
        ))
      }
    </div>

    <p class="mt-10 font-serif text-2xl font-semibold text-white">Alles geklärt. Kopf frei.</p>

    <a
      href={gesamtcheckWhatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      data-cta="result-section-cta"
      class="shadow-lift mt-8 inline-flex items-center justify-center gap-1.5 rounded-full bg-gold-500 px-8 py-4 text-sm font-semibold text-ink-950 transition-transform duration-200 hover:-translate-y-0.5 hover:bg-gold-400"
    >
      Gesamtcheck bei meinem Termin berücksichtigen
      <span aria-hidden="true">→</span>
    </a>
  </div>
</section>
