---
import { Layers } from "lucide-react";

const steps = [
  {
    number: "1",
    title: "Datenerfassung & Priorisierung",
    text: "Gemeinsam erfassen wir deine Lebenssituation sowie Ziele und Wünsche – und priorisieren die für dich wichtigen Themen und Risiken.",
  },
  {
    number: "2",
    title: "Analyse",
    text: "Basierend auf deinen Risiken, Zielen und Wünschen analysieren wir deine bestehende Versorgung und erarbeiten ein passgenaues Lösungskonzept.",
  },
  {
    number: "3",
    title: "Optimierung",
    text: "Gemeinsam besprechen wir dein persönliches Lösungskonzept und optimieren deine Versorgungssituation.",
  },
  {
    number: "4",
    title: "Regelmäßige Service-Betreuung",
    text: "Wir bleiben in regelmäßigem Kontakt – so bist du immer up to date und deine Versorgung auf dem neuesten Stand.",
  },
];
---

<section class="scroll-mt-24 bg-white py-16 sm:py-24">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-black/[0.04] px-3.5 py-1.5 text-[11px] font-semibold uppercase tracking-wider text-ink-700/55">
        <Layers className="h-3.5 w-3.5" aria-hidden="true" />
        360° Konzept
      </span>
      <h2 class="mt-4 font-serif text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">Ein Gespräch. Ein System. Ein klarer Plan.</h2>
    </div>

    <ol class="mt-14 space-y-10">
      {
        steps.map((step, index) => (
          <li data-reveal style={`transition-delay: ${index * 80}ms`} class="relative flex gap-6 sm:gap-8">
            <div class="flex flex-col items-center">
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-ink-950 font-serif text-lg font-semibold text-white">{step.number}</span>
              {index < steps.length - 1 && <span class="mt-2 w-px flex-1 bg-brand-200" aria-hidden="true" />}
            </div>
            <div class="pb-2">
              <h3 class="font-serif text-xl font-semibold text-ink-950">{step.title}</h3>
              <p class="mt-2 max-w-xl text-sm leading-relaxed text-ink-700/80">{step.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
