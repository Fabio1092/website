---
import type { ComponentType } from "react";

interface Mistake {
  icon: ComponentType<{ className?: string; "aria-hidden"?: boolean }>;
  number: string;
  title: string;
  description: string;
  consequence: string;
  solution: string;
}

interface Props {
  id?: string;
  eyebrow: string;
  title: string;
  intro: string;
  mistakes: Mistake[];
  columns?: 2 | 3;
  closing?: { title: string; text: string };
}

const { id, eyebrow, title, intro, mistakes, columns = 3, closing } = Astro.props;
const gridColsClass = columns === 2 ? "sm:grid-cols-2" : "lg:grid-cols-3";
---

<section id={id} class="bg-white py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <span class="text-sm font-semibold uppercase tracking-wider text-brand-600">{eyebrow}</span>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">{title}</h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-700/80">{intro}</p>
    </div>

    <div class={`mt-14 grid gap-6 ${gridColsClass}`}>
      {
        mistakes.map((mistake, index) => (
          <div
            data-reveal
            style={`transition-delay: ${index * 100}ms`}
            class="flex flex-col rounded-2xl border border-black/5 bg-brand-50/30 p-7"
          >
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-white text-brand-600 shadow-sm">
              <mistake.icon className="h-5 w-5" aria-hidden={true} />
            </div>
            <span class="mt-5 text-xs font-semibold uppercase tracking-wider text-danger-500">{mistake.number}</span>
            <h3 class="mt-1.5 font-serif text-lg font-semibold text-ink-950">{mistake.title}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-ink-700/75">{mistake.description}</p>

            <div class="mt-5 rounded-xl border border-danger-500/15 bg-danger-50 p-4">
              <p class="text-xs font-semibold uppercase tracking-wide text-danger-500">Folge</p>
              <p class="mt-1 text-sm leading-relaxed text-ink-700/85">{mistake.consequence}</p>
            </div>
            <div class="mt-3 rounded-xl border border-success-500/15 bg-success-50 p-4">
              <p class="text-xs font-semibold uppercase tracking-wide text-success-500">Unsere Lösung</p>
              <p class="mt-1 text-sm leading-relaxed text-ink-700/85">{mistake.solution}</p>
            </div>
          </div>
        ))
      }
    </div>

    {
      closing && (
        <div class="mt-14 rounded-2xl bg-ink-950 px-8 py-10 text-center text-white">
          <h3 class="font-serif text-xl font-semibold">{closing.title}</h3>
          <p class="mx-auto mt-2 max-w-2xl text-sm text-white/60">{closing.text}</p>
        </div>
      )
    }
  </div>
</section>
