---
interface Props {
  eyebrow: string;
  title: string;
  intro: string;
}

const { eyebrow, title, intro } = Astro.props;
---

<section class="border-b border-black/5 bg-gradient-to-b from-brand-50 to-white">
  <div class="mx-auto max-w-4xl px-4 py-24 text-center sm:px-6 lg:px-8">
    <span
      class="inline-flex items-center rounded-full bg-brand-100 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-brand-700"
    >
      {eyebrow}
    </span>
    <h1 class="mt-6 text-4xl font-semibold tracking-tight text-ink-950 sm:text-5xl">
      {title}
    </h1>
    <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-ink-700/80">
      {intro}
    </p>
  </div>
</section>
