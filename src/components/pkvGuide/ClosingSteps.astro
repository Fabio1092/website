---
import { MessageCircle } from "lucide-react";
import { siteConfig } from "@/lib/site";

const steps = [
  "Sei vollständig.",
  "Sei wahrheitsgemäß.",
  "Beschreibe den Verlauf so gut du kannst.",
  "Und wenn du etwas nicht weißt, rate nicht einfach.",
];
---

<section id="guide-abschluss" class="relative overflow-hidden bg-ink-950 py-24 text-white">
  <div
    class="pointer-events-none absolute left-1/2 top-0 h-[28rem] w-[40rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand-500/15 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div data-reveal class="relative mx-auto max-w-2xl px-4 text-center sm:px-6 lg:px-8">
    <h2 class="font-serif text-3xl font-semibold tracking-tight sm:text-4xl">
      Noch eine Sache <span class="text-brand-400">zum Schluss</span>.
    </h2>
    <p class="mt-4 text-lg leading-relaxed text-white/70">
      Gesundheitsfragen wirken auf den ersten Blick manchmal komplizierter, als sie tatsächlich
      sind.
    </p>
    <p class="mt-2 text-lg leading-relaxed text-white/70">
      Du musst hier nichts „versicherungsperfekt“ formulieren.
    </p>
    <p class="mt-6 text-base font-medium text-white/90">Was mir wichtig ist:</p>

    <ol class="mx-auto mt-6 flex max-w-md flex-col gap-3 text-left">
      {
        steps.map((step, index) => (
          <li class="flex items-center gap-3.5 rounded-xl border border-white/10 bg-white/5 px-5 py-3.5">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-gold-500 text-xs font-semibold text-ink-950">
              {index + 1}
            </span>
            <span class="text-sm text-white/85">{step}</span>
          </li>
        ))
      }
    </ol>

    <p class="mx-auto mt-10 max-w-lg text-base leading-relaxed text-white/70">Den Rest machen wir gemeinsam.</p>

    <div class="mt-14 border-t border-white/10 pt-10">
      <p class="mx-auto max-w-md text-sm leading-relaxed text-white/70">Und sobald du an irgendeiner Stelle unsicher bist:</p>
      <h3 class="mt-3 font-serif text-xl font-semibold">Schreib mir einfach kurz per WhatsApp.</h3>
      <p class="mx-auto mt-3 max-w-md text-sm leading-relaxed text-white/70">
        Ich helfe dir lieber einmal mehr beim Ausfüllen, als dass du lange über einer Frage
        grübelst oder eine Angabe falsch interpretierst.
      </p>

      <a
        href={siteConfig.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-8 inline-flex items-center justify-center gap-2 rounded-full bg-gold-500 px-7 py-3.5 text-sm font-semibold text-ink-950 shadow-lg shadow-gold-500/20 transition-transform duration-200 hover:-translate-y-0.5 hover:bg-gold-400"
      >
        <MessageCircle className="h-4.5 w-4.5" aria-hidden="true" />
        Über WhatsApp schreiben
      </a>

      <p class="mx-auto mt-10 max-w-lg text-base leading-relaxed text-white/70">
        Jetzt kannst du deine E-Mail öffnen, zunächst die Datenschutzerklärung erledigen und
        anschließend mit deinem digitalen Risikofragebogen starten.
      </p>
    </div>
  </div>
</section>
