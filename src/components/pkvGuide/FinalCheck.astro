---
import { CheckCircle2 } from "lucide-react";

const checks = [
  "Habe ich alle Fragen vollständig und wahrheitsgemäß beantwortet?",
  "Habe ich bei gesundheitlichen Angaben nicht nur einzelne Stichwörter genannt?",
  "Sind die ungefähren Zeiträume nachvollziehbar?",
  "Habe ich relevante Untersuchungen und deren Ergebnisse beschrieben?",
  "Habe ich angegeben, wie etwas behandelt wurde?",
  "Habe ich angegeben, ob und wann die Behandlung abgeschlossen wurde?",
  "Habe ich meinen heutigen Zustand bzw. eine bestehende Beschwerdefreiheit beschrieben?",
  "Habe ich relevante vorhandene Unterlagen berücksichtigt?",
  "Habe ich bei Unsicherheiten nicht einfach geraten oder etwas weggelassen?",
  "Habe ich meine Datenschutzerklärung unterschrieben zurückgesendet?",
];
---

<section id="guide-finaler-check" class="bg-brand-50/40 py-24">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">
      10. Bevor du den Fragebogen <span class="text-brand-600">abschickst</span>.
    </h2>
    <p class="mt-4 text-base leading-relaxed text-ink-700/80">
      Bevor du den Risikofragebogen endgültig abschickst, geh deine Angaben bitte noch einmal kurz
      durch.
    </p>

    <ul class="mt-8 grid gap-3 sm:grid-cols-2">
      {
        checks.map((check, index) => (
          <li data-reveal style={`transition-delay: ${(index % 6) * 60}ms`} class="flex items-start gap-2.5 rounded-xl bg-white p-4 text-sm leading-relaxed text-ink-700/85 shadow-sm">
            <CheckCircle2 className="mt-0.5 h-4.5 w-4.5 shrink-0 text-brand-500" aria-hidden="true" />
            {check}
          </li>
        ))
      }
    </ul>

    <p data-reveal class="mt-10 text-lg font-medium leading-relaxed text-ink-950">
      Wenn du diese Punkte abhaken kannst, kannst du deinen Risikofragebogen abschicken.
    </p>
  </div>
</section>
