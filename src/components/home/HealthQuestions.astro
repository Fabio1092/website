---
import { ArrowRight } from "lucide-react";

const topics = [
  {
    title: "Gesundheitsfragen",
    text: "Welche Behandlungen, Diagnosen und Beschwerden anzugeben sind, hängt von den konkreten Fragen und Abfragezeiträumen des Versicherers ab. Eine saubere Aufbereitung ist wichtiger als eine Antwort aus dem Gedächtnis.",
    links: [
      { label: "in der BU", href: "/bu-gesundheitsfragen/", ctaId: "home_health_bu_questions" },
      { label: "in der PKV", href: "/pkv-gesundheitsfragen/", ctaId: "home_health_pkv_questions" },
    ],
  },
  {
    title: "Risikovoranfrage",
    text: "Bei Vorerkrankungen lässt sich vor einem verbindlichen Antrag prüfen, wie Versicherer die gesundheitliche Vorgeschichte einschätzen. So werden mögliche Annahmebedingungen vorab klarer.",
    links: [
      { label: "bei der BU", href: "/bu-risikovoranfrage/", ctaId: "home_health_bu_risk" },
      { label: "bei der PKV", href: "/pkv-risikovoranfrage/", ctaId: "home_health_pkv_risk" },
    ],
  },
];
---

<section class="bg-brand-50/40 py-16 sm:py-24">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 sm:px-6 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16 lg:px-8">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <h2 class="hyphens-auto break-words text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">
        Gesundheitsfragen und Risikovoranfrage bei BU &amp; PKV
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-700/80">
        Die gesundheitliche Vorgeschichte entscheidet oft mit, ob und zu welchen Bedingungen
        Versicherungsschutz möglich ist. Deshalb bereiten wir deine Angaben vor dem Antrag
        sorgfältig auf.
      </p>
    </div>

    <ol class="border-t border-ink-950/10">
      {
        topics.map((topic, index) => (
          <li data-reveal style={`transition-delay: ${index * 90}ms`} class="grid gap-4 border-b border-ink-950/10 py-8 sm:grid-cols-[3rem_1fr] sm:gap-6">
            <span class="font-serif text-3xl font-semibold leading-none text-brand-600/40" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <div>
              <h3 class="font-serif text-xl font-semibold text-ink-950 sm:text-2xl">{topic.title}</h3>
              <p class="mt-3 max-w-xl text-base leading-relaxed text-ink-700/80">{topic.text}</p>
              <div class="mt-5 flex flex-wrap gap-3">
                {topic.links.map((link) => (
                  <a
                    href={link.href}
                    data-cta={link.ctaId}
                    class="group inline-flex min-h-11 items-center gap-2 rounded-full border border-ink-950/15 bg-white px-5 text-sm font-semibold text-ink-950 transition-colors hover:border-brand-600 hover:text-brand-700"
                  >
                    <span>
                      <span class="sr-only">{topic.title} </span>
                      {link.label}
                    </span>
                    <ArrowRight className="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5" aria-hidden="true" />
                  </a>
                ))}
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
