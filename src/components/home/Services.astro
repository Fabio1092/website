---
import { ShieldCheck, HeartPulse, ArrowRight } from "lucide-react";

const services = [
  {
    icon: ShieldCheck,
    title: "Berufsunfähigkeits­versicherung (BU)",
    description:
      "Deine Arbeitskraft ist dein wertvollstes Kapital. Ich unterstütze dich dabei, die passende Berufsunfähigkeitsversicherung zu finden und auf eine saubere Gesundheitsprüfung zu achten.",
    points: [
      "Individuelle Analyse",
      "Hilfe bei Gesundheitsfragen",
      "Vergleich verschiedener Anbieter",
      "Begleitung im Leistungsfall",
    ],
    href: "/bu",
    cta: "Mehr zur BU-Beratung",
  },
  {
    icon: HeartPulse,
    title: "Private Kranken­versicherung (PKV)",
    description:
      "Die Entscheidung für oder gegen die private Krankenversicherung sollte gut durchdacht sein. Ich begleite dich von der Analyse bis zur langfristigen Betreuung.",
    points: ["PKV-Wechsel prüfen", "Selbständige, Beamte & Angestellte", "Anbietervergleich", "Langfristige Betreuung"],
    href: "/private-krankenversicherung-kassel",
    cta: "Mehr zur PKV-Beratung",
  },
];
---

<section class="bg-brand-50/40 py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <span class="text-sm font-semibold uppercase tracking-wider text-brand-600">Meine Leistungen</span>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">So kann ich dich unterstützen</h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-700/80">
        Ich habe mich bewusst auf zwei der wichtigsten Themen der finanziellen Absicherung spezialisiert.
        So profitierst du von einer Beratung mit klarem Fokus, fundiertem Fachwissen und individuellen Lösungen.
      </p>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2">
      {
        services.map((service, index) => (
          <div
            data-reveal
            style={`transition-delay: ${index * 100}ms`}
            class="flex flex-col rounded-2xl border border-black/5 bg-white p-8 shadow-sm transition-shadow duration-300 hover:shadow-xl hover:shadow-brand-900/5"
          >
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-500/10 text-brand-600">
              <service.icon className="h-6 w-6" aria-hidden="true" />
            </div>
            <h3 class="mt-6 font-serif text-xl font-semibold text-ink-950">{service.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-700/75">{service.description}</p>
            <ul class="mt-6 space-y-2.5">
              {service.points.map((point) => (
                <li class="flex items-start gap-2.5 text-sm text-ink-700/85">
                  <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-gold-500" />
                  {point}
                </li>
              ))}
            </ul>
            <a
              href={service.href}
              class="mt-8 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700 transition-colors hover:text-brand-800"
            >
              {service.cta}
              <ArrowRight className="h-4 w-4" aria-hidden="true" />
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>
