---
import { ShieldCheck, HeartPulse, ArrowRight } from "lucide-react";

const services = [
  {
    icon: ShieldCheck,
    dark: false,
    title: "Berufsunfähigkeits­versicherung",
    short: "BU",
    description:
      "Deine Arbeitskraft ist dein wertvollstes Kapital. Ich unterstütze dich dabei, die passende Berufsunfähigkeitsversicherung zu finden und auf eine saubere Gesundheitsprüfung zu achten.",
    points: ["Individuelle Analyse", "Hilfe bei Gesundheitsfragen", "Vergleich verschiedener Anbieter", "Begleitung im Leistungsfall"],
    href: "/berufsunfaehigkeitsversicherung-kassel/",
    cta: "Mehr zur BU-Beratung",
  },
  {
    icon: HeartPulse,
    dark: true,
    title: "Private Kranken­versicherung",
    short: "PKV",
    description:
      "Die Entscheidung für oder gegen die private Krankenversicherung sollte gut durchdacht sein. Ich begleite dich von der Analyse bis zur langfristigen Betreuung.",
    points: ["PKV-Wechsel prüfen", "Selbständige, Beamte & Angestellte", "Anbietervergleich", "Langfristige Betreuung"],
    href: "/private-krankenversicherung-kassel/",
    cta: "Mehr zur PKV-Beratung",
  },
];
---

<section class="bg-white py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">So kann ich <span class="text-brand-600">dich unterstützen</span></h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-700/80">
        Ich habe mich bewusst auf zwei der wichtigsten Themen der finanziellen Absicherung
        spezialisiert. So profitierst du von einer Beratung mit klarem Fokus, fundiertem
        Fachwissen und individuellen Lösungen.
      </p>
    </div>

    <div class="shadow-lift mt-14 grid overflow-hidden rounded-3xl lg:grid-cols-2">
      {
        services.map((service) => (
          <a
            href={service.href}
            data-reveal
            class:list={[
              "group relative flex flex-col justify-between p-10 transition-colors duration-300 sm:p-12 lg:p-14",
              service.dark ? "bg-ink-950 text-white" : "bg-brand-50/60 text-ink-950",
            ]}
          >
            <div
              class:list={[
                "pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full blur-3xl transition-opacity duration-500 group-hover:opacity-80",
                service.dark ? "bg-brand-500/20 opacity-60" : "bg-gold-400/20 opacity-50",
              ]}
              aria-hidden="true"
            />

            <div class="relative">
              <div
                class:list={[
                  "flex h-14 w-14 items-center justify-center rounded-2xl",
                  service.dark ? "bg-white/10 text-brand-300" : "bg-white text-brand-600 shadow-sm",
                ]}
              >
                <service.icon className="h-6 w-6" aria-hidden="true" />
              </div>
              <p
                class:list={[
                  "mt-6 text-xs font-semibold uppercase tracking-wider",
                  service.dark ? "text-brand-300" : "text-brand-600",
                ]}
              >
                {service.short}
              </p>
              <h3 class="mt-2 font-serif text-2xl font-semibold sm:text-3xl">{service.title}</h3>
              <p class:list={["mt-4 max-w-md text-base leading-relaxed", service.dark ? "text-white/70" : "text-ink-700/75"]}>
                {service.description}
              </p>

              <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2">
                {service.points.map((point) => (
                  <li
                    class:list={[
                      "text-sm leading-relaxed",
                      service.dark ? "text-white/60" : "text-ink-700/70",
                    ]}
                  >
                    {point}
                  </li>
                ))}
              </ul>
            </div>

            <div
              class:list={[
                "relative mt-10 inline-flex items-center gap-1.5 text-sm font-semibold",
                service.dark ? "text-brand-300" : "text-brand-700",
              ]}
            >
              {service.cta}
              <ArrowRight className="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true" />
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
