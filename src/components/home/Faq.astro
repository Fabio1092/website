---
import FaqAccordion from "./FaqAccordion.tsx";
---

<section class="bg-brand-50/40 py-24">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <span class="text-sm font-semibold uppercase tracking-wider text-brand-600">FAQ</span>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">
        Noch Fragen? Hier findest du die wichtigsten Antworten.
      </h2>
    </div>
    <div data-reveal class="mt-12">
      <FaqAccordion client:visible />
    </div>
  </div>
</section>
