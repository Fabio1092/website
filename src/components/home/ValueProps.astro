---
import { Scale, UserRound, MessageCircleHeart, Clock } from "lucide-react";

const values = [
  {
    icon: Scale,
    title: "Ungebunden beraten",
    description: "Ich vertrete ausschließlich deine Interessen – nicht die einer Versicherung.",
  },
  {
    icon: UserRound,
    title: "Persönliche Betreuung",
    description: "Du hast einen festen Ansprechpartner, der dich kennt und für dich da ist.",
  },
  {
    icon: MessageCircleHeart,
    title: "Verständliche Empfehlungen",
    description: "Ich erkläre komplexe Themen einfach und klar – ohne Fachchinesisch und ohne Tarifflut.",
  },
  {
    icon: Clock,
    title: "Langfristige Begleitung",
    description: "Auch nach dem Abschluss bleibe ich an deiner Seite und prüfe regelmäßig, ob alles noch passt.",
  },
];
---

<section class="bg-ink-950 py-24 text-white">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="mt-3 font-serif text-3xl font-semibold tracking-tight sm:text-4xl">
        Beratung, die weiterdenkt. <span class="text-brand-400">Für Menschen, nicht für Verträge.</span>
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-white/70">
        Mein Anspruch ist es, die beste Lösung für dich zu finden – und dich langfristig zu begleiten.
        Dafür stehen diese Werte, die meine Beratung ausmachen:
      </p>
    </div>

    <div class="mt-14 grid gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10 sm:grid-cols-2 lg:grid-cols-4">
      {
        values.map((value, index) => (
          <div data-reveal style={`transition-delay: ${index * 80}ms`} class="bg-ink-950 p-8">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-white/5 text-gold-400">
              <value.icon className="h-5 w-5" aria-hidden="true" />
            </div>
            <h3 class="mt-5 text-base font-semibold text-white">{value.title}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-white/60">{value.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
