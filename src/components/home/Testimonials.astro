---
import { Star } from "lucide-react";
import { siteConfig } from "@/lib/site";
---

<section class="bg-white py-24">
  <div class="mx-auto max-w-5xl px-4 text-center sm:px-6 lg:px-8">
    <span class="text-sm font-semibold uppercase tracking-wider text-brand-600">Kundenstimmen</span>
    <h2 class="mt-3 text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">
      Vertrauen entsteht durch <span class="text-brand-600">Ergebnisse</span>
    </h2>
    <div class="mt-4 flex items-center justify-center gap-2 text-gold-500">
      {Array.from({ length: 5 }).map(() => <Star className="h-5 w-5 fill-current" aria-hidden="true" />)}
      <span class="ml-2 text-sm font-medium text-ink-700">5.0 von 5 · basierend auf 36 Bewertungen</span>
    </div>

    <div class="mt-12 rounded-2xl border border-black/5 bg-brand-50/40 p-4 sm:p-6">
      <!-- Trustindex widget: auto-mounts where this script tag is placed -->
      <script is:inline type="text/javascript" defer async src={siteConfig.trustindexEmbedSrc}></script>
      <noscript>
        <p class="p-6 text-sm text-ink-700/70">
          Live-Bewertungen werden über
          <a href="https://www.trustindex.io/reviews/www.fr-makler.de" class="underline" target="_blank" rel="noopener noreferrer">
            Trustindex
          </a>
          angezeigt.
        </p>
      </noscript>
    </div>
  </div>
</section>
