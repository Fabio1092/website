---
const partners = [
  { name: "Allianz", src: "/images/partners/allianz.png" },
  { name: "AXA", src: "/images/partners/axa.png" },
  { name: "ARAG", src: "/images/partners/arag.png" },
  { name: "Baloise", src: "/images/partners/baloise.png" },
  { name: "die Bayerische", src: "/images/partners/die-bayerische.png" },
  { name: "Hannoversche", src: "/images/partners/hannoversche.png" },
  { name: "R+V Versicherung", src: "/images/partners/rv-versicherung.png" },
  { name: "Versicherungskammer Bayern", src: "/images/partners/versicherungskammer-bayern.png" },
];

const track = [...partners, ...partners];
const originalCount = partners.length;
---

<section class="overflow-hidden bg-white py-16 sm:py-20">
  <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
    <h2 class="text-2xl font-semibold tracking-tight text-ink-950 sm:text-3xl">
      Die besten Konditionen von <span class="text-brand-600">starken Partnern.</span>
    </h2>
    <p class="mt-3 text-base leading-relaxed text-ink-700/75">
      Als unabhängiger Makler arbeite ich mit über 100 Gesellschaften zusammen — hier eine
      Auswahl meiner Top-Partner.
    </p>
  </div>

  <div
    data-reveal
    class="group relative mt-12 [mask-image:linear-gradient(to_right,transparent,black_5%,black_95%,transparent)]"
  >
    <div class="flex w-max items-stretch gap-5 [animation-play-state:running] motion-safe:animate-marquee motion-safe:group-hover:[animation-play-state:paused]">
      {
        track.map((partner, index) => {
          const isClone = index >= originalCount;
          return (
            <div
              class="flex h-24 w-48 shrink-0 items-center justify-center rounded-2xl border border-black/5 bg-white p-6 shadow-sm sm:h-28 sm:w-56"
              aria-hidden={isClone ? "true" : undefined}
            >
              <img
                src={partner.src}
                alt={partner.name}
                loading="lazy"
                decoding="async"
                class="max-h-10 w-auto max-w-full object-contain grayscale opacity-70 transition duration-300 hover:grayscale-0 hover:opacity-100 sm:max-h-12"
              />
            </div>
          );
        })
      }
    </div>
  </div>
</section>
