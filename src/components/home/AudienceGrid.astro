---
import { Briefcase, Building2, Landmark, GraduationCap } from "lucide-react";

const audiences = [
  {
    icon: Briefcase,
    title: "Angestellte & Akademiker",
    description:
      "Bei Angestellten spielen Einkommen, berufliche Entwicklung und langfristige Absicherung eine zentrale Rolle.",
    links: [
      { label: "BU für Angestellte", href: "/bu-angestellte-kassel/", ctaId: "home_audience_bu_employees" },
      { label: "PKV für Angestellte", href: "/pkv-angestellte-kassel/", ctaId: "home_audience_pkv_employees" },
    ],
  },
  {
    icon: Building2,
    title: "Selbstständige & Unternehmer",
    description:
      "Für Selbstständige müssen Absicherung und Krankenversicherung auch bei schwankendem Einkommen und langfristiger Unternehmensplanung funktionieren.",
    links: [
      { label: "BU für Selbstständige", href: "/bu-selbststaendige-kassel/", ctaId: "home_audience_bu_selfemployed" },
      { label: "PKV für Selbstständige", href: "/pkv-selbststaendige-kassel/", ctaId: "home_audience_pkv_selfemployed" },
    ],
  },
  {
    icon: Landmark,
    title: "Beamte & Referendare",
    description:
      "Bei Beamten gelten durch Dienstunfähigkeit und Beihilfe besondere Rahmenbedingungen für BU beziehungsweise DU und PKV.",
    links: [
      { label: "BU für Beamte", href: "/bu-beamte-kassel/", ctaId: "home_audience_bu_civilservants" },
      { label: "PKV für Beamte", href: "/pkv-beamte-kassel/", ctaId: "home_audience_pkv_civilservants" },
    ],
  },
  {
    icon: GraduationCap,
    title: "Studenten & Berufseinsteiger",
    description:
      "Bei Studenten kann eine frühe BU-Absicherung relevant sein, weil Gesundheitszustand, Studiengang und späterer Beruf die Versicherbarkeit und Gestaltung beeinflussen können.",
    links: [
      { label: "BU für Studenten", href: "/bu-studenten-kassel/", ctaId: "home_audience_bu_students" },
    ],
  },
];
---

<section class="bg-white py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">
        BU- und PKV-Beratung für <span class="text-brand-600">unterschiedliche Lebenssituationen</span>
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-700/80">
        Je nach Beruf und Lebensphase unterscheiden sich Anforderungen an BU und PKV deutlich. Hier
        findest du die passenden Informationen für deine Situation.
      </p>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-2">
      {
        audiences.map((audience) => (
          <div data-reveal class="flex flex-col rounded-2xl border border-black/5 bg-brand-50/30 p-6">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-white text-brand-600 shadow-sm">
              <audience.icon className="h-5 w-5" aria-hidden="true" />
            </div>
            <h3 class="mt-5 font-serif text-lg font-semibold text-ink-950">{audience.title}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-ink-700/75">{audience.description}</p>
            <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2">
              {audience.links.map((link) => (
                <a
                  href={link.href}
                  data-cta={link.ctaId}
                  class="text-sm font-semibold text-brand-700 underline underline-offset-2 hover:text-brand-800"
                >
                  {link.label}
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
