---
import { Briefcase, Building2, Users, Landmark } from "lucide-react";
import { siteConfig } from "@/lib/site";

const audiences = [
  {
    icon: Briefcase,
    title: "Angestellte & Akademiker",
    description:
      "Du bist angestellt oder Akademiker und möchtest deine Arbeitskraft langfristig absichern? Ich helfe dir, die passende BU und PKV zu finden — verständlich, transparent und auf deine Situation abgestimmt.",
  },
  {
    icon: Building2,
    title: "Selbstständige & Unternehmer",
    description:
      "Du führst dein eigenes Unternehmen und willst dich, deine Familie und dein Business optimal absichern? Gemeinsam entwickeln wir Lösungen, die zu dir und deinem Leben passen.",
  },
  {
    icon: Users,
    title: "Familien & Gutverdiener",
    description:
      "Du möchtest das Beste für deine Liebsten und gleichzeitig deine Gesundheit und dein Einkommen schützen? Ich zeige dir, wie du heute clever vorsorgst.",
  },
  {
    icon: Landmark,
    title: "Beamte & Referendare",
    description:
      "Als Beamter oder Referendar hast du besondere Möglichkeiten bei der Absicherung. Ich begleite dich bei der optimalen Auswahl.",
  },
];

---

<section class="overflow-hidden bg-white py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">
        Meine Beratung passt zu dir, wenn du <span class="text-brand-600">deine Zukunft absichern</span> willst.
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-700/80">
        Egal, in welcher Lebensphase du gerade stehst – ich helfe dir dabei, die passende
        Absicherung für deine Gesundheit, deine Arbeitskraft und deine Familie zu finden.
      </p>
    </div>
  </div>

  <div
    data-reveal
    class="group relative mt-14 [mask-image:linear-gradient(to_right,transparent,black_5%,black_95%,transparent)]"
  >
    <div id="audience-marquee-track" class="flex w-max gap-6 [animation-play-state:running] motion-safe:group-hover:[animation-play-state:paused]">
      {
        audiences.map((audience) => (
          <div class="flex w-[19rem] shrink-0 flex-col rounded-2xl border border-black/5 bg-brand-50/30 p-6 sm:w-[22rem]">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-white text-brand-600 shadow-sm">
              <audience.icon className="h-5 w-5" aria-hidden="true" />
            </div>
            <h3 class="mt-5 font-serif text-lg font-semibold text-ink-950">{audience.title}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-ink-700/75">{audience.description}</p>
          </div>
        ))
      }
    </div>
  </div>

  <div class="mx-auto mt-12 max-w-6xl px-4 text-center sm:px-6 lg:px-8">
    <a
      href={siteConfig.calendlyUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center rounded-full bg-ink-950 px-7 py-3.5 text-sm font-semibold text-white transition-transform duration-200 hover:-translate-y-0.5 hover:bg-ink-800"
    >
      Jetzt Termin vereinbaren
    </a>
  </div>
</section>

<script>
  // Duplicate the track client-side (not in the server-rendered HTML) so the
  // seamless CSS loop still works without doubling this content for crawlers.
  const track = document.getElementById("audience-marquee-track");
  if (track && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const clones = Array.from(track.children).map((node) => {
      const clone = node.cloneNode(true) as HTMLElement;
      clone.setAttribute("aria-hidden", "true");
      return clone;
    });
    clones.forEach((clone) => track.appendChild(clone));
    track.classList.add("animate-marquee");
  }
</script>
