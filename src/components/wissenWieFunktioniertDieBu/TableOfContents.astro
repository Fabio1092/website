  { id: "wann-berufsunfaehig", label: "Wann gilt man als berufsunfähig?" },
  { id: "fuenfzig-prozent-regel", label: "Was bedeutet die 50-Prozent-Regel?" },
  { id: "beispiel-handwerker", label: "Beispiel: Ein Handwerker wird berufsunfähig" },
  { id: "beispiel-bueroangestellter", label: "Beispiel: Ein Büroangestellter wird berufsunfähig" },
  { id: "sechs-monate-krankgeschrieben", label: "Muss ich sechs Monate krankgeschrieben sein?" },
