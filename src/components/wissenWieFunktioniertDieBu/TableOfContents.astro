  { id: "konkrete-verweisung", label: "Was ist eine konkrete Verweisung?" },
  { id: "bu-vs-erwerbsminderungsrente", label: "Was ist der Unterschied zwischen BU-Rente und Erwerbsminderungsrente?" },
  { id: "psychische-erkrankungen", label: "Zahlt die BU auch bei psychischen Erkrankungen?" },
  { id: "gesundheitsfragen-beantworten", label: "Muss ich Gesundheitsfragen beantworten, um eine BU abzuschließen?" },
  { id: "vorerkrankungen", label: "Was mache ich bei Vorerkrankungen?" },
  { id: "was-kostet-eine-bu", label: "Was kostet eine Berufsunfähigkeitsversicherung?" },
  { id: "beitragsdynamik", label: "Was bedeutet Beitragsdynamik?" },
  { id: "leistungsdynamik", label: "Was bedeutet Leistungsdynamik?" },
