  | { type: "quote"; text: string }
  | { type: "list"; items: string[] }
  | { type: "h3"; text: string }
  | { type: "table"; headers: string[]; rows: string[][] };

interface Section {
  id: string;
  heading: string;
  blocks: Block[];
}

const introBlocks: Block[] = [
  { type: "p", parts: ["Aber was passiert, wenn du deinen Beruf wegen einer Krankheit oder eines Unfalls plötzlich nicht mehr ausüben kannst?"] },
  { type: "p", parts: ["Deine laufenden Ausgaben verschwinden dadurch schließlich nicht."] },
  { type: "p", parts: ["Miete, Kredit, Lebensmittel, Versicherungen und deine Altersvorsorge müssen weiterhin bezahlt werden."] },
  { type: "p", parts: ["Genau hier setzt die Berufsunfähigkeitsversicherung an."] },
  { type: "standalone", text: "Eine Berufsunfähigkeitsversicherung soll dein Einkommen absichern, wenn du deinen zuletzt ausgeübten Beruf aus gesundheitlichen Gründen nicht mehr ausreichend ausüben kannst." },
  { type: "p", parts: ["Dafür vereinbarst du mit einem Versicherer eine monatliche BU-Rente."] },
  { type: "p", parts: ["Wenn die vertraglichen Voraussetzungen erfüllt sind, erhältst du diese Rente für die Dauer der versicherten Berufsunfähigkeit, längstens bis zum vereinbarten Ende der Leistungsdauer."] },
  { type: "p", parts: ["Wie das genau funktioniert, erkläre ich dir Schritt für Schritt."] },
];

