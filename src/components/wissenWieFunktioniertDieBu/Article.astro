    heading: "Was ist eine konkrete Verweisung?",
    blocks: [
      { type: "p", parts: ["Anders sieht es aus, wenn du nach Eintritt deiner gesundheitlichen Einschränkungen tatsächlich einen anderen Beruf ausübst."] },
      { type: "p", parts: ["Dann kann unter den vertraglichen Voraussetzungen eine konkrete Verweisung geprüft werden."] },
      { type: "p", parts: ["Dabei spielen beispielsweise deine neue Tätigkeit, deine Ausbildung, deine Fähigkeiten, dein Einkommen und deine bisherige Lebensstellung eine Rolle."] },
      { type: "p", parts: ["Eine neue Tätigkeit führt deshalb nicht automatisch dazu, dass die BU-Rente entfällt."] },
      { type: "p", parts: ["Die genaue Bewertung ist vom Vertrag und vom Einzelfall abhängig."] },
      {
        type: "p",
        parts: [
          "Mehr dazu findest du unter ",
          { a: "Konkrete Verweisung in der BU", href: "/wissen/berufsunfaehigkeitsversicherung/konkrete-verweisung/" },
          ".",
        ],
      },
    ],
  },
  {
    id: "bu-vs-erwerbsminderungsrente",
    heading: "Was ist der Unterschied zwischen BU-Rente und Erwerbsminderungsrente?",
    blocks: [
      { type: "p", parts: ["Das ist ein besonders wichtiger Unterschied."] },
      { type: "p", parts: ["Die private BU sichert grundsätzlich deinen zuletzt ausgeübten Beruf nach den vereinbarten Versicherungsbedingungen ab."] },
      { type: "p", parts: ["Bei der gesetzlichen Erwerbsminderungsrente geht es dagegen grundsätzlich darum, wie lange du aus gesundheitlichen Gründen noch unter den üblichen Bedingungen des allgemeinen Arbeitsmarktes arbeiten kannst."] },
      { type: "p", parts: ["Für eine volle Erwerbsminderungsrente ist grundsätzlich eine Leistungsfähigkeit von weniger als drei Stunden täglich auf dem allgemeinen Arbeitsmarkt maßgeblich."] },
      { type: "p", parts: ["Bei einer teilweisen Erwerbsminderung liegt die Leistungsfähigkeit grundsätzlich bei mindestens drei, aber weniger als sechs Stunden täglich."] },
      { type: "p", parts: ["Zusätzlich müssen die versicherungsrechtlichen Voraussetzungen erfüllt sein."] },
      { type: "p", parts: ["Ein Beispiel:"] },
      { type: "p", parts: ["Du kannst deinen anspruchsvollen bisherigen Beruf aus gesundheitlichen Gründen nicht mehr ausüben."] },
      { type: "p", parts: ["Eine andere, einfachere Tätigkeit wäre möglicherweise aber noch ausreichend lange möglich."] },
      { type: "p", parts: ["Dann kann unter geeigneten BU-Bedingungen durchaus Berufsunfähigkeit vorliegen, obwohl kein Anspruch auf eine volle gesetzliche Erwerbsminderungsrente besteht."] },
      { type: "standalone", text: "Eine private BU-Rente und eine gesetzliche Erwerbsminderungsrente sind deshalb keine identischen Leistungen." },
    ],
  },
  {
    id: "psychische-erkrankungen",
    heading: "Zahlt die BU auch bei psychischen Erkrankungen?",
    blocks: [
      { type: "p", parts: ["Grundsätzlich können auch psychische Erkrankungen zu einem BU-Leistungsanspruch führen."] },
      { type: "p", parts: ["Beispielsweise können schwere psychische Beeinträchtigungen dazu führen, dass berufliche Anforderungen dauerhaft nicht mehr ausreichend erfüllt werden können."] },
      { type: "p", parts: ["Entscheidend ist wiederum nicht allein die Diagnose."] },
      { type: "p", parts: ["Geprüft werden die gesundheitlichen Einschränkungen, deren Auswirkungen auf deinen konkreten Beruf und die Versicherungsbedingungen."] },
      { type: "p", parts: ["Wichtig ist außerdem, ob bei Vertragsabschluss ein individueller Leistungsausschluss vereinbart wurde."] },
      { type: "p", parts: ["Deshalb würde ich bereits beim Abschluss sorgfältig auf eine vollständige und richtige Beantwortung der Gesundheitsfragen achten."] },
    ],
  },
  {
    id: "gesundheitsfragen-beantworten",
    heading: "Muss ich Gesundheitsfragen beantworten, um eine BU abzuschließen?",
    blocks: [
      { type: "p", parts: ["In der Regel ja."] },
      { type: "p", parts: ["Vor Abschluss einer BU stellt der Versicherer Fragen zu deiner Gesundheit."] },
      { type: "p", parts: ["Welche Zeiträume und Informationen abgefragt werden, hängt vom konkreten Antrag ab."] },
      { type: "p", parts: ["Dabei können beispielsweise relevant sein:"] },
      {
        type: "list",
        items: ["ambulante Behandlungen", "stationäre Aufenthalte", "Diagnosen", "Medikamente", "Beschwerden", "psychotherapeutische Behandlungen", "Untersuchungen", "geplante Behandlungen"],
      },
      { type: "p", parts: ["Entscheidend ist, dass du die konkret gestellten Fragen vollständig und wahrheitsgemäß beantwortest."] },
      { type: "p", parts: ["Unrichtige oder unvollständige Antworten können später erhebliche Konsequenzen für den Versicherungsschutz haben."] },
      { type: "p", parts: ["Deshalb würde ich vor einem Antrag deine Gesundheitshistorie sorgfältig aufarbeiten."] },
      {
        type: "p",
        parts: ["Mehr dazu findest du unter ", { a: "Gesundheitsfragen bei der BU", href: "/bu-gesundheitsfragen/" }, "."],
      },
    ],
  },
  {
    id: "vorerkrankungen",
    heading: "Was mache ich bei Vorerkrankungen?",
    blocks: [
      { type: "p", parts: ["Eine Vorerkrankung bedeutet nicht automatisch, dass du keine BU abschließen kannst."] },
      { type: "p", parts: ["Versicherer bewerten gesundheitliche Risiken unterschiedlich."] },
      { type: "p", parts: ["Je nach Vorerkrankung können beispielsweise folgende Ergebnisse entstehen:"] },
      { type: "list", items: ["normale Annahme", "Risikozuschlag", "individueller Leistungsausschluss", "Rückfragen", "Zurückstellung", "Ablehnung"] },
      { type: "p", parts: ["Wenn relevante Vorerkrankungen bestehen, würde ich häufig zuerst eine anonyme oder pseudonymisierte Risikovoranfrage prüfen."] },
      { type: "p", parts: ["So lässt sich vor dem eigentlichen Versicherungsantrag einschätzen, welche Gesellschaften dich zu welchen Bedingungen versichern würden."] },
      { type: "p", parts: ["Wichtig:"] },
      { type: "p", parts: ["Eine Risikovoranfrage ist noch kein abgeschlossener Versicherungsvertrag."] },
      {
        type: "p",
        parts: ["Mehr dazu findest du unter ", { a: "BU-Risikovoranfrage", href: "/bu-risikovoranfrage/" }, "."],
      },
    ],
  },
  {
    id: "was-kostet-eine-bu",
    heading: "Was kostet eine Berufsunfähigkeitsversicherung?",
    blocks: [
      { type: "p", parts: ["Darauf gibt es keine pauschale Antwort."] },
      { type: "p", parts: ["Der Beitrag hängt unter anderem ab von:"] },
      {
        type: "list",
        items: ["Eintrittsalter", "beruflicher Tätigkeit", "Gesundheitshistorie", "gewünschter BU-Rente", "Versicherungsdauer", "Leistungsdauer", "Versicherer", "Tarif und Zusatzbausteinen"],
      },
      { type: "p", parts: ["Deshalb kann dieselbe Rentenhöhe bei zwei Menschen sehr unterschiedlich viel kosten."] },
      { type: "p", parts: ["Und auch unterschiedliche Versicherer können denselben Beruf unterschiedlich einstufen."] },
      { type: "p", parts: ["Ich würde deshalb nicht nur Beiträge vergleichen."] },
      { type: "p", parts: ["Ein günstiger Beitrag hilft dir wenig, wenn wichtige Bedingungen fehlen oder du im Leistungsfall eine erhebliche Versorgungslücke hast."] },
    ],
  },
  {
    id: "beitragsdynamik",
    heading: "Was bedeutet Beitragsdynamik?",
    blocks: [
      { type: "p", parts: ["Eine Beitragsdynamik soll dir ermöglichen, den Versicherungsschutz während der Vertragslaufzeit regelmäßig zu erhöhen."] },
      { type: "p", parts: ["Dadurch kann die versicherte BU-Rente mit der Zeit steigen."] },
      { type: "p", parts: ["Je nach vereinbarten Bedingungen kann die Erhöhung ohne erneute vollständige Gesundheitsprüfung erfolgen."] },
      { type: "p", parts: ["Dabei steigt regelmäßig auch dein Beitrag."] },
      { type: "p", parts: ["Wichtig ist:"] },
      { type: "p", parts: ["Eine Beitragsdynamik ist etwas anderes als die Leistungsdynamik."] },
      { type: "p", parts: ["Die Beitragsdynamik betrifft den Aufbau deines Versicherungsschutzes vor Eintritt der Berufsunfähigkeit."] },
    ],
  },
  {
    id: "leistungsdynamik",
    heading: "Was bedeutet Leistungsdynamik?",
    blocks: [
      { type: "p", parts: ["Die Leistungsdynamik betrifft dagegen die Zeit, in der du bereits eine anerkannte BU-Rente erhältst."] },
      { type: "p", parts: ["Ist eine entsprechende garantierte Rentensteigerung vereinbart, kann sich die laufende BU-Rente während des Leistungsbezugs jährlich um den vereinbarten Prozentsatz erhöhen."] },
      { type: "p", parts: ["Das kann wichtig sein, weil deine Lebenshaltungskosten auch bei einer langjährigen Berufsunfähigkeit steigen können."] },
      { type: "p", parts: ["Eine garantierte Leistungsdynamik ist nicht dasselbe wie eine mögliche Überschussbeteiligung."] },
      {
        type: "p",
        parts: [
          "Mehr dazu findest du unter ",
          { a: "Leistungsdynamik in der BU", href: "/wissen/berufsunfaehigkeitsversicherung/leistungsdynamik/" },
          ".",
        ],
      },
    ],
  },
  {
    id: "bu-rente-spaeter-erhoehen",
    heading: "Kann ich meine BU-Rente später erhöhen?",
    blocks: [
      { type: "p", parts: ["Viele moderne BU-Verträge bieten sogenannte Nachversicherungsmöglichkeiten."] },
      { type: "p", parts: ["Damit kannst du deine versicherte BU-Rente unter bestimmten Voraussetzungen später erhöhen."] },
      { type: "p", parts: ["Zum Beispiel können vertraglich bestimmte Ereignisse relevant sein:"] },
      { type: "list", items: ["Gehaltserhöhung", "Heirat", "Geburt eines Kindes", "Immobilienfinanzierung", "berufliche Veränderungen"] },
      { type: "p", parts: ["Welche Erhöhungsmöglichkeiten bestehen, hängt vom Versicherungsvertrag ab."] },
      { type: "p", parts: ["Dabei sind insbesondere Höchstgrenzen, Fristen und mögliche Verzichtsregelungen zur erneuten Gesundheitsprüfung relevant."] },
      { type: "p", parts: ["Deshalb würde ich Nachversicherungsrechte bereits beim Abschluss berücksichtigen."] },
    ],
  },
  {
    id: "wieder-gesund-werden",
    heading: "Was passiert, wenn ich nach einer Berufsunfähigkeit wieder gesund werde?",
    blocks: [
      { type: "p", parts: ["Eine anerkannte Berufsunfähigkeit muss nicht zwangsläufig bis zum Ende der Versicherungsdauer bestehen bleiben."] },
      { type: "p", parts: ["Wenn sich dein Gesundheitszustand verbessert, kann sich auch deine berufliche Leistungsfähigkeit verändern."] },
      { type: "p", parts: ["Viele Versicherer haben das Recht, im Rahmen der vertraglichen und gesetzlichen Voraussetzungen eine Nachprüfung durchzuführen."] },
      { type: "p", parts: ["Dabei kann beispielsweise geprüft werden, ob die gesundheitlichen Einschränkungen weiterhin bestehen."] },
      { type: "p", parts: ["Wenn die Voraussetzungen für Berufsunfähigkeit nicht mehr erfüllt sind und die rechtlichen Anforderungen an eine Leistungseinstellung eingehalten werden, kann die Zahlung enden."] },
      { type: "p", parts: ["Deshalb ist eine BU-Rente nicht automatisch eine garantierte Zahlung bis zum ursprünglich vereinbarten Endalter."] },
    ],
  },
  {
    id: "wieder-arbeiten-waehrend-leistungsbezug",
    heading: "Was passiert, wenn ich während des Leistungsbezugs wieder arbeite?",
    blocks: [
      { type: "p", parts: ["Das hängt davon ab, welche Tätigkeit du ausübst und was deine Versicherungsbedingungen regeln."] },
      { type: "p", parts: ["Ein neuer Job führt nicht in jedem Fall automatisch zum Wegfall der BU-Rente."] },
      { type: "p", parts: ["Es kann beispielsweise entscheidend sein:"] },
      {
        type: "list",
        items: ["welche Tätigkeit du jetzt ausübst", "wie hoch dein neues Einkommen ist", "welche Qualifikation dafür erforderlich ist", "wie sich deine berufliche und soziale Stellung verändert", "welche konkrete Verweisungsklausel vereinbart ist"],
      },
      { type: "p", parts: ["Deshalb würde ich eine neue Tätigkeit während eines BU-Leistungsbezugs niemals pauschal beurteilen."] },
    ],
  },
  {
    id: "drei-praxisbeispiele",
    heading: "Drei typische Beispiele für die Funktionsweise einer BU",
    blocks: [
      { type: "h3", text: "Beispiel 1: Handwerker mit Rückenproblemen" },
      { type: "p", parts: ["Ein Handwerker kann wesentliche körperliche Tätigkeiten seines bisherigen Berufs wegen einer Erkrankung nicht mehr ausüben."] },
      { type: "p", parts: ["Auch wenn er noch bestimmte Büroaufgaben erledigen kann, kann unter den konkreten Voraussetzungen eine Berufsunfähigkeit vorliegen."] },
      { type: "p", parts: ["Entscheidend sind sein tatsächliches Tätigkeitsbild, die gesundheitlichen Einschränkungen und die Versicherungsbedingungen."] },
      { type: "h3", text: "Beispiel 2: Projektleiter mit psychischer Erkrankung" },
      { type: "p", parts: ["Ein Projektleiter leidet an einer schwerwiegenden psychischen Erkrankung."] },
      { type: "p", parts: ["Er kann wesentliche Anforderungen seines bisherigen Berufs über längere Zeit nicht mehr ausreichend bewältigen."] },
      { type: "p", parts: ["Wenn die vertraglichen Voraussetzungen erfüllt sind, kann auch daraus ein Anspruch auf BU-Leistungen entstehen."] },
      { type: "h3", text: "Beispiel 3: Selbstständiger mit gesundheitlichen Einschränkungen" },
      { type: "p", parts: ["Ein Selbstständiger fällt gesundheitlich aus."] },
      { type: "p", parts: ["Bei ihm muss besonders genau betrachtet werden, welche Aufgaben er bislang selbst übernommen hat und welche betrieblichen Möglichkeiten zur Umorganisation bestehen."] },
      { type: "p", parts: ["Bei guten BU-Bedingungen sind die Voraussetzungen und Grenzen einer zumutbaren Umorganisation entsprechend geregelt."] },
      { type: "p", parts: ["Auch für Selbstständige ist deshalb nicht nur die Berufsbezeichnung entscheidend."] },
    ],
  },
  {
    id: "typische-fehler",
    heading: "Welche Fehler würde ich beim BU-Abschluss vermeiden?",
    blocks: [
      { type: "h3", text: "Fehler 1: Die BU-Rente zu niedrig wählen" },
      { type: "p", parts: ["Eine zu niedrige Rente kann im Leistungsfall erhebliche finanzielle Lücken lassen."] },
      { type: "h3", text: "Fehler 2: Die Laufzeit zu kurz wählen" },
      { type: "p", parts: ["Wenn die BU bereits mit 60 endet, deine Altersrente aber erst später beginnt, kann eine große Versorgungslücke entstehen."] },
      { type: "h3", text: "Fehler 3: Nur nach dem günstigsten Beitrag entscheiden" },
      { type: "p", parts: ["Versicherungsbedingungen und langfristige Absicherung sind mindestens genauso wichtig."] },
      { type: "h3", text: "Fehler 4: Gesundheitsfragen ungenau beantworten" },
      { type: "p", parts: ["Unvollständige Angaben können den späteren Versicherungsschutz gefährden."] },
      { type: "h3", text: "Fehler 5: Auf abstrakte Verweisung nicht achten" },
      { type: "p", parts: ["Eine solche Klausel kann den Leistungsanspruch erheblich beeinflussen."] },
      { type: "h3", text: "Fehler 6: Nachversicherungsmöglichkeiten ignorieren" },
      { type: "p", parts: ["Dein Einkommen und deine finanziellen Verpflichtungen können sich verändern."] },
      { type: "h3", text: "Fehler 7: Beitragsdynamik und Leistungsdynamik verwechseln" },
      { type: "p", parts: ["Beide erfüllen unterschiedliche Funktionen."] },
      { type: "h3", text: "Fehler 8: Glauben, eine Krankschreibung reicht automatisch für die BU-Rente" },
      { type: "p", parts: ["Arbeitsunfähigkeit und Berufsunfähigkeit sind unterschiedliche Sachverhalte."] },
    ],
  },
  {
    id: "checkliste",
    heading: "Meine Checkliste für eine gute Berufsunfähigkeitsversicherung",
    blocks: [
      { type: "p", parts: ["Vor Abschluss würde ich mindestens diese Punkte prüfen:"] },
      {
        type: "list",
        items: [
          "1. Wie hoch ist mein aktuelles Nettoeinkommen?",
          "2. Welche monatlichen Ausgaben muss ich absichern?",
          "3. Wie hoch soll meine BU-Rente sein?",
          "4. Bis zu welchem Alter brauche ich den Versicherungsschutz?",
          "5. Bis zu welchem Alter soll die Rente gezahlt werden können?",
          "6. Welche konkreten beruflichen Tätigkeiten übe ich aus?",
          "7. Wie bewertet der Versicherer meinen Beruf?",
          "8. Sind meine Gesundheitsangaben vollständig aufgearbeitet?",
          "9. Ist eine Risikovoranfrage sinnvoll?",
          "10. Wie definiert der Tarif Berufsunfähigkeit?",
          "11. Welche Prognosedauer gilt?",
          "12. Ist der Verzicht auf abstrakte Verweisung geregelt?",
          "13. Wie funktioniert die konkrete Verweisung?",
          "14. Gibt es besondere Regelungen für Selbstständige?",
          "15. Besteht eine rückwirkende Leistungsregelung?",
          "16. Wie ist die Beitragsbefreiung im Leistungsfall geregelt?",
          "17. Welche Beitragsdynamik ist vorgesehen?",
          "18. Gibt es eine garantierte Leistungsdynamik?",
          "19. Welche Nachversicherungsmöglichkeiten bestehen?",
          "20. Wie funktioniert die Leistungsprüfung?",
          "21. Welche Rechte bestehen bei einer späteren Nachprüfung?",
          "22. Ist der Vertrag langfristig bezahlbar?",
        ],
      },
      { type: "p", parts: ["Wenn diese Fragen sauber beantwortet sind, hast du eine deutlich bessere Grundlage für deine Entscheidung."] },
    ],
  },
];
---

<div class="mx-auto max-w-3xl space-y-20 px-4 py-16 sm:px-6 lg:px-8">
  <div data-reveal class="space-y-4">
    {
      introBlocks.map((block) => {
        if (block.type === "p") return <RichParagraph parts={block.parts} />;
        if (block.type === "standalone") return <p class="text-base font-medium leading-relaxed text-ink-950">{block.text}</p>;
        if (block.type === "list")
          return (
            <ul class="space-y-2">
              {block.items.map((item) => (
                <li class="flex items-baseline gap-2.5 text-base leading-relaxed text-ink-700/85">
                  <span class="h-1.5 w-1.5 shrink-0 translate-y-[-2px] rounded-full bg-brand-400" aria-hidden="true" />
                  {item}
                </li>
              ))}
            </ul>
          );
        return null;
      })
    }
  </div>

  {
    sections.map((section) => (
      <section id={section.id} class="scroll-mt-24">
        <h2 class="font-serif text-2xl font-semibold tracking-tight text-ink-950 sm:text-3xl">{section.heading}</h2>
        <div data-reveal class="mt-6 space-y-4">
          {section.blocks.map((block) => {
            if (block.type === "p") return <RichParagraph parts={block.parts} />;
            if (block.type === "standalone") return <p class="text-base font-medium leading-relaxed text-ink-950">{block.text}</p>;
            if (block.type === "quote")
              return (
                <blockquote class="border-l-2 border-brand-200 pl-5">
                  <p class="font-serif text-lg italic leading-relaxed text-ink-950">{block.text}</p>
                </blockquote>
              );
            if (block.type === "list")
              return (
                <ul class="space-y-2">
                  {block.items.map((item) => (
                    <li class="flex items-baseline gap-2.5 text-base leading-relaxed text-ink-700/85">
                      <span class="h-1.5 w-1.5 shrink-0 translate-y-[-2px] rounded-full bg-brand-400" aria-hidden="true" />
                      {item}
                    </li>
                  ))}
                </ul>
              );
            if (block.type === "h3") return <h3 class="!mt-10 font-serif text-xl font-semibold text-ink-950">{block.text}</h3>;
            if (block.type === "table")
              return (
                <div class="overflow-x-auto rounded-xl border border-black/5">
                  <table class="w-full min-w-[560px] border-collapse text-left text-sm">
                    <thead>
                      <tr class="bg-brand-50/60">
                        {block.headers.map((h) => (
                          <th class="px-4 py-3 font-semibold text-ink-950">{h}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-black/5 bg-white">
                      {block.rows.map((row) => (
                        <tr>
                          {row.map((cell, i) => (
                            <td class={i === 0 ? "px-4 py-3 font-medium text-ink-950" : "px-4 py-3 text-ink-700/80"}>{cell}</td>
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              );
            return null;
          })}
        </div>
      </section>
    ))
  }
</div>
