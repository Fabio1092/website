---
import { ArrowRight } from "lucide-react";

const oldFlow = ["Produkt", "Argumente", "Kunde"];
const newFlow = ["Mensch", "Ziele", "Wünsche", "Prioritäten", "Budget", "Konzept", "passende Lösungen"];
---

<section id="b360-warum-anders" class="bg-ink-950 py-24 text-white">
  <div data-reveal class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
    <span class="text-sm font-semibold uppercase tracking-wider text-brand-300">Warum wir anders beraten</span>
    <h2 class="mt-3 font-serif text-3xl font-semibold tracking-tight sm:text-4xl">
      Produkte sind erst der <span class="text-brand-400">zweite Schritt</span>.
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-lg leading-relaxed text-white/70">
      Der Versicherungsmarkt ist riesig. Doch die entscheidende Frage ist nicht, welcher Tarif auf
      dem Papier die meisten Leistungen enthält. Die entscheidende Frage lautet:
    </p>
    <p class="mx-auto mt-3 max-w-xl font-serif text-xl leading-snug text-white">
      Welche Lösung passt zu deinem Leben?
    </p>

    <p class="mt-8 text-sm font-semibold uppercase tracking-wider text-white/50">
      Deshalb drehen wir die klassische Beratung um
    </p>

    <div class="mx-auto mt-6 flex max-w-lg flex-wrap items-center justify-center gap-x-2 gap-y-2 opacity-50">
      {
        oldFlow.map((step, index) => (
          <>
            <span class="rounded-full border border-white/15 px-4 py-1.5 text-sm text-white/60 line-through decoration-white/40">
              {step}
            </span>
            {index < oldFlow.length - 1 && <ArrowRight className="h-4 w-4 text-white/30" aria-hidden="true" />}
          </>
        ))
      }
    </div>

    <div class="mx-auto mt-5 flex max-w-2xl flex-wrap items-center justify-center gap-x-2 gap-y-3">
      {
        newFlow.map((step, index) => (
          <>
            <span class="rounded-full border border-brand-400/40 bg-brand-500/10 px-4 py-1.5 text-sm font-semibold text-brand-300">
              {step}
            </span>
            {index < newFlow.length - 1 && <ArrowRight className="h-4 w-4 text-brand-400/60" aria-hidden="true" />}
          </>
        ))
      }
    </div>

    <p class="mt-9 font-serif text-xl font-semibold text-white">
      Genau das verstehen wir unter 360° Beratung.
    </p>
  </div>
</section>
