---
import { siteConfig } from "@/lib/site";

interface Props {
  id?: string;
  heading: string;
  ctaId: string;
}

const { id, heading, ctaId } = Astro.props;
---

<section id={id} class="bg-brand-50/30 py-14 sm:py-20">
  <div class="mx-auto max-w-2xl px-4 text-center sm:px-6 lg:px-8">
    <p class="font-serif text-xl font-semibold leading-relaxed text-ink-950 sm:text-2xl">{heading}</p>
    <p class="mt-3 text-sm text-ink-700/60">Gesundheitshistorie zuerst prüfen. Antrag danach.</p>

    <div class="mt-7">
      <a
        href={siteConfig.calendlyUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-cta={ctaId}
        class="inline-flex items-center justify-center rounded-full bg-gold-500 px-7 py-3.5 text-sm font-semibold text-ink-950 shadow-sm transition-transform duration-200 hover:-translate-y-0.5 hover:bg-gold-400"
      >
        PKV-Beratung anfragen
      </a>
    </div>
  </div>
</section>
