---
import { Search, CalendarRange, PlusCircle, ShieldCheck, ChevronRight } from "lucide-react";

const steps = [
  {
    icon: Search,
    number: "1",
    title: "Was wird gefragt?",
    items: ["Krankheit?", "Beschwerde?", "Diagnose?", "Behandlung?", "Untersuchung?", "Beratung?", "Medikament?", "Operation?", "Arbeitsunfähigkeit?"],
  },
  {
    icon: CalendarRange,
    number: "2",
    title: "Welcher Zeitraum gilt?",
    items: ["aktuell", "zwölf Monate", "drei Jahre", "fünf Jahre", "zehn Jahre", "oder möglicherweise ohne ausdrückliche zeitliche Begrenzung"],
  },
  {
    icon: PlusCircle,
    number: "3",
    title: "Welche Erweiterungen gibt es?",
    intro: "Achte insbesondere auf Begriffe wie:",
    items: [
      "„auch wenn nicht behandelt“",
      "„angeraten“",
      "„vorgesehen“",
      "„beabsichtigt“",
      "„Verdachtsdiagnose“",
      "„regelmäßig“",
      "„wiederholt“",
      "„länger als …“",
      "„bestehen Folgen“",
    ],
  },
  {
    icon: ShieldCheck,
    number: "4",
    title: "Welche Ausnahmen gibt es?",
    items: ["Manche Versicherer nehmen beispielsweise bestimmte Bagatellerkrankungen ausdrücklich aus."],
  },
];
---

<section id="gesundheitsfrage-lesen" class="scroll-mt-24 bg-brand-50/30 py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="font-serif text-2xl font-semibold tracking-tight text-ink-950 sm:text-3xl">So solltest Du eine Gesundheitsfrage lesen</h2>
      <p class="mt-4 text-base leading-relaxed text-ink-700/80">Wenn Du einen Antrag vor Dir hast, konzentriere Dich nicht nur auf die Überschrift.</p>
      <p class="mt-2 text-base leading-relaxed text-ink-700/80">Zerlege jede relevante Frage gedanklich in vier Bestandteile.</p>
    </div>

    <div data-reveal class="mt-12 flex flex-col gap-6 lg:flex-row lg:items-stretch lg:gap-0">
      {
        steps.map((step, index) => (
          <>
            <div class="flex flex-1 flex-col rounded-2xl border border-black/5 bg-white p-6">
              <div class="flex items-center gap-3">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-ink-950 text-sm font-semibold text-white">{step.number}</span>
                <step.icon className="h-5 w-5 text-brand-500" aria-hidden="true" />
              </div>
              <h3 class="mt-4 font-serif text-lg font-semibold text-ink-950">{step.title}</h3>
              {step.intro && <p class="mt-2 text-sm text-ink-700/70">{step.intro}</p>}
              <ul class="mt-3 flex-1 space-y-1.5">
                {step.items.map((item) => (
                  <li class="text-sm leading-relaxed text-ink-700/80">{item}</li>
                ))}
              </ul>
            </div>
            {index < steps.length - 1 && (
              <div class="hidden shrink-0 items-center justify-center px-2 lg:flex">
                <ChevronRight className="h-5 w-5 text-brand-300" aria-hidden="true" />
              </div>
            )}
          </>
        ))
      }
    </div>

    <p class="mx-auto mt-10 max-w-xl text-center text-base font-medium leading-relaxed text-ink-950">
      Diese vier Ebenen entscheiden gemeinsam darüber, was die Frage tatsächlich verlangt.
    </p>
  </div>
</section>
