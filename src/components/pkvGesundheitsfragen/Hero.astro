---
import { siteConfig } from "@/lib/site";
---

<section id="pkv-gesundheitsfragen-hero" class="relative overflow-hidden bg-ink-950 text-white">
  <div class="pointer-events-none absolute -top-40 right-[-10%] h-[32rem] w-[32rem] rounded-full bg-brand-500/20 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -bottom-32 left-[-10%] h-[26rem] w-[26rem] rounded-full bg-gold-500/10 blur-3xl" aria-hidden="true"></div>

  <div class="relative mx-auto grid max-w-6xl gap-12 px-4 py-20 sm:px-6 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:gap-10 lg:py-28 lg:px-8">
    <div class="mx-auto max-w-2xl text-center lg:mx-0 lg:text-left">
      <span class="inline-flex items-center rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-brand-300">
        Gesundheitsfragen bei der privaten Krankenversicherung
      </span>

      <h1 class="mt-6 hyphens-auto break-words text-3xl font-semibold leading-tight tracking-tight sm:text-4xl lg:text-5xl">
        Gesundheitsfragen in der PKV: Warum Versicherer <span class="text-brand-400">unterschiedlich genau</span> hinschauen
      </h1>

      <p class="mx-auto mt-6 max-w-xl font-serif text-xl leading-relaxed text-white/90 lg:mx-0">
        Bei der privaten Krankenversicherung gibt es nicht <strong class="font-semibold text-white">die eine Gesundheitsprüfung</strong>.
      </p>

      <div class="mx-auto mt-8 max-w-xl rounded-2xl border border-brand-400/25 bg-white/[0.04] px-6 py-5 text-left lg:mx-0">
        <p class="font-serif text-lg leading-relaxed text-white sm:text-xl">
          Nicht weil sich Deine Gesundheit verändert hat – sondern weil die Versicherer unterschiedlich fragen.
        </p>
      </div>

      <p class="mx-auto mt-6 max-w-xl text-sm leading-relaxed text-white/60 lg:mx-0">
        Mehr dazu liest du auf meiner Seite{" "}
        <a href="/private-krankenversicherung-kassel/" class="underline decoration-brand-400/50 underline-offset-4 text-white/80 transition-colors hover:decoration-brand-400">
          Private Krankenversicherung in Kassel
        </a>.
      </p>

      <div class="mt-9 flex flex-col items-center justify-center gap-4 lg:items-start lg:justify-start sm:flex-row">
        <a
          href={siteConfig.calendlyUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-cta="pkv-gesundheitsfragen-hero"
          class="inline-flex w-full items-center justify-center rounded-full bg-gold-500 px-7 py-3.5 text-sm font-semibold text-ink-950 shadow-lg shadow-gold-500/20 transition-transform duration-200 hover:-translate-y-0.5 hover:bg-gold-400 sm:w-auto"
        >
          PKV-Beratung anfragen
        </a>
      </div>
    </div>

    <div class="hidden lg:block" aria-hidden="true">
      <div class="relative mx-auto h-80 w-full max-w-md">
        <svg class="absolute inset-0 h-full w-full" viewBox="0 0 400 320" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M200 60 L90 160" stroke="currentColor" stroke-width="1.5" class="text-white/15" />
          <path d="M200 60 L200 160" stroke="currentColor" stroke-width="1.5" class="text-white/15" />
          <path d="M200 60 L310 160" stroke="currentColor" stroke-width="1.5" class="text-white/15" />
        </svg>

        <div class="absolute left-1/2 top-0 flex -translate-x-1/2 items-center gap-2 rounded-full border border-brand-400/30 bg-brand-500/15 px-4 py-2 text-xs font-semibold text-brand-200">
          Deine Gesundheitshistorie
        </div>

        {
          [
            { top: "42%", left: "0%", label: "Fragebogen A", lines: [80, 55, 90] },
            { top: "42%", left: "37%", label: "Fragebogen B", lines: [90, 40, 65] },
            { top: "42%", left: "74%", label: "Fragebogen C", lines: [60, 85, 45] },
          ].map((card) => (
            <div class="absolute w-24 rounded-xl border border-white/10 bg-white/[0.06] p-3" style={`top: ${card.top}; left: ${card.left};`}>
              <p class="text-[10px] font-semibold uppercase tracking-wide text-brand-300">{card.label}</p>
              <div class="mt-2 space-y-1.5">
                {card.lines.map((w) => (
                  <div class="h-1 rounded-full bg-white/15" style={`width: ${w}%;`} />
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
