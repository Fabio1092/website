---
const entries = [
  { id: "wichtigste", label: "Das Wichtigste auf einen Blick" },
  { id: "warum-fragen", label: "Warum stellt eine PKV Gesundheitsfragen?" },
  { id: "nicht-die-eine", label: "Es gibt nicht „die“ Gesundheitsfragen der PKV" },
  { id: "beispiel-medikamente", label: "Beispiel 1: Medikamente" },
  { id: "beispiel-psychotherapie", label: "Beispiel 2: Psychotherapie" },
  { id: "beispiel-behandlung-beschwerden", label: "Beispiel 3: „Behandlung“ vs. „Beschwerden“" },
  { id: "beispiel-angeraten", label: "Beispiel 4: „Angeraten“" },
  { id: "beispiel-operationen", label: "Beispiel 5: Ambulante Operationen" },
  { id: "beispiel-verdachtsdiagnosen", label: "Beispiel 6: Verdachtsdiagnosen" },
  { id: "beispiel-ohne-zeitbegrenzung", label: "Beispiel 7: Fragen ohne Zeitbegrenzung" },
  { id: "beispiel-bagatellen", label: "Beispiel 8: Bagatellerkrankungen" },
  { id: "beispiel-brille", label: "Beispiel 9: Die Brille" },
  { id: "beispiel-zaehne", label: "Beispiel 10: Zähne" },
  { id: "offene-sammelfragen", label: "Offene Sammelfragen" },
  { id: "vergleichstabelle", label: "Die Unterschiede auf einen Blick" },
  { id: "gesundheitsfrage-lesen", label: "So liest Du eine Gesundheitsfrage" },
  { id: "krankenakte-offenlegen", label: "Komplette Krankenakte offenlegen?" },
  { id: "krankenakte-anfordern", label: "Krankenakte vorher anfordern?" },
  { id: "einsicht-sinnvoll", label: "Wann Akteneinsicht sinnvoll ist" },
  { id: "diagnosen-vorsicht", label: "Vorsicht bei Diagnosen in Akten" },
  { id: "sachverhalt-aufbereiten", label: "Sachverhalt richtig aufbereiten" },
  { id: "ja-antwort", label: "Ist eine Ja-Antwort automatisch schlecht?" },
  { id: "risikovoranfrage", label: "Warum eine Risikovoranfrage für mich Pflicht ist" },
  { id: "nicht-sofort-antrag", label: "Warum nicht sofort ein Antrag?" },
  { id: "falsche-angaben", label: "Falsche oder unvollständige Angaben" },
  { id: "fallstricke", label: "Die häufigsten Fallstricke" },
  { id: "schritt-fuer-schritt", label: "Gesundheitsprüfung Schritt für Schritt" },
  { id: "wichtigster-rat", label: "Mein wichtigster Rat" },
  { id: "vorerkrankungen-kein-ende", label: "Vorerkrankungen? Kein automatisches Ende" },
  { id: "fazit", label: "Fazit" },
  { id: "faq", label: "Häufige Fragen" },
];
---

<section class="bg-white py-10 sm:py-14">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <details open class="group rounded-2xl border border-black/5 bg-brand-50/30 p-6 sm:p-8">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 [&::-webkit-details-marker]:hidden">
        <span class="text-xs font-semibold uppercase tracking-wide text-brand-600">Inhalt dieses Artikels</span>
        <svg
          class="h-4 w-4 shrink-0 text-brand-600 transition-transform duration-200 group-open:rotate-180"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          aria-hidden="true"
        >
          <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </summary>
      <nav aria-label="Inhaltsverzeichnis">
        <ul class="mt-5 grid grid-cols-1 gap-x-8 gap-y-2.5 sm:grid-cols-2">
          {
            entries.map((entry, index) => (
              <li>
                <a
                  href={`#${entry.id}`}
                  class="group/link flex items-baseline gap-2.5 text-sm leading-relaxed text-ink-700/85 transition-colors duration-150 hover:text-brand-700"
                >
                  <span class="tabular-nums text-xs font-semibold text-brand-400 group-hover/link:text-brand-600">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <span class="underline decoration-transparent underline-offset-2 group-hover/link:decoration-brand-300">{entry.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</section>
