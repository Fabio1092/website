---
function Dots(score: number) {
  return Array.from({ length: 5 }, (_, i) => i < score);
}
---

<section id="guide-hero" class="relative overflow-hidden bg-ink-950 text-white">
  <div class="pointer-events-none absolute -top-40 right-[-10%] h-[32rem] w-[32rem] rounded-full bg-brand-500/20 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -bottom-32 left-[-10%] h-[26rem] w-[26rem] rounded-full bg-gold-500/10 blur-3xl" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    <a
      href="/ratgeber/#reisen-ausland"
      class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-brand-300 transition-colors hover:text-brand-200"
    >
      Ratgeber · Reisen &amp; Ausland
    </a>

    <h1 class="mt-5 hyphens-auto break-words text-3xl font-semibold leading-tight tracking-tight sm:text-4xl lg:text-5xl">
      Auslandsreisekrankenversicherung: <span class="text-brand-400">Für mich ein absolutes Muss</span>
    </h1>

    <p class="mt-5 max-w-xl text-lg leading-relaxed text-white/80">
      Meine Einschätzung, worauf du beim Versicherungsschutz achten solltest und welche
      Auslandsreisekrankenversicherung ich empfehle.
    </p>

    <div data-reveal class="mt-8 max-w-md rounded-2xl border border-black/5 bg-white p-5 shadow-lg sm:p-6">
      <p class="text-xs font-semibold uppercase tracking-wide text-brand-600">Meine Einschätzung</p>

      <div class="mt-4 grid gap-3.5 sm:grid-cols-2">
        <div>
          <div class="flex items-center justify-between text-sm">
            <span class="text-ink-700/70">Sinnhaftigkeit</span>
            <span class="font-medium text-ink-950">5 von 5</span>
          </div>
          <div class="mt-1.5 flex gap-1.5" role="img" aria-label="Sinnhaftigkeit: 5 von 5">
            {Dots(5).map((filled) => <span class:list={["h-1.5 w-6 rounded-full", filled ? "bg-brand-500" : "bg-black/10"]} aria-hidden="true" />)}
          </div>
        </div>
        <div>
          <div class="flex items-center justify-between text-sm">
            <span class="text-ink-700/70">Beratungsbedarf</span>
            <span class="font-medium text-ink-950">Gering</span>
          </div>
          <div class="mt-1.5 flex gap-1.5" role="img" aria-label="Beratungsbedarf: gering">
            {Dots(1).map((filled) => <span class:list={["h-1.5 w-6 rounded-full", filled ? "bg-brand-500" : "bg-black/10"]} aria-hidden="true" />)}
          </div>
        </div>
        <div class="flex items-center justify-between text-sm sm:col-span-2 sm:border-t sm:border-black/5 sm:pt-3.5">
          <span class="text-ink-700/70">Empfehlung</span>
          <span class="font-medium text-ink-950">HanseMerkur</span>
        </div>
        <div class="flex items-center justify-between text-sm sm:col-span-2">
          <span class="text-ink-700/70">Für wen</span>
          <span class="text-right font-medium text-ink-950">Praktisch alle Auslandsreisenden</span>
        </div>
      </div>
    </div>

    <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
      <a
        href="#empfehlung"
        class="inline-flex items-center justify-center rounded-full bg-gold-500 px-6 py-3 text-sm font-semibold text-ink-950 shadow-lg shadow-gold-500/20 transition-transform duration-200 hover:-translate-y-0.5 hover:bg-gold-400"
      >
        Zu meiner Empfehlung
      </a>
      <a
        href="#vergleichsrechner"
        class="inline-flex items-center justify-center gap-1.5 rounded-full border border-white/20 px-6 py-3 text-sm font-semibold text-white/90 transition-colors hover:border-white/40 hover:text-white"
      >
        Zum Vergleichsrechner
      </a>
    </div>

    <p class="mt-6 text-xs text-white/45">
      Von Fabio Rumpf – Versicherungsmakler aus Kassel · Zuletzt aktualisiert: 26. August 2026 ·
      <a href="/ueber-mich" class="underline decoration-white/20 underline-offset-2 hover:text-white/70">Über mich</a>
    </p>
  </div>
</section>
