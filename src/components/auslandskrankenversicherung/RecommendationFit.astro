---
import ComparisonSplit from "@/components/ComparisonSplit.astro";
---

<section class="bg-white py-14 sm:py-16">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <ComparisonSplit
      columns={[
        {
          tone: "brand",
          label: "Passt gut, wenn …",
          points: [
            "du eine normale Urlaubsreise machst",
            "du einen unkomplizierten Jahresvertrag möchtest, der im Hintergrund läuft",
            "deine einzelnen Reisen die maximale Reisedauer des Tarifs nicht überschreiten",
          ],
        },
        {
          tone: "ink",
          label: "Genauer prüfen, wenn …",
          points: [
            "du eine Weltreise, ein Auslandssemester oder Work & Travel planst",
            "du als Expat oder für mehrere Monate ins Ausland gehst",
            "deine Reise die maximale Reisedauer des Tarifs überschreitet",
          ],
        },
      ]}
    />

    <div class="mt-10 text-center">
      <a
        href="#vergleichsrechner"
        class="inline-flex items-center justify-center rounded-full bg-gold-500 px-7 py-3.5 text-sm font-semibold text-ink-950 shadow-lg shadow-gold-500/20 transition-transform duration-200 hover:-translate-y-0.5 hover:bg-gold-400"
      >
        Tarife vergleichen
      </a>
    </div>
  </div>
</section>
