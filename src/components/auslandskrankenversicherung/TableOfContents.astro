---
const entries = [
  { id: "warum", label: "Warum brauche ich die Versicherung?" },
  { id: "gkv", label: "GKV im Ausland" },
  { id: "pkv", label: "PKV im Ausland" },
  { id: "leistungen", label: "Wichtige Leistungen" },
  { id: "reisedauer", label: "Reisedauer" },
  { id: "laengere-aufenthalte", label: "Längere Auslandsaufenthalte" },
  { id: "empfehlung", label: "Meine Empfehlung" },
  { id: "vergleichsrechner", label: "Vergleichsrechner" },
  { id: "faq", label: "FAQ" },
  { id: "fazit", label: "Fazit" },
];
---

<section class="bg-brand-50/30 py-8 sm:py-12">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
    <details class="group rounded-2xl border border-black/5 bg-white p-6 shadow-soft sm:p-7">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 [&::-webkit-details-marker]:hidden">
        <span class="text-xs font-semibold uppercase tracking-wide text-brand-600">Inhalt dieses Ratgebers</span>
        <svg
          class="h-4 w-4 shrink-0 text-brand-600 transition-transform duration-200 group-open:rotate-180"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          aria-hidden="true"
        >
          <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </summary>
      <nav aria-label="Inhaltsverzeichnis">
        <ul class="mt-5 grid grid-cols-1 gap-x-8 gap-y-2.5 sm:grid-cols-2">
          {
            entries.map((entry, index) => (
              <li>
                <a
                  href={`#${entry.id}`}
                  class="group/link flex items-baseline gap-2.5 text-sm leading-relaxed text-ink-700/85 transition-colors duration-150 hover:text-brand-700"
                >
                  <span class="tabular-nums text-xs font-semibold text-brand-400 group-hover/link:text-brand-600">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <span class="underline decoration-transparent underline-offset-2 group-hover/link:decoration-brand-300">{entry.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</section>
