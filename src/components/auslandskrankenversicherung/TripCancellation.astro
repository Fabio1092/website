---
import ComparisonSplit from "@/components/ComparisonSplit.astro";
---

<section id="reiseruecktritt" class="scroll-mt-24 bg-brand-50/30 py-14 sm:py-20">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
    <h2 class="hyphens-auto break-words font-serif text-2xl font-semibold tracking-tight text-ink-950 sm:text-3xl">
      Auslandskrankenversicherung ist nicht Reiserücktritt
    </h2>
  </div>

  <div class="mx-auto mt-6 max-w-4xl px-4 sm:px-6 lg:px-8">
    <ComparisonSplit
      columns={[
        {
          tone: "brand",
          label: "Auslandskrankenversicherung",
          points: ["Schützt dich vor versicherten Krankheitskosten während deiner Reise."],
        },
        {
          tone: "ink",
          label: "Reiserücktrittsversicherung",
          points: ["Kann greifen, wenn du eine Reise aus einem versicherten Grund nicht antreten kannst und dadurch Stornokosten entstehen."],
        },
      ]}
    />
  </div>

  <div class="mx-auto mt-6 max-w-2xl px-4 sm:px-6 lg:px-8">
    <p class="text-base leading-relaxed text-ink-700/85">
      Für mich ist die Reiserücktrittsversicherung nicht auf derselben „Pflichtstufe" wie die
      Auslandskrankenversicherung.
    </p>
  </div>
</section>
