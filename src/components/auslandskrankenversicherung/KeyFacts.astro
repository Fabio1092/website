---
import { CheckCircle2 } from "lucide-react";

const facts = [
  { bold: "Eine Auslandsreisekrankenversicherung gehört für mich ins Reisegepäck.", rest: "" },
  {
    bold: "Dabei spielt es grundsätzlich keine Rolle, ob du gesetzlich oder privat krankenversichert bist.",
    rest: "Dein bestehender Krankenversicherungsschutz kann im Ausland Grenzen haben – insbesondere beim Krankenrücktransport.",
  },
  {
    bold: "Eine gute Auslandsreisekrankenversicherung sollte unter anderem medizinisch notwendige Behandlungen im Ausland und einen guten Schutz beim Krankenrücktransport beinhalten.",
    rest: "Je nach Tarif kommen weitere Leistungen hinzu.",
  },
  { bold: "Für normale Urlaubsreisen ist mein persönlicher Favorit aktuell die HanseMerkur.", rest: "" },
];
---

<section id="wichtigste" class="scroll-mt-24 bg-white py-14 sm:py-16">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
    <div class="rounded-2xl border border-black/5 bg-brand-50/30 p-6 sm:p-8">
      <p class="text-xs font-semibold uppercase tracking-wide text-brand-600">Das Wichtigste in 30 Sekunden</p>
      <p class="mt-2 text-sm leading-relaxed text-ink-700/75">Du willst nicht den ganzen Ratgeber lesen? Dann hier meine Kurzfassung:</p>

      <ul class="mt-6 space-y-4">
        {
          facts.map((fact) => (
            <li class="flex items-start gap-3">
              <CheckCircle2 className="mt-0.5 h-4.5 w-4.5 shrink-0 text-brand-600" aria-hidden="true" />
              <p class="text-sm leading-relaxed text-ink-700/85">
                <span class="font-semibold text-ink-950">{fact.bold}</span> {fact.rest}
              </p>
            </li>
          ))
        }
      </ul>

      <p class="mt-6 text-sm leading-relaxed text-ink-700/70">
        Wenn du selbst vergleichen möchtest, findest du weiter unten auf dieser Seite meinen
        <a href="#vergleichsrechner" class="font-medium text-brand-700 underline underline-offset-2 hover:text-brand-800">
          Vergleichsrechner
        </a>
        und kannst dir dort deinen gewünschten Versicherungsschutz zusammenstellen.
      </p>
    </div>
  </div>
</section>
