---
const groups = ["Beamtenanwärter", "Referendare", "Lehrer", "Polizeibeamte", "Verwaltungsbeamte", "Justizbeamte", "Kommunalbeamte", "Beamte auf Probe", "Beamte auf Lebenszeit"];
---

<section id="bu-beamte-zielgruppen" class="bg-white py-24">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <h2 class="text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">
        Für welche <span class="text-brand-600">Beamten</span> beraten wir?
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-700/80">Unsere Beratung richtet sich unter anderem an:</p>
    </div>

    <div data-reveal class="mt-8 flex flex-wrap justify-center gap-2.5">
      {groups.map((group) => <span class="rounded-full border border-brand-200 bg-brand-50/60 px-4 py-1.5 text-sm font-medium text-brand-700">{group}</span>)}
    </div>

    <p data-reveal class="mx-auto mt-8 max-w-xl text-center text-base leading-relaxed text-ink-700/85">
      Dabei prüfen wir immer die konkrete Tätigkeit und Versorgungssituation. Denn „Beamter“ ist
      genauso wenig eine einheitliche Risikoklasse wie „Angestellter“.
    </p>
  </div>
</section>
