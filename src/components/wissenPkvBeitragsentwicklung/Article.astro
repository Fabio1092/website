      { type: "p", parts: ["Ja."] },
      { type: "p", parts: ["Aber richtig eingeordnet."] },
      { type: "p", parts: ["Bei Angeboten zur privaten Krankenversicherung müssen Versicherer unter anderem Informationen zur bisherigen Beitragsentwicklung bereitstellen."] },
      {
        type: "p",
        parts: ["Vorgesehen ist grundsätzlich eine Übersicht über die Beitragsentwicklung des angebotenen Tarifs in den vergangenen zehn Jahren beziehungsweise – bei jüngeren Tarifen – seit Einführung."],
      },
      { type: "p", parts: ["Das ist sinnvoll."] },
      { type: "p", parts: ["Denn du möchtest wissen, wie sich ein Tarif bisher entwickelt hat."] },
      { type: "p", parts: ["Aber auch hier gilt:"] },
      { type: "standalone", text: "Vergangenheit ist keine Garantie für die Zukunft." },
      { type: "p", parts: ["Ein Tarif, der zehn Jahre relativ stabil war, kann anschließend angepasst werden."] },
      { type: "p", parts: ["Ein Tarif mit einer stärkeren Anpassung in der Vergangenheit kann danach wiederum mehrere Jahre stabil bleiben."] },
      { type: "p", parts: ["Die Historie ist deshalb ein Analysebaustein – kein alleiniger Entscheidungsgrund."] },
    ],
  },
  {
    id: "vorbereiten-auf-steigende-beitraege",
    heading: "Wie kann ich mich auf steigende PKV-Beiträge vorbereiten?",
    blocks: [
      { type: "p", parts: ["Du kannst zukünftige Beitragsanpassungen nicht verhindern."] },
      { type: "p", parts: ["Du kannst deine PKV aber so planen, dass sie langfristig besser zu deiner finanziellen Situation passt."] },
      { type: "h3", text: "1. Nicht den billigsten Tarif wählen" },
      { type: "p", parts: ["Der erste Schritt erfolgt bereits beim Abschluss."] },
      { type: "p", parts: ["Nicht fragen:"] },
      { type: "standalone", text: "„Welche PKV ist heute am günstigsten?“" },
      { type: "p", parts: ["Sondern:"] },
      { type: "standalone", text: "„Welcher leistungsstarke Tarif kann langfristig zu mir passen?“" },
      { type: "h3", text: "2. Einen Beitragsvorteil nicht vollständig konsumieren" },
      {
        type: "p",
        parts: ["Wenn du beispielsweise gegenüber der GKV heute 200 Euro monatlich weniger selbst zahlst, musst du diese 200 Euro nicht zwangsläufig vollständig ausgeben."],
      },
      { type: "p", parts: ["Ein Teil davon kann für die langfristige Absicherung zurückgelegt werden."] },
      { type: "p", parts: ["So schaffst du dir zusätzliche finanzielle Reserven für spätere Lebensphasen."] },
      { type: "h3", text: "3. Beitragsentlastungstarife prüfen" },
      { type: "p", parts: ["Viele Versicherer bieten zusätzliche Beitragsentlastungsbausteine an."] },
      { type: "p", parts: ["Du zahlst heute einen zusätzlichen Beitrag und erhältst dafür ab einem bestimmten Alter eine vertraglich vereinbarte Beitragsreduzierung."] },
      {
        type: "p",
        parts: [
          "Gerade für Angestellte kann das interessant sein, weil der Beitrag eines solchen Entlastungstarifs grundsätzlich arbeitgeberzuschussfähig sein kann, solange die jeweiligen gesetzlichen Voraussetzungen und Höchstgrenzen eingehalten werden.",
        ],
      },
      { type: "p", parts: ["Das bedeutet aber nicht automatisch, dass ein Beitragsentlastungstarif immer die beste Lösung ist."] },
      { type: "p", parts: ["Kosten, Flexibilität, Arbeitgeberzuschuss und alternative Vorsorgemöglichkeiten müssen gemeinsam betrachtet werden."] },
      { type: "h3", text: "4. Zusätzlich privat Vermögen aufbauen" },
      { type: "p", parts: ["Eine weitere Möglichkeit besteht darin, außerhalb der Krankenversicherung Vermögen für später aufzubauen."] },
      { type: "p", parts: ["Der Vorteil:"] },
      { type: "p", parts: ["Das Kapital bleibt grundsätzlich flexibler."] },
      { type: "p", parts: ["Der Nachteil:"] },
      { type: "p", parts: ["Du musst selbst dafür sorgen, dass das Geld langfristig tatsächlich für diesen Zweck erhalten bleibt."] },
      { type: "p", parts: ["Welche Variante besser passt, ist individuell."] },
      { type: "h3", text: "5. Tarifwechselmöglichkeiten kennen" },
      {
        type: "p",
        parts: [
          "Wenn der Beitrag eines bestehenden Tarifs irgendwann nicht mehr zur Situation passt, gibt es innerhalb derselben Gesellschaft ein gesetzliches Tarifwechselrecht nach ",
          { b: "§ 204 VVG" },
          ".",
        ],
      },
      { type: "p", parts: ["Dabei können erworbene Rechte und Alterungsrückstellungen grundsätzlich berücksichtigt werden."] },
      {
        type: "p",
        parts: ["Bei Mehrleistungen im neuen Tarif kann allerdings eine Gesundheitsprüfung beziehungsweise ein Risikozuschlag oder Leistungsausschluss für diese Mehrleistungen relevant werden."],
      },
      { type: "p", parts: ["Ein interner Tarifwechsel sollte deshalb sorgfältig geprüft werden und nicht nur nach dem niedrigsten neuen Beitrag erfolgen."] },
    ],
  },
  {
    id: "beitrag-im-rentenalter",
    heading: "Was passiert mit dem PKV-Beitrag im Rentenalter?",
    blocks: [
      { type: "p", parts: ["Auch hier gibt es keine pauschale Zahl."] },
      { type: "p", parts: ["Mehrere Dinge verändern sich."] },
      { type: "p", parts: ["Zum einen werden die Alterungsrückstellungen zunehmend zur Beitragsstabilisierung genutzt."] },
      { type: "p", parts: ["Zusätzlich entfällt der gesetzliche 10-%-Zuschlag nach Vollendung des 60. Lebensjahres."] },
      { type: "p", parts: ["Mit Renteneintritt wird häufig auch ein vorhandenes Krankentagegeld nicht mehr benötigt."] },
      {
        type: "p",
        parts: ["Privatversicherte Rentner mit gesetzlicher Rente können außerdem unter den gesetzlichen Voraussetzungen einen Zuschuss der Deutschen Rentenversicherung zur privaten Krankenversicherung erhalten."],
      },
      { type: "p", parts: ["Gleichzeitig bleibt der eigentliche PKV-Beitrag grundsätzlich einkommensunabhängig."] },
      { type: "p", parts: ["Wenn dein Einkommen im Ruhestand sinkt, sinkt deshalb nicht automatisch dein Krankenversicherungsbeitrag."] },
      { type: "p", parts: ["Genau deshalb ist langfristige Planung wichtig."] },
    ],
  },
  {
    id: "gkv-im-alter-guenstiger",
    heading: "Ist die GKV im Alter automatisch günstiger?",
    blocks: [
      { type: "p", parts: ["Auch das lässt sich nicht pauschal beantworten."] },
      { type: "p", parts: ["Die GKV funktioniert einkommensabhängig."] },
      { type: "p", parts: ["Welche Beiträge im Ruhestand entstehen, hängt unter anderem davon ab:"] },
      {
        type: "list",
        items: [
          "ob du pflichtversichert oder freiwillig versichert bist",
          "wie hoch deine gesetzliche Rente ist",
          "ob weitere beitragspflichtige Einkünfte bestehen",
          "welche Beitragssätze dann gelten",
        ],
      },
      { type: "p", parts: ["Die PKV funktioniert dagegen grundsätzlich einkommensunabhängig."] },
      { type: "p", parts: ["Deshalb ist ein pauschaler Satz wie:"] },
      { type: "standalone", text: "„Im Alter ist die GKV immer günstiger“" },
      { type: "p", parts: ["genauso wenig seriös wie:"] },
      { type: "standalone", text: "„Die PKV ist im Alter immer günstiger.“" },
      {
        type: "p",
        parts: [
          "Einen grundsätzlichen Systemvergleich findest du unter ",
          { a: "GKV oder PKV?", href: "/wissen/private-krankenversicherung/gkv-oder-pkv/" },
          ".",
        ],
      },
    ],
  },
  {
    id: "wegen-beitragssteigerungen-verzichten",
    heading: "Sollte ich wegen Beitragssteigerungen auf die PKV verzichten?",
    blocks: [
      { type: "p", parts: ["Nicht pauschal."] },
      { type: "p", parts: ["Du solltest aber verstehen, worauf du dich einlässt."] },
      { type: "p", parts: ["Wenn deine Entscheidung lautet:"] },
      { type: "p", parts: ["„Ich gehe in die PKV, weil ich heute 250 Euro spare.“"] },
      { type: "p", parts: ["wäre mir das zu wenig."] },
      { type: "p", parts: ["Wenn deine Entscheidung dagegen lautet:"] },
      {
        type: "p",
        parts: ["„Die PKV passt langfristig zu meiner Lebensplanung, ich möchte die vertraglichen Leistungen, mein Einkommen ist tragfähig und ich habe auch zukünftige Beiträge eingeplant.“"],
      },
      { type: "p", parts: ["dann sieht die Ausgangssituation vollkommen anders aus."] },
      { type: "p", parts: ["Beitragsentwicklung ist ein wichtiger Teil der Entscheidung."] },
      { type: "p", parts: ["Sie ist aber nicht der einzige."] },
      {
        type: "p",
        parts: ["Genau deshalb solltest du vor einem Wechsel sowohl ", { b: "Leistung als auch Beitrag und langfristige Lebensplanung" }, " betrachten."],
      },
      {
        type: "p",
        parts: [
          "Wenn du grundsätzlich wissen möchtest, ob das System zu dir passt, lies ",
          { a: "Für wen lohnt sich die PKV?", href: "/wissen/private-krankenversicherung/fuer-wen-lohnt-sich-die-pkv/" },
          ".",
        ],
      },
    ],
  },
  {
    id: "checkliste",
    heading: "Meine Checkliste zur PKV-Beitragsentwicklung",
    blocks: [
      { type: "p", parts: ["Bevor ich einen Tarif langfristig bewerte, würde ich unter anderem folgende Fragen stellen:"] },
      {
        type: "list",
        items: [
          "1. Wie hochwertig sind die Versicherungsbedingungen?",
          "2. Ist der heutige Beitrag realistisch oder auffällig niedrig?",
          "3. Wie hat sich der Tarif in den vergangenen Jahren entwickelt?",
          "4. Wie lange existiert der Tarif bereits?",
          "5. Welche Selbstbeteiligung besteht?",
          "6. Welche Beitragsrückerstattungen sind einkalkuliert?",
          "7. Welche Alterungsrückstellungen werden gebildet?",
          "8. Ist ein Beitragsentlastungstarif sinnvoll?",
          "9. Wie hoch ist meine heutige Ersparnis gegenüber der GKV?",
          "10. Was mache ich mit dieser Ersparnis?",
          "11. Kann ich den Beitrag auch tragen, wenn er zukünftig steigt?",
          "12. Passt die PKV auch zu meiner Familien- und Karriereplanung?",
        ],
      },
      { type: "p", parts: ["Keine einzelne Antwort entscheidet allein."] },
      { type: "p", parts: ["Aber zusammen entsteht ein deutlich realistischeres Bild als durch die Frage:"] },
      { type: "standalone", text: "„Wie hoch war die letzte Beitragserhöhung?“" },
    ],
  },
];
---

<div class="mx-auto max-w-3xl space-y-20 px-4 py-16 sm:px-6 lg:px-8">
  <div data-reveal class="space-y-4">
    {
      introBlocks.map((block) => {
        if (block.type === "p") return <RichParagraph parts={block.parts} />;
        if (block.type === "standalone") return <p class="text-base font-medium leading-relaxed text-ink-950">{block.text}</p>;
        return null;
      })
    }
  </div>

  {
    sections.map((section) => (
      <section id={section.id} class="scroll-mt-24">
        <h2 class="font-serif text-2xl font-semibold tracking-tight text-ink-950 sm:text-3xl">{section.heading}</h2>
        <div data-reveal class="mt-6 space-y-4">
          {section.blocks.map((block) => {
            if (block.type === "p") return <RichParagraph parts={block.parts} />;
            if (block.type === "standalone") return <p class="text-base font-medium leading-relaxed text-ink-950">{block.text}</p>;
            if (block.type === "quote")
              return (
                <blockquote class="border-l-2 border-brand-200 pl-5">
                  <p class="font-serif text-lg italic leading-relaxed text-ink-950">{block.text}</p>
                </blockquote>
              );
            if (block.type === "list")
              return (
                <ul class="space-y-2">
                  {block.items.map((item) => (
                    <li class="flex items-baseline gap-2.5 text-base leading-relaxed text-ink-700/85">
                      <span class="h-1.5 w-1.5 shrink-0 translate-y-[-2px] rounded-full bg-brand-400" aria-hidden="true" />
                      {item}
                    </li>
                  ))}
                </ul>
              );
            if (block.type === "h3") return <h3 class="!mt-10 font-serif text-xl font-semibold text-ink-950">{block.text}</h3>;
            if (block.type === "table")
              return (
                <div class="overflow-x-auto rounded-xl border border-black/5">
                  <table class="w-full min-w-[560px] border-collapse text-left text-sm">
                    <thead>
                      <tr class="bg-brand-50/60">
                        {block.headers.map((h) => (
                          <th class="px-4 py-3 font-semibold text-ink-950">{h}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-black/5 bg-white">
                      {block.rows.map((row) => (
                        <tr>
                          {row.map((cell, i) => (
                            <td class={i === 0 ? "px-4 py-3 font-medium text-ink-950" : "px-4 py-3 text-ink-700/80"}>{cell}</td>
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              );
            return null;
          })}
        </div>
      </section>
    ))
  }
</div>
