---
import RichParagraph from "@/components/RichParagraph.astro";

type Part = string | { b: string } | { a: string; href: string };

type Block =
  | { type: "p"; parts: Part[] }
  | { type: "standalone"; text: string }
  | { type: "quote"; text: string }
  | { type: "list"; items: string[] }
  | { type: "h3"; text: string }
  | { type: "table"; headers: string[]; rows: string[][] };

interface Section {
  id: string;
  heading: string;
  blocks: Block[];
}

const introBlocks: Block[] = [
  { type: "p", parts: ["Diese Frage bekomme ich bei der Beratung zur PKV immer wieder."] },
  { type: "p", parts: ["Und die seriöse Antwort lautet:"] },
  { type: "standalone", text: "Das kann dir heute niemand verlässlich sagen." },
  { type: "p", parts: ["Natürlich können wir historische Beitragsentwicklungen betrachten, Tarife vergleichen und verschiedene Szenarien rechnen."] },
  {
    type: "p",
    parts: [
      "Aber niemand kennt heute die Gesundheitskosten im Jahr 2050, zukünftige medizinische Möglichkeiten, Zinsen, gesetzliche Rahmenbedingungen oder die konkrete Entwicklung deines Tarifs.",
    ],
  },
  { type: "p", parts: ["Was wir dagegen sehr gut erklären können:"] },
  {
    type: "standalone",
    text: "Warum PKV-Beiträge steigen, warum Anpassungen häufig sprunghaft wirken, wie sich die PKV langfristig im Vergleich zur GKV entwickelt hat und welche Mechanismen dafür sorgen sollen, dass Beiträge auch im Alter tragbar bleiben.",
  },
  { type: "p", parts: ["Und genau darum geht es in diesem Artikel."] },
];

const sections: Section[] = [
  {
    id: "wichtigstes-in-kuerze",
