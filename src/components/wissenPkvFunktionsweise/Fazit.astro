---
import RichParagraph from "@/components/RichParagraph.astro";

const sources = [
  "Bundesministerium für Gesundheit: Private Krankenversicherung – Prämien und Sozialtarife",
  "Bundesministerium für Gesundheit: Versicherte in der gesetzlichen Krankenversicherung / Jahresarbeitsentgeltgrenze",
  "Versicherungsvertragsgesetz § 19 – Anzeigepflicht",
  "Versicherungsvertragsgesetz § 192 – Vertragstypische Leistungen der Krankenversicherung",
  "Versicherungsvertragsgesetz § 203 – Prämien- und Bedingungsanpassung",
  "Versicherungsvertragsgesetz § 204 – Tarifwechsel",
  "Sozialgesetzbuch V § 257 – Beitragszuschüsse für Beschäftigte",
  "Informationen zur Beitragskalkulation und zu Alterungsrückstellungen in der privaten Krankenversicherung",
];
---

<section id="fazit" class="scroll-mt-24 bg-white py-16">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <h2 class="font-serif text-2xl font-semibold tracking-tight text-ink-950 sm:text-3xl">
      Fazit: Die PKV ist ein individuelles Vertragssystem
    </h2>

    <div data-reveal class="mt-6 space-y-4">
      <RichParagraph parts={["Die private Krankenversicherung ist kein einheitliches Produkt."]} />
      <RichParagraph parts={["Sie basiert auf einem individuellen Versicherungsvertrag, dessen Tarifbedingungen festlegen, welche Leistungen versichert sind."]} />
      <RichParagraph
        parts={[
          "Der Gesundheitszustand spielt insbesondere beim Eintritt in die Versicherung eine Rolle. Der Beitrag wird nicht unmittelbar anhand des laufenden Einkommens berechnet. Alterungsrückstellungen berücksichtigen statistisch höhere Gesundheitskosten späterer Lebensphasen. Rechnungen werden überwiegend nach dem Kostenerstattungsprinzip abgewickelt.",
        ]}
      />
      <RichParagraph parts={["Gleichzeitig können sich Tarife bei Leistungen, Selbstbehalten und weiteren Bedingungen deutlich unterscheiden."]} />

      <div class="rounded-2xl border border-brand-200 bg-brand-50/50 px-6 py-5">
        <p class="font-serif text-lg font-medium leading-relaxed text-ink-950">
          Die Qualität einer privaten Krankenversicherung lässt sich nicht allein am Versicherer oder am
          heutigen Monatsbeitrag beurteilen. Entscheidend ist, welche Leistungen und Regeln langfristig im
          konkreten Vertrag vereinbart sind.
        </p>
      </div>
    </div>

    <div class="mt-14 border-t border-black/5 pt-8">
      <p id="quellen" class="scroll-mt-24 text-xs font-semibold uppercase tracking-wide text-ink-700/50">Quellen und rechtliche Grundlagen</p>
      <p class="mt-3 text-xs leading-relaxed text-ink-700/60">
        Für die fachlichen Grundlagen dieses Artikels wurden insbesondere folgende öffentlich zugängliche
        Quellen und Rechtsgrundlagen berücksichtigt:
      </p>
      <ul class="mt-3 space-y-1.5">
        {
          sources.map((source) => (
            <li class="text-xs leading-relaxed text-ink-700/60">{source}</li>
          ))
        }
      </ul>
      <p class="mt-3 text-xs leading-relaxed text-ink-700/50">Stand der gesetzlichen Angaben: September 2026.</p>
    </div>

    <div class="mt-10 border-t border-black/5 pt-8">
      <RichParagraph
        parts={["Zurück zum ", { a: "PKV-Wissen", href: "/wissen/private-krankenversicherung/" }]}
        class="text-sm font-semibold text-ink-700/85"
      />
    </div>
  </div>
</section>
