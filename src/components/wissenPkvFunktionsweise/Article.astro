---
import { CheckCircle2 } from "lucide-react";
import RichParagraph from "@/components/RichParagraph.astro";

type Part = string | { b: string } | { a: string; href: string };

type Block =
  | { type: "p"; parts: Part[] }
  | { type: "standalone"; text: string }
  | { type: "keyFacts"; items: string[] }
  | { type: "quote"; text: string }
  | { type: "list"; items: string[] }
  | { type: "h3"; text: string }
  | { type: "table"; headers: string[]; rows: string[][] };

interface Section {
  id: string;
  heading: string;
  blocks: Block[];
}

const sections: Section[] = [
  {
    id: "das-wichtigste-auf-einen-blick",
    heading: "Das Wichtigste auf einen Blick",
    blocks: [
      {
        type: "keyFacts",
        items: [
          "Die private Krankenversicherung basiert auf einem individuellen Versicherungsvertrag.",
          "Der konkrete Tarif und seine Versicherungsbedingungen bestimmen den Leistungsumfang.",
          "Der PKV-Beitrag wird grundsätzlich nicht als Prozentsatz des Einkommens berechnet.",
          "Eintrittsalter, Leistungsumfang und Gesundheitszustand bei Vertragsbeginn beeinflussen die Kalkulation.",
          "Vor Abschluss eines regulären PKV-Tarifs findet grundsätzlich eine Gesundheitsprüfung statt.",
          "Privatversicherte erhalten ambulante Rechnungen in der Regel selbst und reichen sie anschließend beim Versicherer ein.",
          "Für jede privat versicherte Person besteht grundsätzlich ein eigener Versicherungsschutz mit einem eigenen Beitrag.",
          "Die PKV bildet Alterungsrückstellungen für höhere durchschnittliche Gesundheitskosten im späteren Leben.",
          "Eine Erkrankung nach Vertragsabschluss führt nicht dazu, dass allein deshalb der persönliche Beitrag individuell erhöht wird.",
          "Beiträge können sich dennoch verändern, wenn sich maßgebliche Kalkulationsgrundlagen eines Tarifs verändern.",
          "Innerhalb des bestehenden Versicherers besteht ein gesetzlich geregeltes Tarifwechselrecht.",
        ],
      },
    ],
  },
  {
    id: "was-ist-eine-private-krankenversicherung",
    heading: "1. Was ist eine private Krankenversicherung?",
    blocks: [
      { type: "p", parts: ["Die private Krankenversicherung ist eine vertraglich geregelte Absicherung von Krankheitskosten."] },
      { type: "p", parts: ["Du vereinbarst mit einem Versicherungsunternehmen einen bestimmten Versicherungsschutz."] },
      { type: "p", parts: ["Dieser kann beispielsweise Leistungen für folgende Bereiche enthalten:"] },
      {
        type: "list",
        items: [
          "ambulante Behandlungen",
          "Medikamente",
          "Heilmittel",
          "Hilfsmittel",
          "Psychotherapie",
          "Krankenhausbehandlungen",
          "Zahnbehandlungen",
          "Zahnersatz",
          "Vorsorge",
          "Leistungen im Ausland",
        ],
      },
      { type: "p", parts: ["Welche Leistungen tatsächlich versichert sind, ergibt sich aus dem jeweiligen Tarif und den dazugehörigen Versicherungsbedingungen."] },
      { type: "standalone", text: "Das ist ein wesentlicher Unterschied zur gesetzlichen Krankenversicherung." },
      {
        type: "p",
        parts: [
          "In der GKV ist ein großer Teil des Leistungsrahmens gesetzlich vorgegeben. In der PKV entsteht der individuelle Leistungsanspruch dagegen vor allem aus dem abgeschlossenen Versicherungsvertrag.",
        ],
      },
      {
        type: "p",
        parts: [
          "Nach § 192 Versicherungsvertragsgesetz erstattet eine Krankheitskostenversicherung im vereinbarten Umfang insbesondere Aufwendungen für medizinisch notwendige Heilbehandlungen wegen Krankheit oder Unfallfolgen sowie weitere vertraglich vereinbarte Leistungen.",
        ],
      },
      { type: "p", parts: ["Das entscheidende Wort lautet dabei:"] },
      { type: "quote", text: "„im vereinbarten Umfang“" },
      { type: "p", parts: ["Nicht jede private Krankenversicherung bietet automatisch denselben Leistungsumfang."] },
      { type: "p", parts: ["Deshalb gibt es nicht einfach „die PKV“."] },
      { type: "standalone", text: "Es gibt unterschiedliche Tarife mit teilweise erheblichen Unterschieden in ihren Versicherungsbedingungen." },
    ],
  },
  {
    id: "wer-kann-sich-privat-krankenversichern",
    heading: "2. Wer kann sich privat krankenversichern?",
    blocks: [
      { type: "p", parts: ["Nicht jede Person kann jederzeit frei zwischen gesetzlicher und privater Krankenversicherung wählen."] },
      { type: "p", parts: ["Welche Möglichkeiten bestehen, hängt vom sozialversicherungsrechtlichen Status ab."] },
      { type: "h3", text: "Arbeitnehmer" },
      { type: "p", parts: ["Bei Arbeitnehmern spielt insbesondere die Jahresarbeitsentgeltgrenze eine Rolle."] },
      {
        type: "p",
        parts: [
          "Arbeitnehmer, deren regelmäßiges Jahresarbeitsentgelt die jeweils geltende Grenze übersteigt und bei denen die weiteren gesetzlichen Voraussetzungen erfüllt sind, können versicherungsfrei in der gesetzlichen Krankenversicherung werden.",
        ],
      },
      { type: "standalone", text: "Für das Jahr 2026 beträgt die allgemeine Jahresarbeitsentgeltgrenze 77.400 Euro." },
      { type: "p", parts: ["Diese Grenze wird regelmäßig angepasst."] },
      { type: "p", parts: ["Deshalb sollte bei späterer Nutzung dieser Information immer geprüft werden, welche Grenze im betreffenden Jahr gilt."] },
      {
        type: "p",
        parts: [
          "Mehr zur Beratung für diese Zielgruppe findest du unter ",
          { a: "PKV für Angestellte", href: "/pkv-angestellte-kassel/" },
          ".",
        ],
      },
      { type: "h3", text: "Selbstständige und Freiberufler" },
      { type: "p", parts: ["Selbstständige und Freiberufler unterliegen häufig nicht der allgemeinen Versicherungspflicht als Arbeitnehmer."] },
      { type: "standalone", text: "Abhängig von ihrer individuellen Situation können sie sich freiwillig gesetzlich oder privat krankenversichern." },
      {
        type: "p",
        parts: [
          "Mehr zur Beratung für diese Zielgruppe findest du unter ",
          { a: "PKV für Selbstständige", href: "/pkv-selbststaendige-kassel/" },
          ".",
        ],
      },
      { type: "h3", text: "Beamte" },
      { type: "p", parts: ["Bei Beamten ist zusätzlich die Beihilfe relevant."] },
      { type: "p", parts: ["Der Dienstherr beteiligt sich über die Beihilfe an bestimmten beihilfefähigen Krankheitskosten."] },
      { type: "p", parts: ["Die private Krankenversicherung deckt dann typischerweise den verbleibenden Kostenanteil ab."] },
      { type: "standalone", text: "Aus diesem Grund funktionieren PKV-Tarife für Beamte anders als klassische Vollkostentarife für Arbeitnehmer oder Selbstständige." },
      {
        type: "p",
        parts: [
          "Mehr zur Beratung für diese Zielgruppe findest du unter ",
          { a: "PKV für Beamte", href: "/pkv-beamte-kassel/" },
          ".",
        ],
      },
      { type: "h3", text: "Studenten" },
      { type: "p", parts: ["Auch Studenten können unter bestimmten Voraussetzungen zwischen gesetzlicher und privater Krankenversicherung wählen."] },
      { type: "p", parts: ["Dabei gelten eigene sozialversicherungsrechtliche Regelungen und Fristen."] },
      { type: "p", parts: ["Die Frage:"] },
      { type: "quote", text: "„Darf ich mich privat versichern?“" },
      { type: "p", parts: ["sollte deshalb immer von einer zweiten Frage getrennt werden:"] },
      { type: "quote", text: "„Passt die private Krankenversicherung auch langfristig zu meiner persönlichen Situation?“" },
      { type: "standalone", text: "Beides ist nicht dasselbe." },
    ],
  },
  {
    id: "wie-kommt-ein-pkv-vertrag-zustande",
    heading: "3. Wie kommt ein PKV-Vertrag zustande?",
    blocks: [
      { type: "p", parts: ["Wer eine reguläre private Krankenvollversicherung abschließen möchte, stellt einen Antrag bei einem privaten Krankenversicherer."] },
      { type: "p", parts: ["Teil dieses Antrags sind normalerweise Gesundheitsfragen."] },
      { type: "p", parts: ["Der Versicherer fragt beispielsweise nach:"] },
      {
        type: "list",
        items: ["Erkrankungen", "Beschwerden", "Untersuchungen", "Behandlungen", "Medikamenteneinnahmen", "Psychotherapie", "Krankenhausaufenthalten", "bestimmten Diagnosen"],
      },
      { type: "p", parts: ["Dabei gelten je nach Versicherer unterschiedliche Fragestellungen und Abfragezeiträume."] },
      { type: "p", parts: ["Der Versicherer verwendet diese Angaben, um das bei Vertragsbeginn bestehende gesundheitliche Risiko einzuschätzen."] },
      { type: "p", parts: ["Abhängig vom Ergebnis kann ein Antrag beispielsweise:"] },
      {
        type: "list",
        items: [
          "zu normalen Bedingungen angenommen werden",
          "mit einem Risikozuschlag angenommen werden",
          "in bestimmten Konstellationen mit einem Leistungsausschluss angeboten werden",
          "zurückgestellt werden",
          "oder abgelehnt werden",
        ],
      },
      { type: "p", parts: ["Für besondere gesetzliche Tarife wie den Basistarif gelten andere Regeln."] },
      { type: "standalone", text: "Im Basistarif dürfen beispielsweise wegen eines erhöhten gesundheitlichen Risikos keine Risikozuschläge oder Leistungsausschlüsse vereinbart werden." },
    ],
  },
  {
    id: "warum-sind-gesundheitsfragen-wichtig",
    heading: "4. Warum sind die Gesundheitsfragen so wichtig?",
    blocks: [
      { type: "p", parts: ["Die Gesundheitsprüfung gehört zu den wichtigsten Schritten beim Abschluss einer privaten Krankenversicherung."] },
      {
        type: "p",
        parts: [
          "Nach § 19 Versicherungsvertragsgesetz müssen Antragsteller die ihnen bekannten gefahrerheblichen Umstände angeben, nach denen der Versicherer in Textform fragt.",
        ],
      },
      { type: "standalone", text: "Deshalb sollte man Gesundheitsfragen nicht nach Erinnerung oder Gefühl beantworten." },
      { type: "p", parts: ["Entscheidend ist, was der Versicherer konkret wissen möchte und welcher Zeitraum abgefragt wird."] },
      { type: "p", parts: ["Je nach gesundheitlicher Vorgeschichte kann es sinnvoll sein, beispielsweise:"] },
      {
        type: "list",
        items: ["Patientenakten anzufordern", "Diagnosen zu prüfen", "Arztunterlagen einzusehen", "Abrechnungsdaten zu kontrollieren", "unklare Diagnosen mit dem behandelnden Arzt zu besprechen"],
      },
      {
        type: "p",
        parts: [
          "Eine Diagnose in einer Patientenakte bedeutet dabei nicht automatisch, dass sie medizinisch richtig, aktuell oder für jeden Versicherer gleich relevant ist.",
        ],
      },
      { type: "p", parts: ["Trotzdem sollte eine unklare Dokumentation vor Antragstellung geklärt werden."] },
      { type: "p", parts: ["Bei umfangreicheren Vorerkrankungen kann zusätzlich eine Risikovoranfrage sinnvoll sein."] },
      { type: "p", parts: ["Dabei wird zunächst geprüft, wie Versicherer eine gesundheitliche Vorgeschichte voraussichtlich bewerten."] },
      {
        type: "p",
        parts: [
          "Auf dieser Website gibt es dazu eigene vertiefende Inhalte zu ",
          { a: "PKV-Gesundheitsfragen", href: "/pkv-gesundheitsfragen/" },
          " und zur ",
          { a: "PKV-Risikovoranfrage", href: "/pkv-risikovoranfrage/" },
          ".",
        ],
      },
    ],
  },
  {
    id: "wie-wird-der-beitrag-berechnet",
    heading: "5. Wie wird der Beitrag in der PKV berechnet?",
    blocks: [
      { type: "p", parts: ["Einer der größten Unterschiede zwischen gesetzlicher und privater Krankenversicherung liegt in der Beitragsberechnung."] },
      { type: "standalone", text: "Der reguläre PKV-Beitrag wird grundsätzlich nicht aus dem laufenden Einkommen berechnet." },
      { type: "p", parts: ["Zu den wichtigen Faktoren bei Vertragsbeginn gehören insbesondere:"] },
      { type: "h3", text: "Eintrittsalter" },
      { type: "p", parts: ["Das Eintrittsalter beeinflusst die Kalkulation."] },
      { type: "p", parts: ["Wer später in die PKV eintritt, hat weniger Zeit, Alterungsrückstellungen aufzubauen."] },
      { type: "p", parts: ["Dadurch ist bei ansonsten vergleichbarer Tarifgestaltung typischerweise ein höherer Beitrag erforderlich."] },
      { type: "h3", text: "Gesundheitszustand" },
      { type: "p", parts: ["Der Gesundheitszustand wird bei Vertragsbeginn im Rahmen der Risikoprüfung berücksichtigt."] },
      { type: "p", parts: ["Bestehende gesundheitliche Risiken können beispielsweise zu einem Risikozuschlag führen."] },
      { type: "h3", text: "Leistungsumfang" },
      { type: "p", parts: ["Auch der gewählte Leistungsumfang beeinflusst den Beitrag."] },
      {
        type: "p",
        parts: [
          "Ein Tarif mit umfangreicheren versicherten Leistungen benötigt grundsätzlich eine andere Kalkulation als ein Tarif mit deutlich begrenzterem Leistungsumfang.",
        ],
      },
      { type: "h3", text: "Selbstbehalt" },
      { type: "p", parts: ["Auch ein vereinbarter Selbstbehalt beeinflusst den Beitrag."] },
      { type: "p", parts: ["Übernimmt die versicherte Person einen größeren Teil ihrer Krankheitskosten selbst, kann dies den Versicherungsbeitrag reduzieren."] },
      { type: "p", parts: ["Wichtig ist deshalb:"] },
      { type: "standalone", text: "Ein höheres Einkommen macht einen bestehenden PKV-Tarif nicht automatisch teurer." },
      { type: "p", parts: ["Ein sinkendes Einkommen macht denselben Tarif aber auch nicht automatisch günstiger."] },
      { type: "standalone", text: "Der Beitrag und das Einkommen sind grundsätzlich voneinander getrennte Größen." },
    ],
  },
  {
    id: "aequivalenzprinzip",
    heading: "6. Was bedeutet das Äquivalenzprinzip?",
    blocks: [
      { type: "p", parts: ["Die private Krankenversicherung kalkuliert ihre Beiträge nach dem sogenannten Äquivalenzprinzip."] },
      { type: "p", parts: ["Vereinfacht bedeutet das:"] },
      {
        type: "standalone",
        text: "Beiträge und erwartete Versicherungsleistungen sollen für ein Versichertenkollektiv langfristig in einem kalkulatorischen Verhältnis zueinander stehen.",
      },
      { type: "p", parts: ["Der Versicherer betrachtet dabei unter anderem die voraussichtlich entstehenden Gesundheitskosten und weitere versicherungsmathematische Rechnungsgrundlagen."] },
      { type: "p", parts: ["Das unterscheidet sich vom Finanzierungsprinzip der gesetzlichen Krankenversicherung."] },
      { type: "p", parts: ["Wichtig für das Verständnis ist:"] },
      { type: "quote", text: "Die PKV ist keine persönliche Sparkasse, bei der jeder Versicherte exakt seine eigenen späteren Krankheitskosten anspart." },
      { type: "p", parts: ["Die Versicherung funktioniert weiterhin über Kollektive und Risikoausgleich."] },
      { type: "standalone", text: "Die Alterungsrückstellungen sind Bestandteil dieser langfristigen Kalkulation." },
    ],
  },
  {
    id: "alterungsrueckstellungen",
    heading: "7. Was sind Alterungsrückstellungen?",
    blocks: [
      { type: "p", parts: ["Mit zunehmendem Alter steigen statistisch die durchschnittlichen Ausgaben für medizinische Leistungen."] },
      {
        type: "p",
        parts: [
          "Würde eine private Krankenversicherung ausschließlich die jeweils im aktuellen Alter erwarteten Kosten berechnen, müssten die Beiträge allein aufgrund des Älterwerdens stark ansteigen.",
        ],
      },
      { type: "standalone", text: "Deshalb werden Alterungsrückstellungen aufgebaut." },
      { type: "p", parts: ["Vereinfacht funktioniert das folgendermaßen:"] },
      { type: "p", parts: ["In jüngeren Jahren liegt der kalkulierte Beitrag teilweise über den durchschnittlich erwarteten Gesundheitskosten des jeweiligen Alters."] },
      { type: "p", parts: ["Ein Teil dieses Beitrags fließt in die Alterungsrückstellungen."] },
      { type: "p", parts: ["In höheren Altersstufen können diese Rückstellungen dazu beitragen, die steigenden durchschnittlichen Krankheitskosten mitzufinanzieren."] },
      { type: "standalone", text: "Das bedeutet allerdings nicht, dass PKV-Beiträge im Laufe des Lebens niemals steigen können." },
      { type: "p", parts: ["Alterungsrückstellungen sollen den kalkulierten Effekt des Älterwerdens berücksichtigen."] },
      { type: "p", parts: ["Andere Veränderungen der Rechnungsgrundlagen können trotzdem Beitragsanpassungen erforderlich machen."] },
    ],
  },
  {
    id: "teurer-bei-krankheit",
    heading: "8. Wird meine PKV teurer, wenn ich krank werde?",
    blocks: [
      {
        type: "standalone",
        text: "Nein – jedenfalls nicht in dem Sinne, dass dein individueller Beitrag nach Vertragsabschluss erhöht wird, nur weil du persönlich krank wirst oder hohe Rechnungen einreichst.",
      },
      { type: "p", parts: ["Der Gesundheitszustand wird grundsätzlich beim Eintritt in die Versicherung bewertet."] },
      { type: "p", parts: ["Verschlechtert sich dein Gesundheitszustand später, führt dies nicht zu einem neuen individuellen Risikozuschlag aufgrund dieser Erkrankung."] },
      { type: "p", parts: ["Das ist ein wichtiger Grundgedanke der Versicherung."] },
      {
        type: "standalone",
        text: "Wer nach Vertragsabschluss beispielsweise eine chronische Erkrankung entwickelt, wird nicht jedes Jahr neu medizinisch bewertet und erhält deshalb keinen persönlichen Krankheitszuschlag.",
      },
    ],
  },
  {
    id: "warum-koennen-beitraege-steigen",
    heading: "9. Warum können PKV-Beiträge trotzdem steigen?",
    blocks: [
      { type: "p", parts: ["Dass eine individuelle Erkrankung keine persönliche Beitragserhöhung auslöst, bedeutet nicht, dass ein PKV-Beitrag dauerhaft unverändert bleibt."] },
      { type: "p", parts: ["Die Kalkulation eines Tarifs basiert auf verschiedenen Rechnungsgrundlagen."] },
      { type: "standalone", text: "Verändern sich maßgebliche Grundlagen dauerhaft stärker als kalkuliert, kann eine Beitragsanpassung erforderlich werden." },
      { type: "p", parts: ["Mögliche Ursachen können unter anderem sein:"] },
      {
        type: "list",
        items: ["veränderte durchschnittliche Leistungsausgaben", "steigende Behandlungskosten", "medizinischer Fortschritt", "Veränderungen versicherungsmathematischer Rechnungsgrundlagen"],
      },
      { type: "p", parts: ["Beitragsanpassungen sind gesetzlich geregelt."] },
      { type: "p", parts: ["Bei der substitutiven privaten Krankenversicherung ist eine Anpassung nicht einfach eine freie Preisentscheidung des Versicherers."] },
      {
        type: "p",
        parts: [
          "Die gesetzlichen Voraussetzungen und die versicherungsmathematische Kalkulation müssen berücksichtigt werden; bei entsprechenden Anpassungen ist zudem ein unabhängiger Treuhänder eingebunden.",
        ],
      },
      { type: "p", parts: ["Deshalb sollte man zwei Dinge klar voneinander trennen:"] },
      { type: "list", items: ["persönlicher Gesundheitszustand", "Beitragsentwicklung des gesamten Tarifs bzw. Versichertenkollektivs"] },
    ],
  },
  {
    id: "welche-leistungen-uebernimmt-die-pkv",
    heading: "10. Welche Leistungen übernimmt eine private Krankenversicherung?",
    blocks: [
      { type: "p", parts: ["Darauf gibt es keine pauschale Antwort."] },
      { type: "p", parts: ["Der Leistungsumfang hängt vom jeweiligen Tarif ab."] },
      { type: "p", parts: ["Typische Leistungsbereiche sind beispielsweise:"] },
      {
        type: "table",
        headers: ["Bereich", "Mögliche Tarifunterschiede"],
        rows: [
