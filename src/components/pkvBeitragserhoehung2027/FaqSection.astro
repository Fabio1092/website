---
import { ChevronDown } from "lucide-react";

const faqs = [
  {
    question: "Kann ich einfach zu einer anderen privaten Krankenversicherung wechseln?",
    answer: [
      "Grundsätzlich ja, allerdings ist ein Wechsel zu einer anderen Gesellschaft keine Formalität.",
      "Die neue Gesellschaft führt in der Regel eine eigene Gesundheitsprüfung durch und entscheidet eigenständig über die Annahme.",
    ],
  },
  {
    question: "Muss ich bei einem Wechsel zu einer anderen Gesellschaft erneut Gesundheitsfragen beantworten?",
    answer: [
      "Ja. Anders als beim internen Tarifwechsel nach § 204 VVG prüft eine andere Gesellschaft deinen Gesundheitszustand bei Antragstellung grundsätzlich erneut.",
      "Das Ergebnis kann eine normale Annahme, ein Risikozuschlag, ein Leistungsausschluss, eine Zurückstellung oder eine Ablehnung sein.",
    ],
  },
  {
    question: "Was passiert mit meinen Alterungsrückstellungen bei einem Versichererwechsel?",
    answer: [
      "Für ab 2009 abgeschlossene Krankheitskostenvollversicherungen besteht ein gesetzlich geregelter Übertragungswert, der sich unter anderem am Basistarif orientiert.",
      "Nicht übertragbar ist in der Regel der darüberhinausgehende Teil deiner bisherigen Alterungsrückstellungen.",
      "Bei vor 2009 abgeschlossenen Verträgen ist eine Übertragung bei einem gewöhnlichen Gesellschaftswechsel grundsätzlich nicht möglich.",
    ],
  },
  {
    question: "Was ist eine Risikovoranfrage und wofür brauche ich sie?",
    answer: [
      "Eine Risikovoranfrage ist eine anonymisierte oder pseudonymisierte Anfrage bei einer oder mehreren Gesellschaften, mit der mögliche Annahmebedingungen vorab eingeschätzt werden können.",
      "Sie ersetzt keine verbindliche Zusage, kann aber helfen, Überraschungen bei einem späteren Antrag zu vermeiden.",
    ],
  },
  {
    question: "Kann ein Wechsel auch bei Vorerkrankungen funktionieren?",
    answer: [
      "Das hängt von der Art und Schwere der Vorerkrankung sowie von der Annahmepolitik der jeweiligen Gesellschaft ab.",
      "Eine Vorerkrankung schließt einen Wechsel nicht automatisch aus, kann aber zu Zuschlägen, Ausschlüssen oder einer Ablehnung führen.",
    ],
  },
  {
    question: "Gibt es wegen der Beitragserhöhung ein Sonderkündigungsrecht?",
    answer: [
      "Bei einer entsprechenden Beitragsanpassung besteht grundsätzlich ein Sonderkündigungsrecht nach § 205 Abs. 4 VVG. Die Kündigung muss innerhalb von zwei Monaten nach Zugang der Änderungsmitteilung erklärt werden.",
      "Bei einer privaten Krankenvollversicherung muss zudem ein nahtloser anderweitiger Versicherungsschutz nachgewiesen werden.",
      "Ein vorschneller Wechsel kann Nachteile haben. Deshalb würde ich die Alternativen vor einer Kündigung sorgfältig prüfen.",
    ],
  },
  {
    question: "Was passiert, wenn ich bei der neuen Gesellschaft abgelehnt werde?",
    answer: [
      "Dann bleibt dein bisheriger Vertrag unverändert bestehen, solange du ihn nicht gekündigt hast.",
      "Deshalb solltest du deinen bestehenden PKV-Vertrag niemals kündigen, bevor der neue Versicherungsschutz verbindlich geklärt ist.",
    ],
  },
  {
    question: "Lohnt sich ein Wechsel auch für langjährig Privatversicherte?",
    answer: [
      "Das lässt sich nicht pauschal beantworten.",
      "Je länger du privat versichert bist, desto höher sind in der Regel die nicht übertragbaren Alterungsrückstellungen – und desto genauer sollte die Wirtschaftlichkeit geprüft werden.",
    ],
  },
];
---

<section id="faq" class="scroll-mt-20 bg-brand-50/30 py-16 sm:py-24">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="font-serif text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">Häufige Fragen zur PKV-Beitragserhöhung 2027</h2>
    </div>

    <div data-reveal class="mx-auto mt-10 max-w-2xl divide-y divide-black/5 overflow-hidden rounded-2xl border border-black/5 bg-white shadow-soft">
      {
        faqs.map((faq) => (
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 marker:content-none [&::-webkit-details-marker]:hidden">
              <h3 class="font-serif text-base font-semibold text-ink-950 sm:text-lg">{faq.question}</h3>
              <ChevronDown className="h-5 w-5 shrink-0 text-ink-700/50 transition-transform duration-200 group-open:rotate-180" aria-hidden={true} />
            </summary>
            <div class="space-y-3 px-6 pb-6 text-sm leading-relaxed text-ink-700/80 sm:text-base">
              {faq.answer.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
