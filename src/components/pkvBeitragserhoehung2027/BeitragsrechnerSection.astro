---
import BookingButton from "@/components/pkvBeitragserhoehung2027/BookingButton.astro";
---

<section id="rechner" class="scroll-mt-20 bg-white py-16 sm:py-24">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <div data-reveal class="mx-auto max-w-2xl text-center">
      <h2 class="font-serif text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">Was kostet dich deine PKV-Erhöhung wirklich?</h2>
      <p class="mx-auto mt-4 max-w-xl text-lg leading-relaxed text-ink-700/80">
        Gib deinen bisherigen und neuen Monatsbeitrag ein. Der Rechner zeigt dir unmittelbar, wie sich deine
        Belastung verändert.
      </p>
    </div>

    <div data-reveal id="beitragsrechner" class="mx-auto mt-10 max-w-xl rounded-3xl border border-black/5 bg-brand-50/20 p-6 shadow-soft sm:p-8">
      <form id="rechner-form" class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="rechner-alt" class="block text-sm font-medium text-ink-950">Bisheriger Monatsbeitrag</label>
          <div class="relative mt-2">
            <input
              type="number"
              id="rechner-alt"
              name="alt"
              inputmode="decimal"
              min="0"
              step="1"
              value="650"
              class="w-full rounded-xl border border-black/10 bg-white px-4 py-3 pr-10 text-base text-ink-950 shadow-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/30"
            />
            <span class="pointer-events-none absolute inset-y-0 right-4 flex items-center text-sm text-ink-700/50" aria-hidden="true">€</span>
          </div>
        </div>
        <div>
          <label for="rechner-neu" class="block text-sm font-medium text-ink-950">Neuer Monatsbeitrag</label>
          <div class="relative mt-2">
            <input
              type="number"
              id="rechner-neu"
              name="neu"
              inputmode="decimal"
              min="0"
              step="1"
              value="750"
              class="w-full rounded-xl border border-black/10 bg-white px-4 py-3 pr-10 text-base text-ink-950 shadow-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/30"
            />
            <span class="pointer-events-none absolute inset-y-0 right-4 flex items-center text-sm text-ink-700/50" aria-hidden="true">€</span>
          </div>
        </div>
      </form>

      <div class="mt-7 grid gap-4 sm:grid-cols-3" role="status" aria-live="polite" aria-atomic="true">
        <div class="rounded-2xl border border-black/5 bg-white p-5 text-center shadow-soft">
          <p class="text-xs font-semibold uppercase tracking-wide text-ink-700/50">Pro Monat</p>
          <p id="rechner-monat" class="mt-2 font-serif text-2xl font-semibold tracking-tight text-ink-950">+100,00 €</p>
        </div>
        <div class="rounded-2xl border border-black/5 bg-white p-5 text-center shadow-soft">
          <p class="text-xs font-semibold uppercase tracking-wide text-ink-700/50">Pro Jahr</p>
          <p id="rechner-jahr" class="mt-2 font-serif text-2xl font-semibold tracking-tight text-ink-950">+1.200,00 €</p>
        </div>
        <div class="rounded-2xl border border-black/5 bg-white p-5 text-center shadow-soft">
          <p class="text-xs font-semibold uppercase tracking-wide text-ink-700/50">Veränderung</p>
          <p id="rechner-prozent" class="mt-2 font-serif text-2xl font-semibold tracking-tight text-ink-950">+15,38 %</p>
        </div>
      </div>

      <p id="rechner-hinweis" class="mt-4 min-h-[1.25rem] text-sm leading-relaxed text-ink-700/70"></p>

      <div class="mt-5 rounded-2xl border border-black/5 bg-white p-5">
        <div class="h-2.5 w-full overflow-hidden rounded-full bg-black/5">
          <div
            id="rechner-balken"
            class="h-full rounded-full bg-brand-500 transition-[width] duration-300 ease-out motion-reduce:transition-none"
            style="width: 86.7%"
          >
          </div>
        </div>
        <p class="mt-2 text-xs text-ink-700/50">Bisheriger Beitrag im Verhältnis zum neuen Beitrag</p>
      </div>

      <p class="mt-6 text-xs leading-relaxed text-ink-700/55">
        Dieser Rechner zeigt ausschließlich deine Mehr- oder Minderbelastung durch die Beitragsanpassung.
        Er ist kein Ersparnisrechner und ermittelt kein Sparpotenzial durch einen Gesellschaftswechsel.
      </p>

      <noscript>
        <p class="mt-6 rounded-xl border border-black/5 bg-white p-4 text-sm leading-relaxed text-ink-700/80">
          Der interaktive Rechner benötigt JavaScript. Als Beispiel: Bei einer Erhöhung von 650 € auf 750 €
          im Monat ergibt sich eine Mehrbelastung von 100 € im Monat beziehungsweise 1.200 € im Jahr.
        </p>
      </noscript>
    </div>

    <div class="mx-auto mt-8 max-w-lg text-center">
      <BookingButton location="calculator" variant="compact" label="PKV-Versichererwechsel prüfen lassen" />
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var root = document.getElementById("beitragsrechner");
    if (!root) return;

    var altInput = root.querySelector("#rechner-alt");
    var neuInput = root.querySelector("#rechner-neu");
    var monatOut = root.querySelector("#rechner-monat");
    var jahrOut = root.querySelector("#rechner-jahr");
    var prozentOut = root.querySelector("#rechner-prozent");
    var hinweis = root.querySelector("#rechner-hinweis");
    var balken = root.querySelector("#rechner-balken");

    var eur = new Intl.NumberFormat("de-DE", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    var pct = new Intl.NumberFormat("de-DE", { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    function parseValue(input) {
      if (input.value.trim() === "") return null;
      var n = parseFloat(input.value.replace(",", "."));
      if (!isFinite(n) || isNaN(n) || n < 0) return null;
      return n;
    }

    function formatSigned(n, suffix) {
      var sign = n > 0 ? "+" : n < 0 ? "−" : "";
      return sign + eur.format(Math.abs(n)) + " " + suffix;
    }

    function update() {
      var alt = parseValue(altInput);
      var neu = parseValue(neuInput);

      if (alt === null || neu === null) {
        monatOut.textContent = "–";
        jahrOut.textContent = "–";
        prozentOut.textContent = "–";
        hinweis.textContent = "Bitte gib zwei gültige Beiträge ein (keine negativen Werte).";
        balken.style.width = "0%";
        return;
      }

      var diffMonat = neu - alt;
      var diffJahr = diffMonat * 12;

      monatOut.textContent = formatSigned(diffMonat, "€");
      jahrOut.textContent = formatSigned(diffJahr, "€");

      if (alt === 0) {
        prozentOut.textContent = "Nicht berechenbar";
      } else {
        var prozent = (diffMonat / alt) * 100;
        var sign = prozent > 0 ? "+" : prozent < 0 ? "−" : "";
        prozentOut.textContent = sign + pct.format(Math.abs(prozent)) + " %";
      }

      if (diffMonat === 0) {
        hinweis.textContent = "Dein Beitrag bleibt unverändert.";
      } else if (diffMonat > 0) {
        hinweis.textContent =
          "Bei einer fünf Jahre lang unveränderten Differenz entspräche das insgesamt " + eur.format(diffJahr * 5) + " € — rein rechnerisch, ohne künftige Beitragsanpassungen zu unterstellen.";
      } else {
        hinweis.textContent = "Dein Beitrag sinkt im Vergleich zum bisherigen Betrag.";
      }

      var max = Math.max(alt, neu, 1);
      var breite = alt === 0 && neu === 0 ? 0 : (Math.min(alt, max) / max) * 100;
      balken.style.width = Math.max(0, Math.min(100, breite)) + "%";
    }

    altInput.addEventListener("input", update);
    neuInput.addEventListener("input", update);
    update();
  })();
</script>
