---
import BookingButton from "@/components/pkvBeitragserhoehung2027/BookingButton.astro";

const steps = [
  {
    number: "1",
    title: "Wir schauen uns deine Beitragserhöhung an",
    text: "Zunächst prüfen wir deine aktuelle Versicherung, deinen Tarif, die bisherigen Beiträge und die angekündigte Anpassung zum 1. Januar 2027. Dabei ist auch wichtig, welche Leistungen dir heute besonders wichtig sind.",
  },
  {
    number: "2",
    title: "Wir prüfen mögliche Tarifalternativen",
    text: "Anschließend schauen wir, welche Wechselmöglichkeiten innerhalb deiner bestehenden Versicherung infrage kommen. Wenn es sinnvolle Alternativen gibt, werden Beitrag, Selbstbehalt und Versicherungsleistungen gegenübergestellt.",
  },
];
---

<section id="beratungsprozess" class="scroll-mt-20 bg-brand-50/30 py-16 sm:py-24">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="font-serif text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">So läuft die Überprüfung deiner PKV ab</h2>
    </div>

    <ol class="mt-14 space-y-10">
      {
        steps.map((step, index) => (
          <li data-reveal style={`transition-delay: ${index * 80}ms`} class="relative flex gap-6 sm:gap-8">
            <div class="flex flex-col items-center">
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-ink-950 font-serif text-base font-semibold text-white">
                {step.number}
              </span>
              <span class="mt-2 w-px flex-1 bg-brand-200" aria-hidden="true" />
            </div>
            <div class="min-w-0 pb-2">
              <h3 class="font-serif text-xl font-semibold text-ink-950 sm:text-2xl">{step.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-ink-700/80 sm:text-base">{step.text}</p>
            </div>
          </li>
        ))
      }

      <li data-reveal style="transition-delay: 160ms" class="relative flex gap-6 sm:gap-8">
        <div class="flex flex-col items-center">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-ink-950 font-serif text-base font-semibold text-white">3</span>
        </div>
        <div class="min-w-0 pb-2">
          <h3 class="font-serif text-xl font-semibold text-ink-950 sm:text-2xl">Du bekommst eine verständliche Einschätzung</h3>
          <p class="mt-3 text-sm leading-relaxed text-ink-700/80 sm:text-base">Am Ende sollst du wissen:</p>
          <ul class="mt-4 space-y-2">
            {
              [
                "Welche Möglichkeiten hast du tatsächlich?",
                "Wie unterscheiden sich die Beiträge?",
                "Welche Leistungen bleiben bestehen?",
                "Wo gibt es möglicherweise Nachteile?",
                "Ist ein Wechsel sinnvoll oder solltest du lieber im bisherigen Tarif bleiben?",
              ].map((item) => (
                <li class="flex items-start gap-2.5 text-sm leading-relaxed text-ink-700/85 sm:text-base">
                  <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500" aria-hidden="true" />
                  {item}
                </li>
              ))
            }
          </ul>
          <p class="mt-4 text-base font-medium leading-relaxed text-ink-950">Die Entscheidung triffst du erst, wenn die Unterschiede nachvollziehbar sind.</p>
        </div>
      </li>
    </ol>

    <div class="mx-auto mt-14 max-w-lg text-center">
      <BookingButton location="process" variant="compact" />
    </div>
  </div>
</section>
