---
import BookingButton from "@/components/pkvBeitragserhoehung2027/BookingButton.astro";

const steps = [
  {
    number: "1",
    title: "Erstgespräch",
    text: "Wir besprechen deine Beitragserhöhung, deinen bisherigen Vertrag und deine Ziele.",
  },
  {
    number: "2",
    title: "Voraussetzungen prüfen",
    text: "Wir klären, ob ein anderer Versicherer grundsätzlich infrage kommt – einschließlich Gesundheit und Übertragungswert.",
  },
  {
    number: "3",
    title: "Alternativen vergleichen",
    text: "Wenn ein Wechsel realistisch ist, vergleichen wir geeignete Lösungen und ihre langfristigen Auswirkungen.",
  },
  {
    number: "4",
    title: "Fundiert entscheiden",
    text: "Du entscheidest auf Grundlage einer nachvollziehbaren Gegenüberstellung.",
  },
];
---

<section id="beratungsprozess" class="scroll-mt-20 bg-white py-16 sm:py-24">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <div data-reveal class="mx-auto max-w-2xl text-center">
      <h2 class="font-serif text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">So läuft die Prüfung ab</h2>
    </div>

    <ol class="mx-auto mt-10 grid max-w-3xl gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((step, index) => (
          <li data-reveal style={`transition-delay: ${index * 80}ms`} class="rounded-2xl border border-black/5 bg-brand-50/20 p-5">
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-ink-950 font-serif text-sm font-semibold text-white">{step.number}</span>
            <h3 class="mt-4 font-serif text-base font-semibold text-ink-950">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-700/80">{step.text}</p>
          </li>
        ))
      }
    </ol>

    <p class="mx-auto mt-8 max-w-xl text-center text-xs text-ink-700/55">
      Nur der erste Schritt ist das kostenlose 15-minütige Erstgespräch. Die weiteren Schritte finden im
      Rahmen der individuellen Beratung statt.
    </p>

    <div class="mx-auto mt-6 max-w-lg text-center">
      <BookingButton location="process" variant="compact" />
    </div>
  </div>
</section>
