---
import ComparisonSplit from "@/components/ComparisonSplit.astro";
import BookingButton from "@/components/pkvBeitragserhoehung2027/BookingButton.astro";

const columns: [
  { tone: "danger"; label: string; points: string[] },
  { tone: "success"; label: string; points: string[] },
] = [
  {
    tone: "danger",
    label: "Nur auf den Monatsbeitrag schauen",
    points: [
      "Der neue Tarif erscheint günstiger.",
      "Unterschiede bei den Leistungen werden möglicherweise übersehen.",
      "Ein höherer Selbstbehalt verändert die tatsächliche Belastung.",
      "Risikozuschläge können den vermeintlichen Preisvorteil reduzieren.",
      "Nicht übertragbare Alterungsrückstellungen bleiben unberücksichtigt.",
      "Die langfristige Entwicklung wird nicht ausreichend betrachtet.",
    ],
  },
  {
    tone: "success",
    label: "Versichererwechsel ganzheitlich prüfen",
    points: [
      "Beiträge und Leistungen werden miteinander verglichen.",
      "Gesundheitsfragen werden vorab geklärt.",
      "Mögliche Zuschläge und Ausschlüsse werden berücksichtigt.",
      "Der Übertragungswert wird einbezogen.",
      "Eigenanteile und Selbstbehalte werden gegenübergestellt.",
      "Die langfristigen Auswirkungen werden besprochen.",
    ],
  },
];
---

<section id="vergleich" class="scroll-mt-20 bg-brand-50/30 py-16 sm:py-24">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <div data-reveal class="mx-auto max-w-2xl text-center">
      <h2 class="font-serif text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">Nicht nur den Beitrag vergleichen – die Gesamtlösung zählt</h2>
    </div>

    <div data-reveal class="mx-auto mt-6 max-w-2xl space-y-4 text-center text-lg leading-relaxed text-ink-700/80">
      <p>Wenn du wegen einer Beitragserhöhung über einen Versichererwechsel nachdenkst, ist der Monatsbeitrag verständlicherweise besonders wichtig.</p>
      <p>Ich würde trotzdem vermeiden, ausschließlich nach dem günstigsten Angebot zu suchen.</p>
    </div>

    <div class="mx-auto mt-10 max-w-3xl">
      <ComparisonSplit columns={columns} />
    </div>

    <p class="mx-auto mt-10 max-w-2xl text-center text-base font-medium leading-relaxed text-ink-950">
      Mein Ziel ist nicht, dir den günstigsten Tarif zu verkaufen, sondern eine Lösung zu finden, die auch
      langfristig zu deiner Lebenssituation passt.
    </p>

    <div class="mt-8 flex justify-center">
      <BookingButton location="comparison" variant="compact" label="PKV-Versichererwechsel prüfen lassen" />
    </div>
  </div>
</section>
