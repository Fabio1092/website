---
import RichParagraph from "@/components/RichParagraph.astro";

type Part = string | { b: string } | { a: string; href: string };

type Block =
  | { type: "p"; parts: Part[] }
  | { type: "standalone"; text: string }
  | { type: "quote"; text: string }
  | { type: "list"; items: string[] }
  | { type: "h3"; text: string }
  | { type: "table"; headers: string[]; rows: string[][] };

interface Section {
  id: string;
  heading: string;
  blocks: Block[];
}

const introBlocks: Block[] = [
  { type: "p", parts: ["Das klingt zunächst ziemlich einfach."] },
  {
    type: "p",
    parts: [
      "In der Praxis gehört der Selbstbehalt aber zu den Punkten einer privaten Krankenversicherung, bei denen ein vermeintlich günstiger Tarif schnell schlechter aussehen kann, sobald man richtig rechnet.",
    ],
  },
  {
    type: "p",
    parts: [
      "Denn ein hoher Selbstbehalt senkt zwar normalerweise deinen Versicherungsbeitrag. Gleichzeitig trägst du aber einen größeren Teil deiner Krankheitskosten selbst.",
    ],
  },
  { type: "p", parts: ["Bei Angestellten kommt noch ein wichtiger Punkt hinzu:"] },
  { type: "standalone", text: "Dein Arbeitgeber beteiligt sich am PKV-Beitrag – aber nicht an deinem Selbstbehalt." },
  {
    type: "p",
    parts: ["Und wenn du deinen Selbstbehalt später wieder reduzieren möchtest, kann je nach Tarif sogar erneut eine Gesundheitsprüfung notwendig werden."],
