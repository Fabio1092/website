      { type: "p", parts: ["Du weißt:"] },
      { type: "p", parts: ["Im ungünstigen Fall kann dieser Betrag auf dich zukommen."] },
      { type: "p", parts: ["Schwieriger finde ich Tarife, bei denen Eigenanteile an vielen verschiedenen Stellen entstehen."] },
      { type: "p", parts: ["Zum Beispiel:"] },
      {
        type: "list",
        items: [
          "nur 80 Prozent Erstattung bestimmter Leistungen",
          "begrenzte Höchstbeträge",
          "Preisverzeichnisse",
          "Einschränkungen bei Heilmitteln",
          "reduzierte Zahnleistungen",
          "Begrenzung bestimmter Hilfsmittel",
        ],
      },
      { type: "p", parts: ["Dann existiert möglicherweise gar kein großer, sichtbar ausgewiesener Selbstbehalt."] },
      { type: "p", parts: ["Trotzdem können im Leistungsfall erhebliche Eigenkosten entstehen."] },
      { type: "p", parts: ["Für mich gilt:"] },
      { type: "standalone", text: "Ein transparenter Selbstbehalt ist leichter planbar als unklare Leistungslücken." },
    ],
  },
  {
    id: "wie-hoch-sollte-er-sein",
    heading: "Wie hoch sollte der PKV-Selbstbehalt sein?",
    blocks: [
      { type: "p", parts: ["Darauf gibt es keine pauschale Zahl."] },
      { type: "p", parts: ["Ich würde die Höhe anhand von fünf Fragen bestimmen."] },
      { type: "h3", text: "1. Wie viel Beitrag spare ich wirklich?" },
      { type: "p", parts: ["Nicht:"] },
      { type: "p", parts: ["„Der Tarif kostet 70 Euro weniger.“"] },
      { type: "p", parts: ["Sondern:"] },
      { type: "standalone", text: "Wie viel spare ich pro Jahr tatsächlich?" },
      { type: "h3", text: "2. Wie stark steigt mein maximales Eigenrisiko?" },
      {
        type: "p",
        parts: ["Steigt dein Selbstbehalt um 1.000 Euro, der Beitrag sinkt aber nur um 250 Euro im Jahr, wäre das für mich wirtschaftlich wenig überzeugend."],
      },
      { type: "h3", text: "3. Bin ich Angestellter oder Selbstständiger?" },
      {
        type: "p",
        parts: ["Für Angestellte ist ein hoher Selbstbehalt oft weniger attraktiv, weil der Arbeitgeber am Beitrag beteiligt ist, am Selbstbehalt jedoch nicht."],
      },
      { type: "p", parts: ["Für Selbstständige kann eine höhere Selbstbeteiligung eher sinnvoll sein, weil die gesamte Beitragsersparnis bei ihnen ankommt."] },
      { type: "h3", text: "4. Kann ich den Betrag jederzeit problemlos bezahlen?" },
      { type: "p", parts: ["Ein Selbstbehalt gehört aus meiner Sicht nicht auf die Kreditkarte."] },
      {
        type: "p",
        parts: [
          "Wenn dich eine unerwartete Rechnung über 1.500 Euro finanziell aus der Bahn werfen würde, solltest du keinen Tarif wählen, bei dem genau dieses Eigenrisiko realistisch auftreten kann.",
        ],
      },
      { type: "h3", text: "5. Kann ich den Selbstbehalt später flexibel reduzieren?" },
      { type: "p", parts: ["Diese Frage wird häufig vergessen."] },
      { type: "p", parts: ["Mit 30 Jahren und hohem Einkommen kann ein größerer Selbstbehalt problemlos erscheinen."] },
      { type: "p", parts: ["Mit 50 Jahren, Familie oder gesundheitlichen Veränderungen kann die Situation anders aussehen."] },
      { type: "p", parts: ["Deshalb ist Flexibilität für mich wichtiger als die letzten 15 Euro Beitragsersparnis."] },
    ],
  },
  {
    id: "drei-typische-situationen",
    heading: "Drei typische Situationen",
    blocks: [
      { type: "h3", text: "Beispiel 1: Angestellter mit hohem Selbstbehalt" },
      { type: "p", parts: ["Ein Angestellter könnte zwischen zwei Tarifen wählen."] },
      { type: "p", parts: ["Tarif A hat einen moderaten Selbstbehalt."] },
      { type: "p", parts: ["Tarif B spart 60 Euro Monatsbeitrag, verlangt dafür aber einen deutlich höheren Selbstbehalt."] },
      {
        type: "p",
        parts: ["Von den 60 Euro Beitragsersparnis kommen bei hälftigem Arbeitgeberzuschuss vereinfacht möglicherweise nur rund 30 Euro beim Arbeitnehmer an."],
      },
      { type: "p", parts: ["Der zusätzliche Selbstbehalt liegt dagegen vollständig bei ihm."] },
      {
        type: "p",
        parts: [{ b: "Meine Einschätzung:" }, " Genau rechnen. Der niedrigere Monatsbeitrag kann optisch attraktiver wirken, als er wirtschaftlich tatsächlich ist."],
      },
      { type: "h3", text: "Beispiel 2: Selbstständiger mit guten Rücklagen" },
      { type: "p", parts: ["Ein wirtschaftlich stabiler Selbstständiger kann durch einen höheren Selbstbehalt 80 Euro Beitrag im Monat sparen."] },
      { type: "p", parts: ["Das sind:"] },
      { type: "standalone", text: "960 Euro im Jahr." },
      { type: "p", parts: ["Das zusätzliche maximale Eigenrisiko gegenüber der Alternative beträgt beispielsweise 600 Euro."] },
      {
        type: "p",
        parts: [{ b: "Meine Einschätzung:" }, " Kann wirtschaftlich sinnvoll sein, sofern Tarifqualität, Rücklagen und langfristige Flexibilität stimmen."],
      },
      { type: "h3", text: "Beispiel 3: Niedriger Beitrag, aber viele versteckte Eigenanteile" },
      { type: "p", parts: ["Tarif A kostet 50 Euro weniger als Tarif B."] },
      { type: "p", parts: ["Auf den ersten Blick wirkt Tarif A günstiger."] },
      { type: "p", parts: ["Dann zeigt die Bedingungsanalyse:"] },
      { type: "p", parts: ["Bei bestimmten Heilmitteln, Zahnersatz und weiteren Leistungen bestehen zusätzliche Begrenzungen."] },
      {
        type: "p",
        parts: [{ b: "Meine Einschätzung:" }, " Nicht nur den offiziellen Selbstbehalt vergleichen. Die gesamten Bedingungen entscheiden darüber, wie hoch dein tatsächliches Eigenrisiko ist."],
      },
    ],
  },
  {
    id: "selbstbehalt-oder-hoeherer-beitrag",
    heading: "Selbstbehalt oder lieber höherer Beitrag?",
    blocks: [
      { type: "p", parts: ["Ich würde die Entscheidung nicht ideologisch treffen."] },
      { type: "p", parts: ["Ein Selbstbehalt ist weder grundsätzlich gut noch schlecht."] },
      { type: "p", parts: ["Er ist ein Werkzeug."] },
      { type: "p", parts: ["Richtig eingesetzt kann er:"] },
      {
        type: "list",
        items: ["deinen laufenden Beitrag reduzieren", "kleine Risiken sinnvoll bei dir belassen", "gerade für Selbstständige wirtschaftlich interessant sein"],
      },
      { type: "p", parts: ["Falsch eingesetzt kann er:"] },
      {
        type: "list",
        items: [
          "einen Tarif nur optisch billig machen",
          "bei Angestellten den Arbeitgeberzuschuss unnötig reduzieren",
          "hohe Eigenkosten verursachen",
          "später schwer wieder reduzierbar sein",
        ],
      },
      { type: "p", parts: ["Deshalb lautet meine Regel:"] },
      {
        type: "standalone",
        text: "Versichere die Risiken, die du nicht sinnvoll selbst tragen kannst – und übernimm nur so viel Selbstbehalt, wie wirtschaftlich wirklich sinnvoll und dauerhaft tragbar ist.",
      },
    ],
  },
  {
    id: "checkliste",
    heading: "Meine Checkliste für den PKV-Selbstbehalt",
    blocks: [
      { type: "p", parts: ["Bevor du dich für einen Tarif entscheidest, würde ich diese Punkte beantworten:"] },
      {
        type: "list",
        items: [
          "1. Wie hoch ist der Selbstbehalt pro Jahr?",
          "2. Gilt er für alle Leistungen oder nur bestimmte Bereiche?",
          "3. Gibt es zusätzlich prozentuale Eigenanteile?",
          "4. Gibt es indirekte oder versteckte Selbstbehalte?",
          "5. Wie stark reduziert der Selbstbehalt tatsächlich meinen Beitrag?",
          "6. Wie sieht die Rechnung im maximalen Leistungsjahr aus?",
          "7. Wie wirkt sich mein Arbeitgeberzuschuss darauf aus?",
          "8. Welche Beitragsrückerstattung ist vorgesehen?",
          "9. Kann ich den Selbstbehalt später reduzieren?",
          "10. Ist dafür eine neue Gesundheitsprüfung notwendig?",
          "11. Kann ich den maximalen Eigenanteil jederzeit aus meinen Rücklagen zahlen?",
          "12. Passt der Tarif auch ohne die reine Beitragsersparnis zu meinen Leistungsanforderungen?",
        ],
      },
      { type: "p", parts: ["Wenn diese Fragen sauber beantwortet sind, wird die Entscheidung deutlich einfacher."] },
    ],
  },
];
---

<div class="mx-auto max-w-3xl space-y-20 px-4 py-16 sm:px-6 lg:px-8">
  <div data-reveal class="space-y-4">
    {
      introBlocks.map((block) => {
        if (block.type === "p") return <RichParagraph parts={block.parts} />;
        if (block.type === "standalone") return <p class="text-base font-medium leading-relaxed text-ink-950">{block.text}</p>;
        return null;
      })
    }
  </div>

  {
    sections.map((section) => (
      <section id={section.id} class="scroll-mt-24">
        <h2 class="font-serif text-2xl font-semibold tracking-tight text-ink-950 sm:text-3xl">{section.heading}</h2>
        <div data-reveal class="mt-6 space-y-4">
          {section.blocks.map((block) => {
            if (block.type === "p") return <RichParagraph parts={block.parts} />;
            if (block.type === "standalone") return <p class="text-base font-medium leading-relaxed text-ink-950">{block.text}</p>;
            if (block.type === "quote")
              return (
                <blockquote class="border-l-2 border-brand-200 pl-5">
                  <p class="font-serif text-lg italic leading-relaxed text-ink-950">{block.text}</p>
                </blockquote>
              );
            if (block.type === "list")
              return (
                <ul class="space-y-2">
                  {block.items.map((item) => (
                    <li class="flex items-baseline gap-2.5 text-base leading-relaxed text-ink-700/85">
                      <span class="h-1.5 w-1.5 shrink-0 translate-y-[-2px] rounded-full bg-brand-400" aria-hidden="true" />
                      {item}
                    </li>
                  ))}
                </ul>
              );
            if (block.type === "h3") return <h3 class="!mt-10 font-serif text-xl font-semibold text-ink-950">{block.text}</h3>;
            if (block.type === "table")
              return (
                <div class="overflow-x-auto rounded-xl border border-black/5">
                  <table class="w-full min-w-[560px] border-collapse text-left text-sm">
                    <thead>
                      <tr class="bg-brand-50/60">
                        {block.headers.map((h) => (
                          <th class="px-4 py-3 font-semibold text-ink-950">{h}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-black/5 bg-white">
                      {block.rows.map((row) => (
                        <tr>
                          {row.map((cell, i) => (
                            <td class={i === 0 ? "px-4 py-3 font-medium text-ink-950" : "px-4 py-3 text-ink-700/80"}>{cell}</td>
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              );
            return null;
          })}
        </div>
      </section>
    ))
  }
</div>
