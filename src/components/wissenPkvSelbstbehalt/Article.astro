  { type: "p", parts: ["Deshalb lautet die richtige Frage nicht:"] },
  { type: "standalone", text: "„Mit welchem Selbstbehalt bekomme ich den niedrigsten PKV-Beitrag?“" },
  { type: "p", parts: ["Sondern:"] },
  { type: "standalone", text: "„Welche Selbstbeteiligung ergibt für meine persönliche Situation langfristig wirtschaftlich Sinn?“" },
  { type: "p", parts: ["Genau das schauen wir uns in diesem Artikel an."] },
];

