---
type Part = string | { b: string } | { a: string; href: string };

interface Props {
  parts: Part[];
  class?: string;
}

const { parts, class: className = "text-sm leading-relaxed text-ink-700/85 sm:text-base" } = Astro.props;
---

<p class={className}>
  {
    parts.map((part) => {
      if (typeof part === "string") return part;
      if ("href" in part)
        return (
          <a href={part.href} class="font-medium text-brand-700 underline underline-offset-2 hover:text-brand-800">
            {part.a}
          </a>
        );
      return <strong class="font-semibold text-ink-950">{part.b}</strong>;
    })
  }
</p>
