---
import { ArrowRight } from "lucide-react";
import { guideCategories, guidesByCategory, categoryAnchors, guideHref } from "@/lib/guides";
---

<section class="bg-white py-16 sm:py-24">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <h2 class="font-serif text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">Alle Versicherungs-Ratgeber</h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-700/80">
        Nicht jede Versicherung ist für jeden Menschen gleich wichtig. Deshalb findest du meine Ratgeber nach Lebensbereichen sortiert.
      </p>
    </div>

    <div class="mt-10 divide-y divide-ink-950/10 border-y border-ink-950/10">
      {
        guideCategories.map((category) => {
          const all = guidesByCategory(category);
          const published = all.filter((guide) => guide.status === "published");
          const upcoming = all.filter((guide) => guide.status !== "published");
          return (
            <div id={categoryAnchors[category]} class="grid scroll-mt-24 gap-x-10 gap-y-3 py-7 md:grid-cols-[13rem_minmax(0,1fr)]">
              <h3 class="font-serif text-xl font-semibold text-ink-950 md:pt-3">{category}</h3>
              <div class="min-w-0">
                {published.map((guide) => (
                  <a href={guideHref(guide.slug)} class="group -mx-3 flex items-start justify-between gap-4 rounded-xl px-3 py-3 transition-colors hover:bg-brand-50/60">
                    <span class="min-w-0">
                      <span class="block font-serif text-lg font-semibold text-ink-950 group-hover:text-brand-700">{guide.title}</span>
                      <span class="mt-1 block text-sm leading-relaxed text-ink-700/75">{guide.teaser}</span>
                    </span>
                    <ArrowRight className="mt-1.5 h-5 w-5 shrink-0 text-brand-600 transition-transform duration-200 group-hover:translate-x-0.5" aria-hidden="true" />
                  </a>
                ))}
                {upcoming.length > 0 && (
                  <p class:list={["text-sm leading-relaxed text-ink-700/65", published.length > 0 ? "mt-2" : "md:pt-3.5"]}>
                    <span class="font-semibold text-ink-700/80">In Vorbereitung:</span> {upcoming.map((guide) => guide.title).join(" · ")}
                  </p>
                )}
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
