---
import { CheckCircle2 } from "lucide-react";

interface Props {
  beratungsbedarf: string;
  wer: string;
  favoriten: string;
  favoritenLabel?: string;
}

const { beratungsbedarf, wer, favoriten, favoritenLabel = "Mein Favorit" } = Astro.props;
---

<div data-reveal class="mt-8 max-w-md rounded-2xl border border-black/5 bg-white p-5 shadow-lg sm:p-6">
  <p class="text-xs font-semibold uppercase tracking-wide text-brand-600">Meine Einschätzung</p>

  <ul class="mt-4 space-y-3">
    <li class="flex items-start gap-2.5 text-sm">
      <CheckCircle2 className="mt-0.5 h-4 w-4 shrink-0 text-brand-600" aria-hidden="true" />
      <span class="text-ink-950">Beratungsbedarf: <span class="font-medium">{beratungsbedarf}</span></span>
    </li>
    <li class="flex items-start gap-2.5 text-sm">
      <CheckCircle2 className="mt-0.5 h-4 w-4 shrink-0 text-brand-600" aria-hidden="true" />
      <span class="text-ink-950">Wer benötigt es: <span class="font-medium">{wer}</span></span>
    </li>
    <li class="flex items-start gap-2.5 text-sm">
      <CheckCircle2 className="mt-0.5 h-4 w-4 shrink-0 text-brand-600" aria-hidden="true" />
      <span class="text-ink-950">{favoritenLabel}: <span class="font-medium">{favoriten}</span></span>
    </li>
  </ul>
</div>
