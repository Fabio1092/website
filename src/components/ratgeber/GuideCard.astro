---
import { Clock } from "lucide-react";

interface Props {
  title: string;
  teaser: string;
  href: string;
  ctaLabel: string;
  category?: string;
  variant?: "featured" | "compact";
  comingSoon?: boolean;
  delay?: number;
}

const { title, teaser, href, ctaLabel, category, variant = "featured", comingSoon = false, delay = 0 } = Astro.props;
---

{
  variant === "featured" ? (
    <div data-reveal style={`transition-delay: ${delay}ms`} class="min-w-0 flex flex-col rounded-2xl border border-black/5 bg-white p-6 shadow-soft sm:p-7">
      <div class="flex items-start justify-between gap-3">
        {category && <span class="min-w-0 text-xs font-semibold uppercase tracking-wide text-brand-600">{category}</span>}
        {comingSoon && (
          <span class="inline-flex shrink-0 items-center gap-1 rounded-full border border-gold-200 bg-gold-50 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wide text-gold-700">
            <Clock className="h-3 w-3" aria-hidden="true" />
            Soon
          </span>
        )}
      </div>
      <h3 class="mt-3 min-w-0 hyphens-auto break-words font-serif text-lg font-semibold text-ink-950">{title}</h3>
      <p class="mt-2.5 flex-1 text-sm leading-relaxed text-ink-700/75">{teaser}</p>
      <a href={href} class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700 transition-colors hover:text-brand-800">
        {ctaLabel} →
      </a>
    </div>
  ) : (
    <div data-reveal style={`transition-delay: ${delay}ms`} class="min-w-0 flex flex-col rounded-2xl border border-black/5 bg-white p-6">
      <div class="flex items-start justify-between gap-3">
        <h4 class="min-w-0 hyphens-auto break-words font-serif text-base font-semibold text-ink-950">{title}</h4>
        {comingSoon && (
          <span class="inline-flex shrink-0 items-center gap-1 rounded-full border border-gold-200 bg-gold-50 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-gold-700">
            <Clock className="h-2.5 w-2.5" aria-hidden="true" />
            Soon
          </span>
        )}
      </div>
      <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-700/75">{teaser}</p>
      <a href={href} class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700 transition-colors hover:text-brand-800">
        {ctaLabel} →
      </a>
    </div>
  )
}
