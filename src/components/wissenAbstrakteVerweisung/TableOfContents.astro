---
const entries = [
  { id: "das-wichtigste-auf-einen-blick", label: "Das Wichtigste auf einen Blick" },
  { id: "was-ist-die-abstrakte-verweisung", label: "Was ist die abstrakte Verweisung?" },
  { id: "beispiel-abstrakte-verweisung", label: "Ein einfaches Beispiel" },
  { id: "verzicht-auf-die-abstrakte-verweisung", label: "Was bedeutet der Verzicht?" },
  { id: "ausbildung-faehigkeiten-lebensstellung", label: "Ausbildung, Fähigkeiten und Lebensstellung" },
  { id: "verzicht-heute-noch-besonders", label: "Ist der Verzicht heute noch etwas Besonderes?" },
  { id: "vorsicht-bei-aelteren-bu-vertraegen", label: "Vorsicht bei älteren BU-Verträgen" },
  { id: "versteckte-abstrakte-verweisung-berufspause", label: "Die „versteckte“ Verweisung bei Berufspausen" },
  { id: "abstrakte-und-konkrete-verweisung-unterschied", label: "Abstrakte vs. konkrete Verweisung" },
  { id: "alten-vertrag-kuendigen", label: "Muss ich einen alten Vertrag kündigen?" },
  { id: "meine-einschaetzung", label: "Meine Einschätzung" },
  { id: "fazit", label: "Fazit" },
  { id: "faq", label: "FAQ" },
];
---

<section class="bg-white py-14">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <nav aria-label="Inhaltsverzeichnis" class="rounded-2xl border border-black/5 bg-brand-50/30 p-6 sm:p-8">
      <p class="text-xs font-semibold uppercase tracking-wide text-brand-600">Inhalt dieses Artikels</p>
      <ul class="mt-4 grid grid-cols-1 gap-x-8 gap-y-2.5 sm:grid-cols-2">
        {
          entries.map((entry, index) => (
            <li>
              <a
                href={`#${entry.id}`}
                class="group flex items-baseline gap-2.5 text-sm leading-relaxed text-ink-700/85 transition-colors duration-150 hover:text-brand-700"
              >
                <span class="tabular-nums text-xs font-semibold text-brand-400 group-hover:text-brand-600">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="underline decoration-transparent underline-offset-2 group-hover:decoration-brand-300">{entry.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</section>
