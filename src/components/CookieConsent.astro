---
---

<div
  id="cookie-consent"
  class="fixed inset-x-0 bottom-0 z-[60] hidden border-t border-white/10 bg-ink-950 px-4 py-5 text-white shadow-2xl sm:px-6 lg:px-8"
  role="dialog"
  aria-live="polite"
  aria-label="Cookie-Einwilligung"
>
  <div class="mx-auto flex max-w-6xl flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-sm leading-relaxed text-white/80">
      Wir nutzen Cookies, um die Nutzung unserer Website mit Google Analytics zu analysieren und
      den Erfolg unserer Google-Ads-Anzeigen zu messen. Du kannst frei entscheiden, ob du dem
      zustimmst. Mehr dazu in unserer
      <a href="/datenschutz/" class="underline underline-offset-2 hover:text-white">Datenschutzerklärung</a>.
    </p>
    <div class="flex shrink-0 gap-3">
      <button
        id="cookie-reject"
        type="button"
        class="rounded-full border border-white/20 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:border-white/40 hover:bg-white/5"
      >
        Ablehnen
      </button>
      <button
        id="cookie-accept"
        type="button"
        class="rounded-full bg-gold-500 px-5 py-2.5 text-sm font-semibold text-ink-950 transition-transform duration-200 hover:-translate-y-0.5 hover:bg-gold-400"
      >
        Akzeptieren
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var STORAGE_KEY = "cookie-consent";

    function showBanner() {
      var banner = document.getElementById("cookie-consent");
      if (banner) banner.classList.remove("hidden");
    }

    function hideBanner() {
      var banner = document.getElementById("cookie-consent");
      if (banner) banner.classList.add("hidden");
    }

    var stored = localStorage.getItem(STORAGE_KEY);
    if (stored !== "accepted" && stored !== "rejected") {
      showBanner();
    }

    var acceptBtn = document.getElementById("cookie-accept");
    var rejectBtn = document.getElementById("cookie-reject");

    if (acceptBtn) {
      acceptBtn.addEventListener("click", function () {
        localStorage.setItem(STORAGE_KEY, "accepted");
        window.gtag("consent", "update", {
          analytics_storage: "granted",
          ad_storage: "granted",
          ad_user_data: "granted",
          ad_personalization: "granted",
        });
        hideBanner();
      });
    }

    if (rejectBtn) {
      rejectBtn.addEventListener("click", function () {
        localStorage.setItem(STORAGE_KEY, "rejected");
        window.gtag("consent", "update", {
          analytics_storage: "denied",
          ad_storage: "denied",
          ad_user_data: "denied",
          ad_personalization: "denied",
        });
        hideBanner();
      });
    }

    window.openCookieSettings = function () {
      showBanner();
    };
  })();
</script>
