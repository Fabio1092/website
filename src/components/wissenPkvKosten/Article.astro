          "stationärer Behandlung",
          "Ein- oder Zweibettzimmer",
          "privatärztlicher Behandlung",
          "Zahnersatz",
          "Psychotherapie",
          "Hilfsmitteln",
          "Heilmitteln",
          "Vorsorge",
          "Auslandsschutz",
          "Gebührenordnung",
          "Erstattung über die Höchstsätze der Gebührenordnung",
