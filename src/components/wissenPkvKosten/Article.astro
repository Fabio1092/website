---
import RichParagraph from "@/components/RichParagraph.astro";

type Part = string | { b: string } | { a: string; href: string };

type Block =
  | { type: "p"; parts: Part[] }
  | { type: "standalone"; text: string }
  | { type: "quote"; text: string }
  | { type: "list"; items: string[] }
  | { type: "h3"; text: string }
  | { type: "table"; headers: string[]; rows: string[][] };

interface Section {
  id: string;
  heading: string;
  blocks: Block[];
}

const introBlocks: Block[] = [
  { type: "p", parts: ["Alle drei Aussagen können richtig sein."] },
  {
    type: "p",
    parts: ["Denn anders als in der gesetzlichen Krankenversicherung wird dein Beitrag in der PKV nicht einfach anhand deines Einkommens berechnet."],
  },
  {
    type: "p",
    parts: [
      "Entscheidend sind unter anderem dein Eintrittsalter, dein Gesundheitszustand, der gewünschte Leistungsumfang, der Selbstbehalt und die konkrete Kalkulation des Versicherers.",
    ],
  },
  { type: "p", parts: ["Deshalb ist jede Zahl in diesem Artikel zunächst eine Orientierung."] },
  { type: "standalone", text: "Dein persönlicher PKV-Beitrag kann deutlich davon abweichen." },
  { type: "p", parts: ["Trotzdem halte ich wenig davon, bei der Frage nach den Kosten nur mit „Es kommt darauf an“ zu antworten."] },
  {
    type: "p",
    parts: ["Wer über einen Wechsel in die private Krankenversicherung nachdenkt, möchte zumindest wissen, in welcher Größenordnung sich vernünftiger Versicherungsschutz bewegt."],
  },
  { type: "p", parts: ["Genau darum geht es hier."] },
];

const sections: Section[] = [
  {
    id: "pkv-kosten-2026-ueberblick",
    heading: "PKV-Kosten 2026 auf einen Blick",
    blocks: [
      { type: "p", parts: ["Wenn du nur eine erste Größenordnung suchst:"] },
      { type: "p", parts: ["Der PKV-Verband erwartet für 2026 einen durchschnittlichen PKV-Beitrag von rund ", { b: "617 Euro monatlich" }, "."] },
      { type: "p", parts: ["Wichtig ist allerdings die Einordnung:"] },
      { type: "standalone", text: "Dieser Durchschnittswert ist kein typischer Angebotspreis für einen Neuabschluss." },
      { type: "p", parts: ["Dein persönlicher Beitrag kann deutlich darunter oder darüber liegen."] },
