      { type: "p", parts: ["beziehungsweise:"] },
      { type: "standalone", text: "69.750 Euro jährlich." },
      { type: "p", parts: ["Der allgemeine Beitragssatz der gesetzlichen Krankenversicherung liegt bei:"] },
      { type: "standalone", text: "14,6 Prozent." },
      { type: "p", parts: ["Hinzu kommt der Zusatzbeitrag der jeweiligen Krankenkasse."] },
      { type: "p", parts: ["Der vom Bundesministerium für Gesundheit festgelegte durchschnittliche Zusatzbeitragssatz beträgt 2026:"] },
      { type: "standalone", text: "2,9 Prozent." },
      {
        type: "p",
        parts: ["Bei Anwendung dieses durchschnittlichen Zusatzbeitrags ergibt sich an der Beitragsbemessungsgrenze ein Krankenversicherungsbeitrag von rund:"],
      },
      { type: "standalone", text: "1.017,19 Euro monatlich." },
      { type: "p", parts: ["Wichtig für einen fairen Vergleich:"] },
      { type: "standalone", text: "Diese 1.017,19 Euro beziehen sich auf die gesetzliche Krankenversicherung." },
      { type: "p", parts: ["Die Pflegeversicherung kommt zusätzlich hinzu."] },
      {
        type: "p",
        parts: [
          "Wenn wir einen PKV-Gesamtbeitrag betrachten, in dem die private Pflegepflichtversicherung bereits enthalten ist, dürfen wir diese Werte deshalb nicht ungekennzeichnet direkt miteinander vergleichen.",
        ],
      },
      { type: "p", parts: ["Bei einem Angestellten wird außerdem auch der GKV-Beitrag zwischen Arbeitnehmer und Arbeitgeber aufgeteilt."] },
      { type: "p", parts: ["Der volle Systembeitrag ist also nicht identisch mit dem persönlichen Eigenanteil des Arbeitnehmers."] },
      {
        type: "p",
        parts: [
          "Einen ausführlicheren Vergleich der beiden Systeme findest du unter ",
          { a: "GKV oder PKV?", href: "/wissen/private-krankenversicherung/gkv-oder-pkv/" },
          ".",
        ],
      },
    ],
  },
  {
    id: "pkv-automatisch-guenstiger",
    heading: "Ist die PKV automatisch günstiger als die GKV?",
    blocks: [
      { type: "p", parts: ["Nein."] },
      { type: "p", parts: ["Sie kann günstiger sein."] },
      { type: "p", parts: ["Sie kann ähnlich teuer sein."] },
      { type: "p", parts: ["Oder sie kann teurer sein."] },
      {
        type: "p",
        parts: ["Gerade bei jungen, gesunden und gutverdienenden Angestellten kann nach Arbeitgeberzuschuss ein deutlicher Beitragsunterschied entstehen."],
      },
      { type: "p", parts: ["Das darf aber nicht zur falschen Schlussfolgerung führen:"] },
      { type: "standalone", text: "„Die PKV ist besser, weil sie heute günstiger ist.“" },
      { type: "p", parts: ["Eine Krankenversicherung begleitet dich möglicherweise mehrere Jahrzehnte."] },
      { type: "p", parts: ["Familienplanung, Teilzeit, Selbstständigkeit, Einkommensentwicklung und Alter können die finanzielle Betrachtung verändern."] },
      { type: "p", parts: ["Deshalb sollte ein heutiger Beitragsvorteil niemals das einzige Wechselargument sein."] },
      {
        type: "p",
        parts: [
          "Wenn du grundsätzlich wissen möchtest, ob das System zu deiner Lebenssituation passt, findest du dazu meinen Artikel ",
          { a: "Für wen lohnt sich die PKV?", href: "/wissen/private-krankenversicherung/fuer-wen-lohnt-sich-die-pkv/" },
          ".",
        ],
      },
    ],
  },
  {
    id: "guenstige-pkv-automatisch-gut",
    heading: "Ist eine günstige PKV automatisch gut?",
    blocks: [
      { type: "p", parts: ["Nein."] },
      { type: "p", parts: ["Wenn mir jemand sagt:"] },
      { type: "p", parts: ["„Ich habe eine PKV für 320 Euro gefunden.“"] },
      { type: "p", parts: ["ist meine erste Frage nicht:"] },
      { type: "p", parts: ["„Wo kann ich unterschreiben?“"] },
      { type: "p", parts: ["Sondern:"] },
      { type: "standalone", text: "„Was ist dort eigentlich versichert?“" },
      { type: "p", parts: ["Ein sehr niedriger Beitrag kann beispielsweise durch:"] },
      { type: "list", items: ["hohen Selbstbehalt", "reduzierten Leistungsumfang", "schwächere Erstattungsregelungen", "bestimmte Tarifkonstruktionen"] },
      { type: "p", parts: ["entstehen."] },
      {
        type: "p",
        parts: ["Wenn du dich für eine private Krankenversicherung entscheidest, triffst du möglicherweise eine Entscheidung für mehrere Jahrzehnte."],
      },
      { type: "p", parts: ["Dann halte ich es für falsch, die Auswahl danach zu treffen, welcher Tarif heute 50 oder 70 Euro günstiger ist."] },
      {
        type: "p",
        parts: ["Ich würde lieber einen leistungsstarken Tarif auswählen, dessen Beitrag vernünftig zu deinem Einkommen passt, als ausschließlich den billigsten Tarif am Markt zu suchen."],
      },
    ],
  },
  {
    id: "vorerkrankungen-und-beitrag",
    heading: "Was passiert bei Vorerkrankungen mit dem Beitrag?",
    blocks: [
      { type: "p", parts: ["Vorerkrankungen können Einfluss auf die Annahme und den Beitrag haben."] },
      { type: "p", parts: ["Abhängig von Diagnose, Verlauf und Versicherer kann beispielsweise ein Risikozuschlag verlangt werden."] },
      { type: "p", parts: ["Ein Tarif, der für eine gesunde Person 650 Euro kostet, könnte mit einem Risikozuschlag entsprechend teurer werden."] },
      { type: "p", parts: ["Wie hoch dieser Zuschlag ausfällt oder ob überhaupt einer verlangt wird, lässt sich nicht pauschal sagen."] },
      { type: "p", parts: ["Versicherer bewerten gesundheitliche Vorgeschichten unterschiedlich."] },
      { type: "p", parts: ["Deshalb würde ich bei relevanten Vorerkrankungen zuerst prüfen:"] },
      { type: "standalone", text: "Zu welchen Bedingungen ist eine private Krankenversicherung überhaupt möglich?" },
      { type: "p", parts: ["Erst danach macht eine genaue Beitragsdiskussion Sinn."] },
      { type: "p", parts: ["Mehr dazu findest du unter:"] },
      { type: "p", parts: [{ a: "Gesundheitsfragen in der PKV", href: "/pkv-gesundheitsfragen/" }] },
      { type: "p", parts: ["und"] },
      { type: "p", parts: [{ a: "PKV-Risikovoranfrage", href: "/pkv-risikovoranfrage/" }] },
    ],
  },
  {
    id: "kosten-40-jahre",
    heading: "Was kostet die PKV mit 40 Jahren?",
    blocks: [
      { type: "p", parts: ["Mit 40 Jahren kann ein Neueinstieg bereits spürbar teurer sein als mit 30."] },
      {
        type: "p",
        parts: ["Veröffentlichte Tarifbeispiele für Vollschutz inklusive Pflege, aber teilweise ohne Krankentagegeld, bewegen sich je nach Leistungsniveau ungefähr zwischen:"],
      },
      { type: "standalone", text: "400 und 680 Euro monatlich." },
      { type: "p", parts: ["Innerhalb einzelner Tarifserien können besonders leistungsstarke Varianten auch darüber liegen."] },
      { type: "p", parts: ["Das zeigt einen wichtigen Punkt:"] },
      { type: "standalone", text: "Das Eintrittsalter macht einen Unterschied – aber genauso der konkrete Leistungsumfang." },
      { type: "p", parts: ["Ein günstiger 40-Jährigen-Tarif ist deshalb nicht automatisch besser als ein teurerer."] },
    ],
  },
  {
    id: "kosten-45-50-jahre",
    heading: "Was kostet die PKV mit 45 oder 50 Jahren?",
    blocks: [
      { type: "p", parts: ["Mit zunehmendem Eintrittsalter steigt die Bedeutung einer individuellen Kalkulation nochmals."] },
      { type: "p", parts: ["In veröffentlichten Tarifbeispielen lagen verschiedene Tarifstufen mit 45 Jahren ungefähr zwischen:"] },
      { type: "standalone", text: "490 und 1.000 Euro monatlich." },
      { type: "p", parts: ["Je leistungsstärker der Tarif, desto höher kann der Beitrag ausfallen."] },
      { type: "p", parts: ["Mit 50 Jahren kann ein umfassender Neuabschluss entsprechend nochmals darüber liegen."] },
      { type: "p", parts: ["Das bedeutet nicht, dass ein Wechsel mit 45 oder 50 grundsätzlich falsch ist."] },
      { type: "p", parts: ["Aber:"] },
      { type: "standalone", text: "Je später der Einstieg, desto wichtiger wird eine langfristige finanzielle Betrachtung." },
      { type: "p", parts: ["Gerade hier würde ich nicht nur auf den heutigen Monatsbeitrag schauen."] },
    ],
  },
  {
    id: "pkv-im-alter-unbezahlbar",
    heading: "Wird die PKV im Alter unbezahlbar?",
    blocks: [
      { type: "p", parts: ["PKV-Beiträge bleiben nicht für Jahrzehnte unverändert."] },
      { type: "p", parts: ["Beiträge können angepasst werden."] },
      { type: "p", parts: ["Das gehört zur langfristigen Kalkulation dazu."] },
      { type: "p", parts: ["Gleichzeitig enthält das PKV-System verschiedene Mechanismen, die der Beitragsentwicklung im Alter entgegenwirken sollen."] },
      { type: "p", parts: ["Dazu gehören insbesondere:"] },
      {
        type: "list",
        items: [
          "Alterungsrückstellungen",
          "der gesetzliche 10-%-Zuschlag",
          "mögliche zusätzliche Beitragsentlastungstarife",
          "Wegfall des Krankentagegeldes nach Ende der Erwerbstätigkeit, sofern es dann nicht mehr benötigt wird",
          "mögliche Zuschüsse im Rentenalter",
        ],
      },
      { type: "p", parts: ["Deshalb halte ich wenig von pauschalen Hochrechnungen wie:"] },
      { type: "p", parts: ["„600 Euro heute plus jedes Jahr 4 Prozent – also kostet die PKV später mehrere Tausend Euro.“"] },
      { type: "p", parts: ["Solche Rechnungen bilden die tatsächliche Tarifmechanik nicht vollständig ab."] },
      { type: "p", parts: ["Umgekehrt wäre es genauso unseriös zu sagen:"] },
      { type: "p", parts: ["„Die PKV bleibt im Alter automatisch günstig.“"] },
      { type: "p", parts: ["Das weiß heute niemand."] },
      { type: "p", parts: ["Die sinnvollere Frage ist:"] },
      { type: "standalone", text: "Wie plane ich meine PKV so, dass ich den Beitrag auch langfristig tragen kann?" },
      { type: "p", parts: ["Für mich gehören dazu:"] },
      {
        type: "list",
        items: [
          "vernünftiger Einstiegsbeitrag",
          "leistungsstarke Tarifbedingungen",
          "ausreichende Altersvorsorge",
          "Alterungsrückstellungen",
          "mögliche Beitragsentlastung",
          "finanzielle Reserven",
          "einen heutigen Beitragsvorteil nicht vollständig zu konsumieren",
        ],
      },
    ],
  },
  {
    id: "was-kostet-eine-gute-pkv",
    heading: "Was kostet eine gute PKV also wirklich?",
    blocks: [
      { type: "p", parts: ["Wenn du nur eine grobe Einordnung möchtest, würde ich es so zusammenfassen:"] },
      {
        type: "table",
        headers: ["Situation", "Grobe Orientierung"],
        rows: [
          ["Gesunder 30-Jähriger, einfacherer Schutz", "ca. 250–400 €"],
          ["Gesunder 30-Jähriger, solider Schutz", "ca. 350–500 €"],
          ["Gesunder 30-Jähriger, sehr guter Schutz", "ca. 500–650 €"],
          ["Gesunder 30-Jähriger, Premiumschutz", "ca. 600–800 €"],
          ["Einstieg mit etwa 40 Jahren", "je nach Tarif häufig ca. 400–700 € oder mehr"],
          ["Einstieg mit etwa 45 Jahren", "je nach Tarif ca. 490–1.000 € oder mehr"],
          ["Selbstständiger mit umfangreicher Absicherung", "häufig ca. 650–900 € oder mehr"],
          ["Beamter mit Beihilfe", "häufig deutlich niedriger als eine normale Vollversicherung"],
          ["Kind", "häufig grob ca. 150–270 €"],
        ],
      },
      { type: "p", parts: ["Diese Werte sind ausdrücklich:"] },
      { type: "standalone", text: "Orientierungswerte und keine verbindlichen Angebote." },
      { type: "p", parts: ["Die tatsächliche Kalkulation kann erheblich abweichen."] },
      { type: "p", parts: ["Alter, Gesundheit, Tarif, Selbstbehalt, Krankentagegeld und Leistungsumfang können den Beitrag stark verändern."] },
    ],
  },
  {
    id: "durchschnitt-oder-persoenliches-angebot",
    heading: "Durchschnittlicher PKV-Beitrag oder persönliches Angebot?",
    blocks: [
      { type: "p", parts: ["Diese beiden Zahlen sollte man nicht miteinander verwechseln."] },
      { type: "p", parts: ["Der PKV-Verband erwartet für 2026 einen durchschnittlichen Beitrag von rund:"] },
      { type: "standalone", text: "617 Euro monatlich." },
      { type: "p", parts: ["Dieser Wert sagt etwas über den Versichertenbestand aus."] },
      { type: "p", parts: ["Er beantwortet aber nicht:"] },
      { type: "standalone", text: "„Was kostet ein Neuabschluss für mich heute?“" },
      { type: "p", parts: ["Ein 29-jähriger gesunder Angestellter kann bei einem konkreten Tarif deutlich darunter liegen."] },
      { type: "p", parts: ["Ein 48-jähriger Interessent mit höherem Leistungsniveau kann deutlich darüber liegen."] },
      { type: "p", parts: ["Deshalb sind Durchschnittswerte interessant, aber für eine konkrete Entscheidung nur begrenzt hilfreich."] },
    ],
  },
  {
    id: "wichtigster-rat",
    heading: "Mein wichtigster Rat zum PKV-Beitrag",
    blocks: [
      { type: "p", parts: ["Ich würde eine private Krankenversicherung niemals nach der Frage auswählen:"] },
      { type: "standalone", text: "„Wie bekomme ich meinen Monatsbeitrag maximal niedrig?“" },
      { type: "p", parts: ["Sondern:"] },
      { type: "standalone", text: "„Welcher Versicherungsschutz passt langfristig zu mir – und kann ich diesen Beitrag dauerhaft vernünftig tragen?“" },
      { type: "p", parts: ["Wenn dabei gegenüber der gesetzlichen Krankenversicherung zusätzlich ein Beitragsvorteil entsteht, ist das angenehm."] },
      { type: "p", parts: ["Aber der Beitragsvorteil sollte:"] },
      { type: "standalone", text: "das Ergebnis einer guten PKV-Entscheidung sein und nicht der alleinige Grund für die Entscheidung." },
      { type: "p", parts: ["Wenn du noch nicht weißt, ob die PKV grundsätzlich zu deiner Lebenssituation passt:"] },
      { type: "p", parts: [{ a: "Für wen lohnt sich die PKV?", href: "/wissen/private-krankenversicherung/fuer-wen-lohnt-sich-die-pkv/" }] },
      { type: "p", parts: ["Wenn du wissen möchtest, ob du überhaupt in die private Krankenversicherung wechseln kannst:"] },
      { type: "p", parts: [{ a: "PKV Voraussetzungen", href: "/wissen/private-krankenversicherung/pkv-voraussetzungen/" }] },
    ],
  },
];
---

<div class="mx-auto max-w-3xl space-y-20 px-4 py-16 sm:px-6 lg:px-8">
  <div data-reveal class="space-y-4">
    {
      introBlocks.map((block) => {
        if (block.type === "p") return <RichParagraph parts={block.parts} />;
        if (block.type === "standalone") return <p class="text-base font-medium leading-relaxed text-ink-950">{block.text}</p>;
        return null;
      })
    }
  </div>

  {
    sections.map((section) => (
      <section id={section.id} class="scroll-mt-24">
        <h2 class="font-serif text-2xl font-semibold tracking-tight text-ink-950 sm:text-3xl">{section.heading}</h2>
        <div data-reveal class="mt-6 space-y-4">
          {section.blocks.map((block) => {
            if (block.type === "p") return <RichParagraph parts={block.parts} />;
            if (block.type === "standalone") return <p class="text-base font-medium leading-relaxed text-ink-950">{block.text}</p>;
            if (block.type === "quote")
              return (
                <blockquote class="border-l-2 border-brand-200 pl-5">
                  <p class="font-serif text-lg italic leading-relaxed text-ink-950">{block.text}</p>
                </blockquote>
              );
            if (block.type === "list")
              return (
                <ul class="space-y-2">
                  {block.items.map((item) => (
                    <li class="flex items-baseline gap-2.5 text-base leading-relaxed text-ink-700/85">
                      <span class="h-1.5 w-1.5 shrink-0 translate-y-[-2px] rounded-full bg-brand-400" aria-hidden="true" />
                      {item}
                    </li>
                  ))}
                </ul>
              );
            if (block.type === "h3") return <h3 class="!mt-10 font-serif text-xl font-semibold text-ink-950">{block.text}</h3>;
            if (block.type === "table")
              return (
                <div class="overflow-x-auto rounded-xl border border-black/5">
                  <table class="w-full min-w-[560px] border-collapse text-left text-sm">
                    <thead>
                      <tr class="bg-brand-50/60">
                        {block.headers.map((h) => (
                          <th class="px-4 py-3 font-semibold text-ink-950">{h}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-black/5 bg-white">
                      {block.rows.map((row) => (
                        <tr>
                          {row.map((cell, i) => (
                            <td class={i === 0 ? "px-4 py-3 font-medium text-ink-950" : "px-4 py-3 text-ink-700/80"}>{cell}</td>
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              );
            return null;
          })}
        </div>
      </section>
    ))
  }
</div>
