---
const cards = [
  {
    title: "Tarife verständlich einordnen",
    text: "Ich ordne geeignete PKV-Tarife ein und erkläre dir die wichtigsten Unterschiede bei Leistungen und Beiträgen.",
  },
  {
    title: "Gesundheitsfragen sorgfältig vorbereiten",
    text: "Wir bereiten deine Angaben vor und prüfen bei Bedarf eine Risikovoranfrage.",
  },
  {
    title: "Persönliche Begleitung bis zum Antrag",
    text: "Du bekommst Raum für Fragen und wirst bei der Antragstellung begleitet.",
  },
];
---

<section id="leistungen" class="scroll-mt-20 bg-white py-16 sm:py-24">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <div data-reveal class="mx-auto max-w-xl text-center">
      <h2 class="font-serif text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">Was du von mir bekommst</h2>
    </div>

    <div class="mx-auto mt-10 grid gap-5 sm:grid-cols-3">
      {
        cards.map((c, i) => (
          <div data-reveal style={`transition-delay: ${i * 80}ms`} class="rounded-2xl border border-black/5 bg-brand-50/20 p-6 shadow-soft">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-ink-950 font-serif text-sm font-semibold text-white">
              {i + 1}
            </span>
            <h3 class="mt-4 font-serif text-lg font-semibold text-ink-950">{c.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-700/80">{c.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
