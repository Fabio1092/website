---
const faqs = [
  {
    question: "Ist die PKV für Referendare immer sinnvoll?",
    answer: "Nein – das hängt von Status, Beihilfe und deiner Situation ab.",
  },
  {
    question: "Welche Rolle spielt die Beihilfe?",
    answer: "Viele verbeamtete Lehrkräfte erhalten Beihilfe. Die Höhe hängt von Dienstherr und Bundesland ab.",
  },
  {
    question: "Was ist bei Gesundheitsfragen wichtig?",
    answer: "Du musst die Gesundheitsfragen vollständig beantworten. Wir bereiten deine Angaben vor und prüfen bei Bedarf eine Risikovoranfrage.",
  },
  {
    question: "Muss ich den günstigsten Anwärtertarif nehmen?",
    answer: "Nicht allein wegen des Preises – auch Leistungen und die spätere Entwicklung zählen.",
  },
  {
    question: "Was passiert im kostenlosen Erstgespräch?",
    answer: "In 15 Minuten klären wir deine Situation und die nächsten Schritte.",
  },
];
---

<section id="faq" class="scroll-mt-20 bg-brand-50/30 py-16 sm:py-24">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <h2 class="font-serif text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">Häufige Fragen</h2>
    </div>

    <div data-reveal class="mx-auto mt-10 divide-y divide-black/5 overflow-hidden rounded-2xl border border-black/5 bg-white shadow-soft">
      {
        faqs.map((faq) => (
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 marker:content-none [&::-webkit-details-marker]:hidden">
              <h3 class="font-serif text-base font-semibold text-ink-950 sm:text-lg">{faq.question}</h3>
              <svg
                class="h-5 w-5 shrink-0 text-ink-700/50 transition-transform duration-200 group-open:rotate-180"
                viewBox="0 0 20 20"
                fill="none"
                aria-hidden="true"
              >
                <path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <p class="px-6 pb-6 text-sm leading-relaxed text-ink-700/80 sm:text-base">{faq.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
