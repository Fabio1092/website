---
import BookingButton from "@/components/BookingButton.astro";

const steps = [
  { number: "01", title: "Kennenlernen", text: "Wir klären deine Situation und deine Ziele." },
  { number: "02", title: "Voraussetzungen", text: "Wir betrachten Beihilfe, Leistungen und Gesundheitsfragen." },
  { number: "03", title: "Vergleich", text: "Ich bereite geeignete Möglichkeiten verständlich für dich auf." },
  { number: "04", title: "Entscheidung", text: "Du entscheidest auf einer nachvollziehbaren Grundlage." },
];
---

<section id="beratungsprozess" class="scroll-mt-20 bg-brand-50/30 py-16 sm:py-24">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <div data-reveal class="mx-auto max-w-xl text-center">
      <h2 class="font-serif text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">In vier Schritten zu deiner PKV-Entscheidung</h2>
    </div>

    <div class="relative mx-auto mt-14 max-w-sm lg:max-w-3xl">
      <div class="absolute left-0 right-0 top-6 hidden h-px bg-brand-200 lg:block" aria-hidden="true"></div>

      <ol class="relative flex flex-col gap-8 lg:grid lg:grid-cols-4 lg:gap-4">
        {
          steps.map((step, i) => (
            <li data-reveal style={`transition-delay: ${i * 80}ms`} class="relative flex gap-5 lg:flex-col lg:items-center lg:gap-0 lg:text-center">
              <div class="flex flex-col items-center lg:contents">
                <span class="relative z-10 flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-ink-950 font-serif text-sm font-semibold text-white lg:h-12 lg:w-12">
                  {step.number}
                </span>
                {i < steps.length - 1 && <span class="mt-2 w-px flex-1 bg-brand-200 lg:hidden" aria-hidden="true" />}
              </div>
              <div class="min-w-0 pb-2 lg:min-w-0 lg:pb-0 lg:pt-4">
                <h3 class="font-serif text-base font-semibold text-ink-950">{step.title}</h3>
                <p class="mt-1 max-w-[11rem] text-sm leading-relaxed text-ink-700/75 lg:mx-auto">{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <p class="mx-auto mt-10 max-w-md text-center text-xs leading-relaxed text-ink-700/55">
      Nur Schritt 1 ist das kostenlose 15-minütige Erstgespräch. Eine vollständige Marktanalyse ist in 15
      Minuten nicht möglich.
    </p>

    <div class="mx-auto mt-6 max-w-lg text-center">
      <BookingButton location="process" variant="compact" />
    </div>
  </div>
</section>
