---
import BookingButton from "@/components/BookingButton.astro";

const facts = ["Fachwirt für Versicherungen und Finanzen", "Mehr als zehn Jahre Berufserfahrung", "Unabhängiger Versicherungsmakler", "Persönlich in Kassel, digital deutschlandweit"];
---

<section id="ansprechpartner" class="scroll-mt-20 bg-white py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:items-center lg:gap-16">
      <div class="mx-auto w-full max-w-xs sm:max-w-sm lg:mx-0 lg:max-w-none">
        <div class="relative">
          <div class="pointer-events-none absolute -inset-4 -z-10 rounded-[2rem] bg-gradient-to-br from-brand-500/10 via-transparent to-gold-500/10 blur-xl" aria-hidden="true"></div>
          <img
            src="/images/1-48.jpg"
            alt="Fabio Rumpf, Versicherungsmakler aus Kassel"
            class="aspect-[4/5] w-full rounded-[2rem] border border-black/5 object-cover shadow-2xl shadow-black/10"
            width="800"
            height="1000"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>

      <div data-reveal class="min-w-0 text-center lg:text-left">
        <span class="inline-flex items-center rounded-full border border-brand-200 bg-brand-50 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-brand-700">
          Dein Ansprechpartner
        </span>

        <h2 class="mt-5 font-serif text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">Dein Ansprechpartner: Fabio Rumpf</h2>

        <p class="mx-auto mt-6 max-w-xl text-base leading-relaxed text-ink-700/80 lg:mx-0">
          Ich bin unabhängiger Versicherungsmakler aus Kassel und auf PKV und BU spezialisiert. Ich helfe dir, die
          entscheidenden Unterschiede zu verstehen und deine PKV-Entscheidung sorgfältig vorzubereiten.
        </p>

        <ul class="mx-auto mt-6 grid max-w-xl grid-cols-1 gap-2.5 text-left sm:grid-cols-2 lg:mx-0">
          {
            facts.map((fact) => (
              <li class="flex items-start gap-2.5 text-sm text-ink-700/80">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500" aria-hidden="true" />
                {fact}
              </li>
            ))
          }
        </ul>

        <div class="mx-auto mt-8 lg:mx-0">
          <BookingButton location="advisor" variant="compact" />
        </div>
      </div>
    </div>
  </div>
</section>
