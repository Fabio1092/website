---
import BookingButton from "@/components/BookingButton.astro";

const statuses = [
  {
    key: "studium",
    label: "Noch im Studium",
    text: "Du möchtest frühzeitig verstehen, welche Krankenversicherungsfragen mit Referendariat und Berufseinstieg auf dich zukommen. Wir klären, welche Vorbereitung jetzt sinnvoll ist.",
  },
  {
    key: "referendariat",
    label: "Im Referendariat",
    text: "Du möchtest wissen, wie dein aktuelles Dienstverhältnis, mögliche Beihilfeansprüche und passende PKV-Tarife zusammenspielen. Wir schauen nicht nur auf den heutigen Anwärterbeitrag.",
  },
  {
    key: "verbeamtung",
    label: "Deine Verbeamtung steht an",
    text: "Du möchtest deinen Versicherungsschutz passend zu deiner neuen beruflichen Situation gestalten. Wir prüfen die relevanten Voraussetzungen, Leistungen und möglichen Fristen.",
  },
  {
    key: "angestellt",
    label: "Du bist als Lehrkraft angestellt",
    text: "Für angestellte Lehrkräfte gelten andere Voraussetzungen als für Beamte. Deshalb klären wir zuerst, ob die PKV für dich überhaupt infrage kommt.",
  },
];
---

<section id="status" class="scroll-mt-20 bg-brand-50/30 py-16 sm:py-24">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
    <div data-reveal class="text-center">
      <h2 class="font-serif text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">Wo stehst du gerade?</h2>
      <p class="mx-auto mt-3 max-w-md text-sm text-ink-700/60">Eine Orientierung, keine automatische Versicherungsempfehlung.</p>
    </div>

    <div data-reveal id="status-selector" class="mx-auto mt-8 max-w-xl rounded-3xl border border-black/5 bg-white p-6 shadow-soft sm:p-8">
      <div class="flex flex-wrap justify-center gap-2.5" role="group" aria-label="Wähle deine aktuelle Situation">
        {
          statuses.map((s) => (
            <button
              type="button"
              data-status-btn={s.key}
              aria-pressed="false"
              class="status-btn rounded-full border border-black/10 bg-white px-4 py-2.5 text-sm font-medium text-ink-700/80 transition-colors hover:border-brand-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500 aria-pressed:border-brand-500 aria-pressed:bg-brand-500 aria-pressed:text-white"
            >
              {s.label}
            </button>
          ))
        }
      </div>

      <div id="status-texts" class="mt-6 space-y-4">
        {
          statuses.map((s) => (
            <div data-status-text={s.key} class="rounded-2xl border border-black/5 bg-brand-50/20 p-5">
              <p class="font-serif text-base font-semibold text-ink-950">{s.label}</p>
              <p class="mt-2 text-sm leading-relaxed text-ink-700/80">{s.text}</p>
            </div>
          ))
        }
      </div>
    </div>

    <div class="mx-auto mt-8 max-w-lg text-center">
      <BookingButton location="status" variant="compact" label="Meine Situation besprechen" />
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var root = document.getElementById("status-selector");
    if (!root) return;
    var buttons = root.querySelectorAll(".status-btn");
    var texts = root.querySelectorAll("[data-status-text]");

    // Progressive enhancement: collapse to a single-select view only once JS runs.
    texts.forEach(function (t) {
      t.hidden = true;
    });

    function select(key) {
      buttons.forEach(function (b) {
        b.setAttribute("aria-pressed", String(b.getAttribute("data-status-btn") === key));
      });
      texts.forEach(function (t) {
        t.hidden = t.getAttribute("data-status-text") !== key;
      });
    }

    buttons.forEach(function (b) {
      b.addEventListener("click", function () {
        select(b.getAttribute("data-status-btn"));
      });
    });

    select(buttons[0].getAttribute("data-status-btn"));
  })();
</script>
