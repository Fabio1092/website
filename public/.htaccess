# Canonical host: force https://fr-makler.de (non-www)
# Single rule handles both http->https and www->non-www in one hop, avoiding redirect chains.
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.fr-makler\.de$ [NC]
RewriteRule ^(.*)$ https://fr-makler.de/$1 [L,R=301]

# Permanent redirect: BU main page migrated from /bu/ to its SEO-optimized URL.
# Query strings are preserved automatically by mod_rewrite (no QSD flag set).
RewriteRule ^bu/?$ https://fr-makler.de/berufsunfaehigkeitsversicherung-kassel/ [R=301,L]

# Ensure the charset is sent in the HTTP response header, not just in the HTML meta tag
AddDefaultCharset UTF-8

# Private, unlisted page: reinforce the noindex meta tags with an HTTP header.
# Not listed in robots.txt on purpose — that file is public and would broadcast the URL.
<IfModule mod_headers.c>
  RewriteCond %{REQUEST_URI} ^/gesamtcheck
  RewriteRule ^ - [E=NOINDEX_ROUTE:1]
  Header set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet" env=NOINDEX_ROUTE
</IfModule>
